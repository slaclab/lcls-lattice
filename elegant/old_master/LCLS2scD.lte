! LCLS2sc (November 27, 2018)
! ===========================

C: CHARGE,TOTAL= 100.0E-12

!Longitudinal wake of L0:
!=======================
!L0ZWAKE         : WAKE,INPUTFILE="zWake_1.3GHz_OneCavity_dz2um_TESLA2003-09.sdds", &
!  FACTOR=8.3,TCOLUMN="t",WCOLUMN="W",N_BINS=0,SMOOTHING=1
L0ZWAKE         : DRIF,L= 0.000000000E+00

!Laser heater ON:
!===============
HTRUND          : SCATTER,DP=5.5E-5

!Resistive-Wall wake of 2-inch-diameter SS linac extension line:
!==============================================================
RWWAKE1         : WAKE,INPUTFILE="SS_24.5mmR_100nm3mm.sdds", &
  FACTOR=24,TCOLUMN="t",WCOLUMN="W",N_BINS=0,SMOOTHING=1

!Resistive-Wall wake of 2-inch-diameter SS 1st dog-leg:
!=====================================================
RWWAKE2         : WAKE,INPUTFILE="SS_24.5mmR_100nm3mm.sdds", &
  FACTOR=78,TCOLUMN="t",WCOLUMN="W",N_BINS=0,SMOOTHING=1

!Resistive-Wall wake of 2-inch-diameter SS bypass line after dog-leg:
!===================================================================
RWWAKE4         : WAKE,INPUTFILE="SS_24.5mmR_100nm3mm.sdds", &
  FACTOR=2035,TCOLUMN="t",WCOLUMN="W",N_BINS=0,SMOOTHING=1

