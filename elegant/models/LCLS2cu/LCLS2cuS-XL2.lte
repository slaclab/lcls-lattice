! AD_ACCEL (preRelease)
! =====================

C: CHARGE,TOTAL= 0.25E-09

!Resistive-Wall wake of 24.5-mm-radius SS (BEGCLTH_0/RWWAKE3S):
!=============================================================
RWWAKE3S        : WAKE,INPUTFILE="SS_24.5mmR_100nm3mm.sdds", &
  FACTOR=182.0,TCOLUMN="t",WCOLUMN="W",N_BINS=0,SMOOTHING=1

!Resistive-Wall wake of 17.4-mm-radius Cu (RWWAKE3S/RWWAKE4S):
!============================================================
RWWAKE4S        : WAKE,INPUTFILE="Cu_17.4mmR_100nm_3mm.sdds", &
  FACTOR=341.7,TCOLUMN="t",WCOLUMN="W",N_BINS=0,SMOOTHING=1

!Resistive-Wall wake of 5.0-mm-gap Al (RWWAKE4S/RWWAKE5S):
!========================================================
RWWAKE5S        : WAKE,INPUTFILE="Al5mmgap_flat_0p5um10mm.sdds", &
  FACTOR=151.9,TCOLUMN="t",WCOLUMN="W",N_BINS=0,SMOOTHING=1

