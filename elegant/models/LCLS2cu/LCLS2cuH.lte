! AD_ACCEL: copper linac: WS02 to HXR
! ===================================
 
! *** OPTICS=AD_ACCEL-01JUN2026s ***
 
C: CHARGE,TOTAL= 250.0E-12
 
!Resistive-Wall wake of 24.5-mm-radius SS (BEGCLTH/RWWAKE3H):
!===========================================================
RWWAKE3H        : WAKE,INPUTFILE="SS_24.5mmR_100nm3mm.sdds", &
  FACTOR=182.0,TCOLUMN="t",WCOLUMN="W",N_BINS=0,SMOOTHING=1
 
!Resistive-Wall wake of 17.4-mm-radius Cu (RWWAKE3H/RWWAKE4H):
!============================================================
RWWAKE4H        : WAKE,INPUTFILE="Cu_17.4mmR_100nm_3mm.sdds", &
  FACTOR=338.7,TCOLUMN="t",WCOLUMN="W",N_BINS=0,SMOOTHING=1
 
!Resistive-Wall wake of 5.0-mm-gap Al (RWWAKE4H/RWWAKE5H):
!========================================================
RWWAKE5H        : WAKE,INPUTFILE="Al5mmgap_flat_0p5um10mm.sdds", &
  FACTOR=152.8,TCOLUMN="t",WCOLUMN="W",N_BINS=0,SMOOTHING=1
 
