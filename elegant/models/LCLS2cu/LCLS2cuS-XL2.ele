
! *** OPTICS=AD_ACCEL-18FEB2025s ***

! Edit "search_path =" in run_setup to point to the locations of your
! wakefield definition files and input particle distribution files

&run_setup
 lattice = LCLS2cuS-XL2.lte,
 rootname = LCLS2cuS-XL2,
 use_beamline = myline,
 output = %s.out,
 centroid = %s.cen,
 sigma = %s.sig,
 final = %s.fin,
 parameters = %s.par,
 magnets = %s.mag,
 combine_bunch_statistics = 0,
 default_order = 2,
 concat_order = 0,
 print_statistics = 0,
 random_number_seed = 9876543210,
 p_central_mev = 135,
 tracking_updates = 1,
 search_path = "D:\AD_ACCEL\wakes,D:\AD_ACCEL\beams"
&end

&run_control
 n_steps = 1,
 n_indices = 0,
 reset_rf_for_each_step = 1
&end

&floor_coordinates !initial coordinates at WS02
 filename = %s.flr,
 X0 = 2.370017058026,
 Z0 = 2.029449371971E3,
 theta0 = -0.610865238198
&end

&twiss_output !initial Twiss at WS02
 filename = %s.twi,
 matched = 0,
 beta_x = 1.112974241083,
 alpha_x = 0.068237677519,
 beta_y = 1.112508206187,
 alpha_y = 0.066916206364,
 concat_order = 3
&end

&sdds_beam !initial beam at WS02
 input = WS02_250pC_rescaleto540um_solGTF1M_flat.out,
 input_type = "elegant",
 sample_interval = 40,
 p_lower = 0,
 p_upper = 1e10,
 reuse_bunch = 0,
 reverse_t_sign = 0
&end

&track &end
