! AD_ACCEL: superconducting linac to HXR
! ======================================

! *** OPTICS=AD_ACCEL-14APR2025s ***

C: CHARGE,TOTAL= 100.0E-12

!Longitudinal wake of L0:
!=======================
!L0ZWAKE         : WAKE,INPUTFILE="zWake_1.3GHz_OneCavity_dz2um_TESLA2003-09.sdds", &
!  FACTOR=8.3,TCOLUMN="t",WCOLUMN="W",N_BINS=0,SMOOTHING=1
L0ZWAKE         : DRIF,L= 0.000000000E+00

!Laser heater ON:
!===============
HTRUNDB         : SCATTER,DP=5.0E-5

!Resistive-Wall wake of 24.5-mm-radius SS (BEGEXT/RWWAKE1):
!=========================================================
RWWAKE1         : WAKE,INPUTFILE="SS_24.5mmR_100nm3mm.sdds", &
  FACTOR=101.5,TCOLUMN="t",WCOLUMN="W",N_BINS=0,SMOOTHING=1

!Resistive-Wall wake of 24.5-mm-radius SS (RWWAKE1/RWWAKE2):
!==========================================================
RWWAKE2         : WAKE,INPUTFILE="SS_24.5mmR_100nm3mm.sdds", &
  FACTOR=2035.2,TCOLUMN="t",WCOLUMN="W",N_BINS=0,SMOOTHING=1

!Resistive-Wall wake of 24.5-mm-radius SS (RWWAKE1/RWWAKE3H):
!===========================================================
RWWAKE3H        : WAKE,INPUTFILE="SS_24.5mmR_100nm3mm.sdds", &
  FACTOR=443.7,TCOLUMN="t",WCOLUMN="W",N_BINS=0,SMOOTHING=1

!Resistive-Wall wake of 17.4-mm-radius Cu (RWWAKE3H/RWWAKE4H):
!============================================================
RWWAKE4H        : WAKE,INPUTFILE="Cu_17.4mmR_100nm_3mm.sdds", &
  FACTOR=338.7,TCOLUMN="t",WCOLUMN="W",N_BINS=0,SMOOTHING=1

!Resistive-Wall wake of 5.0-mm-gap Al (RWWAKE4H/RWWAKE5H):
!========================================================
RWWAKE5H        : WAKE,INPUTFILE="Al5mmgap_flat_0p5um10mm.sdds", &
  FACTOR=152.8,TCOLUMN="t",WCOLUMN="W",N_BINS=0,SMOOTHING=1

