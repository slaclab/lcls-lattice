! ==============================================================================
! quadrupoles
! ------------------------------------------------------------------------------

lq8cm = 2.0
rq8cm = 0.08/2
lq19 = 2.0
rq19 = 0.186/2
lq20 = 1.31318
rq20 = 8.25*0.0254/2
lsq = 0.55
rsq = 0.08/2

! the K-values below are for DASEL (the only connection to ALINE)

kq10 = 0.040946131243
kq11 = -0.038135136057
kq19 = 0.030837113549
kq20 = 0.146624351215e-2
kq27 = -0.083919622056
kq28 = 0.03548040664
kq30 = -0.028849559713
kq38 = 0.034487458519

q10: quadrupole, l = lq8cm/2, aperture = rq8cm, k1 = kq10, type = "3.15Q76"
q11: quadrupole, l = lq8cm/2, aperture = rq8cm, k1 = kq11, type = "3.15Q76"
q19: quadrupole, l = lq19/2, aperture = rq19, k1 = kq19, type = "Aline_Q19"
q20: quadrupole, l = lq20/2, aperture = rq20, k1 = kq20, type = "Aline_Q20"
q27: quadrupole, l = lq8cm/2, aperture = rq8cm, k1 = kq27, type = "3.15Q76"
q28: quadrupole, l = lq8cm/2, aperture = rq8cm, k1 = kq28, type = "3.15Q76"
q30: quadrupole, l = lq8cm/2, aperture = rq8cm, k1 = kq30, type = "3.15Q76"
q38: quadrupole, l = lq8cm/2, aperture = rq8cm, k1 = kq38, type = "3.15Q76"

ksq = 0.0

sq27p5: quadrupole, tilt = pi/4, l = lsq/2, aperture = rsq, k1 = ksq, type = "Aline_SQ27"

