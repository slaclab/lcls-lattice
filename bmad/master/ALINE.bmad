b22: sbend, type = "Aline_bend", hgap = gba/2, l = lba, angle = aba, e1 = aba/2, fint = 0.5, e2 = aba/2, fintx = 0.5
b23: sbend, type = "Aline_bend", hgap = gba/2, l = lba, angle = aba, e1 = aba/2, fint = 0.5, e2 = aba/2, fintx = 0.5
b24: sbend, type = "Aline_bend", hgap = gba/2, l = lba, angle = aba, e1 = aba/2, fint = 0.5, e2 = aba/2, fintx = 0.5
b25: sbend, type = "Aline_bend", hgap = gba/2, l = lba, angle = aba, e1 = aba/2, fint = 0.5, e2 = aba/2, fintx = 0.5
