! ==============================================================================
! coordinate rolls ... bend plane rotated to remove linac slope
! ------------------------------------------------------------------------------

rollon = 1.0

! original A-line values

 !ROLL1 : SROT, ANGLE= 0.014303845885    * ROLLON
 !ROLL2 : SROT, ANGLE=-0.393462907527E-2 * ROLLON
 !ROLL3 : SROT, ANGLE=-0.011395368282    * ROLLON

! new values

 !ROLL4 : SROT, ANGLE= 0.014303788803    * ROLLON
 !ROLL2 : SROT, ANGLE=-0.399639784046E-2 * ROLLON
 !ROLL3 : SROT, ANGLE= 0.0               * ROLLON !no ROLL3 per alignment group

roll2: patch, tilt = (0.014303788803-0.399639784046e-2) * rollon, descrip = "mad8_key:srot"
roll3: patch, tilt = 0.0 * rollon, descrip = "mad8_key:srot" !no ROLL3 per alignment group

! ==============================================================================
! XCORs and YCORs
! ------------------------------------------------------------------------------

a28x: hkicker, descrip = "mad8_key:hkic"
a32x: hkicker, descrip = "mad8_key:hkic"

a10y: vkicker, descrip = "mad8_key:vkic"
a18y: vkicker, descrip = "mad8_key:vkic"
a29y: vkicker, descrip = "mad8_key:vkic"
a33y: vkicker, descrip = "mad8_key:vkic"

! ==============================================================================
! BPMs
! ------------------------------------------------------------------------------

! rename BPM10 and BPM12 to avoid conflicts

bpm10a: monitor, descrip = "mad8_key:moni"
bpm12a: monitor, descrip = "mad8_key:moni"
bpm17: monitor, descrip = "mad8_key:moni"
bpm24: monitor, descrip = "mad8_key:moni"
bpm28: monitor, descrip = "mad8_key:moni"
bpm31: monitor, descrip = "mad8_key:moni"
bpm32: monitor, descrip = "mad8_key:moni"

! ==============================================================================
! profile monitors, wire scanners, wire arrays, synchrotron light ports,
! spectrum foils, burn-through monitors, and Cu-target
! ------------------------------------------------------------------------------

pr10: monitor, descrip = "mad8_key:moni"
sync: instrument, descrip = "mad8_key:inst"
pr18: monitor, descrip = "mad8_key:moni"
sp18: instrument, descrip = "mad8_key:inst"
pr20: monitor, descrip = "mad8_key:moni"
pr28: monitor, descrip = "mad8_key:moni"
pr33: monitor, descrip = "mad8_key:moni"

! ==============================================================================
! toroids and beam charge monitors
! ------------------------------------------------------------------------------

i10: marker, descrip = "mad8_key:mark"
i11: marker, descrip = "mad8_key:mark"
i24: marker, descrip = "mad8_key:mark"
i28: marker, descrip = "mad8_key:mark"
i29: marker, descrip = "mad8_key:mark"

! ==============================================================================
! collimators and slits
! ------------------------------------------------------------------------------

pc10: ecollimator, descrip = "mad8_key:ecol"
pc12: ecollimator, descrip = "mad8_key:ecol"
pc14: ecollimator, descrip = "mad8_key:ecol"
pc17: ecollimator, descrip = "mad8_key:ecol"
sl19: rcollimator, descrip = "mad8_key:rcol"
sl10: rcollimator, descrip = "mad8_key:rcol"
pc20: ecollimator, descrip = "mad8_key:ecol"
pc24: ecollimator, descrip = "mad8_key:ecol"
c24: rcollimator, descrip = "mad8_key:rcol"
pc26: ecollimator, descrip = "mad8_key:ecol"
pc29: ecollimator, descrip = "mad8_key:ecol"
c37: rcollimator, descrip = "mad8_key:rcol"

! ==============================================================================
! vacuum components
! ------------------------------------------------------------------------------

iv10: marker, descrip = "mad8_key:mark"
fv10: marker, descrip = "mad8_key:mark"
iv26: marker, descrip = "mad8_key:mark"
fv28: marker, descrip = "mad8_key:mark"

! ==============================================================================
! points of interest
! ------------------------------------------------------------------------------

begb: marker, descrip = "mad8_key:mark" !start of A-line bending
st22: marker, descrip = "mad8_key:mark" !beam stopper
marc: marker, descrip = "mad8_key:mark" !match point
endb: marker, descrip = "mad8_key:mark" !end of A-line bending (final emittance)
st29: marker, descrip = "mad8_key:mark" !beam stopper
alwall: marker, descrip = "mad8_key:mark" !upstream face of wall that separates A-line tunnel from alcove
esae: marker, descrip = "mad8_key:mark" !east wall of ESA
bmde: marker, descrip = "mad8_key:mark" !Beam Dump East

