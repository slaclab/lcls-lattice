
! *** OPTICS=AD_ACCEL-05OCT20 ***

! LCLS2sc A-line

! ==============================================================================
! Modification History
! ------------------------------------------------------------------------------
! 26-MAR-2019, M. Woodley
!  * split BSYA area into two subareas, BSYA_1 and BSYA_2
! ------------------------------------------------------------------------------
! 31-OCT-2018, Y. Nosochkov
!  * minor adjustment of DA04c drift length for DASEL with 25G kicker field
! 09-OCT-2018, M. Woodley
!  * add YCBSYA per D. McCormick
! ------------------------------------------------------------------------------
! 25-MAY-2018, M. Woodley
!  * change name of E158 bends in ESA to avoid redefinitions
! ------------------------------------------------------------------------------
! 07-FEB-2018, M. Woodley
!  * add TYPE designations for A-line magnets
! 05-FEB-2018, Y. Nosochkov
!  * minor optics rematch
! 25-JAN-2018, M. Woodley
!  * remove PCBSY2/BTMBSY2 per A. Ibrahimov
! ------------------------------------------------------------------------------
! 07-JUL-2017, Y. Nosochkov
!  * minor optics rematch for LCLS-II-HE
! ------------------------------------------------------------------------------
! 05-MAY-2017, M. Woodley
!  * remove deferral designations
!  * remove unused element definitions
!  * pulsed correctors XCAPM2/YCAPM2 will be timed to affect the straight-ahead
!    LTUH beam, but not the A-line beam
!  * extend line to 3PR2
! ------------------------------------------------------------------------------
! 02-MAR-2017, M. Woodley
!  * rename "SQ27.5" to SQ27p5 per G. White
!  * expand BSYA area to include entire A-line (up to End Station wall)
!  * add definitions for ABRDAS2 and TBRDAS2 (copied from DASEL.xsif)
! 24-FEB-2017, Y. Nosochkov
!  * merge with A-line deck containing diagnostic + E158 (from M. Woodley)
!  * rename rolled BKXAPM1-4 to BKRAPM1-4 (per naming convention)
!  * rename rolled BXAM1 to BRAM1 (per naming convention)
!  * remove ROLL4 S-rotation and replace it with BRAM1 tilt angle
!  * update ROLL2 value
!  * rename some parameters and drifts
!  * update definition of 2-hole DUMPBSYA copper collimator using two separate
!    collimators: for A-line (PCBSYA) and straight ahead BSY (PCBSYH)
!  * move PCBSYA/PCBSYH (formerly DUMPBSYA) 1.35 m upstream (D. McCormick)
!  * add deferred profile monitor PRBRAM1 and Cu target TGTBRAM1 upstream of
!    BRAM1 (D. McCormick)
!  * make the PRAPM profile monitor a YAG monitor (D. McCormick) and change
!    name to YAGAPM
!  * add deferred corrector package XCAPM2/YCAPM2 to the pulsed magnets
!    (D. McCormick)
!  * change deferment level of new A-line components from @3 to @1
! ------------------------------------------------------------------------------
! 02-NOV-2016, Y. Nosochkov
!  * replace fast kicker/septum magnets with 120 Hz pulsed magnets (deferred)
!    for ESTB (D. McCormick, J. Amann)
!  * the pulsed magnets and other ESTB devices are not funded by LCLS-II (Paul)
!  * update eng. type of BXAM1 from 1.0D38.37 to 2.0D38.37 (J. Amann)
!  * move to baseline: PCBSY2, BTMBSY2
! ------------------------------------------------------------------------------
! 24-JUN-2016, Y. Nosochkov
!  * add deferred BPMCUA between A-line kicker and septum
!  * update the engineering type of BKYAL1,...,BKYAL5 kickers to
!    "0.787K35.4" (J. Amann)
! ------------------------------------------------------------------------------
! 26-FEB-2016, M. Woodley
!  * remove SEQnn MARKers
! 26-FEB-2016, Y. Nosochkov
!  * add BCS PCBSY2/BTMBSY2 at Z=3124 m (deferred @0) (S. Mao)
!  * increase distance between kickers from 15 cm to 30 cm
! ------------------------------------------------------------------------------
! 25-SEP-2015, Y. Nosochkov
!  * update definitions of kickers and septum to allow zero angle
! 24-AUG-2015, Y. Nosochkov
!  * update the TYPE of septum from 0.39SD38.98 to 0.625SD38.98 (J. Amann)
!  * adjust quad strengths for match to the updated BSY optics
!  * match geometry to the updated positions of A-line kicker & septum
! ------------------------------------------------------------------------------
! 20-MAR-2015, M. Woodley
!  * add SEQ21BEG, SEQ21END, BEGBSYA, ENDBSYA MARKERs
! 12-MAR-2015, Y. Nosochkov
!  * add fast kickers and septum (as in spreader) to deflect beam into A-line
!  * A-line optics based on original design per M. Woodley's deck
! ------------------------------------------------------------------------------

! NOTE: ABRDAS2 and TBRDAS2 are defined in common.xsif

! ==============================================================================
! dipoles
! ------------------------------------------------------------------------------

! yawed pulsed magnets

gbkrapm = 35.687e-3      !1.405K40.83 pulsed magnet gap (m)
sbkrapm = 1.055          !PM eff. straight length (m)
tbkrapm = 0.014303833885 !PM tilt angle (rad)

abkrapm0 = -0.276615046502e-2
abkrapm = abkrapm0*setal     !angle per one PM (rad)
abkrapmh = abkrapm/2           !PM half-angle
abkrapmh2 = abkrapmh*abkrapmh
abkrapmh4 = abkrapmh2*abkrapmh2

lbkrapm = sbkrapm/(1-abkrapmh2/6+abkrapmh4/120) !PM path length

bkrapm1a: sbend, e1 = abkrapm/2, e2 = 0, fint = 0.5, fintx = 0, hgap = gbkrapm/2, type =  &
        "1.405K40.83", ref_tilt = tbkrapm, l = lbkrapm/2, angle =  &
        lbkrapm/2 * abkrapm/2/(lbkrapm/2)
bkrapm1b: sbend, e2 = abkrapm/2, e1 = 0, fint = 0, fintx = 0.5, hgap = gbkrapm/2, type =  &
        "1.405K40.83", ref_tilt = tbkrapm, l = lbkrapm/2, angle =  &
        lbkrapm/2 * abkrapm/2/(lbkrapm/2)

bkrapm2a: sbend, e1 = abkrapm/2, e2 = 0, fint = 0.5, fintx = 0, hgap = gbkrapm/2, type =  &
        "1.405K40.83", ref_tilt = tbkrapm, l = lbkrapm/2, angle =  &
        lbkrapm/2 * abkrapm/2/(lbkrapm/2)
bkrapm2b: sbend, e2 = abkrapm/2, e1 = 0, fint = 0, fintx = 0.5, hgap = gbkrapm/2, type =  &
        "1.405K40.83", ref_tilt = tbkrapm, l = lbkrapm/2, angle =  &
        lbkrapm/2 * abkrapm/2/(lbkrapm/2)

bkrapm3a: sbend, e1 = abkrapm/2, e2 = 0, fint = 0.5, fintx = 0, hgap = gbkrapm/2, type =  &
        "1.405K40.83", ref_tilt = tbkrapm, l = lbkrapm/2, angle =  &
        lbkrapm/2 * abkrapm/2/(lbkrapm/2)
bkrapm3b: sbend, e2 = abkrapm/2, e1 = 0, fint = 0, fintx = 0.5, hgap = gbkrapm/2, type =  &
        "1.405K40.83", ref_tilt = tbkrapm, l = lbkrapm/2, angle =  &
        lbkrapm/2 * abkrapm/2/(lbkrapm/2)

bkrapm4a: sbend, e1 = abkrapm/2, e2 = 0, fint = 0.5, fintx = 0, hgap = gbkrapm/2, type =  &
        "1.405K40.83", ref_tilt = tbkrapm, l = lbkrapm/2, angle =  &
        lbkrapm/2 * abkrapm/2/(lbkrapm/2)
bkrapm4b: sbend, e2 = abkrapm/2, e1 = 0, fint = 0, fintx = 0.5, hgap = gbkrapm/2, type =  &
        "1.405K40.83", ref_tilt = tbkrapm, l = lbkrapm/2, angle =  &
        lbkrapm/2 * abkrapm/2/(lbkrapm/2)

! define unsplit SBENs for BMAD ... not used by MAD

bkrapm1: sbend, hgap = gbkrapm/2, e1 = abkrapm/2, fint = 0.5, e2 = abkrapm/2, type =  &
        "1.405K40.83", ref_tilt = tbkrapm, l = lbkrapm, angle = lbkrapm * abkrapm/lbkrapm
bkrapm2: sbend, hgap = gbkrapm/2, e1 = abkrapm/2, fint = 0.5, e2 = abkrapm/2, type =  &
        "1.405K40.83", ref_tilt = tbkrapm, l = lbkrapm, angle = lbkrapm * abkrapm/lbkrapm
bkrapm3: sbend, hgap = gbkrapm/2, e1 = abkrapm/2, fint = 0.5, e2 = abkrapm/2, type =  &
        "1.405K40.83", ref_tilt = tbkrapm, l = lbkrapm, angle = lbkrapm * abkrapm/lbkrapm
bkrapm4: sbend, hgap = gbkrapm/2, e1 = abkrapm/2, fint = 0.5, e2 = abkrapm/2, type =  &
        "1.405K40.83", ref_tilt = tbkrapm, l = lbkrapm, angle = lbkrapm * abkrapm/lbkrapm

! PM projections onto BSY HXR beam

zbkrapm1 = sbkrapm*cos(abkrapm0*1/2)
zbkrapm2 = sbkrapm*cos(abkrapm0*3/2)
zbkrapm3 = sbkrapm*cos(abkrapm0*5/2)
zbkrapm4 = sbkrapm*cos(abkrapm0*7/2)

dbkrapm1a: drift, l = zbkrapm1/2
dbkrapm1b: drift, l = zbkrapm1/2
dbkrapm2a: drift, l = zbkrapm2/2
dbkrapm2b: drift, l = zbkrapm2/2
dbkrapm3a: drift, l = zbkrapm3/2
dbkrapm3b: drift, l = zbkrapm3/2
dbkrapm4a: drift, l = zbkrapm4/2
dbkrapm4b: drift, l = zbkrapm4/2

! A-line merge bend

gbram1 = 50.8e-3                         !2.0D38.37 gap height (m)
sbram1 = 1.025                           !2.0D38.37 straight length (m)
abram1 = 0.23261117109e-2                !bend angle (rad)
lbram1 = sbram1*abram1/(2*sin(abram1/2)) !path length (m)
tbram1 = 0.014303788803                  !bend roll (rad)

bram1a: sbend, e1 = abram1/2, e2 = 0, hgap = gbram1/2, fint = 0.5, fintx = 0, type = "2.0D38.37" &
        , ref_tilt = tbram1, l = lbram1/2, angle = lbram1/2 * abram1/2/(lbram1/2)
bram1b: sbend, e2 = abram1/2, e1 = 0, hgap = gbram1/2, fint = 0, fintx = 0.5, type = "2.0D38.37" &
        , ref_tilt = tbram1, l = lbram1/2, angle = lbram1/2 * abram1/2/(lbram1/2)

! define unsplit SBENs for BMAD ... not used by MAD

bram1: sbend, hgap = gbram1/2, e1 = abram1/2, fint = 0.5, e2 = abram1/2, type = "2.0D38.37",  &
        ref_tilt = tbram1, l = lbram1, angle = lbram1 * abram1/lbram1

! A-bends

aarc = -24*degrees             !total arc bend angle (24 degrees)
nbend = 12                     !number of arc bends
 !ABA   := AARC/Nbend             !nominal arc bend angle
aba = -1.999526617334*degrees !arc bend angle per Transport deck

lba = 3.024
gba = 0.06  !Blue Book value

b11a: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, fintx = 0, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b11b: sbend, hgap = gba/2, e2 = aba/2, fint = 0, fintx = 0.5, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b12a: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, fintx = 0, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b12b: sbend, hgap = gba/2, e2 = aba/2, fint = 0, fintx = 0.5, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b13a: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, fintx = 0, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b13b: sbend, hgap = gba/2, e2 = aba/2, fint = 0, fintx = 0.5, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b14a: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, fintx = 0, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b14b: sbend, hgap = gba/2, e2 = aba/2, fint = 0, fintx = 0.5, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b15a: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, fintx = 0, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b15b: sbend, hgap = gba/2, e2 = aba/2, fint = 0, fintx = 0.5, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b16a: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, fintx = 0, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b16b: sbend, hgap = gba/2, e2 = aba/2, fint = 0, fintx = 0.5, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b21a: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, fintx = 0, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b21b: sbend, hgap = gba/2, e2 = aba/2, fint = 0, fintx = 0.5, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b22a: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, fintx = 0, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b22b: sbend, hgap = gba/2, e2 = aba/2, fint = 0, fintx = 0.5, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b23a: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, fintx = 0, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b23b: sbend, hgap = gba/2, e2 = aba/2, fint = 0, fintx = 0.5, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b24a: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, fintx = 0, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b24b: sbend, hgap = gba/2, e2 = aba/2, fint = 0, fintx = 0.5, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b25a: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, fintx = 0, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b25b: sbend, hgap = gba/2, e2 = aba/2, fint = 0, fintx = 0.5, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b26a: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, fintx = 0, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)
b26b: sbend, hgap = gba/2, e2 = aba/2, fint = 0, fintx = 0.5, type = "Aline_bend", l = lba/2,  &
        angle = lba/2 * aba/2/(lba/2)

! define unsplit SBENs for BMAD ... not used by MAD

b11: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, e2 = aba/2, type = "Aline_bend", l = lba, angle &
         = lba * aba/lba
b12: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, e2 = aba/2, type = "Aline_bend", l = lba, angle &
         = lba * aba/lba
b13: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, e2 = aba/2, type = "Aline_bend", l = lba, angle &
         = lba * aba/lba
b14: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, e2 = aba/2, type = "Aline_bend", l = lba, angle &
         = lba * aba/lba
b15: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, e2 = aba/2, type = "Aline_bend", l = lba, angle &
         = lba * aba/lba
b16: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, e2 = aba/2, type = "Aline_bend", l = lba, angle &
         = lba * aba/lba
b21: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, e2 = aba/2, type = "Aline_bend", l = lba, angle &
         = lba * aba/lba
b22: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, e2 = aba/2, type = "Aline_bend", l = lba, angle &
         = lba * aba/lba
b23: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, e2 = aba/2, type = "Aline_bend", l = lba, angle &
         = lba * aba/lba
b24: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, e2 = aba/2, type = "Aline_bend", l = lba, angle &
         = lba * aba/lba
b25: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, e2 = aba/2, type = "Aline_bend", l = lba, angle &
         = lba * aba/lba
b26: sbend, hgap = gba/2, e1 = aba/2, fint = 0.5, e2 = aba/2, type = "Aline_bend", l = lba, angle &
         = lba * aba/lba

! ESA bends (E158)

ld1s = 1.83
ld2s = 3.45
ld3s = 3.45

ad1s = 0.022344631354
ad2s = -0.044690490267
ad3s = 0.022345239962

bxd1sa: sbend, fint = 0, l = ld1s/2, angle = ld1s/2 * ad1s/2/(ld1s/2)
bxd1sb: sbend, fint = 0, l = ld1s/2, angle = ld1s/2 * ad1s/2/(ld1s/2)
bxd2sa: sbend, fint = 0, l = ld2s/2, angle = ld2s/2 * ad2s/2/(ld2s/2)
bxd2sb: sbend, fint = 0, l = ld2s/2, angle = ld2s/2 * ad2s/2/(ld2s/2)
bxd3sa: sbend, fint = 0, l = ld3s/2, angle = ld3s/2 * ad3s/2/(ld3s/2)
bxd3sb: sbend, fint = 0, l = ld3s/2, angle = ld3s/2 * ad3s/2/(ld3s/2)

! define unsplit SBENs for BMAD ... not used by MAD

bxd1s: sbend, fint = 0, l = ld1s, angle = ld1s * ad1s/ld1s
bxd2s: sbend, fint = 0, l = ld2s, angle = ld2s * ad2s/ld2s
bxd3s: sbend, fint = 0, l = ld3s, angle = ld3s * ad3s/ld3s

! ==============================================================================
! quadrupoles
! ------------------------------------------------------------------------------

lq8cm = 2.0
rq8cm = 0.08/2
lq19 = 2.0
rq19 = 0.186/2
lq20 = 1.31318
rq20 = 8.25*0.0254/2
lsq = 0.55
rsq = 0.08/2

! * the K-values below are for SC beam; also copy these settings
!   to SETK2scA in "LCLS2sc_main.mad8"
! * settings for Cu beam are in SETK2cuA in "LCLS2cu_main.mad8"
! * settings for DASEL are in SETK2scDA in "LCLS2sc_main.mad8"

kq10 = 0.04078118414  ! 0.040732418682
kq11 = -0.035978491015 !-0.035470391686
kq19 = 0.0288935235   ! 0.028832646424
kq20 = 0.011673337852 ! 0.011866327361
kq27 = -0.069796542848 !-0.068187477866
kq28 = 0.029206357304 ! 0.029868541394
kq30 = -0.029497355276 !-0.029618830812
kq38 = 0.034805766493 ! 0.034798028844

q10: quadrupole, l = lq8cm/2, aperture = rq8cm, type = "Aline_Q8cm", k1 = kq10
q11: quadrupole, l = lq8cm/2, aperture = rq8cm, type = "Aline_Q8cm", k1 = kq11
q19: quadrupole, l = lq19/2, aperture = rq19, type = "Aline_Q19", k1 = kq19
q20: quadrupole, l = lq20/2, aperture = rq20, type = "Aline_Q20", k1 = kq20
q27: quadrupole, l = lq8cm/2, aperture = rq8cm, type = "Aline_Q8cm", k1 = kq27
q28: quadrupole, l = lq8cm/2, aperture = rq8cm, type = "Aline_Q8cm", k1 = kq28
q30: quadrupole, l = lq8cm/2, aperture = rq8cm, type = "Aline_Q8cm", k1 = kq30
q38: quadrupole, l = lq8cm/2, aperture = rq8cm, type = "Aline_Q8cm", k1 = kq38

ksq = 0.0

sq27p5: quadrupole, l = lsq/2, aperture = rsq, type = "Aline_SQ27", k1 = ksq, tilt = pi/4

! ESA quads (E158)

lqsa = 1.327
rqsa = 193.0e-3

! E158 run value (P. Bosted)

kq1sa = 0.016723215505
kq2sa = -0.031838409505
kq3sa = 0.031838409505
kq4sa = -0.016080013116

q1s: quadrupole, l = lqsa/2, aperture = rqsa, k1 = kq1sa
q2s: quadrupole, l = lqsa/2, aperture = rqsa, k1 = kq2sa
q3s: quadrupole, l = lqsa/2, aperture = rqsa, k1 = kq3sa
q4s: quadrupole, l = lqsa/2, aperture = rqsa, k1 = kq4sa

! ==============================================================================
! drifts
! ------------------------------------------------------------------------------

d105: drift, l = 5.5372
d106: drift, l = 0.727
d107: drift, l = 0.7755
d108: drift, l = 3.84839
d109: drift, l = 0.7755
d110: drift, l = 3.84839
d111: drift, l = 0.7755
d112: drift, l = 15.74899
d113: drift, l = 9.0997
d114: drift, l = 5.94572
d115: drift, l = 0.7755
d116: drift, l = 3.84839
d117: drift, l = 0.7755
d118: drift, l = 3.84839
d119: drift, l = 0.7755
d120: drift, l = 1.744768 !1.74477
d121: drift, l = 1.525
d122: drift, l = 1.925
d123: drift, l = 38.1116
d124: drift, l = 21.4778
d125: drift, l = 5.04065
