! ==============================================================================
! ILC-ESA Test Beam
! ------------------------------------------------------------------------------

! T-474 chicane
! - 3D37 dipoles ("10D37")
! - rule-of-thumb on-axis effective length
! - use series approximation for sinc(x)=sin(x)/x to allow AB7=0

gb7 = 3.0*in2m !full gap
zb7 = in2m*(37+3.0) !on-axis effective length
fb7 = 0.5 !not measured
ab7 = 0.125313303478e-2 !-5 mm center offset
bb7 = brhof*sin(ab7)/zb7
ab7_2 = ab7*ab7
ab7_4 = ab7_2*ab7_2
ab7_6 = ab7_4*ab7_2
sincab7 = 1-ab7_2/6+ab7_4/120-ab7_6/5040 !~sinc(AB7)=sin(AB7)/AB7
lb7 = zb7/sincab7
ab7s = asin(sin(ab7)/2)
ab7s_2 = ab7s*ab7s
ab7s_4 = ab7s_2*ab7s_2
ab7s_6 = ab7s_4*ab7s_2
sincab7s = 1-ab7s_2/6+ab7s_4/120-ab7s_6/5040 !~sinc(AB7S)=sin(AB7S)/AB7S
lb7s = zb7/(2*sincab7s)
ab7l = ab7-ab7s
lb7l = lb7-lb7s

bcx3d1a: sbend, type = "3D37", l = lb7s, angle = +ab7s, hgap = gb7/2, e1 = 0, fint = fb7, fintx = 0
bcx3d1b: sbend, type = "3D37", l = lb7l, angle = +ab7l, hgap = gb7/2, fint = 0, e2 = +ab7, fintx = fb7
bcx3d2a: sbend, type = "3D37", l = lb7l, angle = -ab7l, hgap = gb7/2, e1 = -ab7, fint = fb7, fintx = 0
bcx3d2b: sbend, type = "3D37", l = lb7s, angle = -ab7s, hgap = gb7/2, fint = 0, e2 = 0, fintx = fb7
bcx3d3a: sbend, type = "3D37", l = lb7s, angle = -ab7s, hgap = gb7/2, e1 = 0, fint = fb7, fintx = 0
bcx3d3b: sbend, type = "3D37", l = lb7l, angle = -ab7l, hgap = gb7/2, fint = 0, e2 = -ab7, fintx = fb7
bcx3d4a: sbend, type = "3D37", l = lb7l, angle = +ab7l, hgap = gb7/2, e1 = +ab7, fint = fb7, fintx = 0
bcx3d4b: sbend, type = "3D37", l = lb7s, angle = +ab7s, hgap = gb7/2, fint = 0, e2 = 0, fintx = fb7

! define unsplit SBENs for BMAD ... not used by MAD

bcx3d1: sbend, type = "3D37", hgap = gb7/2, l = lb7, angle = +ab7, e1 = 0, fint = fb7, e2 = +ab7, fintx = fb7
bcx3d2: sbend, type = "3D37", hgap = gb7/2, l = lb7, angle = -ab7, e1 = -ab7, fint = fb7, e2 = 0, fintx = fb7
bcx3d3: sbend, type = "3D37", hgap = gb7/2, l = lb7, angle = -ab7, e1 = 0, fint = fb7, e2 = -ab7, fintx = fb7
bcx3d4: sbend, type = "3D37", hgap = gb7/2, l = lb7, angle = +ab7, e1 = +ab7, fint = fb7, e2 = 0, fintx = fb7

