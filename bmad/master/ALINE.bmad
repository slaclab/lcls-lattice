kq28 = 0.03548040664
kq30 = -0.028849559713
kq38 = 0.034487458519

q10: quadrupole, l = lq8cm/2, aperture = rq8cm, k1 = kq10, type = "Aline_Q8cm", descrip = "mad8_key:quad"
q11: quadrupole, l = lq8cm/2, aperture = rq8cm, k1 = kq11, type = "Aline_Q8cm", descrip = "mad8_key:quad"
q19: quadrupole, l = lq19/2, aperture = rq19, k1 = kq19, type = "Aline_Q19", descrip = "mad8_key:quad"
