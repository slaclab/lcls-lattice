qdli3_full: line = (qdli3)
qdli3[L] = 2*qdli3[L]
bpmdli3[superimpose] = T
bpmdli3[ref] = qdli3


!Old split line:  BXDLIR1_full : LINE=(BXDLIR1a,BXDLIR1b)

bxdlir1_full: line = (bxdlir1)
bxdlir1_svy: null_ele, superimpose, ref=bxdlir1, ref_origin=beginning, offset=bxdlir1a[l] !bend survey marker


!Old split line:  BXDLIR2_full : LINE=(BXDLIR2a,BXDLIR2b)

bxdlir2_full: line = (bxdlir2)
bxdlir2_svy: null_ele, superimpose, ref=bxdlir2, ref_origin=beginning, offset=bxdlir2a[l] !bend survey marker


!Old split line:  QDLI4_full   : LINE=(QDLI4,BPMDLI4,QDLI4)

qdli4_full: line = (qdli4)
qdli4[L] = 2*qdli4[L]
bpmdli4[superimpose] = T
bpmdli4[ref] = qdli4


!Old split line:  QDLI5_full   : LINE=(QDLI5,BPMDLI5,QDLI5)

