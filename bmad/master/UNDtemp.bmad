!Old split line: LINE=(QHXh13,XCHX13,MUQH,YCHX13,QHXh13)

qhxh13_full: line = (qhxh13)
qhxh13[L] = 2*qhxh13[L]
xchx13[superimpose] = T
xchx13[ref] = qhxh13
muqh[superimpose] = T
muqh[ref] = qhxh13
ychx13[superimpose] = T
ychx13[ref] = qhxh13


!Old split line: LINE=(QHXh14,XCHX14,MUQH,YCHX14,QHXh14)

qhxh14_full: line = (qhxh14)
