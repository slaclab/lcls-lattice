
! *** OPTICS=AD_ACCEL-01APR20 ***

! LCLS-style quadrupole (shorter effective length)

lqut = 0.078 !LCLS undulator quadrupole effective length [m]

intghx13 = 29.673579533188
intghx14 = -31.079320404825
intghx15 = 28.660549048536
intghx16 = -28.846589136205
intghx17 = 29.438380624827
intghx18 = -27.936601652186
intghx19 = 28.461216069912
intghx20 = -30.111620004728
intghx22 = -29.632718941697
intghx23 = 30.92878037616

kqhxh13 = intghx13/lqut/brhou
kqhxh14 = intghx14/lqut/brhou
kqhxh15 = intghx15/lqut/brhou
kqhxh16 = intghx16/lqut/brhou
kqhxh17 = intghx17/lqut/brhou
kqhxh18 = intghx18/lqut/brhou
kqhxh19 = intghx19/lqut/brhou
kqhxh20 = intghx20/lqut/brhou
kqhxh22 = intghx22/lqut/brhou
kqhxh23 = intghx23/lqut/brhou

qhxh13: quadrupole, type = "QUND", l = lqut/2, k1 = kqhxh13 !QU01
qhxh14: quadrupole, type = "QUND", l = lqut/2, k1 = kqhxh14 !QU02
qhxh15: quadrupole, type = "QUND", l = lqut/2, k1 = kqhxh15 !QU03
qhxh16: quadrupole, type = "QUND", l = lqut/2, k1 = kqhxh16 !QU04
qhxh17: quadrupole, type = "QUND", l = lqut/2, k1 = kqhxh17 !QU05
qhxh18: quadrupole, type = "QUND", l = lqut/2, k1 = kqhxh18 !QU06
qhxh19: quadrupole, type = "QUND", l = lqut/2, k1 = kqhxh19 !QU07
qhxh20: quadrupole, type = "QUND", l = lqut/2, k1 = kqhxh20 !QU08
qhxh22: quadrupole, type = "QUND", l = lqut/2, k1 = kqhxh22 !QU10
qhxh23: quadrupole, type = "QUND", l = lqut/2, k1 = kqhxh23 !QU11

lrfbut = 0 !undulator RF-BPM only implemented as zero length monitor

rfbhx13: instrument, l = lrfbut, type = "01_um_res" !RFBU01
rfbhx14: instrument, l = lrfbut, type = "01_um_res" !RFBU02
rfbhx15: instrument, l = lrfbut, type = "01_um_res" !RFBU03
rfbhx16: instrument, l = lrfbut, type = "01_um_res" !RFBU04
rfbhx17: instrument, l = lrfbut, type = "01_um_res" !RFBU05
rfbhx18: instrument, l = lrfbut, type = "01_um_res" !RFBU06
rfbhx19: instrument, l = lrfbut, type = "01_um_res" !RFBU07
rfbhx20: instrument, l = lrfbut, type = "01_um_res" !RFBU08
rfbhx22: instrument, l = lrfbut, type = "01_um_res" !RFBU10
rfbhx23: instrument, l = lrfbut, type = "01_um_res" !RFBU11

! unused Beam Finder Wires

bfw01: marker
bfw02: marker
bfw03: marker
bfw04: marker
bfw05: marker
bfw06: marker
bfw07: marker
bfw08: marker
bfw10: marker
bfw11: marker

dusegh: drift, l = 1.665
dtt: drift, l = 0.035
dbwmt: drift, l = 0.035133
db4t: drift, l = 0.058577
db1: drift, l = 0.06889
db3: drift, l = 0.09111
dbrst: drift, l = 0.13829
dbrl: drift, l = 0.56629

ustbk01: line = (dtt, dusegh, dusegh, dtt)
ustbk02: line = (dtt, dusegh, dusegh, dtt)
ustbk03: line = (dtt, dusegh, dusegh, dtt)
ustbk04: line = (dtt, dusegh, dusegh, dtt)
ustbk05: line = (dtt, dusegh, dusegh, dtt)
ustbk06: line = (dtt, dusegh, dusegh, dtt)
ustbk07: line = (dtt, dusegh, dusegh, dtt)
ustbk08: line = (dtt, dusegh, dusegh, dtt)
ustbk10: line = (dtt, dusegh, dusegh, dtt)
ustbk11: line = (dtt, dusegh, dusegh, dtt)



!Old split line: line = (qhxh13, xchx13, muqh, ychx13, qhxh13)

