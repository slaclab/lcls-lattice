zbsyg01 = 5.152655814e+02 !start of LCLS GIRD01
zbsyg05 = 5.349052914e+02 !end of LCLS GIRD05

zbsyc13 = 5.150949847e+02 !start of LCLS-II cell 13
zbsyc17 = 5.351583181e+02 !end of LCLS-II cell 17

dgird01u: drift, l = zbsyg01-zbsyc13
dgird05d: drift, l = zbsyc17-zbsyg05
