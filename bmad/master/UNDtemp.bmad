gird10: line = (bfw10, dbwmt, db4t, ustbk10, db1, qhxh22_full, db3, rfbhx22) !cell 22: LCLS-style, no undulator
gird11: line = (bfw11, dbwmt, db4t, ustbk11, db1, qhxh23_full, db3, rfbhx23) !cell 23: LCLS-style, no undulator

zbsyg01 = 515.2655814 !start of LCLS GIRD01
zbsyg08 = 546.9432914 !end of LCLS GIRD08
zbsyg10 = 551.3795814 !start of LCLS GIRD10
zbsyg11 = 558.9812914 !end of LCLS GIRD11

zbsyc13 = 515.0949847 !start of LCLS-II cell 13
zbsyc20 = 547.1963181 !end of LCLS-II cell 20
zbsyc22 = 551.2089847 !start of LCLS-II cell 22
zbsyc23 = 559.2343181 !end of LCLS-II cell 23

dgird01u: drift, l = zbsyg01-zbsyc13
dgird08d: drift, l = zbsyc20-zbsyg08
dgird10u: drift, l = zbsyg10-zbsyc22-0.1e-06
dgird11d: drift, l = zbsyc23-zbsyg11

! replaces HXR cells 13-20

undcla: line = (dgird01u, gird01, dbrst, gird02, dbrst, gird03, dbrl, gird04, dbrst, gird05,  &
        dbrst, gird06, dbrl, gird07, dbrst, gird08, dgird08d)

! replaces HXR cells 22-23

undclb: line = (dgird10u, gird10, dbrst, gird11, dgird11d)
