
! *** OPTICS=AD_ACCEL-05OCT20 ***

! LCLS2sc transport from Cu-linac to SXR

! ==============================================================================
! Modification History
! ------------------------------------------------------------------------------
! 28-MAY-2019, M. Woodley
!  * relocate XCCUS1, YCCUS2, and BPMCUS3 per L. Borzenets
! 13-MAY-2019, M. Woodley
!  * change length of STCLTS to 30" and move 5.1 cm d/s per A. Ibrahimov
! 30-APR-2019, M. Woodley
!  * use measured FINT=0.4861 for 1.0D38.37 @ 200A
! ------------------------------------------------------------------------------
! 04-OCT-2018, M. Woodley
!  * include alternative DC extraction into CUSXR
!  * replace 1.0D22.625 dipoles (BYCUS1&2) with 3D8.8MK3 corrector magnets
! 15-AUG-2018, M. Woodley
!  * add STCLTS (PEP-II insertable PPS stopper) between QCUS8 and QCUS9
! 04-MAY-2018, M. Woodley
!  * undefer everything (LCLS pays)
! ------------------------------------------------------------------------------
! 02-NOV-2016, Y. Nosochkov
!  * minor adjustment to kicker angle
!  * add a note that BRCUS1 is a special merge DC-bend which is turned ON
!    for CURF beam to SXR or OFF for SCRF beam to SXR
! ------------------------------------------------------------------------------
! 24-JUN-2016, Y. Nosochkov
!  * add deferred BPMCUS between kicker and septum
!  * move BPMs inside the quads QCUS4, QCUS5, QCUS7
!  * update the engineering type of BKRCUS kicker to "1.92K41.2" (J. Amann)
!  * remove corrector dipoles BRCCUS1&2, rematch geometry and optics
! ------------------------------------------------------------------------------
! 26-FEB-2016, M. Woodley
!  * remove SEQnn MARKers
! 26-FEB-2016, Y. Nosochkov
!  * replace 5 kickers (based on spreader kicker design) with one kicker
!    based on BYKIK1 design (per T. Beukers)
!  * increase CUSXR length by 1.2 m to avoid interference with A-line kicker
!    (septum and first 3 quad positions are not changed, but the rest is moved
!    downstream while keeping the CUSXR symmetry)
! ------------------------------------------------------------------------------
! 25-SEP-2015, Y. Nosochkov
!  * update definitions of kickers, septum and last DC bend to allow
!    zero angle
! 24-AUG-2015, Y. Nosochkov
!  * move BPMCUS2 downstream of QCUS2
!  * move XCCUS10 upstream of QCUS10
!  * replace the first DC bend with a fast kicker and a septum (deferred at @3)
!  * increase the distance from first/last bend to the nearest quad
!  * add two corrector bends to cancel the kicker orbit and dispersion (at @3)
! ------------------------------------------------------------------------------
! 19-JUN-2015, Y. Nosochkov
!  * add additional deferred quadrupole at center of CUSXR
!  * rename some magnets/devices to put the names in order
!  * change magnet type of QCUS4, QCUS5, QCUS6, QCUS7 from 2Q10 to 1.085Q4.31
!  * change BPM type at 2Q10 to Stripline-5, and at 1.085Q4.31 to Stripline-2
!  * move BPMs outside of the quads
!  * adjust distance from BPM/corr to the quad
! ------------------------------------------------------------------------------
! 20-MAR-2015, M. Woodley
!  * move definitions of BEGCUSXR and ENDCUSXR MARKERs to common.xsif
!  * add SEQ20BEG and SEQ20END MARKERs
! 12-MAR-2015, Y. Nosochkov
!  * add a dogleg transport line from Cu-linac to SXR (deferred to level 3)
! ------------------------------------------------------------------------------

! XYZ (linac system) at entrance of the kicker (BEGCLTS)

xcus1 = -3.309962022e-7 !per existing LCLS-1 coordinates
ycus1 = 0.0
zcus1 = 3058.456916    !moved upstream for CUSXR DC extraction
thcus1 = 0.0
phcus1 = 0.0
pscus1 = 0.0

! XYZ (linac system) at exit of the last bend (ENDCUSXR)

xcus2 = -25.610*in2m
ycus2 = 25.570*in2m
zcus2 = 3177.65
thcus2 = 0.0
phcus2 = 0.0
pscus2 = 0.0

! Twiss at BEGCLTS

tbxcus1 = 28.733475248907
tbycus1 = 51.61209559579
taxcus1 = -0.11996119728
taycus1 = 0.738889504715

! ------------------------------------------------------------------------------

! quads (Cu-linac energy is limited to 10 GeV)

kqcus1 = 0.491233972308
kqcus2 = -0.414060432356
kqcus3 = -0.314369385154
kqcus4 = 2.369394892073
kqcus5 = -1.396338070942
kqcus9 = -0.456516817666
kqcus10 = 0.496780961708
kqcus6 = kqcus5
kqcus7 = kqcus4
kqcus8 = kqcus3

qcus1: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqcus1
qcus2: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqcus2
qcus3: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqcus3
qcus4: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqcus4
qcus5: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqcus5
qcus6: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqcus6
qcus7: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqcus7
qcus8: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqcus8
qcus9: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqcus9
qcus10: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqcus10

! ------------------------------------------------------------------------------

! kicker is aligned along the BSY1 axis and rolled approx. -45 deg
! kicker design is based on existing BYKIK1 (max. field ~600G per T. Beukers)

tcusxr = -0.673868825333 !roll angle of kicker (+pi/2) and septum (rad)
gbkrcus = 25.4e-3 !kicker gap (m)
zbkrcus = 1.0601  !kicker straight length (m)

abkrcus0 = -0.87326308078e-3
pulsed = abs(setcus)*(1+setcus)/2
abkrcus = abkrcus0*pulsed          !total kicker angle (rad)
abkrcusa = asin(sin(abkrcus)/2)     !1st half-kicker angle (rad)
abkrcusb = abkrcus-abkrcusa         !2nd half-kicker angle (rad)

abkrcus_2 = abkrcus*abkrcus
abkrcus_4 = abkrcus_2*abkrcus_2
abkrcusa_2 = abkrcusa*abkrcusa
abkrcusa_4 = abkrcusa_2*abkrcusa_2

lbkrcus = zbkrcus/(1-abkrcus_2/6+abkrcus_4/120)
lbkrcusa = zbkrcus/2/(1-abkrcusa_2/6+abkrcusa_4/120)
lbkrcusb = lbkrcus-lbkrcusa

bkrcusa: sbend, e1 = 0, e2 = 0, fint = 0.5, fintx = 0, hgap = gbkrcus/2, type = "1.92K41.2",  &
        ref_tilt = pi/2+tcusxr, l = lbkrcusa, angle = lbkrcusa * abkrcusa/lbkrcusa
bkrcusb: sbend, e1 = 0, e2 = abkrcus, fint = 0, fintx = 0.5, hgap = gbkrcus/2, type = "1.92K41.2" &
        , ref_tilt = pi/2+tcusxr, l = lbkrcusb, angle = lbkrcusb * abkrcusb/lbkrcusb

! define unsplit SBENs for BMAD ... not used by MAD

bkrcus: sbend, hgap = gbkrcus/2, e1 = 0, fint = 0.5, e2 = abkrcus, type = "1.92K41.2", ref_tilt &
         = pi/2+tcusxr, l = lbkrcus, angle = lbkrcus * abkrcus/lbkrcus

! ------------------------------------------------------------------------------

! DC alternative to kicker comprised of two 3D8.8MK3 correctors, one at each end of BKRCUS
! - both correctors are aligned along the linac z-axis

gbrcusdc = 2.031*in2m !full gap (m)
zbrcusdc = 0.2691     !on-axis effective length (m) (measured)
fbrcusdc = 0.3041     !FINT (measured)
tbrcusdc = tcusxr     !roll angle (+pi/2)

dcmode = abs(setcus)*(1-setcus)/2
abrcusdc = abkrcus0*dcmode          !total bend angle (rad)
abrcusdc1 = asin(sin(abrcusdc)/2)    !1st corrector bend angle (rad)
abrcusdc2 = abrcusdc-abrcusdc1       !2nd corrector bend angle (rad)

! Note: 1-theta^2/6 ~ sinc(theta)

lbrcusdc = 2*zbrcusdc/(1-abrcusdc*abrcusdc/6)
lbrcusdc1 = zbrcusdc/(1-abrcusdc1*abrcusdc1/6)
lbrcusdc2 = lbrcusdc-lbrcusdc1

lbrcusdc1a = 0.134538920784 !ZBRCUSdc/2
lbrcusdc1b = lbrcusdc1-lbrcusdc1a
abrcusdc1a = abrcusdc1*(lbrcusdc1a/lbrcusdc1)
abrcusdc1b = abrcusdc1-abrcusdc1a

brcusdc1a: sbend, hgap = gbrcusdc/2, e1 = 0, fint = fbrcusdc, fintx = 0, type = "3D8.8MK3",  &
        ref_tilt = pi/2+tbrcusdc, l = lbrcusdc1a, angle = lbrcusdc1a * abrcusdc1a/lbrcusdc1a
brcusdc1b: sbend, hgap = gbrcusdc/2, fint = 0, e2 = abrcusdc1, fintx = fbrcusdc, type =  &
        "3D8.8MK3", ref_tilt = pi/2+tbrcusdc, l = lbrcusdc1b, angle =  &
        lbrcusdc1b * abrcusdc1b/lbrcusdc1b

lbrcusdc2a = 0.1345578935 !ZBRCUSdc/2
lbrcusdc2b = lbrcusdc2-lbrcusdc2a
abrcusdc2a = abrcusdc2*(lbrcusdc2a/lbrcusdc2)
abrcusdc2b = abrcusdc2-abrcusdc2a

brcusdc2a: sbend, hgap = gbrcusdc/2, e1 = -abrcusdc1, fint = fbrcusdc, fintx = 0, type =  &
        "3D8.8MK3", ref_tilt = pi/2+tbrcusdc, l = lbrcusdc2a, angle =  &
        lbrcusdc2a * abrcusdc2a/lbrcusdc2a
brcusdc2b: sbend, hgap = gbrcusdc/2, fint = 0, e2 = abrcusdc, fintx = fbrcusdc, type = "3D8.8MK3" &
        , ref_tilt = pi/2+tbrcusdc, l = lbrcusdc2b, angle = lbrcusdc2b * abrcusdc2b/lbrcusdc2b

ldck = 40.03*in2m                !center-to-center Z-distance between corrector and kicker
zckdc = ldck-(zbrcusdc+zbkrcus)/2 !Z-distance between corrector and kicker
zcusblr = 16.1469-zckdc-zbrcusdc    !Z-distance between kicker and septum
zcusblra = 5.1956-(zckdc+zbrcusdc)   !Z-distance between corrector and BPM
zcusblrb = zcusblr-zcusblra          !Z-distance between BPM and septum

ldckdc1 = zckdc/cos(abrcusdc1)
ldckdc2 = zckdc/cos(abrcusdc1+abkrcus)   !one of these angles will be zero
ldcusblr = zcusblr/cos(abrcusdc+abkrcus)  !one of these angles will be zero
ldcusblra = zcusblra/cos(abrcusdc+abkrcus) !one of these angles will be zero
ldcusblrb = zcusblrb/cos(abrcusdc+abkrcus) !one of these angles will be zero

dckdc1: drift, l = ldckdc1
dckdc2: drift, l = ldckdc2
dcusblra: drift, l = ldcusblra
dcusblrb: drift, l = ldcusblrb

! define unsplit SBENs for BMAD ... not used by MAD

brcusdc1: sbend, hgap = gbrcusdc/2, e1 = 0, fint = fbrcusdc, e2 = abrcusdc1, type = "3D8.8MK3",  &
        ref_tilt = pi/2+tbrcusdc, l = lbrcusdc1, angle = lbrcusdc1 * abrcusdc1/lbrcusdc1
brcusdc2: sbend, hgap = gbrcusdc/2, e1 = -abrcusdc1, fint = fbrcusdc, e2 = abrcusdc, type =  &
        "3D8.8MK3", ref_tilt = pi/2+tbrcusdc, l = lbrcusdc2, angle =  &
        lbrcusdc2 * abrcusdc2/lbrcusdc2

! ------------------------------------------------------------------------------

! 2-hole rolled septum aligned along the BSY1 axis

gblrcus = gblsp !septum gap height (m)
zblrcus = lblsp !septum straight length (m)

ablrcus0 = 0.911077773379e-2
ablrcus = ablrcus0*abs(setcus) !septum bending angle (rad)
ablrcusa = asin(sin(ablrcus)/2) !angle per 1st half of the septum
ablrcusb = ablrcus-ablrcusa     !angle per 2nd half of the septum

ablrcus_2 = ablrcus*ablrcus
ablrcus_4 = ablrcus_2*ablrcus_2
ablrcusa_2 = ablrcusa*ablrcusa
ablrcusa_4 = ablrcusa_2*ablrcusa_2

lblrcus = zblrcus/(1-ablrcus_2/6+ablrcus_4/120)/cos(abkrcus)
lblrcusa = zblrcus/2/(1-ablrcusa_2/6+ablrcusa_4/120)/cos(abkrcus)
lblrcusb = lblrcus-lblrcusa

blrcusa: sbend, e1 = 0, e2 = 0, fint = 0.5, fintx = 0, hgap = gblrcus/2, type = "0.625SD38.98",  &
        ref_tilt = tcusxr, l = lblrcusa, angle = lblrcusa * ablrcusa/lblrcusa
blrcusb: sbend, e1 = 0, e2 = ablrcus, fint = 0, fintx = 0.5, hgap = gblrcus/2, type =  &
        "0.625SD38.98", ref_tilt = tcusxr, l = lblrcusb, angle = lblrcusb * ablrcusb/lblrcusb

! define unsplit SBENs for BMAD ... not used by MAD

blrcus: sbend, hgap = gblrcus/2, e1 = 0, fint = 0.5, e2 = ablrcus, type = "0.625SD38.98",  &
        ref_tilt = tcusxr, l = lblrcus, angle = lblrcus * ablrcus/lblrcus

! rolled DC bend
! Note: BRCUS1 is a merge DC-bend which is either turned ON to operate
!       CURF beam in SXR, or turned OFF to operate SCRF beam in SXR

tbrcus = -0.769423721099 !roll angle of DC bend (rad)
gbrcus = gbsp !bend gap height (m)
zbrcus = lbsp !bend straight length (1.0D38.37) (m)
fbrcus = 0.4861 !measured FINT

dabrcus = -0.417540592574e-4
abrcus = (-ablrcus0+dabrcus)*abs(setcus)
abrcush = abrcus/2
abrcush_2 = abrcush*abrcush
abrcush_4 = abrcush_2*abrcush_2
lbrcus = zbrcus/(1-abrcush_2/6+abrcush_4/120) !bend path length (m)

brcus1a: sbend, e1 = abrcus/2, e2 = 0, fint = fbrcus, fintx = 0, hgap = gbrcus/2, type =  &
        "1.0D38.37", ref_tilt = tbrcus, l = lbrcus/2, angle = lbrcus/2 * abrcus/2/(lbrcus/2)
brcus1b: sbend, e2 = abrcus/2, e1 = 0, fint = 0, fintx = fbrcus, hgap = gbrcus/2, type =  &
        "1.0D38.37", ref_tilt = tbrcus, l = lbrcus/2, angle = lbrcus/2 * abrcus/2/(lbrcus/2)

! define unsplit SBENs for BMAD ... not used by MAD

brcus1: sbend, hgap = gbrcus/2, e1 = abrcus/2, fint = fbrcus, e2 = abrcus/2, type = "1.0D38.37",  &
        ref_tilt = tbrcus, l = lbrcus, angle = lbrcus * abrcus/lbrcus

! inner vertical bends for R56 cancellation
! NOTE: 1.0D22.625 dipoles replaced with 3D8.8MK3 correctors

gbycus = gbrcusdc       !full gap (m)
zbycus = zbrcusdc       !on-axis effective length (m)
fbycus = 0.5 !FBRCUSdc  !FINT
dld2c = (0.6-zbycus)/2 !1.0D22.625 -> 3D8.8MK3

abycus = 0.4e-3
lbycus = zbycus*abycus/(2*sin(abycus/2)) !bend path length (m)

bycus1a: sbend, e1 = abycus/2, e2 = 0, fint = fbycus, fintx = 0, hgap = gbycus/2, type =  &
        "3D8.8MK3", ref_tilt = pi/2, l = lbycus/2, angle = lbycus/2 * abycus/2/(lbycus/2)
bycus1b: sbend, e2 = abycus/2, e1 = 0, fint = 0, fintx = fbycus, hgap = gbycus/2, type =  &
        "3D8.8MK3", ref_tilt = pi/2, l = lbycus/2, angle = lbycus/2 * abycus/2/(lbycus/2)

bycus2a: sbend, e1 = -abycus/2, e2 = 0, fint = fbycus, fintx = 0, hgap = gbycus/2, type =  &
        "3D8.8MK3", ref_tilt = pi/2, l = lbycus/2, angle = lbycus/2 * (-abycus/2)/(lbycus/2)
bycus2b: sbend, e2 = -abycus/2, e1 = 0, fint = 0, fintx = fbycus, hgap = gbycus/2, type =  &
        "3D8.8MK3", ref_tilt = pi/2, l = lbycus/2, angle = lbycus/2 * (-abycus/2)/(lbycus/2)

! define unsplit SBENs for BMAD ... not used by MAD

bycus1: sbend, hgap = gbycus/2, e1 = abycus/2, fint = fbycus, e2 = abycus/2, type = "3D8.8MK3",  &
        ref_tilt = pi/2, l = lbycus, angle = lbycus * abycus/lbycus
bycus2: sbend, hgap = gbycus/2, e1 = -abycus/2, fint = fbycus, e2 = -abycus/2, type = "3D8.8MK3" &
        , ref_tilt = pi/2, l = lbycus, angle = lbycus * (-abycus)/lbycus

! rolled DC corrector bends -- removed

lbrccus = 0.6

dbrccus1: drift, l = lbrccus/2
dbrccus2: drift, l = lbrccus/2

! ------------------------------------------------------------------------------

! drifts

dldcus0 = 0.0  !adjust length of CUSXR
dldcus2 = 0.0  !adjust positions of QCUS2,9
dldcus3 = -0.9  !adjust positions of QCUS3,8
dldcus4 = 0.16 !adjust positions of QCUS4,7
dldcus13 = 0.0  !asymmetry between LDCUS1 and LDCUS13

ldcus0 = 5.133675753223652+dldcus0
ldcus1 = 29.4
ldcus2 = ldcus0+dldcus2
ldcus3 = ldcus0-dldcus2+dldcus3
ldcus4 = ldcus0-dldcus3+dldcus4+0.599963125932
ldcus5 = 1.5-0.25-dldcus4+dld2c
ldcus6 = 1.0+0.25+dld2c
ldcus7 = 0.3/2
ldcus8 = ldcus6
ldcus9 = ldcus5
ldcus10 = ldcus4
ldcus11 = ldcus3
ldcus12 = ldcus2
ldcus13 = ldcus1+lblrcus/2-lbrcus/2+dldcus13

ldcus1b = 7.0
ldcus1c = 0.5
ldcus1a = ldcus1-ldcus1b-ldcus1c-lbrccus-lbrccus-dldcus13
ldcus2a = 0.464083 !0.4471
ldcus2b = 0.747032 !0.619817
ldcus2c = ldcus2-ldcus2a-ldcus2b
ldcus3a = 0.463634 !0.4471
ldcus3b = 0.747031 !0.843035
ldcus3d = 0.389900 !0.593909
ldcus3c = ldcus3-ldcus3a-ldcus3b-ldcus3d
ldcus4a = 0.4285
ldcus4c = 0.1924
ldcus4b = ldcus4-ldcus4a-ldcus4c+(lqr-lqe)/2
ldcus5a = 0.4
ldcus5b = ldcus5-ldcus5a+(lqr-lqe)/2
ldcus6b = 0.1924
ldcus6a = ldcus6-ldcus6b+(lqr-lqe)/2-lqe/2-ldcus7
ldcus8a = 0.4
ldcus8b = ldcus8-ldcus8a+(lqr-lqe)/2-lqe/2-ldcus7
ldcus9b = 0.1924
ldcus9a = ldcus9-ldcus9b+(lqr-lqe)/2
ldcus10a = 0.4
ldcus10c = 0.390327 !0.4781
ldcus10b = ldcus10-ldcus10a-ldcus10c+(lqr-lqe)/2
ldcus11a = 0.4285
ldcus11c = 0.390815 !0.4781
ldcus11b = ldcus11-ldcus11a-ldcus11c
ldcus12a = 0.4285
ldcus12c = 0.821035 !0.6058
ldcus12d = 0.390264 !0.4781
ldcus12b = ldcus12-ldcus12a-ldcus12c-ldcus12d

dcus1a: drift, l = ldcus1a
dcus1b: drift, l = ldcus1b
dcus1c: drift, l = ldcus1c
dcus2a: drift, l = ldcus2a
dcus2b: drift, l = ldcus2b
dcus2c: drift, l = ldcus2c
dcus3a: drift, l = ldcus3a
dcus3b: drift, l = ldcus3b
dcus3c: drift, l = ldcus3c
dcus3d: drift, l = ldcus3d
dcus4a: drift, l = ldcus4a
dcus4b: drift, l = ldcus4b
dcus4c: drift, l = ldcus4c
dcus5a: drift, l = ldcus5a
dcus5b: drift, l = ldcus5b
dcus6a: drift, l = ldcus6a
dcus6b: drift, l = ldcus6b
dcus7: drift, l = ldcus7
dcus8a: drift, l = ldcus8a
dcus8b: drift, l = ldcus8b
dcus9a: drift, l = ldcus9a
dcus9b: drift, l = ldcus9b
dcus10a: drift, l = ldcus10a
dcus10b: drift, l = ldcus10b
dcus10c: drift, l = ldcus10c
dcus11a: drift, l = ldcus11a
dcus11b: drift, l = ldcus11b
dcus11c: drift, l = ldcus11c
dcus12a: drift, l = ldcus12a
dcus12b: drift, l = ldcus12b
dcus12c: drift, l = ldcus12c
dcus12d: drift, l = ldcus12d
dcus13: drift, l = ldcus13

! markers

begcusxr: marker
midcusxr: marker !center of CUSXR
cntcus1: marker, type = "CENTER"
cntcus2: marker, type = "CENTER"
cntcus3: marker, type = "CENTER"
cntcus4: marker, type = "CENTER"
cntcus5: marker, type = "CENTER"
endcusxr: marker

! monitors

bpmcus: instrument, type = "Stripline-5"
bpmcus1: instrument, type = "Stripline-5"
bpmcus2: instrument, type = "Stripline-5"
bpmcus3: instrument, type = "Stripline-5"
bpmcus4: instrument, type = "Stripline-2"
bpmcus5: instrument, type = "Stripline-2"
bpmcus7: instrument, type = "Stripline-2"
bpmcus8: instrument, type = "Stripline-5"
bpmcus9: instrument, type = "Stripline-5"
bpmcus10: instrument, type = "Stripline-5"

! steering correctors

xccus1: kicker, type = "class-4" !type TBD
xccus4: kicker, type = "class-4" !type TBD
xccus7: kicker, type = "class-4" !type TBD
xccus10: kicker, type = "class-4" !type TBD

yccus2: kicker, type = "class-4" !type TBD
yccus3: kicker, type = "class-4" !type TBD
yccus6: kicker, type = "class-4" !type TBD
yccus8: kicker, type = "class-4" !type TBD
yccus9: kicker, type = "class-4" !type TBD

! insertable stopper / tuneup dump

stclts: instrument, l = 0.30, type = "PPS stopper" !from PEP-II injection line
btmclts: instrument, type = "PPS BTM"
dcus11b1: drift, l = 2.114313 !1.883313
dcus11b2: drift, l = dcus11b[l]-dcus11b1[l]-stclts[l]

! SROT to remove rotation angle

arocus1 = -0.249098811997e-4
arocus2 = 0.209318005136e-4
arocus3 = 0.117879544139e-19
arocus4 = -arocus3

rocus1: patch, tilt = arocus1
rocus2: patch, tilt = arocus2
rocus3: patch, tilt = arocus3
rocus4: patch, tilt = arocus4

! beamlines

brcusdc1_full: line = (brcusdc1)
!old: brcusdc1_full: line = (brcusdc1a, brcusdc1b)
bkrcus_full: line = (bkrcus)
!old: bkrcus_full: line = (bkrcusa, bkrcusb)
brcusdc2_full: line = (brcusdc2)
!old: brcusdc2_full: line = (brcusdc2a, brcusdc2b)
blrcus_full: line = (blrcus)
!old: blrcus_full: line = (blrcusa, blrcusb)
bycus1_full: line = (bycus1)
!old: bycus1_full: line = (bycus1a, bycus1b)
bycus2_full: line = (bycus2)
!old: bycus2_full: line = (bycus2a, bycus2b)
brcus1_full: line = (brcus1)
!old: brcus1_full: line = (brcus1a, brcus1b)



!Old split line: line = (qcus1, qcus1)

qcus1_full: line = (qcus1)
qcus1[L] = 2*qcus1[L]


!Old split line: line = (qcus2, qcus2)

qcus2_full: line = (qcus2)
qcus2[L] = 2*qcus2[L]


!Old split line: line = (qcus3, qcus3)

qcus3_full: line = (qcus3)
qcus3[L] = 2*qcus3[L]


!Old split line: line = (qcus4, bpmcus4, qcus4)

qcus4_full: line = (qcus4)
qcus4[L] = 2*qcus4[L]
bpmcus4[superimpose] = T
bpmcus4[ref] = qcus4


!Old split line: line = (qcus5, bpmcus5, qcus5)

qcus5_full: line = (qcus5)
qcus5[L] = 2*qcus5[L]
bpmcus5[superimpose] = T
bpmcus5[ref] = qcus5


!Old split line: line = (qcus6, qcus6)

qcus6_full: line = (qcus6)
qcus6[L] = 2*qcus6[L]


!Old split line: line = (qcus7, bpmcus7, qcus7)

qcus7_full: line = (qcus7)
qcus7[L] = 2*qcus7[L]
bpmcus7[superimpose] = T
bpmcus7[ref] = qcus7


!Old split line: line = (qcus8, qcus8)

qcus8_full: line = (qcus8)
qcus8[L] = 2*qcus8[L]


!Old split line: line = (qcus9, qcus9)

qcus9_full: line = (qcus9)
qcus9[L] = 2*qcus9[L]


!Old split line: line = (qcus10, qcus10)

qcus10_full: line = (qcus10)
qcus10[L] = 2*qcus10[L]

kcusxra: line = (brcusdc1_full, dckdc1, bkrcus_full, dckdc2, brcusdc2_full, dcusblra, bpmcus,  &
        dcusblrb, blrcus_full)

kcusxrb: line = (cntcus1, rocus1, dcus1a, dbrccus1, dbrccus1, dcus1b, dbrccus2, dbrccus2, cntcus5 &
        )

kcusxr: line = (kcusxra, kcusxrb)

dlcusxr: line = (dcus1c, qcus1_full, dcus2a, bpmcus1, dcus2b, xccus1, dcus2c, qcus2_full, dcus3a &
        , bpmcus2, dcus3b, yccus2, dcus3c, bpmcus3, dcus3d, qcus3_full, dcus4a, yccus3, dcus4b,  &
        dcus4c, qcus4_full, dcus5a, xccus4, dcus5b, bycus1_full, cntcus3, rocus3, dcus6a, dcus6b &
        , qcus5_full, dcus7, midcusxr, dcus7, qcus6_full, dcus8a, yccus6, dcus8b, rocus4,  &
        bycus2_full, cntcus4, dcus9a, dcus9b, qcus7_full, dcus10a, xccus7, dcus10b, bpmcus8,  &
        dcus10c, qcus8_full, dcus11a, yccus8, dcus11b1, stclts, btmclts, dcus11b2, bpmcus9,  &
        dcus11c, qcus9_full, dcus12a, yccus9, dcus12b, xccus10, dcus12c, bpmcus10, dcus12d,  &
        qcus10_full, dcus13, rocus2, brcus1_full, cntcus2)

cusxr: line = (begcusxr, kcusxr, dlcusxr, endcusxr)

