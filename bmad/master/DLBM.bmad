  CCDLU : LINE=(CCDLUBEG,BCXDLU1_full,DCCDLUo,BCXDLU2_full,DCCDLUi,CCDLUMID,DCCDLUi,BCXDLU3_full,DCCDLUo,BCXDLU4_full,
         CNTDLU,CCDLUEND)

