! match into bypass dogleg FODO cell (at center of QDOG1)
! LINE=(QDOG1,DBD1,QDOG2,QDOG2,DBD1,QDOG1)

bxdlm = 13.103975995473
axdlm = -1.328121315284
bydlm = 15.962707890974
aydlm = 1.529775364964

dzdog = 77.99997504 !Z-extent of dogleg (BRB1 entrance to BRB2 exit)

! ==============================================================================
! SBEN
! ------------------------------------------------------------------------------

! upstream R56 compensation chicane:
!   ABCX..  = chicane bend angle (rad)
!   BBCX..  = chicane bend field (kG)
!   LBCX..  = chicane bend path length (m)
!   ABCX..S = "short" half chicane bend angle (rad)
!   ABCX..L = "long" half chicane bend angle (rad)
!   LBCX..S = "short" half chicane bend path length (m)
!   LBCX..L = "long" half chicane bend path length (m)

abcxdlu0 = 0.010734075009 !R56=9.99E-5
abcxdlu = 1.15*abcxdlu0  !R56=1.32E-4
bbcxdlu = brhof*sin(abcxdlu)/zbcc
abcxdlu_2 = abcxdlu*abcxdlu
abcxdlu_4 = abcxdlu_2*abcxdlu_2
abcxdlu_6 = abcxdlu_4*abcxdlu_2
sincbcxdlu = 1-abcxdlu_2/6+abcxdlu_4/120-abcxdlu_6/5040
lbcxdlu = zbcc/sincbcxdlu
abcxdlus = asin(sin(abcxdlu)/2)
abcxdlus_2 = abcxdlus*abcxdlus
abcxdlus_4 = abcxdlus_2*abcxdlus_2
abcxdlus_6 = abcxdlus_4*abcxdlus_2
sincbcxdlus = 1-abcxdlus_2/6+abcxdlus_4/120-abcxdlus_6/5040
lbcxdlus = zbcc/(2*sincbcxdlus)
abcxdlul = abcxdlu-abcxdlus
lbcxdlul = lbcxdlu-lbcxdlus

bcxdlu1a: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdlus, angle = +abcxdlus, e1 = 0, fint = fbcc, fintx = 0
bcxdlu1b: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdlul, angle = +abcxdlul, e2 = +abcxdlu, fint = 0,
          fintx = fbcc
bcxdlu2a: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdlul, angle = -abcxdlul, e1 = -abcxdlu, fint = fbcc,
          fintx = 0
bcxdlu2b: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdlus, angle = -abcxdlus, e2 = 0, fint = 0, fintx = fbcc
bcxdlu3a: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdlus, angle = -abcxdlus, e1 = 0, fint = fbcc, fintx = 0
bcxdlu3b: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdlul, angle = -abcxdlul, e2 = -abcxdlu, fint = 0,
          fintx = fbcc
bcxdlu4a: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdlul, angle = +abcxdlul, e1 = +abcxdlu, fint = fbcc,
          fintx = 0
bcxdlu4b: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdlus, angle = +abcxdlus, e2 = 0, fint = 0, fintx = fbcc

! dogleg

! XOFF  : x-offset of bypass line (old PEP-II 9-GeV) w.r.t. old linac axis
!         (<0 is south)
! YOFF  : y-offset of bypass line (old PEP-II 9-GeV) w.r.t. old linac axis
!         (>0 is up)
! ROLLA : roll angle of sec-10 bends to get XOFF and YOFF bypass offsets

gbr = 0.0254          !1.0D38.37 gap height (m)
lbr = 1.0             !1.0D38.37 gap height (m)
fbr = 0.4875          !1.0D38.37 FINT @ 262 A
anga = 0.024477314712  !dogleg bend angle (rad)
xoff = -25.610*in2m
yoff = 25.570*in2m
rolla = -1.054575132367

brb1a: sbend, type = "1.0D38.37", hgap = gbr/2, l = lbr/2, angle = anga/2, e1 = anga/2, e2 = 0, fint = fbr, fintx = 0,
          ref_tilt = rolla
brb1b: sbend, type = "1.0D38.37", hgap = gbr/2, l = lbr/2, angle = anga/2, e1 = 0, e2 = anga/2, fint = 0, fintx = fbr,
          ref_tilt = rolla
brb2a: sbend, type = "1.0D38.37", hgap = gbr/2, l = lbr/2, angle = -anga/2, e1 = -anga/2, e2 = 0, fint = fbr, fintx = 0,
          ref_tilt = rolla
brb2b: sbend, type = "1.0D38.37", hgap = gbr/2, l = lbr/2, angle = -anga/2, e1 = 0, e2 = -anga/2, fint = 0, fintx = fbr,
          ref_tilt = rolla


! downstream R56 compensation chicane:
!   ABCX..  = chicane bend angle (rad)
!   BBCX..  = chicane bend field (kG)
!   LBCX..  = chicane bend path length (m)
!   ABCX..S = "short" half chicane bend angle (rad)
!   ABCX..L = "long" half chicane bend angle (rad)
!   LBCX..S = "short" half chicane bend path length (m)
!   LBCX..L = "long" half chicane bend path length (m)

abcxdld0 = 0.010734075009 !R56=9.99E-5
abcxdld = 1.15*abcxdld0  !R56=1.32E-4
bbcxdld = brhof*sin(abcxdld)/zbcc
abcxdld_2 = abcxdld*abcxdld
abcxdld_4 = abcxdld_2*abcxdld_2
abcxdld_6 = abcxdld_4*abcxdld_2
sincbcxdld = 1-abcxdld_2/6+abcxdld_4/120-abcxdld_6/5040
lbcxdld = zbcc/sincbcxdld
abcxdlds = asin(sin(abcxdld)/2)
abcxdlds_2 = abcxdlds*abcxdlds
abcxdlds_4 = abcxdlds_2*abcxdlds_2
abcxdlds_6 = abcxdlds_4*abcxdlds_2
sincbcxdlds = 1-abcxdlds_2/6+abcxdlds_4/120-abcxdlds_6/5040
lbcxdlds = zbcc/(2*sincbcxdlds)
abcxdldl = abcxdld-abcxdlds
lbcxdldl = lbcxdld-lbcxdlds

bcxdld1a: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdlds, angle = +abcxdlds, e1 = 0, fint = fbcc, fintx = 0
bcxdld1b: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdldl, angle = +abcxdldl, e2 = +abcxdld, fint = 0,
          fintx = fbcc
bcxdld2a: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdldl, angle = -abcxdldl, e1 = -abcxdld, fint = fbcc,
          fintx = 0
bcxdld2b: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdlds, angle = -abcxdlds, e2 = 0, fint = 0, fintx = fbcc
bcxdld3a: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdlds, angle = -abcxdlds, e1 = 0, fint = fbcc, fintx = 0
bcxdld3b: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdldl, angle = -abcxdldl, e2 = -abcxdld, fint = 0,
          fintx = fbcc
bcxdld4a: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdldl, angle = +abcxdldl, e1 = +abcxdld, fint = fbcc,
          fintx = 0
bcxdld4b: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdlds, angle = +abcxdlds, e2 = 0, fint = 0, fintx = fbcc

! define unsplit SBENs for BMAD ... not used by MAD

bcxdlu1: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdlu, angle = +abcxdlu, e1 = 0, fint = fbcc, e2 = +abcxdlu,
          fintx = fbcc
bcxdlu2: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdlu, angle = -abcxdlu, e1 = -abcxdlu, fint = fbcc, e2 = 0,
          fintx = fbcc
bcxdlu3: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdlu, angle = -abcxdlu, e1 = 0, fint = fbcc, e2 = -abcxdlu,
          fintx = fbcc
bcxdlu4: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdlu, angle = +abcxdlu, e1 = +abcxdlu, fint = fbcc, e2 = 0,
          fintx = fbcc
brb1: sbend, type = "1.0D38.37", hgap = gbr/2, l = lbr, angle = anga, e1 = anga/2, fint = fbr, e2 = anga/2, fintx = fbr,
          ref_tilt = rolla
brb2: sbend, type = "1.0D38.37", hgap = gbr/2, l = lbr, angle = -anga, e1 = -anga/2, fint = fbr, e2 = -anga/2,
          fintx = fbr, ref_tilt = rolla
bcxdld1: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdld, angle = +abcxdld, e1 = 0, fint = fbcc, e2 = +abcxdld,
          fintx = fbcc
bcxdld2: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdld, angle = -abcxdld, e1 = -abcxdld, fint = fbcc, e2 = 0,
          fintx = fbcc
bcxdld3: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdld, angle = -abcxdld, e1 = 0, fint = fbcc, e2 = -abcxdld,
          fintx = fbcc
bcxdld4: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbcxdld, angle = +abcxdld, e1 = +abcxdld, fint = fbcc, e2 = 0,
          fintx = fbcc

! ==============================================================================
! QUAD
! ------------------------------------------------------------------------------

! dogleg

kqdog = 0.563669043742

qdog1: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqdog
qdog2: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = -kqdog
qdog3: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqdog
qdog4: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = -kqdog
qdog5: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqdog
qdog6: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = -kqdog
qdog7: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqdog
qdog8: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = -kqdog

! match to bypass line

kql1p = 0.322623395309
kql2p = -0.155036336326
kql3p = 0.223203385308
kql4p = -0.284566066043
kql5p = 0.151439029009

ql1p: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kql1p
ql2p: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kql2p
ql3p: quadrupole, type = "2Q4W", l = lqm/2, aperture = rqm, k1 = kql3p
ql4p: quadrupole, type = "2Q4W", l = lqm/2, aperture = rqm, k1 = kql4p
ql5p: quadrupole, type = "2Q4W", l = lqm/2, aperture = rqm, k1 = kql5p

! bypass line FODO

kqbyp = 0.060580505638 !45 degree per cell

qbpf: quadrupole, type = "2Q4", l = lqm/2, aperture = rqm, k1 = kqbyp
qbpd: quadrupole, type = "2Q4", l = lqm/2, aperture = rqm, k1 = -kqbyp

qbp10: quadrupole, type = "2Q4", l = lqm/2, aperture = rqm, k1 = -kqbyp
qbp11: quadrupole, type = "2Q4", l = lqm/2, aperture = rqm, k1 = kqbyp
qbp12: quadrupole, type = "2Q4", l = lqm/2, aperture = rqm, k1 = -kqbyp

! integrated strengths

!=!  COMMENT !nominal energy
!=!  COMMENT !nominal energy
!=!    VALUE, (Cb*Ef)*KQDOG*LQR
!=!    VALUE, (Cb*Ef)*KQL1P*LQR
!=!    VALUE, (Cb*Ef)*KQL2P*LQR
!=!    VALUE, (Cb*Ef)*KQL3P*LQM
!=!    VALUE, (Cb*Ef)*KQL4P*LQM
!=!    VALUE, (Cb*Ef)*KQL5P*LQM
!=!    VALUE, (Cb*Ef)*KQBYP*LQM
!=!  ENDCOMMENT

!=!  COMMENT !maximum energy (10 GeV)
!=!  COMMENT !maximum energy (10 GeV)
!=!    VALUE, (Cb*Emax)*KQDOG*LQR
!=!    VALUE, (Cb*Emax)*KQL1P*LQR
!=!    VALUE, (Cb*Emax)*KQL2P*LQR
!=!    VALUE, (Cb*Emax)*KQL3P*LQM
!=!    VALUE, (Cb*Emax)*KQL4P*LQM
!=!    VALUE, (Cb*Emax)*KQL5P*LQM
!=!    VALUE, (Cb*Emax)*KQBYP*LQM
!=!  ENDCOMMENT

! ==============================================================================
! SEXT
! ------------------------------------------------------------------------------

ksdog1 = -9.188528777604 !-9.801
ksdog2 = 22.656285406772 !-20.61

tsdog1 = -13.252537412109 !-0.2331*DEGRAD
tsdog2 = 16.730337124259 ! 0.3342*DEGRAD

sdog1: sextupole, tilt = raddeg*tsdog1, type = "@1,1.38S3.00", l = lsb/2, aperture = rsb, k2 = ksdog1
sdog2: sextupole, tilt = raddeg*tsdog2, type = "@1,1.38S3.00", l = lsb/2, aperture = rsb, k2 = ksdog2

!=!  COMMENT
!=!  COMMENT
!=!    VALUE, (Cb*Ef)*KSDOG1*LSb,(Cb*10)*KSDOG1*LSb
!=!    VALUE, (Cb*Ef)*KSDOG2*LSb,(Cb*10)*KSDOG2*LSb
!=!  ENDCOMMENT

! ==============================================================================
! ROLL
! ------------------------------------------------------------------------------

arobrb1 = -0.12862097585e-3
arobrb2 = -arobrb1

robrb1: patch, tilt = arobrb1
robrb2: patch, tilt = arobrb2

! ==============================================================================
! DRIF
! ------------------------------------------------------------------------------

! R56 compensation chicane

dccdluo: drift, l = zdcc/cos(abcxdlu), type = "CSR"
dccdlui: drift, l = zdcc/2, type = "CSR"

! dogleg

nqbd = 8                    !number of dogleg quads
ltota = 76.022947763944      !path length from BRB1-exit to BRB2-entrance
ldbd = (ltota+lbr)/(nqbd/2) !FODO cell half length
dldbd = -0.12481688608e-4    !adjustment for dispersion correction
ldbdh = ldbd/2+dldbd         !FODO cell half length

dbdm0: drift, l = 0.2333 !drift between VVEXTD and CCDLU
dbdm1: drift, l = 0.5 !drift between CCDLU and BRB1
dbd: drift, l = ltota
dbd0: drift, l = (ldbdh-lbr-lqr)/2-4*dldbd
dbd1: drift, l = ldbdh-lqr
dbd2: drift, l = ldbdh-lqr
dbd3: drift, l = ldbdh-lqr
dbd4: drift, l = ldbdh-lqr
dbd5: drift, l = ldbdh-lqr
dbd6: drift, l = ldbdh-lqr
dbd7: drift, l = ldbdh-lqr
dbd8: drift, l = (ldbdh-lqr-lbr)/2-4*dldbd

!=!  COMMENT
!=!  COMMENT
!=!    VALUE, LTOTA,(NQBD/2)*LDBD-LBR
!=!    VALUE, DBD0[L]+DBD1[L]+DBD2[L]+DBD3[L]+DBD4[L]+&
!=!           DBD5[L]+DBD6[L]+DBD7[L]+DBD8[L]+NQBD*LQR
!=!  ENDCOMMENT

dbd1sb: drift, l = 0.2016
dbd1sa: drift, l = dbd1[l]-lsb-dbd1sb[l]
dbd6sb: drift, l = 0.203095
dbd6sa: drift, l = dbd6[l]-lsb-dbd6sb[l]

dbd0a: drift, l = 1.0
dbd0c: drift, l = 0.5185-lqr/2
dbd0b: drift, l = dbd0[l]-dbd0a[l]-dbd0c[l]
dbd1a: drift, l = 0.5786-lqr/2
dbd1d: drift, l = 0.2016
dbd1c: drift, l = 0.536-lsb-dbd1d[l]
dbd1b: drift, l = dbd1[l]-dbd1a[l]-ljaw-dbd1c[l]-lsb-dbd1d[l]
dbd2a: drift, l = 0.5786-lqr/2
dbd2b: drift, l = 0.6368
dbd2d: drift, l = 0.5185-lqr/2
dbd2c: drift, l = dbd2[l]-dbd2a[l]-dbd2b[l]-dbd2d[l]
dbd3a: drift, l = 0.5786-lqr/2
dbd3c: drift, l = 0.5185-lqr/2
dbd3b: drift, l = dbd3[l]-dbd3a[l]-dbd3c[l]
dbd4a: drift, l = 0.5786-lqr/2
dbd4c: drift, l = 0.5185-lqr/2
dbd4b: drift, l = dbd4[l]-dbd4a[l]-dbd4c[l]
dbd4h: drift, l = dbd4[l]/2
dbd5a: drift, l = 0.5786-lqr/2
dbd5c: drift, l = 0.5
dbd5d: drift, l = 0.536
dbd5b: drift, l = dbd5[l]-dbd5a[l]-dbd5c[l]-dbd5d[l]
dbd6a: drift, l = 0.5786-lqr/2
dbd6b: drift, l = 0.527
dbd6e: drift, l = 0.203095
dbd6d: drift, l = 0.772576-lqr/2-lsb-dbd6e[l]
dbd6c: drift, l = dbd6[l]-dbd6a[l]-dbd6b[l]-dbd6d[l]-lsb-dbd6e[l]
dbd7a: drift, l = 0.5786-lqr/2
dbd7c: drift, l = 0.5185-lqr/2
dbd7b: drift, l = dbd7[l]-dbd7a[l]-dbd7c[l]
dbd8a: drift, l = 0.5786-lqr/2
dbd8b: drift, l = dbd8[l]-dbd8a[l]

! R56 compensation chicane

dccdldo: drift, l = zdcc/cos(abcxdld), type = "CSR"
dccdldi: drift, l = zdcc/2, type = "CSR"

! bypass line FODO

dbp: drift, l = (101.6-lqm)/2
dbpsa: drift, l = 15.468697 !to sector boundary
dbpsb: drift, l = dbp[l]-dbpsa[l]

! match to bypass line

lltot = 99.751028062384

ll0 = 5.0
ll1 = 18.0
ll2 = 34.5
ll3 = 11.0
ll4 = lltot-ll0-ll1-ll2-ll3

dlccp: drift, l = 0.5
dl0p: drift, l = ll0
dl1p: drift, l = ll1
dl2p: drift, l = ll2
dl3p: drift, l = ll3
dl4p: drift, l = ll4

dl0pa: drift, l = 0.3
dl0pb: drift, l = ll0-dl0pa[l]
dl1pa: drift, l = 0.4471
dl1pb: drift, l = 0.6368
dl1pc: drift, l = ll1-dl1pa[l]-dl1pb[l]
dl2pa: drift, l = 0.4471
dl2pb: drift, l = 1.245325 !0.6368
dl2pc: drift, l = ll2-dl2pa[l]-dl2pb[l]
dl3pa: drift, l = 0.4598
dl3pb: drift, l = 0.7433
dl3pc: drift, l = 5.9032251
dl3pd: drift, l = ll3-dl3pa[l]-dl3pb[l]-dl3pc[l]
dl4pa: drift, l = 0.4598
dl4pb: drift, l = 0.7433
dl4pc: drift, l = ll4-dl4pa[l]-dl4pb[l]
dbpa: drift, l = 0.44518 !0.4598
dbpb: drift, l = 0.62865 !0.7433
dbpc: drift, l = dbp[l]-dbpa[l]-dbpb[l]
dbpe: drift, l = 0.1
dbpf: drift, l = 1.0
dbpd: drift, l = dbp[l]-dbpa[l]-dbpb[l]-dbpe[l]-dbpf[l]

dbpb1: drift, l = dbpb[l]+0.38327
dbpc1: drift, l = dbpc[l]-0.38327
dbpd1: drift, l = 21.516667
dbpd1a: drift, l = 3.950667 !30*in2m
dbpd1b: drift, l = dbpd1[l]-dbpd1a[l]
s10wall: drift, l = 1.848
dbpd2: drift, l = dbpd[l]-dbpd1[l]-s10wall[l]

! ==============================================================================
! BPMs
! ------------------------------------------------------------------------------

bpmdog1: monitor, type = "Stripline-5"
bpmdog2: monitor, type = "Stripline-5" !RFBDOG2 : MONI, TYPE="@2,CavityL-1"
bpmdog3: monitor, type = "Stripline-5"
bpmdog4: monitor, type = "Stripline-5"
bpmdog5: monitor, type = "Stripline-5"
bpmdog6: monitor, type = "Stripline-5" !RFBDOG6 : MONI, TYPE="@2,CavityL-1"
bpmdog7: monitor, type = "Stripline-5"
bpmdog8: monitor, type = "Stripline-5"
bpml1p: monitor, type = "Stripline-5"
bpml2p: monitor, type = "Stripline-5"
bpml3p: monitor, type = "Stripline-5"
bpml4p: monitor, type = "Stripline-5"
bpml5p: monitor, type = "Stripline-5"
bpmbp10: monitor, type = "Stripline-5"
bpmbp11: monitor, type = "Stripline-5"
bpmbp12: monitor, type = "Stripline-5"

rfbwsbp1: monitor, type = "@2,CavityS-1"

! ==============================================================================
! XCORs
! ------------------------------------------------------------------------------

xcdog1: hkicker, type = "type-4"
xcdog3: hkicker, type = "type-4"
xcdog5: hkicker, type = "type-4"
xcdog7: hkicker, type = "type-4"
xcl1p: hkicker, type = "type-4"
xcl3p: hkicker, type = "type-4"
xcl5p: hkicker, type = "type-4"
xcbp10: hkicker, type = "type-4"
xcbp11: hkicker, type = "type-4"

! ==============================================================================
! YCORs
! ------------------------------------------------------------------------------

ycdog0: vkicker, type = "type-4"
ycdog2: vkicker, type = "type-4"
ycdog4: vkicker, type = "type-4"
ycdog6: vkicker, type = "type-4"
ycdog8: vkicker, type = "type-4"
ycl2p: vkicker, type = "type-4"
ycl4p: vkicker, type = "type-4"
ycbp10: vkicker, type = "type-4"
ycbp12: vkicker, type = "type-4"

! ==============================================================================
! marker points, etc.
! ------------------------------------------------------------------------------

! collimator

! CEDOG : energy coll in bypass dog-leg (YSIZE is half-gap)

cedog: rcollimator, l = ljaw, y_limit = 8.6e-3, type = "VCOLL"

! beam profile measurement

otrdog: monitor, type = "OTR"
wsdog: marker, type = "@3,fast"
wsbp1: marker, type = "fast"

! combination OTR/YAG !PSI type

otr31: monitor, type = "@3,OTR"
otr31_yag: monitor, type = "@3,YAG"
  OTR31_full : LINE=(OTR31,OTR31_YAG)

! markers

ccdlubeg: marker
ccdlumid: marker
cntdlu: marker, type = "CENTER"
ccdluend: marker
bdbeg: marker
clbrb1: marker !BRB1 centerline
midbd: marker
clbrb2: marker !BRB2 centerline
cntdog: marker, type = "CENTER"
bdend: marker
ccdldbeg: marker
ccdldmid: marker
cntdld: marker, type = "CENTER"
ccdldend: marker
rwwake1: marker, type = "WAKE" !EXT+BD beampipe wake applied here

! sector boundaries (ZBEG=101.6*(n-1); ZEND=101.6*n)

bpn09beg: marker
bpn09end: marker
bpn10beg: marker
bpn10end: marker
bpn11beg: marker
bpn11end: marker
bpn12beg: marker

