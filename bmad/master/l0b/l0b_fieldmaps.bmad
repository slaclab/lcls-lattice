


! L0B fieldmap modifications 
! ---------------------------

cavity9_1300MHz: lcavity, 
    L = 1.3,
    voltage = 1e6,
    tracking_method = runge_kutta, 
    mat6_calc_method = tracking,  n_cell = 9, longitudinal = 0, 
    rf_frequency = 1300000000.0, 
    field_calc = fieldmap, 
    aperture_at = continuous, aperture_type=wall3d,
    !grid_field = call::$LCLS_LATTICE/bmad/fieldmaps/cavity9/cavity9_1300MHz_center.h5,
    grid_field = call::$LCLS_LATTICE/bmad/fieldmaps/cavity9/cavity9_1300MHz_full.h5,    
    wall = call::$LCLS_LATTICE/bmad/fieldmaps/cavity9/cavity9_1300MHz_full_wall.bmad



DCAVMAP[L] = 0
LCAVITY::CAVL*[L] = 1.3
LCAVITY::CAVL*[n_cell] = 9
LCAVITY::CAVL*[longitudinal] = 0

LCAVITY::CAVL*[tracking_method] = runge_kutta
LCAVITY::CAVL*[mat6_calc_method] = tracking

LCAVITY::CAVL*[field_calc] = fieldmap
LCAVITY::CAVL*[grid_field] = cavity9_1300MHz[grid_field]