! XYZ (linac system) and optimized Twiss at the beginning of spreader (BEGSPH)

xsp = xoff
ysp = yoff
zsp = 2780.276003
thsp = 0.0
phsp = 0.0
pssp = 0.0

tbxsp = 1.112796938491e2
tbysp = 60.000000012297
taxsp = 2.930243793946
taysp = 0.853023050724

! XYZ (linac system) at the end of HXR merge bend BXSP1h

xsph = 0.0
ysph = 0.0
zsph = 3110.961492
thsph = 0.0
phsph = 0.0
pssph = 0.0

! HXR quads

kqsp1h = 0.492283667698 ! 0.492284061187
kqsp2h = -1.000975451311 !-1.000975933726
kqsp3h = 0.304631037813 ! 0.304631069714
kqsp4h = -0.301467336919 !-0.301467337182
kqsp5h = 0.179797525903 ! 0.179797501925
kqsp6h = -0.221916299351 !-0.221916295184
kqsp7h = 0.447153951126 ! 0.447153906987
kqsp10h = -0.301520274195 !-0.301520272128
kqsp11h = 0.304797784837 ! 0.304797809076
kqsp12h = -0.991899431333 !-0.991897597733
kqsp13h = 0.491351727496 ! 0.49135154631
kqsp8h = kqsp6h
kqsp9h = kqsp5h

qsp1h: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqsp1h
qsp2h: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqsp2h
qsp3h: quadrupole, type = "1.26Q12", l = lqa/2, aperture = rqa, k1 = kqsp3h
qsp4h: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqsp4h
qsp5h: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqsp5h
qsp6h: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqsp6h
qsp7h: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqsp7h
qsp8h: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqsp8h
qsp9h: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqsp9h
qsp10h: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqsp10h
qsp11h: quadrupole, type = "1.26Q12", l = lqa/2, aperture = rqa, k1 = kqsp11h
qsp12h: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqsp12h
qsp13h: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqsp13h

! HXR sextupoles

kssp1h = -20.980886636913 !-20.980854539502
kssp2h = 22.597513710817 ! 22.597505265891

tssp1h = 15.249352738505 ! 15.249361095235
tssp2h = 17.803041269766 ! 17.803035424509

ssp1h: sextupole, type = "@1,1.38S3.00", l = lsb/2, aperture = rsb, k2 = kssp1h, tilt =  &
        degrees*tssp1h
ssp2h: sextupole, type = "@1,1.38S3.00", l = lsb/2, aperture = rsb, k2 = kssp2h, tilt =  &
        degrees*tssp2h

!=!  COMMENT
!=!  COMMENT
!=!    VALUE, (Cb*Ef)*KSSP1h*LSb,(Cb*10)*KSSP1h*LSb
!=!    VALUE, (Cb*Ef)*KSSP2h*LSb,(Cb*10)*KSSP2h*LSb
!=!  ENDCOMMENT

! SXR & dumpline shared quads

kqsp1 = 0.52687626083
kqsp2 = -0.521500809125

qsp1: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqsp1
qsp2: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqsp2

! SXR quads

kqsp1s = 0.633675228645 ! 0.633675409102
kqsp2s = -0.558846778994 !-0.558846970939
kqsp3s = 0.652027259917 ! 0.652027344684
kqsp4s = -0.497671456472 !-0.497671571574
kqsp5s = 0.184431144204 ! 0.184431117493
kqsp8s = -0.559080484823 !-0.559079941433
kqsp9s = 0.633806872701 ! 0.633806671882
kqsp6s = kqsp4s
kqsp7s = kqsp3s

qsp1s: quadrupole, type = "1.26Q12", l = lqa/2, aperture = rqa, k1 = kqsp1s
qsp2s: quadrupole, type = "1.26Q12", l = lqa/2, aperture = rqa, k1 = kqsp2s
qsp3s: quadrupole, type = "1.26Q12", l = lqa/2, aperture = rqa, k1 = kqsp3s
qsp4s: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqsp4s
qsp5s: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqsp5s
qsp6s: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqsp6s
qsp7s: quadrupole, type = "1.26Q12", l = lqa/2, aperture = rqa, k1 = kqsp7s
qsp8s: quadrupole, type = "1.26Q12", l = lqa/2, aperture = rqa, k1 = kqsp8s
qsp9s: quadrupole, type = "1.26Q12", l = lqa/2, aperture = rqa, k1 = kqsp9s

! SXR sextupoles

kssp1s = 12.701345963181 ! 12.701341641754
kssp2s = 12.699237045946 ! 12.699235330279

ssp1s: sextupole, type = "@1,1.38S3.00", l = lsb/2, aperture = rsb, k2 = kssp1s
ssp2s: sextupole, type = "@1,1.38S3.00", l = lsb/2, aperture = rsb, k2 = kssp2s

!=!  COMMENT
!=!  COMMENT
!=!    VALUE, (Cb*Ef)*KSSP1s*LSb,(Cb*10)*KSSP1s*LSb
!=!    VALUE, (Cb*Ef)*KSSP2s*LSb,(Cb*10)*KSSP2s*LSb
!=!  ENDCOMMENT

! BSY dumpline quads

kqsp1d = -0.258027172416
kqsp2d = 0.232777714022

qsp1d: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqsp1d
qsp2d: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqsp2d

! HXR vertical magnetic kickers
! All kickers aligned along the same z-axis (per T. Beukers)
! Assume the same z-length per kicker and same field (in SXR or HXR)

gbkysp = gbksp !kicker gap (m) - round pipe, square bore aperture
lbkysp = lbksp !kicker straight length (m)

setkikh = 0.5*setsp*(setsp-1)    !scale for HXR spreader kicker & septum
abkysph0 = -0.75e-3
abkysph = abkysph0*setkikh      !total HXR kicker y-angle (rad)
abkysp1h = asin(sin(abkysph)/3) !1st HXR kicker y-angle (rad)
abkysp12h = asin(2*sin(abkysph)/3) !1st+2nd HXR kicker y-angle (rad)
abkysp2h = abkysp12h-abkysp1h     !2nd HXR kicker y-angle (rad)
abkysp3h = abkysph-abkysp12h    !3rd HXR kicker y-angle (rad)

lbkysp1h = lbkysp/(1-abkysp1h*abkysp1h/6)
lbkysp12h = 2*lbkysp/(1-abkysp12h*abkysp12h/6)
lbkysp13h = 3*lbkysp/(1-abkysph*abkysph/6)
lbkysp2h = lbkysp12h-lbkysp1h
lbkysp3h = lbkysp13h-lbkysp12h

bkysp1ha: sbend, hgap = gbkysp/2, fint = 0.5, fintx = 0, e2 = 0, e1 = 0, type = "0.787K35.4",  &
        ref_tilt = pi/2, l = lbkysp1h/2, angle = lbkysp1h/2 * abkysp1h/2/(lbkysp1h/2)
bkysp1hb: sbend, hgap = gbkysp/2, fint = 0, fintx = 0.5, e1 = 0, e2 = abkysp1h, type =  &
        "0.787K35.4", ref_tilt = pi/2, l = lbkysp1h/2, angle =  &
        lbkysp1h/2 * abkysp1h/2/(lbkysp1h/2)

bkysp2ha: sbend, hgap = gbkysp/2, fint = 0.5, fintx = 0, e2 = 0, e1 = -abkysp1h, type =  &
        "0.787K35.4", ref_tilt = pi/2, l = lbkysp2h/2, angle =  &
        lbkysp2h/2 * abkysp2h/2/(lbkysp2h/2)
bkysp2hb: sbend, hgap = gbkysp/2, fint = 0, fintx = 0.5, e1 = 0, e2 = abkysp12h, type =  &
        "0.787K35.4", ref_tilt = pi/2, l = lbkysp2h/2, angle =  &
        lbkysp2h/2 * abkysp2h/2/(lbkysp2h/2)

bkysp3ha: sbend, hgap = gbkysp/2, fint = 0.5, fintx = 0, e2 = 0, e1 = -abkysp12h, type =  &
        "0.787K35.4", ref_tilt = pi/2, l = lbkysp3h/2, angle =  &
        lbkysp3h/2 * abkysp3h/2/(lbkysp3h/2)
bkysp3hb: sbend, hgap = gbkysp/2, fint = 0, fintx = 0.5, e1 = 0, e2 = abkysph, type =  &
        "0.787K35.4", ref_tilt = pi/2, l = lbkysp3h/2, angle =  &
        lbkysp3h/2 * abkysp3h/2/(lbkysp3h/2)

! placeholder zero-strength magnets for future LCLS-II-HE HXR kickers

lbkysp0h = lbkysp
lbkysp4h = lbkysp/cos(abkysph)

bkysp0ha: sbend, hgap = gbkysp/2, fint = 0.5, fintx = 0, e2 = 0, e1 = 0, type = "@2,0.787K35.4",  &
        ref_tilt = pi/2, l = lbkysp0h/2
bkysp0hb: sbend, hgap = gbkysp/2, fint = 0, fintx = 0.5, e1 = 0, e2 = 0, type = "@2,0.787K35.4",  &
        ref_tilt = pi/2, l = lbkysp0h/2

bkysp4ha: sbend, hgap = gbkysp/2, fint = 0.5, fintx = 0, e2 = 0, e1 = -abkysph, type =  &
        "@2,0.787K35.4", ref_tilt = pi/2, l = lbkysp4h/2
bkysp4hb: sbend, hgap = gbkysp/2, fint = 0, fintx = 0.5, e1 = 0, e2 = abkysph, type =  &
        "@2,0.787K35.4", ref_tilt = pi/2, l = lbkysp4h/2

gbkysp5h = 0.035
zbkysp5h = 1.0
lbkysp5h = zbkysp5h/cos(abkysph)

bkysp5ha: sbend, hgap = gbkysp5h/2, fint = 0.5, fintx = 0, e2 = 0, e1 = -abkysph, type =  &
        "@2,1.378K35.4", ref_tilt = pi/2, l = lbkysp5h/2
bkysp5hb: sbend, hgap = gbkysp5h/2, fint = 0, fintx = 0.5, e1 = 0, e2 = abkysph, type =  &
        "@2,1.378K35.4", ref_tilt = pi/2, l = lbkysp5h/2

! SXR vertical magnetic kickers
! All kickers aligned along the same z-axis (per T. Beukers)
! Assume the same z-length per kicker and same field (in SXR or HXR)

setkiks = 0.5*setsp*(setsp+1)    !scale for SXR spreader kicker & septum
abkysps0 = -0.75e-3
abkysps = abkysps0*setkiks      !total SXR kicker y-angle (rad)
abkysp1s = asin(sin(abkysps)/3) !1st SXR kicker y-angle (rad)
abkysp12s = asin(2*sin(abkysps)/3) !1st+2nd SXR kicker y-angle (rad)
abkysp2s = abkysp12s-abkysp1s     !2nd SXR kicker y-angle (rad)
abkysp3s = abkysps-abkysp12s    !3rd SXR kicker y-angle (rad)

lbkysp1s = lbkysp/(1-abkysp1s*abkysp1s/6)
lbkysp12s = 2*lbkysp/(1-abkysp12s*abkysp12s/6)
lbkysp13s = 3*lbkysp/(1-abkysps*abkysps/6)
lbkysp2s = lbkysp12s-lbkysp1s
lbkysp3s = lbkysp13s-lbkysp12s

bkysp1sa: sbend, hgap = gbkysp/2, fint = 0.5, fintx = 0, e2 = 0, e1 = 0, type = "0.787K35.4",  &
        ref_tilt = pi/2, l = lbkysp1s/2, angle = lbkysp1s/2 * abkysp1s/2/(lbkysp1s/2)
bkysp1sb: sbend, hgap = gbkysp/2, fint = 0, fintx = 0.5, e1 = 0, e2 = abkysp1s, type =  &
        "0.787K35.4", ref_tilt = pi/2, l = lbkysp1s/2, angle =  &
        lbkysp1s/2 * abkysp1s/2/(lbkysp1s/2)

bkysp2sa: sbend, hgap = gbkysp/2, fint = 0.5, fintx = 0, e2 = 0, e1 = -abkysp1s, type =  &
        "0.787K35.4", ref_tilt = pi/2, l = lbkysp2s/2, angle =  &
        lbkysp2s/2 * abkysp2s/2/(lbkysp2s/2)
bkysp2sb: sbend, hgap = gbkysp/2, fint = 0, fintx = 0.5, e1 = 0, e2 = abkysp12s, type =  &
        "0.787K35.4", ref_tilt = pi/2, l = lbkysp2s/2, angle =  &
        lbkysp2s/2 * abkysp2s/2/(lbkysp2s/2)

bkysp3sa: sbend, hgap = gbkysp/2, fint = 0.5, fintx = 0, e2 = 0, e1 = -abkysp12s, type =  &
        "0.787K35.4", ref_tilt = pi/2, l = lbkysp3s/2, angle =  &
        lbkysp3s/2 * abkysp3s/2/(lbkysp3s/2)
bkysp3sb: sbend, hgap = gbkysp/2, fint = 0, fintx = 0.5, e1 = 0, e2 = abkysps, type =  &
        "0.787K35.4", ref_tilt = pi/2, l = lbkysp3s/2, angle =  &
        lbkysp3s/2 * abkysp3s/2/(lbkysp3s/2)

! placeholder zero-strength magnets for future LCLS-II-HE SXR kickers

lbkysp0s = lbkysp
lbkysp4s = lbkysp/cos(abkysps)

bkysp0sa: sbend, hgap = gbkysp/2, fint = 0.5, fintx = 0, e2 = 0, e1 = 0, type = "@2,0.787K35.4",  &
        ref_tilt = pi/2, l = lbkysp0s/2
bkysp0sb: sbend, hgap = gbkysp/2, fint = 0, fintx = 0.5, e1 = 0, e2 = 0, type = "@2,0.787K35.4",  &
        ref_tilt = pi/2, l = lbkysp0s/2

bkysp4sa: sbend, hgap = gbkysp/2, fint = 0.5, fintx = 0, e2 = 0, e1 = -abkysps, type =  &
        "@2,0.787K35.4", ref_tilt = pi/2, l = lbkysp4s/2
bkysp4sb: sbend, hgap = gbkysp/2, fint = 0, fintx = 0.5, e1 = 0, e2 = abkysps, type =  &
        "@2,0.787K35.4", ref_tilt = pi/2, l = lbkysp4s/2

gbkysp5s = 0.035
zbkysp5s = 1.0
lbkysp5s = zbkysp5s/cos(abkysps)

bkysp5sa: sbend, hgap = gbkysp5s/2, fint = 0.5, fintx = 0, e2 = 0, e1 = -abkysps, type =  &
        "@2,1.378K35.4", ref_tilt = pi/2, l = lbkysp5s/2
bkysp5sb: sbend, hgap = gbkysp5s/2, fint = 0, fintx = 0.5, e1 = 0, e2 = abkysps, type =  &
        "@2,1.378K35.4", ref_tilt = pi/2, l = lbkysp5s/2

! 2-hole HXR horizontal septum aligned along the bypass axis

gblxsp = gblsp !septum gap height (m)
lblxsp = lblsp !septum straight length (m)

ablxsph0 = -0.0055277237035
ablxsph = ablxsph0*setkikh
ablxspha = asin(sin(ablxsph)/2)
ablxsphb = ablxsph-ablxspha
ablxsph_2 = ablxsph*ablxsph
ablxsph_4 = ablxsph_2*ablxsph_2
ablxspha_2 = ablxspha*ablxspha
ablxspha_4 = ablxspha_2*ablxspha_2

lblxsph = lblxsp/(1-ablxsph_2/6+ablxsph_4/120)/cos(abkysph)
lblxspha = lblxsp/2/(1-ablxspha_2/6+ablxspha_4/120)/cos(abkysph)
lblxsphb = lblxsph-lblxspha

blxspha: sbend, e1 = 0, e2 = 0, fint = 0.5, fintx = 0, hgap = gblxsp/2, type = "0.625SD38.98", l &
         = lblxspha, angle = lblxspha * ablxspha/lblxspha
blxsphb: sbend, e1 = 0, e2 = ablxsph, fint = 0, fintx = 0.5, hgap = gblxsp/2, type =  &
        "0.625SD38.98", l = lblxsphb, angle = lblxsphb * ablxsphb/lblxsphb

! 2-hole SXR horizontal septum aligned along the bypass axis

ablxsps0 = 0.011055447407
ablxsps = ablxsps0*setkiks
ablxspsa = asin(sin(ablxsps)/2)
ablxspsb = ablxsps-ablxspsa
ablxsps_2 = ablxsps*ablxsps
ablxsps_4 = ablxsps_2*ablxsps_2
ablxspsa_2 = ablxspsa*ablxspsa
ablxspsa_4 = ablxspsa_2*ablxspsa_2

lblxsps = lblxsp/(1-ablxsps_2/6+ablxsps_4/120)/cos(abkysps)
lblxspsa = lblxsp/2/(1-ablxspsa_2/6+ablxspsa_4/120)/cos(abkysps)
lblxspsb = lblxsps-lblxspsa

blxspsa: sbend, e1 = 0, e2 = 0, fint = 0.5, fintx = 0, hgap = gblxsp/2, type = "0.625SD38.98", l &
         = lblxspsa, angle = lblxspsa * ablxspsa/lblxspsa
blxspsb: sbend, e1 = 0, e2 = ablxsps, fint = 0, fintx = 0.5, hgap = gblxsp/2, type =  &
        "0.625SD38.98", l = lblxspsb, angle = lblxspsb * ablxspsb/lblxspsb

! measured FINT for 1.0D38.37 @ 200A

fbsp = 0.4861

! HXR rolled bends

abrsph = 0.650488048269e-2
lbrsph = lbsp*abrsph/(2*sin(abrsph/2)) !BRSPh path length (m)
tbrsph = 0.555232529864                !BRSPh roll angle (rad)

brsp1ha: sbend, e1 = abrsph/2, e2 = 0, fint = fbsp, fintx = 0, hgap = gbsp/2, type = "1.0D38.37" &
        , ref_tilt = tbrsph, l = lbrsph/2, angle = lbrsph/2 * abrsph/2/(lbrsph/2)
brsp1hb: sbend, e1 = 0, e2 = abrsph/2, fint = 0, fintx = fbsp, hgap = gbsp/2, type = "1.0D38.37" &
        , ref_tilt = tbrsph, l = lbrsph/2, angle = lbrsph/2 * abrsph/2/(lbrsph/2)

brsp2ha: sbend, e1 = -abrsph/2, e2 = 0, fint = fbsp, fintx = 0, hgap = gbsp/2, type = "1.0D38.37" &
        , ref_tilt = tbrsph, l = lbrsph/2, angle = lbrsph/2 * (-abrsph/2)/(lbrsph/2)
brsp2hb: sbend, e1 = 0, e2 = -abrsph/2, fint = 0, fintx = fbsp, hgap = gbsp/2, type = "1.0D38.37" &
        , ref_tilt = tbrsph, l = lbrsph/2, angle = lbrsph/2 * (-abrsph/2)/(lbrsph/2)

! HXR horizontal bend
! Note: BXSP1h is a merge DC-bend which is either turned ON to operate
!       SCRF beam in HXR, or turned OFF to operate CURF beam in HXR

dabxsph = 0.155464098791e-8
abxsph = (-ablxsph0+dabxsph)*setkikh
abxsphh = abxsph/2
abxsphh_2 = abxsphh*abxsphh
abxsphh_4 = abxsphh_2*abxsphh_2
lbxsph = lbsp/(1-abxsphh_2/6+abxsphh_4/120) !BXSP1h path length (m)

bxsp1ha: sbend, e1 = abxsph/2, e2 = 0, fint = fbsp, fintx = 0, hgap = gbsp/2, type = "1.0D38.37" &
        , l = lbxsph/2, angle = lbxsph/2 * abxsph/2/(lbxsph/2)
bxsp1hb: sbend, e1 = 0, e2 = abxsph/2, fint = 0, fintx = fbsp, hgap = gbsp/2, type = "1.0D38.37" &
        , l = lbxsph/2, angle = lbxsph/2 * abxsph/2/(lbxsph/2)

! SXR horizontal bends

dabxsps = 0.310901777441e-8
abxsps = ablxsps0+dabxsps
lbxsps = lbsp*abxsps/(2*sin(abxsps/2)) !BXSPs path length (m)

bxsp1sa: sbend, e1 = -abxsps/2, e2 = 0, fint = fbsp, fintx = 0, hgap = gbsp/2, type = "1.0D38.37" &
        , l = lbxsps/2, angle = lbxsps/2 * (-abxsps/2)/(lbxsps/2)
bxsp1sb: sbend, e1 = 0, e2 = -abxsps/2, fint = 0, fintx = fbsp, hgap = gbsp/2, type = "1.0D38.37" &
        , l = lbxsps/2, angle = lbxsps/2 * (-abxsps/2)/(lbxsps/2)

bxsp2sa: sbend, e1 = -abxsps/2, e2 = 0, fint = fbsp, fintx = 0, hgap = gbsp/2, type = "1.0D38.37" &
        , l = lbxsps/2, angle = lbxsps/2 * (-abxsps/2)/(lbxsps/2)
bxsp2sb: sbend, e1 = 0, e2 = -abxsps/2, fint = 0, fintx = fbsp, hgap = gbsp/2, type = "1.0D38.37" &
        , l = lbxsps/2, angle = lbxsps/2 * (-abxsps/2)/(lbxsps/2)

bxsp3sa: sbend, e1 = abxsps/2, e2 = 0, fint = fbsp, fintx = 0, hgap = gbsp/2, type = "1.0D38.37" &
        , l = lbxsps/2, angle = lbxsps/2 * abxsps/2/(lbxsps/2)
bxsp3sb: sbend, e1 = 0, e2 = abxsps/2, fint = 0, fintx = fbsp, hgap = gbsp/2, type = "1.0D38.37" &
        , l = lbxsps/2, angle = lbxsps/2 * abxsps/2/(lbxsps/2)

! BSY dumpline vertical bends

abyspd = 0.877684127155e-2
lbyspd = lbsp*abyspd/(2*sin(abyspd/2)) !BYSPd path length (m)

bysp1da: sbend, e1 = abyspd/2, e2 = 0, fint = fbsp, fintx = 0, hgap = gbsp/2, type = "1.0D38.37" &
        , ref_tilt = pi/2, l = lbyspd/2, angle = lbyspd/2 * abyspd/2/(lbyspd/2)
bysp1db: sbend, e1 = 0, e2 = abyspd/2, fint = 0, fintx = fbsp, hgap = gbsp/2, type = "1.0D38.37" &
        , ref_tilt = pi/2, l = lbyspd/2, angle = lbyspd/2 * abyspd/2/(lbyspd/2)

bysp2da: sbend, e1 = -abyspd/2, e2 = 0, fint = fbsp, fintx = 0, hgap = gbsp/2, type = "1.0D38.37" &
        , ref_tilt = pi/2, l = lbyspd/2, angle = lbyspd/2 * (-abyspd/2)/(lbyspd/2)
bysp2db: sbend, e1 = 0, e2 = -abyspd/2, fint = 0, fintx = fbsp, hgap = gbsp/2, type = "1.0D38.37" &
        , ref_tilt = pi/2, l = lbyspd/2, angle = lbyspd/2 * (-abyspd/2)/(lbyspd/2)

! HXR DC bend correctors to compensate kicker orbit and dispersion

lbcsp = 0.6    !DC corrector length
gbcsp = 0.0254 !DC corrector gap
fbcsp = 0.4725 !measured DC corrector FINT value

abcsp1h = 0.445436076072e-2
abcsp2h = -0.370437221909e-2
lbcsp1h = lbcsp*abcsp1h/(2*sin(abcsp1h/2)) !BYSP1h path length (m)
lbcsp2h = lbcsp*abcsp2h/(2*sin(abcsp2h/2)) !BYSP2h path length (m)

bysp1ha: sbend, e1 = abcsp1h/2, e2 = 0, fint = fbcsp, fintx = 0, hgap = gbcsp/2, type =  &
        "1.0D22.625", ref_tilt = pi/2, l = lbcsp1h/2, angle = lbcsp1h/2 * abcsp1h/2/(lbcsp1h/2)
bysp1hb: sbend, e2 = abcsp1h/2, e1 = 0, fintx = fbcsp, fint = 0, hgap = gbcsp/2, type =  &
        "1.0D22.625", ref_tilt = pi/2, l = lbcsp1h/2, angle = lbcsp1h/2 * abcsp1h/2/(lbcsp1h/2)

bysp2ha: sbend, e1 = abcsp2h/2, e2 = 0, fint = fbcsp, fintx = 0, hgap = gbcsp/2, type =  &
        "1.0D22.625", ref_tilt = pi/2, l = lbcsp2h/2, angle = lbcsp2h/2 * abcsp2h/2/(lbcsp2h/2)
bysp2hb: sbend, e2 = abcsp2h/2, e1 = 0, fintx = fbcsp, fint = 0, hgap = gbcsp/2, type =  &
        "1.0D22.625", ref_tilt = pi/2, l = lbcsp2h/2, angle = lbcsp2h/2 * abcsp2h/2/(lbcsp2h/2)

! SXR DC bend correctors to compensate kicker orbit and dispersion

abcsp1s = 0.315465742092e-2
abcsp2s = -0.240470325405e-2
lbcsp1s = lbcsp*abcsp1s/(2*sin(abcsp1s/2)) !BYSP1s path length (m)
lbcsp2s = lbcsp*abcsp2s/(2*sin(abcsp2s/2)) !BYSP2s path length (m)

bysp1sa: sbend, e1 = abcsp1s/2, e2 = 0, fint = fbcsp, fintx = 0, hgap = gbcsp/2, type =  &
        "1.0D22.625", ref_tilt = pi/2, l = lbcsp1s/2, angle = lbcsp1s/2 * abcsp1s/2/(lbcsp1s/2)
bysp1sb: sbend, e2 = abcsp1s/2, e1 = 0, fintx = fbcsp, fint = 0, hgap = gbcsp/2, type =  &
        "1.0D22.625", ref_tilt = pi/2, l = lbcsp1s/2, angle = lbcsp1s/2 * abcsp1s/2/(lbcsp1s/2)

bysp2sa: sbend, e1 = abcsp2s/2, e2 = 0, fint = fbcsp, fintx = 0, hgap = gbcsp/2, type =  &
        "1.0D22.625", ref_tilt = pi/2, l = lbcsp2s/2, angle = lbcsp2s/2 * abcsp2s/2/(lbcsp2s/2)
bysp2sb: sbend, e2 = abcsp2s/2, e1 = 0, fintx = fbcsp, fint = 0, hgap = gbcsp/2, type =  &
        "1.0D22.625", ref_tilt = pi/2, l = lbcsp2s/2, angle = lbcsp2s/2 * abcsp2s/2/(lbcsp2s/2)

! define unsplit SBENs for BMAD ... not used by MAD

bkysp0h: sbend, hgap = gbkysp/2, e1 = 0, fint = 0.5, e2 = 0, type = "@2,0.787K35.4", ref_tilt =  &
        pi/2, l = lbkysp0h
bkysp1h: sbend, hgap = gbkysp/2, e1 = 0, fint = 0.5, e2 = abkysp1h, type = "0.787K35.4", ref_tilt &
         = pi/2, l = lbkysp1h, angle = lbkysp1h * abkysp1h/lbkysp1h
bkysp2h: sbend, hgap = gbkysp/2, e1 = -abkysp1h, fint = 0.5, e2 = abkysp12h, type = "0.787K35.4" &
        , ref_tilt = pi/2, l = lbkysp2h, angle = lbkysp2h * abkysp2h/lbkysp2h
bkysp3h: sbend, hgap = gbkysp/2, e1 = -abkysp12h, fint = 0.5, e2 = abkysph, type = "0.787K35.4",  &
        ref_tilt = pi/2, l = lbkysp3h, angle = lbkysp3h * abkysp3h/lbkysp3h
bkysp4h: sbend, hgap = gbkysp/2, e1 = -abkysph, fint = 0.5, e2 = abkysph, type = "@2,0.787K35.4" &
        , ref_tilt = pi/2, l = lbkysp4h
bkysp5h: sbend, hgap = gbkysp5h/2, e1 = -abkysph, fint = 0.5, e2 = abkysph, type =  &
        "@2,1.378K35.4", ref_tilt = pi/2, l = lbkysp5h
blxsph: sbend, hgap = gblxsp/2, e1 = 0, fint = 0.5, e2 = ablxsph, type = "0.625SD38.98", l =  &
        lblxsph, angle = lblxsph * ablxsph/lblxsph
bysp1h: sbend, hgap = gbcsp/2, e1 = abcsp1h/2, fint = fbcsp, e2 = abcsp1h/2, type = "1.0D22.625" &
        , ref_tilt = pi/2, l = lbcsp1h, angle = lbcsp1h * abcsp1h/lbcsp1h
bysp2h: sbend, hgap = gbcsp/2, e1 = abcsp2h/2, fint = fbcsp, e2 = abcsp2h/2, type = "1.0D22.625" &
        , ref_tilt = pi/2, l = lbcsp2h, angle = lbcsp2h * abcsp2h/lbcsp2h
brsp1h: sbend, hgap = gbsp/2, e1 = abrsph/2, fint = fbsp, e2 = abrsph/2, type = "1.0D38.37",  &
        ref_tilt = tbrsph, l = lbrsph, angle = lbrsph * abrsph/lbrsph
brsp2h: sbend, hgap = gbsp/2, e1 = -abrsph/2, fint = fbsp, e2 = -abrsph/2, type = "1.0D38.37",  &
        ref_tilt = tbrsph, l = lbrsph, angle = lbrsph * (-abrsph)/lbrsph
bxsp1h: sbend, hgap = gbsp/2, e1 = abxsph/2, fint = fbsp, e2 = abxsph/2, type = "1.0D38.37", l =  &
        lbxsph, angle = lbxsph * abxsph/lbxsph

bkysp0s: sbend, hgap = gbkysp/2, e1 = 0, fint = 0.5, e2 = 0, type = "@2,0.787K35.4", ref_tilt =  &
        pi/2, l = lbkysp0s
bkysp1s: sbend, hgap = gbkysp/2, e1 = 0, fint = 0.5, e2 = abkysp1s, type = "0.787K35.4", ref_tilt &
         = pi/2, l = lbkysp1s, angle = lbkysp1s * abkysp1s/lbkysp1s
