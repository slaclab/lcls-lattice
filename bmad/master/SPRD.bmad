bpmsp10h: monitor, type = "Stripline-5"
bpmsp11h: monitor, type = "Stripline-5"
bpmsp12h: monitor, type = "Stripline-2"
bpmsp13h: monitor, type = "Stripline-5"

bpmsp1s: monitor, type = "Stripline-5"
bpmsp2s: monitor, type = "Stripline-5"
bpmsp3s: monitor, type = "Stripline-5"
bpmsp4s: monitor, type = "Stripline-5"
bpmsp5s: monitor, type = "Stripline-5"
bpmsp6s: monitor, type = "Stripline-5"
bpmsp7s: monitor, type = "Stripline-5"
bpmsp8s: monitor, type = "Stripline-5"
bpmsp9s: monitor, type = "Stripline-5"

bpmsp1d: monitor, type = "Stripline-5"
bpmsp2d: monitor, type = "Stripline-5"
bpmsp3d: monitor, type = "Stripline-8" !has been already ordered (should have been Stripline-11)
bpmsp4d: monitor, type = "Stripline-5"
bpmsp5d: monitor, type = "Stripline-14" !large aperture BPM for raster

mrfbsp1d: marker !MONI, TYPE="CavityS-1" !make RF-bpm if spreader is RF
mrfbsp2d: marker !MONI, TYPE="CavityS-1" !make RF-bpm if spreader is RF

! steering correctors

xcsp1h: hkicker, type = "class-4"
xcsp3h: hkicker, type = "class-4"
xcsp5h: hkicker, type = "class-4"
xcsp7h: hkicker, type = "class-4"
xcsp9h: hkicker, type = "class-4"
xcsp11h: hkicker, type = "class-4"
xcsp13h: hkicker, type = "class-4"

ycsp2h: vkicker, type = "class-4"
ycsp4h: vkicker, type = "class-4"
ycsp6h: vkicker, type = "class-4"
ycsp8h: vkicker, type = "class-4"
ycsp10h: vkicker, type = "class-4"
ycsp12h: vkicker, type = "class-4"

xcsp1: hkicker, type = "class-4"
ycsp2: vkicker, type = "class-4"

xcsp1s: hkicker, type = "class-4"
xcsp3s: hkicker, type = "class-4"
xcsp5s: hkicker, type = "class-4"
xcsp7s: hkicker, type = "class-4"
xcsp9s: hkicker, type = "class-4"

ycsp2s: vkicker, type = "class-4"
ycsp4s: vkicker, type = "class-4"
ycsp6s: vkicker, type = "class-4"
ycsp8s: vkicker, type = "class-4"

xcsp1d: hkicker, type = "class-4"
xcsp3d: hkicker, type = "class-4"
XCSP5D: pipe, L = 0.0, type ="@0,class-5", descrip = "deferred HKICKER" !not installed
!old: xcsp5d: hkicker, type = "@0,class-5"

ycsp2d: vkicker, type = "class-4"
ycsp4d: vkicker, type = "class-4"
YCSP6D: pipe, L = 0.0, type ="@0,class-5", descrip = "deferred VKICKER" !not installed
!old: ycsp6d: vkicker, type = "@0,class-5"

! NOTE: the raster magnets operating at ~60 Hz with 90 deg phase between each
!       other have been de-scoped from the LCLS-II project ... BKXRASd and
!       BKYRASd are normal (class-4) correctors which were installed instead
!       of XCSP5d and YCSP6d

bkxrasd: hkicker, type = "class-4"
bkyrasd: vkicker, type = "class-4"

! SROT to remove rotation angle

arosp1h = 0.414577244197e-5
arosp2h = 0.947723870567e-5
arosp3h = -arosp2h
arosp1s = -0.829141820709e-5

rosp1h: patch, tilt = arosp1h
rosp2h: patch, tilt = arosp2h
rosp3h: patch, tilt = arosp3h
rosp1s: patch, tilt = arosp1s

! other diagnostic

imsp0h: marker, type = "ICT" !diagnostic ACM in SPH
imsp0s: marker, type = "ICT" !diagnostic ACM in SPS
imsp0d: marker, type = "ICT" !diagnostic ACM in SPD

IMBCSH1: pipe, L = 0.0, type ="@0,BCS ACM", descrip = "deferred MARKER" !BCS ACM doublet in SPH
!old: imbcsh1: marker, type = "@0,BCS ACM"
IMBCSH2: pipe, L = 0.0, type ="@0,BCS ACM", descrip = "deferred MARKER" !BCS ACM doublet in SPH
!old: imbcsh2: marker, type = "@0,BCS ACM"
IMBCSS1: pipe, L = 0.0, type ="@0,BCS ACM", descrip = "deferred MARKER" !BCS ACM doublet in SPS
!old: imbcss1: marker, type = "@0,BCS ACM"
IMBCSS2: pipe, L = 0.0, type ="@0,BCS ACM", descrip = "deferred MARKER" !BCS ACM doublet in SPS
!old: imbcss2: marker, type = "@0,BCS ACM"
IMBCSD1: pipe, L = 0.0, type ="@0,BCS ACM", descrip = "deferred MARKER" !BCS ACM doublet in SPD
!old: imbcsd1: marker, type = "@0,BCS ACM"
IMBCSD2: pipe, L = 0.0, type ="@0,BCS ACM", descrip = "deferred MARKER" !BCS ACM doublet in SPD
!old: imbcsd2: marker, type = "@0,BCS ACM"

btmspdmp: instrument, type = "PPS BTM" !Burn-Through-Monitor behind BSY dump

wssp1d: marker, type = "fast" !to measure beam size and energy before BSY dump

OTRSPDMP: pipe, L = 0.0, type ="@0,OTR", descrip = "deferred MONITOR" !OTR screen before BSY dump
!old: otrspdmp: monitor, type = "@0,OTR"

