d0h02e: drift, l = 0.5-d0h02f[l]
d0h02d: drift, l = d0h02[l]-d0h02a[l]-d0h02b[l]-d0h02c[l]-d0h02e[l]-d0h02f[l]
d0h03a: drift, l = 0.204906
d0h03b: drift, l = d0h03[l]-d0h03a[l]
d0h04a: drift, l = 0.2148
d0h04b: drift, l = 0.0333
d0h04c: drift, l = 0.2437
d0h04d: drift, l = 0.2492
d0h04e: drift, l = d0h04[l]-d0h04a[l]-d0h04b[l]-d0h04c[l]-d0h04d[l]
d0h05a: drift, l = 0.204906
d0h05b: drift, l = d0h05[l]-d0h05a[l]
d0h06a: drift, l = 0.204906
d0h06c: drift, l = 0.204906
d0h06b: drift, l = d0h06[l]-d0h06a[l]-d0h06c[l]
d0h07a: drift, l = 0.204906
d0h07b: drift, l = d0h07[l]-d0h07a[l]
d0h08a: drift, l = 0.1934
d0h08b: drift, l = d0h08[l]-d0h08a[l]

! laser heater

zhbbo = 3.264933791099
zhbbi = 2.009304
zhbmo = 1.53742329
zhbmiu = 0.37561671
zhbmid = 1.389994208901

dlhun = 0.506263-9*lam !adjust undulator length

dh01: drift, l = zhbbo/cos(abh), type = "CSR"
dh01a: drift, l = zhbmo/cos(abh), type = "CSR"
dh01b: drift, l = zhbmiu/cos(abh), type = "CSR"
dh01c: drift, l = dh01[l]-dh01a[l]-dh01b[l], type = "CSR"
dh02: drift, l = zhbbi, type = "CSR"
dh02a: drift, l = 0.192614-ljaw/2, type = "CSR"
dh02b: drift, l = 0.298450-ljaw/2, type = "CSR"

! Shorten so that umhtr has an integer number of poles
dh02c: drift, l = 0.2795065 - ( 10*0.054 - 0.506263 ) /2 , type = "CSR" !0.297036 !0.2795065  !wig heater
!dh02c: drift, l = 0.2795065 - ( 9*0.054 - 0.506263 ) /2 , type = "CSR" !0.297036 !0.2795065  !mat heater
!old: dh02c: drift, l = 0.2795065+dlhun/2, type = "CSR"

! Shorten so that umhtr has an integer number of poles
dh02d: drift, l = 0.2724707 - ( 10*0.054 - 0.506263 ) /2, type = "CSR" !0.2900002 !0.2724707 !wig heater
!dh02d: drift, l = 0.2724707 - ( 9*0.054 - 0.506263 ) /2, type = "CSR" !0.2900002 !0.2724707  !mat heater
!old: dh02d: drift, l = 0.2724707+dlhun/2, type = "CSR"
dh02e: drift, l = 0.4599998, type = "CSR"
dh03: drift, l = zhbbo/cos(abh), type = "CSR"
dh03a: drift, l = zhbmid/cos(abh), type = "CSR"
dh03c: drift, l = zhbmo/cos(abh), type = "CSR"
dh03b: drift, l = dh03[l]-dh03a[l]-dh03c[l], type = "CSR"

! laser heater to diagnostic line

dhd00: drift, l = 0.381398817802
dhd01: drift, l = 0.6566
dhd02: drift, l = 2.580388
dhd03: drift, l = 0.459812
dhd04: drift, l = 0.3687996

dhd00b: drift, l = 0.1
dhd00a: drift, l = dhd00[l]-dhd00b[l]
dhd01a: drift, l = 0.204906
dhd01c: drift, l = 0.204906
dhd01b: drift, l = dhd01[l]-dhd01a[l]-dhd01c[l]
dhd02b: drift, l = 0.204906
dhd02a: drift, l = dhd02[l]-dhd02b[l]
dhd02a2: drift, l = 0.305410
dhd02a3: drift, l = 0.777294
dhd02a1: drift, l = dhd02a[l]-dhd02a2[l]-dhd02a3[l]
dhd03b: drift, l = 0.204906
dhd03a: drift, l = dhd03[l]-dhd03b[l]
dhd04a: drift, l = 0.1208998
dhd04b: drift, l = dhd04[l]-dhd04a[l]

!=!  COMMENT
!=!  COMMENT
!=!    VALUE, DHD00[L],DHD00a[L]+DHD00b[L]
!=!    VALUE, DHD01[L],DHD01a[L]+DHD01b[L]+DHD01c[L]
!=!    VALUE, DHD02[L],DHD02a[L]+DHD02b[L]
!=!    VALUE, DHD03[L],DHD03a[L]+DHD03b[L]
!=!    VALUE, DHD04[L],DHD04a[L]+DHD04b[L]
!=!  ENDCOMMENT

! collimation FODO

dcoll0: drift, l = 4.0-lqx
dcoll0a: drift, l = 0.2508
dcoll0c: drift, l = 0.325-ljaw/2
dcoll0b: drift, l = dcoll0[l]-dcoll0a[l]-ljaw-dcoll0c[l]
dcoll0b2: drift, l = 0.3
dcoll0b3: drift, l = 0.3151
dcoll0b4: drift, l = 0.25-ljaw/2
dcoll0b1: drift, l = dcoll0b[l]-dcoll0b2[l]-dcoll0b3[l]-dcoll0b4[l]
dcoll0b5: drift, l = 3.2862

! DIAG0 extraction magnets

dbkrdg0a: drift, l = 0.5
dbkrdg0b: drift, l = 0.5
dblrdg0a: drift, l = 0.2
dblrdg0b: drift, l = 0.2

! COL0 collimation section

dc000: drift, l = 5.4832+4e-7
dc001: drift, l = 0.673
dc002: drift, l = 0.8238
dc003: drift, l = 1.533669597623
dc004: drift, l = 5.2128
dc010: drift, l = dcoll0[l]
dc011: drift, l = 2.8252
dc012: drift, l = 2.52236

dc000a: drift, l = zksd0
dc000c: drift, l = 0.19
dc000b: drift, l = dc000[l]-zk0-dc000a[l]-zs0-dc000c[l] !2.5932004
dc003a: drift, l = 0.2508
dc003b: drift, l = dc003[l]-dc003a[l]
dc004a: drift, l = 0.2508
dc004c: drift, l = 0.325-ljaw/2
dc004b: drift, l = dc004[l]-dc004a[l]-ljaw-dc004c[l]
dc010a: drift, l = dcoll0a[l]
dc010c: drift, l = 0.3
dc010b: drift, l = dc010[l]-dc010a[l]-dc010c[l]
dc011a: drift, l = 0.2508
dc011c: drift, l = 0.327
dc011b: drift, l = dc011[l]-dc011a[l]-dc011c[l]

dc000aa: drift, l = zksd0a
dc000ab: drift, l = zksd0b

