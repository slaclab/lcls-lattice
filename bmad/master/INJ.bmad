kq0h02 = 5.905989161645
kq0h03 = 2.403934435238
kq0h04 = -6.042774733767

q0h01: quadrupole, type = "2Q4", l = lqm/2, aperture = rqm, k1 = kq0h01
q0h02: quadrupole, type = "2Q4", l = lqm/2, aperture = rqm, k1 = kq0h02
q0h03: quadrupole, type = "2Q4", l = lqm/2, aperture = rqm, k1 = kq0h03
q0h04: quadrupole, type = "2Q4", l = lqm/2, aperture = rqm, k1 = kq0h04

