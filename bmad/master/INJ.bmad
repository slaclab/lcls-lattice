qhd04: quadrupole, type = "2Q4", l = lqm/2, aperture = rqm, k1 = kqhd04

! collimation FODO

kqcoll0 = 1.787850470726  !45 degree FODO
! BminColl0 := 6.996145818354
! BmaxColl0 := 15.616293369747

qfcoll0: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqcoll0
qdcoll0: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = -kqcoll0

! COL0 collimation section

kqc001 = 5.055115116458
kqc002 = 0.157983740943
kqc003 = -5.345027237214
kqc004 = 2.756594856384
kqc005 = -kqcoll0
kqc006 = kqcoll0
kqc007 = -kqcoll0
kqc008 = kqcoll0
kqc009 = -kqcoll0
kqc010 = 1.029493895725
kqc011 = -1.580615430886
kqc012 = 1.296911536424

qc001: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc001
qc002: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc002
qc003: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc003
qc004: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc004
qc005: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc005
qc006: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc006
qc007: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc007
qc008: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc008
qc009: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc009
qc010: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc010
qc011: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc011
qc012: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc012

! ==============================================================================
! SOLE
! ------------------------------------------------------------------------------

! solenoids between gun and L0

rsol = 0.0475/2
lsol1 = 0.1342              !m (measured)
lsol2 = 0.1350              !m (measured)
bsol1 = 0                   !0.0570 T
bsol2 = 0                   !0.0322 T
brho = cb*sqrt(e0^2-mc2^2) !kG-m (non-relativistic)
ksol1 = (10*bsol1)/brho     !1/m
ksol2 = (10*bsol2)/brho     !1/m

sol1bkb: solenoid, ks = 0, type = "Bucking Coil", l = 0
sol1b: solenoid, ks = ksol1, type = "LBNL", l = lsol1/2, aperture = rsol
sol2b: solenoid, ks = ksol2, type = "LBNL", l = lsol2/2, aperture = rsol

! ==============================================================================
! MATR
! ------------------------------------------------------------------------------

! laser heater undulator
! - modeled as R-matrix to include vertical natural focusing
! - parameters from LCLS-II Phase 1 undulator

! lam   : laser-heater undulator period [m]
! lamr  : heater laser wavelength [m]
! gami  : Lorentz energy factor in laser-heater undulator [1]
! K_und : undulator K for laser heater undulator
! Lhun  : length of laser-heater undulator (10 periods) [m]
! Lhunh : half-length of laser-heater undulator [m]
! kqlh  : natural undulator focusing "k" in y-plane [1/m2]

lam = 0.054 !0.0471204
lamr = 1030e-9
gami = ei/(m_electron * 1e-9)
k_und = sqrt(2*(lamr*2*gami^2/lam-1))
lhun = 0.506263 !10*lam
lhunh = lhun/2
kqlh = (k_und*2*pi/lam/sqrt(2)/gami)^2

! handle K_und->0 by expressing R34 as an approximate SINC function

argh = lhunh*sqrt(kqlh)
argh2 = argh*argh
argh4 = argh2*argh2
argh6 = argh4*argh2
sincargh = 1-argh2/6+argh4/120-argh6/5040 !~sinc(ARGh)=sin(ARGh)/ARGh
r34h = lhunh*sincargh

! undulator segment modeled as R-matrix to include vertical natural focusing


!------- Laser Heater Undulator for SC Linac -------
my_umhtr_k = 0.960143

umhtr: wiggler, 
        type = "laser_heater_undulator",
        L_period = 0.054, 
        n_period = 10, 
        b_max = my_umhtr_k * 2*pi*m_electron / (c_light * 0.054), 
        L = 10*0.054 ! Was: 0.506263, 
        ds_step = 0.054
        
umhtr[L] = umhtr[L]/2 ! Will be doubled in desplitting process. 
!--------------------------------- !,                               &
!old: umhtr: taylor, type = "LHund", l = lhunh, {1: 1.0, 1 0 0 0 0 0}, {1: lhunh, 0 1 0 0 0 0}, {2: 0.0 &
!old         , 1 0 0 0 0 0}, {2: 1.0, 0 1 0 0 0 0}, {3: cos(lhunh*sqrt(kqlh)), 0 0 1 0 0 0}, {3: r34h &
!old         , 0 0 0 1 0 0}, {4: -sin(lhunh*sqrt(kqlh))*sqrt(kqlh), 0 0 1 0 0 0}, {4:  &
!old         cos(lhunh*sqrt(kqlh)), 0 0 0 1 0 0}, {5: 1, 0 0 0 0 1 0}, {6: 1, 0 0 0 0 0 1}
   !R56=Lhunh/(gami^2)*(1+(K_und^2)/2)

! ==============================================================================
! DRIF
! ------------------------------------------------------------------------------

! gun to L0

lgun = 0.04 !APEX gun

dgbca: drift, l = -0.071705
dgbcb: drift, l = 0.071705
dgun: drift, l = lgun
dg001: drift, l = 0.246530-lgun-lsol1/2
dg002: drift, l = 0.140950-lsol1/2
dg003: drift, l = 0.097020
dg004: drift, l = 0.005150
dg005: drift, l = 0.105042
dg006: drift, l = 0.075408
dg007: drift, l = 0.139016-lbun/2
dg008: drift, l = 0.155084-lbun/2
dg009: drift, l = 0.181801
dg010: drift, l = 0.222999
dg011: drift, l = 0.121314
dg012: drift, l = 0.155496-lsol2/2
dg013: drift, l = 0.136970-lsol2/2
dg014: drift, l = 0.101444
dg015: drift, l = 0.004540
dg016: drift, l = 0.163813

dg016b: drift, l = 0.082968
dg016a: drift, l = dg016[l]-dg016b[l]

dgeic: drift, l = 3.0-2.052577

! L0 to laser heater

d0h00: drift, l = 0.407975
d0h01: drift, l = 0.427898
d0h02: drift, l = 4.179215
d0h03: drift, l = 0.409812
d0h04: drift, l = 1.0979
d0h05: drift, l = 0.409812
d0h06: drift, l = 1.366076
d0h07: drift, l = 0.409812
d0h08: drift, l = 0.3687

d0h00b: drift, l = 0.291975
d0h00a: drift, l = d0h00[l]-ljaw-d0h00b[l]
d0h01a: drift, l = 0.213949
d0h01b: drift, l = d0h01[l]-d0h01a[l]
d0h02a: drift, l = 0.204906
d0h02b: drift, l = 0.443171
d0h02c: drift, l = 0.64135
d0h02d: drift, l = 0.64135
d0h02f: drift, l = 0.204906
d0h02e: drift, l = d0h02[l]-d0h02a[l]-d0h02b[l]-d0h02c[l]-d0h02d[l]-d0h02f[l]
d0h03a: drift, l = 0.204906
d0h03b: drift, l = d0h03[l]-d0h03a[l]
d0h04a: drift, l = 0.2148
d0h04b: drift, l = 0.0333
d0h04c: drift, l = 0.2437
d0h04d: drift, l = 0.2492
d0h04e: drift, l = d0h04[l]-d0h04a[l]-d0h04b[l]-d0h04c[l]-d0h04d[l]
d0h05a: drift, l = 0.204906
d0h05b: drift, l = d0h05[l]-d0h05a[l]
d0h06a: drift, l = 0.204906
d0h06c: drift, l = 0.204906
d0h06b: drift, l = d0h06[l]-d0h06a[l]-d0h06c[l]
d0h07a: drift, l = 0.204906
d0h07b: drift, l = d0h07[l]-d0h07a[l]
d0h08a: drift, l = 0.1934
d0h08b: drift, l = d0h08[l]-d0h08a[l]

! laser heater

zhbbo = 3.264933791099
zhbbi = 2.009304
zhbmo = 1.53742329
zhbmiu = 0.37561671
zhbmid = 1.389994208901

dh01: drift, l = zhbbo/cos(abh), type = "CSR"
dh01a: drift, l = zhbmo/cos(abh), type = "CSR"
dh01b: drift, l = zhbmiu/cos(abh), type = "CSR"
dh01c: drift, l = dh01[l]-dh01a[l]-dh01b[l], type = "CSR"
dh02: drift, l = zhbbi, type = "CSR"
dh02a: drift, l = 0.192614-ljaw/2, type = "CSR"
dh02b: drift, l = 0.298450-ljaw/2, type = "CSR"

! Shorten so that umhtr has an integer number of poles
dh02c: drift, l = 0.2795065 - ( 10*0.054 - 0.506263 ) /2 , type = "CSR" !0.297036 !0.297036
!old: dh02c: drift, l = 0.2795065, type = "CSR"

! Shorten so that umhtr has an integer number of poles
dh02d: drift, l = 0.2724707 - ( 10*0.054 - 0.506263 ) /2, type = "CSR" !0.2900002 !0.2900002
!old: dh02d: drift, l = 0.2724707, type = "CSR"
dh02e: drift, l = 0.4599998, type = "CSR"
dh03: drift, l = zhbbo/cos(abh), type = "CSR"
dh03a: drift, l = zhbmid/cos(abh), type = "CSR"
dh03c: drift, l = zhbmo/cos(abh), type = "CSR"
dh03b: drift, l = dh03[l]-dh03a[l]-dh03c[l], type = "CSR"

! laser heater to diagnostic line

dhd00: drift, l = 0.381398817802
dhd01: drift, l = 0.6566
dhd02: drift, l = 2.580388
dhd03: drift, l = 0.459812
dhd04: drift, l = 0.3687996

dhd00b: drift, l = 0.1
dhd00a: drift, l = dhd00[l]-dhd00b[l]
dhd01a: drift, l = 0.204906
dhd01c: drift, l = 0.204906
dhd01b: drift, l = dhd01[l]-dhd01a[l]-dhd01c[l]
dhd02b: drift, l = 0.204906
dhd02a: drift, l = dhd02[l]-dhd02b[l]
dhd02a2: drift, l = 0.305410
dhd02a3: drift, l = 0.334815
dhd02a4: drift, l = 0.442479
dhd02a1: drift, l = dhd02a[l]-dhd02a2[l]-dhd02a3[l]-dhd02a4[l]
dhd03b: drift, l = 0.204906
dhd03a: drift, l = dhd03[l]-dhd03b[l]
dhd04a: drift, l = 0.1208998
dhd04b: drift, l = dhd04[l]-dhd04a[l]

!=!  COMMENT
!=!  COMMENT
!=!    VALUE, DHD00[L],DHD00a[L]+DHD00b[L]
!=!    VALUE, DHD01[L],DHD01a[L]+DHD01b[L]+DHD01c[L]
!=!    VALUE, DHD02[L],DHD02a[L]+DHD02b[L]
!=!    VALUE, DHD03[L],DHD03a[L]+DHD03b[L]
!=!    VALUE, DHD04[L],DHD04a[L]+DHD04b[L]
!=!  ENDCOMMENT

! collimation FODO

dcoll0: drift, l = 4.0-lqx
dcoll0a: drift, l = 0.2508
dcoll0c: drift, l = 0.325-ljaw/2
dcoll0b: drift, l = dcoll0[l]-dcoll0a[l]-ljaw-dcoll0c[l]
dcoll0b2: drift, l = 0.3
dcoll0b3: drift, l = 0.3151
dcoll0b4: drift, l = 0.25-ljaw/2
dcoll0b1: drift, l = dcoll0b[l]-dcoll0b2[l]-dcoll0b3[l]-dcoll0b4[l]
dcoll0b5: drift, l = 3.2862

! DIAG0 extraction magnets

dbkrdg0a: drift, l = 0.5
dbkrdg0b: drift, l = 0.5
dblrdg0a: drift, l = 0.2
dblrdg0b: drift, l = 0.2

! COL0 collimation section

dc000: drift, l = 5.4832+4e-7
dc001: drift, l = 0.673
dc002: drift, l = 0.8238
dc003: drift, l = 1.533669597623
dc004: drift, l = 5.2128
dc010: drift, l = dcoll0[l]
dc011: drift, l = 2.8252

dc000a: drift, l = zksd0
dc000c: drift, l = 0.19
dc000b: drift, l = dc000[l]-zk0-dc000a[l]-zs0-dc000c[l] !2.5932004
dc003a: drift, l = 0.2508
dc003b: drift, l = dc003[l]-dc003a[l]
dc004a: drift, l = 0.2508
dc004c: drift, l = 0.325-ljaw/2
dc004b: drift, l = dc004[l]-dc004a[l]-ljaw-dc004c[l]
dc010a: drift, l = dcoll0a[l]
dc010c: drift, l = 0.3
dc010b: drift, l = dc010[l]-dc010a[l]-dc010c[l]
dc011a: drift, l = 0.2508
dc011c: drift, l = 0.327
dc011b: drift, l = dc011[l]-dc011a[l]-dc011c[l]

dc000aa: drift, l = zksd0a
dc000ab: drift, l = zksd0b

