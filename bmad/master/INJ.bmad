! ==============================================================================
! diagnostics, etc.
! ------------------------------------------------------------------------------

! halo/dark current collimator

pc0h00: ecollimator, x_limit = 6.0e-3, y_limit = 6.0e-3, l = ljaw, type = "tungsten"

! collimators
! (betatron X/Y half-gaps are 24/16 sigma for 1 um normalized emittance)

cehtr: rcollimator, x_limit = 3.0e-3, l = ljaw, type = "HCOLL"    !X momentum collimator
cyc01: rcollimator, y_limit = 4.4e-3, l = ljaw, type = "VCOLL"    !Y betatron collimator
cxc01: rcollimator, x_limit = 4.4e-3, l = ljaw, type = "HCOLL"    !X betatron collimator
cyc02: rcollimator, y_limit = 4.4e-3, l = ljaw, type = "@4,VCOLL" !Y betatron collimator
cxc02: rcollimator, x_limit = 4.4e-3, l = ljaw, type = "@4,HCOLL" !X betatron collimator
cyc03: rcollimator, y_limit = 4.4e-3, l = ljaw, type = "VCOLL"    !Y betatron collimator
cxc03: rcollimator, x_limit = 4.4e-3, l = ljaw, type = "HCOLL"    !X betatron collimator

! instruments

cathodeb: instrument
vv01b: instrument
im01b: marker, type = "ICT"
yag01b: instrument, type = "YAG INJ"
vv02b: instrument
ws0h04: marker, type = "fast"
otr0h04: instrument, type = "@2,YAG/OTR PSI"
bz0h04: instrument, type = "gap/diode"
yagh1: instrument, type = "YAG INJ"
yagh2: instrument, type = "YAG INJ"
imbcsi1: marker, type = "@0,BCS ACM"
imbcsi2: marker, type = "@0,BCS ACM"
imbcsi3: marker, type = "@0,BCS ACM"
otrc006: instrument, type = "@4,YAG/OTR PSI"
wsc006: marker, type = "@4,fast"

fc00eic: instrument, type = "Faraday cup"

! marker points

am00b: marker !gun laser injection mirror (MIR01)
blfu: marker !beamline flange
dp0h01: marker
dp0h02: marker
dp0h03: marker
lhbegb: marker
mirlhu: marker, type = "laser inj/ext"
htrundb: marker, type = "SCATTER"
mirlhd: marker, type = "laser inj/ext"
cnthtr: marker, type = "CENTER"
lhendb: marker

begeic: marker
ecueic: marker !u/s flange face
endeic: marker

! ==============================================================================
! BEAMLINE
! ------------------------------------------------------------------------------

sol1bl: line = (sol1b, 2*cq01b, 2*sq01b, sol1b)
sol2bl: line = (sol2b, 2*cq02b, 2*sq02b, sol2b)

sc1b: line = (xc01b, yc01b)
sc2b: line = (xc02b, yc02b)
sc3b: line = (xc03b, yc03b)
sc4b: line = (xc04b, yc04b)
sc5b: line = (xc05b, yc05b)
scc000: line = (xcc000, ycc000)

gun: line = (beggunb, dgbca, sol1bkb, dgbcb, cathodeb, dgun, dg001, sol1bl, dg002, vv01b, dg003,  &
        sc1b, dg004, bpm1b, dg005, im01b, dg006, sc2b, dg007, bun1b, dg008, sc3b, dg009, am00b,  &
        dg010, sc4b, dg011, yag01b, dg012, sol2bl, dg013, vv02b, dg014, bpm2b, dg015, sc5b,  &
        dg016a, blfu, dg016b, endgunb)

eic: line = (begeic, dgbca, sol1bkb, dgbcb, cathodeb, dgun, dg001, sol1bl, dg002, vv01b, dg003,  &
        sc1b, dg004, bpm1b, dg005, im01b, dg006, sc2b, dg007, bun1b, dg008, sc3b, dg009, am00b,  &
        dg010, sc4b, dg011, yag01b, dg012, sol2bl, dg013, vv02b, dg014, bpm2b, dg015, sc5b,  &
        dg016a, blfu, dg016b, ecueic, dgeic, fc00eic, endeic)

lsrhtr: line = (lhbegb, bcxh1a, bcxh1b, dh01a, bpmh1, dh01b, mirlhu, dh01c, bcxh2a, bcxh2b, dh02a &
        , cehtr, dh02b, yagh1, dh02c, umhtr, htrundb, umhtr, dh02d, yagh2, dh02e, bcxh3a, bcxh3b &
        , dh03a, mirlhd, dh03b, bpmh2, dh03c, bcxh4a, bcxh4b, cnthtr, lhendb)

