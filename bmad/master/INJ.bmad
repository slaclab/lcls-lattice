! ==============================================================================
! lcavity
! ------------------------------------------------------------------------------

! buncher cavity
! (no gradient/phase values available)

lbun = 0.21876 !m
abun = 0.0517  !m
gbun = 1.8     !MV/m
pbun = -85     !deg

! bun1b is actually a standing wave, copper cavity.
! However, it is modeled in mad as a traveling wave cavity.  That will be corrected in due time.
! In any case, the injector is not well modeled by linear optics anyways, so for now just call bun1b
! a traveling wave cavity in Bmad too.
bun1b: lcavity, type = "LBNL", rf_frequency = 1300 * 1e6, l = lbun/2, aperture = abun/2, voltage = gbun*lbun/2 * 1e6,
          phi0 = pbun/360
!bun1b: lcavity, type = "LBNL", rf_frequency = 1300 * 1e6, l = lbun/2, aperture = abun/2, voltage = gbun*lbun/2 * 1e6,
!          phi0 = pbun/360, num_steps=1, cavity_type=traveling_wave, fringe_type=none

! ==============================================================================
! SBEN
! ------------------------------------------------------------------------------

! laser heater chicane
! - approximate on-axis effective length per R. Carr (01-AUG-05 PE)
! - use series approximation for sinc(x)=sin(x)/x to allow BCXH=0

! Brhoh : beam rigidity at chicane (kG-m)
! GBh   : 5D3.9 gap height (m)
! ZBh   : 5D3.9 "Z" length (m)
! FBh   : measured chicane bend FINT/FINTX
! ABh   : chicane bend angle (rad)
! BBh   : heater-chicane bend field (kG)
! LBh   : chicane bend path length (m)
! ABhS  : "short" half chicane bend angle (rad)
! LBhS  : "short" half chicane bend path length (m)
! ABhL  : "long" half chicane bend angle (rad)
! LBhL  : "long" half chicane bend path length (m)

brhoh = cb*ei
gbh = 0.03
zbh = 0.1244
fbh = 0.3887
abh = 0.022113758957 !DXmax=0.075
bbh = brhoh*sin(abh)/zbh
abh_2 = abh*abh
abh_4 = abh_2*abh_2
abh_6 = abh_4*abh_2
sincabh = 1-abh_2/6+abh_4/120-abh_6/5040 !~sinc(ABh)=sin(ABh)/ABh
lbh = zbh/sincabh
abhs = asin(sin(abh)/2)
abhs_2 = abhs*abhs
abhs_4 = abhs_2*abhs_2
abhs_6 = abhs_4*abhs_2
sincabhs = 1-abhs_2/6+abhs_4/120-abhs_6/5040 !~sinc(ABhS)=sin(ABhS)/ABhS
lbhs = zbh/(2*sincabhs)
abhl = abh-abhs
lbhl = lbh-lbhs

bcxh1a: sbend, type = "5D3.9", l = lbhs, angle = +abhs, hgap = gbh/2, e1 = 0, fint = fbh, fintx = 0
bcxh1b: sbend, type = "5D3.9", l = lbhl, angle = +abhl, hgap = gbh/2, fint = 0, e2 = +abh, fintx = fbh
bcxh2a: sbend, type = "5D3.9", l = lbhl, angle = -abhl, hgap = gbh/2, e1 = -abh, fint = fbh, fintx = 0
bcxh2b: sbend, type = "5D3.9", l = lbhs, angle = -abhs, hgap = gbh/2, fint = 0, e2 = 0, fintx = fbh
bcxh3a: sbend, type = "5D3.9", l = lbhs, angle = -abhs, hgap = gbh/2, e1 = 0, fint = fbh, fintx = 0
bcxh3b: sbend, type = "5D3.9", l = lbhl, angle = -abhl, hgap = gbh/2, fint = 0, e2 = -abh, fintx = fbh
bcxh4a: sbend, type = "5D3.9", l = lbhl, angle = +abhl, hgap = gbh/2, e1 = +abh, fint = fbh, fintx = 0
bcxh4b: sbend, type = "5D3.9", l = lbhs, angle = +abhs, hgap = gbh/2, fint = 0, e2 = 0, fintx = fbh

! define unsplit SBENs for BMAD ... not used by MAD

bcxh1: sbend, type = "5D3.9", hgap = gbh/2, l = lbh, angle = +abh, e1 = 0, fint = fbh, e2 = +abh, fintx = fbh
bcxh2: sbend, type = "5D3.9", hgap = gbh/2, l = lbh, angle = -abh, e1 = -abh, fint = fbh, e2 = 0, fintx = fbh
bcxh3: sbend, type = "5D3.9", hgap = gbh/2, l = lbh, angle = -abh, e1 = 0, fint = fbh, e2 = -abh, fintx = fbh
bcxh4: sbend, type = "5D3.9", hgap = gbh/2, l = lbh, angle = +abh, e1 = +abh, fint = fbh, e2 = 0, fintx = fbh

