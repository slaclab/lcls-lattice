kq0h05 = -6.486739294274 ! -7.451314362911 ! -7.50807265705  !
kq0h06 = 0.966024601548 !  1.835321162849 !  1.870908387703 !
kq0h07 = 7.974521691066 !  7.794364054297 !  7.804907479843 !
kq0h08 = -8.324215790715 ! -8.272683698332 ! -8.306722243052 !

q0h05: quadrupole, type = "2Q4", l = lqm/2, aperture = rqm, k1 = kq0h05
q0h06: quadrupole, type = "2Q4", l = lqm/2, aperture = rqm, k1 = kq0h06
q0h07: quadrupole, type = "2Q4", l = lqm/2, aperture = rqm, k1 = kq0h07
q0h08: quadrupole, type = "2Q4", l = lqm/2, aperture = rqm, k1 = kq0h08

! laser heater to diagnostic line

!              heater ON        heater OFF        chicane OFF
!           ---------------   ---------------   ---------------
kqhd01 = -9.165493466042 ! -8.743988180274 ! -8.746794738551 !
kqhd02 = 6.5393744713   !  6.400024201736 !  6.401620200766 !
kqhd03 = -8.445995045319 ! -8.612136472635 ! -8.622952974047 !
kqhd04 = 6.743451959252 !  6.860670404609 !  6.864937307631 !

qhd01: quadrupole, type = "2Q4", l = lqm/2, aperture = rqm, k1 = kqhd01
qhd02: quadrupole, type = "2Q4", l = lqm/2, aperture = rqm, k1 = kqhd02
