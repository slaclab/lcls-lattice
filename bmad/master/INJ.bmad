! ==============================================================================
! collimators, diagnostics, etc.
! ------------------------------------------------------------------------------

! halo/dark current collimator

pc0h00: ecollimator, l = ljaw, x_limit = 6.0e-3, y_limit = 6.0e-3, type = "tungsten"

! collimators
! (betatron X/Y half-gaps are 24/16 sigma for 1 um normalized emittance)

cehtr: rcollimator, l = ljaw, x_limit = 3.0e-3, type = "HCOLL"    !X momentum collimator
cyc01: rcollimator, l = ljaw, y_limit = 4.4e-3, type = "VCOLL"    !Y betatron collimator
cxc01: rcollimator, l = ljaw, x_limit = 4.4e-3, type = "HCOLL"    !X betatron collimator
CYC02: pipe, L = 0.06, type ="@4,VCOLL", descrip = "deferred RCOLLIMATOR" !Y betatron collimator
!old: cyc02: rcollimator, l = ljaw, y_limit = 4.4e-3, type = "@4,VCOLL"
CXC02: pipe, L = 0.06, type ="@4,HCOLL", descrip = "deferred RCOLLIMATOR" !X betatron collimator
!old: cxc02: rcollimator, l = ljaw, x_limit = 4.4e-3, type = "@4,HCOLL"
cyc03: rcollimator, l = ljaw, y_limit = 4.4e-3, type = "VCOLL"    !Y betatron collimator
cxc03: rcollimator, l = ljaw, x_limit = 4.4e-3, type = "HCOLL"    !X betatron collimator

! instruments

cathodeb: instrument
vv01b: instrument
im01b: marker, type = "ICT"
vv02b: instrument
ws0h04: marker, type = "fast"
bz0h04: monitor, type = "gap/diode"
yagh1: monitor, type = "YAG INJ"
yagh2: monitor, type = "YAG INJ"
imbcsi1: marker, type = "BCS ACM"
imbcsi2: marker, type = "BCS ACM"
WSC006: pipe, L = 0.0, type ="@4,fast", descrip = "deferred MARKER"
!old: wsc006: marker, type = "@4,fast"

fc00eic: instrument, type = "Faraday cup"

! combination YAG/collimator/Faraday Cup
! - beam pipe ID = 47.6 mm
! - one standard YAG crystal
! - one YAG crystal with a 6 mm diameter hole in it (for measuring beam halo)
! - four circular collimator bores
! - Faraday Cup

yag01b: monitor, type = "YAG" !with or without hole
yag01b_coll: ecollimator, type = "collimator" !bore: 12mm, 16mm, 20mm, or 24mm
yag01b_fcup: instrument, type = "Faraday Cup"
  YAG01B_full : LINE=(YAG01B,YAG01B_COLL,YAG01B_FCUP)

! combination OTR/YAG !PAL type

otr0h04: monitor, type = "OTR"
otr0h04_yag: monitor, type = "YAG"
  OTR0H04_full : LINE=(OTR0H04,OTR0H04_YAG)

otrc006: monitor, type = "OTR"
otrc006_yag: monitor, type = "YAG"
  OTRC006_full : LINE=(OTRC006,OTRC006_YAG)

! marker points

am00b: marker !gun laser injection mirror (MIR01)
blfu: marker !beamline flange
dp0h01: marker
dp0h02: marker
dp0h03: marker
lhbegb: marker
mirlhu: marker, type = "laser inj/ext"
htrundb: marker, type = "SCATTER"
mirlhd: marker, type = "laser inj/ext"
cnthtr: marker, type = "CENTER"
lhendb: marker

begeic: marker
ecueic: marker !u/s flange face
endeic: marker

