
! *** OPTICS=AD_ACCEL-14APR2025s ***

! ==============================================================================
! 07-JAN-2019, M. Woodley
!  * rename some LI21 correctors to avoid name conflicts with LCLS-II per
!    T. Maxwell
! ------------------------------------------------------------------------------
! 11-JAN-2007, P. Emma
!    Move QA11 a few mm as observed by alignment.
! 09-MAR-2006, P. Emma
!    Move SC11, SCA11, SCA12, and XC21202 and YC21203 per P. Stephens.
! 01-DEC-2005, P. Emma
!    Move XC21202 and YC21203 onto end of 21-1d.
! 29-NOV-2005, P. Emma
!    Add types for lcavity's.
! 09-NOV-2005, P. Emma
!    Use type-1 x/y corrector packages in L1-linac and relocate.
! 25-SEP-2005, P. Emma
!    Break L1 structure up to insert correctors at proper locations.
! ==============================================================================
! lcavitys
! ------------------------------------------------------------------------------
! the L1 linac consists of:   1 9.4  ft S-band sections @ 50% power
!                             1 9.4  ft S-band sections @ 25% power
!                             1 10   ft S-band sections @ 25% power
! ------------------------------------------------------------------------------

dlb1 = 0.200+0.253432
dlb2 = dlwl9-dlb1
k21_1b1: lcavity, rf_frequency = sbandf * 1e6, l = dlb1, voltage = p50*gradl1*dlb1 * 1e6, phi0 = phil1, type = "9.4ft",
          cavity_type = traveling_wave
k21_1b2: lcavity, rf_frequency = sbandf * 1e6, l = dlb2, voltage = p50*gradl1*dlb2 * 1e6, phi0 = phil1, type = "9.4ft",
          cavity_type = traveling_wave
dlc1 = 0.200+0.2534458
dlc2 = dlwl9-dlc1
k21_1c1: lcavity, rf_frequency = sbandf * 1e6, l = dlc1, voltage = p25*gradl1*dlc1 * 1e6, phi0 = phil1, type = "9.4ft",
          cavity_type = traveling_wave
k21_1c2: lcavity, rf_frequency = sbandf * 1e6, l = dlc2, voltage = p25*gradl1*dlc2 * 1e6, phi0 = phil1, type = "9.4ft",
          cavity_type = traveling_wave
dld1 = 0.200+0.1693348
dld3 = 0.300+0.167527-0.1799554
dld4 = 0.200+0.1799554
dld2 = dlwl10-dld1-dld3-dld4
k21_1d1: lcavity, rf_frequency = sbandf * 1e6, l = dld1, voltage = p25*gradl1*dld1 * 1e6, phi0 = phil1, type = "10ft",
          cavity_type = traveling_wave
k21_1d2: lcavity, rf_frequency = sbandf * 1e6, l = dld2, voltage = p25*gradl1*dld2 * 1e6, phi0 = phil1, type = "10ft",
          cavity_type = traveling_wave
k21_1d3: lcavity, rf_frequency = sbandf * 1e6, l = dld3, voltage = p25*gradl1*dld3 * 1e6, phi0 = phil1, type = "10ft",
          cavity_type = traveling_wave
k21_1d4: lcavity, rf_frequency = sbandf * 1e6, l = dld4, voltage = p25*gradl1*dld4 * 1e6, phi0 = phil1, type = "10ft",
          cavity_type = traveling_wave

! define unsplit lcavitys for BMAD ... not used by MAD

k21_1b: lcavity, rf_frequency = sbandf * 1e6, l = dlwl9, voltage = p50*gradl1*dlwl9 * 1e6, phi0 = phil1, type = "9.4ft",
          cavity_type = traveling_wave
k21_1c: lcavity, rf_frequency = sbandf * 1e6, l = dlwl9, voltage = p25*gradl1*dlwl9 * 1e6, phi0 = phil1, type = "9.4ft",
          cavity_type = traveling_wave
k21_1d: lcavity, rf_frequency = sbandf * 1e6, l = dlwl10, voltage = p25*gradl1*dlwl10 * 1e6, phi0 = phil1,
          type = "10ft", cavity_type = traveling_wave

! ==============================================================================
! BEAMLINEs
! ------------------------------------------------------------------------------

!---------------------
! K21_1B LCAVITY
K21_1B_full: line = (K21_1B)
! contains zero length elements:
    XC21101[superimpose] = T
    XC21101[ref] = K21_1B
    XC21101[ref_origin] = beginning
    XC21101[offset] = 0.453432
    YC21102[superimpose] = T
    YC21102[ref] = K21_1B
    YC21102[ref_origin] = beginning
    YC21102[offset] = 0.453432
!old:   K21_1b_full : LINE=(K21_1b1,XC21101,YC21102,K21_1b2)
!---------------------
! K21_1C LCAVITY
K21_1C_full: line = (K21_1C)
! contains zero length elements:
    XC21135[superimpose] = T
    XC21135[ref] = K21_1C
    XC21135[ref_origin] = beginning
    XC21135[offset] = 0.4534458
    YC21136[superimpose] = T
    YC21136[ref] = K21_1C
    YC21136[ref_origin] = beginning
    YC21136[offset] = 0.4534458
!old:   K21_1c_full : LINE=(K21_1c1,XC21135,YC21136,K21_1c2)
!---------------------
! K21_1D LCAVITY
K21_1D_full: line = (K21_1D)
! contains zero length elements:
    XC21165[superimpose] = T
    XC21165[ref] = K21_1D
    XC21165[ref_origin] = beginning
    XC21165[offset] = 0.3693348
    YC21166[superimpose] = T
    YC21166[ref] = K21_1D
    YC21166[ref_origin] = beginning
    YC21166[offset] = 0.3693348
    YC21174[superimpose] = T
    YC21174[ref] = K21_1D
    YC21174[ref_origin] = beginning
    YC21174[offset] = 2.376573
    XC21175[superimpose] = T
    XC21175[ref] = K21_1D
    XC21175[ref_origin] = beginning
    XC21175[offset] = 2.6641446
!old:   K21_1d_full : LINE=(K21_1d1,XC21165,YC21166,K21_1d2,YC21174,K21_1d3,XC21175,K21_1d4)

  QA11_full : LINE=(QA11,BPMA11,QA11)
  QA12_full : LINE=(QA12,BPMA12,QA12)

  L1 : LINE=(BEGL1,ZLIN01,K21_1b_full,DAQA1,QA11_full,DAQA2,K21_1c_full,DAQA3,QA12_full,DAQA4,K21_1d_full,ENDL1)

