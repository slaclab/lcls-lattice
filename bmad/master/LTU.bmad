spoilers: instrument           !TDKIKS dump spoiler (1 mm Ti)
tdkiks: instrument, l = 0.6096 !vertical off-axis in-line dump

ldbldl = 3.0 ! length of LTU doublet including drifts

wall: drift, l = 16.764 !length of muon wall
dwalla: drift, l = 1.840975 !distance from face of muon wall to face of BSY dump
dwallb: drift, l = wall[l]-dwalla[l]
ddbldlb: drift, l = 0.5 +(lqa-lqe)/2
ddbldlc: drift, l = 0.4
ddbldld: drift, l = (lqa-lqe)/2
ddbldla: drift, l = 0.5*(ldbldl-2*lqe-ddbldlb[l]-2*ddbldlc[l]-ddbldld[l]-ljaw)
ddbldla1: drift, l = 0.654660
ddbldla2: drift, l = 2*ddbldla[l]-ddbldla1[l]

ldlcel = 25.5
ldl6b = 0.4
ldl0a = ldlcel/2-lqa-ldl6b
ldl0b = ldlcel/2-lqa-ldl6b+(lqa-lqr)
ldl0ba = 0.1953
ldl0bb = 3.213005+(lqa-lqr)/2-ldl0ba
ldl0bc = ldl0b-ldl0ba-ldl0bb
ldl1b = 2.9815+(lqa-lqr)/2
