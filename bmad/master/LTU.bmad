dcy32: drift, l = 0.08
dcy36: drift, l = 0.08

 !CX31 : RCOL, L=0.08 !LCLS collimator removed
 !CX35 : RCOL, L=0.08 !reconfigured as CXQT22
 !CY32 : RCOL, L=0.08 !reconfigured as CYBX32
 !CY36 : RCOL, L=0.08 !reconfigured as CYBX36

dbmark36: marker !center of WS31



!Old split line: line = (qem1, bpmem1, qem1)

qem1_full: line = (qem1)
qem1[L] = 2*qem1[L]
bpmem1[superimpose] = T
bpmem1[ref] = qem1


!Old split line: line = (qem2, bpmem2, qem2)

