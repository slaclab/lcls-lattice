        , ddbldlc, qdbl2_full, ddbldld)

dl2sc: line = (dbmark34b, ddl20b, xcdl11, ddl6b, qdl11_full, ddl15ba, bpmdl11, ddl15bb, ddl15bc,  &
        cc31b, ddl16b, bx31b_full, ddl1ba, pc01b, btm01b, ddl1bb, bpmdl12, ddl1bc, qdl12_full,  &
        ddl6b, ycdl12, ddl9b, xcdl13, ddl6ba, sdl1_full, ddl6bb, qdl13_full, ddl7ba, cedl13,  &
        ddl7bb, bpmdl13, ddl8b, ycdl14, ddl6b, qdl14_full, ddl8ca, bpmdl14, ddl8cb, dwigsa, pc03b &
        , btm03b, dwigsb, ddl8d, xcdl15, ddl6ba, sdl2_full, ddl6bb, qdl15_full, ddl0ba, bpmdl15,  &
        ddl0bb, ddl0bc, ycdl16, ddl6b, qdl16_full, dbyks01, cydl16, dbyks02, bpmdl16, dbyks03,  &
        pc04b, btm04b, dbyks04, bykik1s_full, dbyks05, dbyks05, bykik2s_full, dbyks06, xcdl17,  &
        dbyks07, bpmdl17, dbyks08, qdl17_full, dbyks11, cedl17, dbyks12, dbyks13, spoilers,  &
        dbyks14, tdkiks, dbyks15, pctdkik1s, dbyks16, pctdkik2s, dbyks16, pctdkik3s, dbyks16,  &
        pctdkik4s, dbyks17, otrdl18, dbyks18, ycdl18, dbyks19, qdl18_full, ddl19ba, bpmdl18,  &
        ddl19bb, pc06b, btm06b, ddl19bc, xcdl19, ddl6b, qdl19_full, ddl2ba, bpmdl19, ddl2bb,  &
        bx32b_full, cntlt1s, ddl14b, qdl20_full, ddl6b, ycdl20, ddl17b, cc32b, ddl18ba, pc07b,  &
