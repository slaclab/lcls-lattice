!=!  COMMENT !test line to find ABYKIKS angle for -14.2 mm offset at front face of TDKIKS
!=!  COMMENT !test line to find ABYKIKS angle for -14.2 mm offset at front face of TDKIKS
!=!ABYKIKS = 0.889371410732E-3
!=!    KYKIK1S : VKIC, L=LKIKS/2, KICK=-ABYKIKS/4
!=!    KYKIK2S : VKIC, L=LKIKS/2, KICK=-ABYKIKS/4
!=!    KYKIK1S_full : LINE=(KYKIK1S,KYKIK1S)
!=!    KYKIK2S_full : LINE=(KYKIK2S,KYKIK2S)
!=!    TESTBYKIKS : LINE=(&
!=!      KYKIK1S_full,DBYKS05,DBYKS05,&
!=!      KYKIK2S_full,DBYKS06,XCDL17,DBYKS07,BPMDL17,DBYKS08,&
!=!      QDL17_full,DBYKS11,CEDL17,DBYKS12,BTM05B,DBYKS13,SPOILERS,DBYKS14)
!=!    USE, TESTBYKIKS
!=!    MATCH, BETX=10, BETY=10, ORBIT
!=!      VARY, ABYKIKS, STEP=1.E-6
!=!      CONSTR, #E, Y=-14.2E-3
!=!     !LMDIF, TOL=1.E-20
!=!     !MIGRAD, TOL=1.E-20
!=!    ENDMATCH
!=!    VALUE, ABYKIKS
!=!    SELECT, OPTICS, FULL
!=!    OPTICS, BETX=10, BETY=10, COLUMNS=NAME,S,L,Y,PY
!=!    STOP
!=!  ENDCOMMENT

! ------------------------------------------------------------------------------
! SXR VBEND
! ------------------------------------------------------------------------------

kqvbb = -2.509359002417
kqvm3b = 0.953555362463
kqvm4b = -1.16254158193

qvb1b: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqvbb
qvb2b: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = -kqvbb
qvb3b: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqvbb
qvm3b: quadrupole, type = "1.26Q12", l = lqa/2, aperture = rqa, k1 = kqvm3b
qvm4b: quadrupole, type = "1.26Q12", l = lqa/2, aperture = rqa, k1 = kqvm4b

s100_pitch = -4.760000e-3
s100_height = 77.643680
z_s100_undh = 583.000000
r_earth = 6.372508025e6

lvb = 1.025      !3D39 vertical bend effective length (m)
gvb = 0.034925   !gap width (m)
avb = (s100_pitch+asin(z_s100_undh/(r_earth+s100_height)))/2 !bend up twice this angle so e- is level in cnt. of und.

by1b1: sbend, hgap = gvb/2, e1 = avb/2, fint = 0.5, fintx = 0, type = "3D39", ref_tilt = pi/2, l &
         = lvb/2, angle = lvb/2 * avb/2/(lvb/2)
by1b2: sbend, hgap = gvb/2, e2 = avb/2, fint = 0, fintx = 0.5, type = "3D39", ref_tilt = pi/2, l &
         = lvb/2, angle = lvb/2 * avb/2/(lvb/2)
by2b1: sbend, hgap = gvb/2, e1 = avb/2, fint = 0.5, fintx = 0, type = "3D39", ref_tilt = pi/2, l &
         = lvb/2, angle = lvb/2 * avb/2/(lvb/2)
by2b2: sbend, hgap = gvb/2, e2 = avb/2, fint = 0, fintx = 0.5, type = "3D39", ref_tilt = pi/2, l &
         = lvb/2, angle = lvb/2 * avb/2/(lvb/2)

