! ------------------------------------------------------------------------------
! SXR R56 compensating chicanes
! - use series approximation for sinc(x)=sin(x)/x to allow zero field
! ------------------------------------------------------------------------------

! Brhof  : beam rigidity at chicane (kG-m)
! GBCC   : gap height (m)
! ZBCC   : magnet Z-length along axis (m)
! ZDCC   : Z-space between magnets (m)
! BBX..  : chicane bend field (kG) at 4 GeV
! ABX..  : chicane bend angle (rad)
! LBX..  : chicane bend path length (m)
! ABX..S : "short" half chicane bend angle (rad)
! ABX..L : "long" half chicane bend angle (rad)
! LBX..S : "short" half chicane bend path length (m)
! LBX..L : "long" half chicane bend path length (m)

bbx31b = 5.0450 *ef/4.0 *1.15
arg31b = zbcc*bbx31b/brhof
abx31b = asin(arg31b)
abx31b_2 = abx31b*abx31b
abx31b_4 = abx31b_2*abx31b_2
abx31b_6 = abx31b_4*abx31b_2
sinc31b = 1-abx31b_2/6+abx31b_4/120-abx31b_6/5040
lbx31b = zbcc/sinc31b
abx31bs = asin(arg31b/2)
abx31bs_2 = abx31bs*abx31bs
abx31bs_4 = abx31bs_2*abx31bs_2
abx31bs_6 = abx31bs_4*abx31bs_2
sinc31bs = 1-abx31bs_2/6+abx31bs_4/120-abx31bs_6/5040
lbx31bs = zbcc/(2*sinc31bs)
abx31bl = abx31b-abx31bs
lbx31bl = lbx31b-lbx31bs

bcx31b11: sbend, type = "0.788D11.50", l = lbx31bs, angle = +abx31bs, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0
bcx31b12: sbend, type = "0.788D11.50", l = lbx31bl, angle = +abx31bl, e2 = +abx31b, hgap = gbcc/2, fint = 0, fintx = fbcc
bcx31b21: sbend, type = "0.788D11.50", l = lbx31bl, angle = -abx31bl, e1 = -abx31b, hgap = gbcc/2, fint = fbcc, fintx = 0
bcx31b22: sbend, type = "0.788D11.50", l = lbx31bs, angle = -abx31bs, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc
bcx31b31: sbend, type = "0.788D11.50", l = lbx31bs, angle = -abx31bs, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0
bcx31b32: sbend, type = "0.788D11.50", l = lbx31bl, angle = -abx31bl, e2 = -abx31b, hgap = gbcc/2, fint = 0, fintx = fbcc
bcx31b41: sbend, type = "0.788D11.50", l = lbx31bl, angle = +abx31bl, e1 = +abx31b, hgap = gbcc/2, fint = fbcc, fintx = 0
bcx31b42: sbend, type = "0.788D11.50", l = lbx31bs, angle = +abx31bs, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc

! define unsplit SBENs for BMAD ... not used by MAD

bcx31b1: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbx31b, angle = +abx31b, e1 = 0, fint = fbcc, e2 = +abx31b,
          fintx = fbcc
bcx31b2: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbx31b, angle = -abx31b, e1 = -abx31b, fint = fbcc, e2 = 0,
          fintx = fbcc
bcx31b3: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbx31b, angle = -abx31b, e1 = 0, fint = fbcc, e2 = -abx31b,
          fintx = fbcc
bcx31b4: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbx31b, angle = +abx31b, e1 = +abx31b, fint = fbcc, e2 = 0,
          fintx = fbcc

dcc31bo: drift, l = zdcc/cos(abx31b), type = "CSR"
dcc31bi: drift, l = zdcc, type = "CSR"

cc31bbeg: marker
cc31bend: marker



!Old split line:  BCX31B1_full : LINE=(BCX31B11,BCX31B12)

bcx31b1_full: line = (bcx31b1)


!Old split line:  BCX31B2_full : LINE=(BCX31B21,BCX31B22)

bcx31b2_full: line = (bcx31b2)


!Old split line:  BCX31B3_full : LINE=(BCX31B31,BCX31B32)

bcx31b3_full: line = (bcx31b3)


!Old split line:  BCX31B4_full : LINE=(BCX31B41,BCX31B42)

bcx31b4_full: line = (bcx31b4)

  CC31B   : LINE=(CC31BBEG,BCX31B1_full,DCC31Bo,BCX31B2_full,DCC31Bi,BCX31B3_full,DCC31Bo,BCX31B4_full,CC31BEND)

bbx32b = 5.0450 *ef/4.0 *1.15
arg32b = zbcc*bbx32b/brhof
abx32b = asin(arg32b)
abx32b_2 = abx32b*abx32b
abx32b_4 = abx32b_2*abx32b_2
abx32b_6 = abx32b_4*abx32b_2
sinc32b = 1-abx32b_2/6+abx32b_4/120-abx32b_6/5040
lbx32b = zbcc/sinc32b
abx32bs = asin(arg32b/2)
abx32bs_2 = abx32bs*abx32bs
abx32bs_4 = abx32bs_2*abx32bs_2
abx32bs_6 = abx32bs_4*abx32bs_2
sinc32bs = 1-abx32bs_2/6+abx32bs_4/120-abx32bs_6/5040
lbx32bs = zbcc/(2*sinc32bs)
abx32bl = abx32b-abx32bs
lbx32bl = lbx32b-lbx32bs

bcx32b11: sbend, type = "0.788D11.50", l = lbx32bs, angle = +abx32bs, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0
bcx32b12: sbend, type = "0.788D11.50", l = lbx32bl, angle = +abx32bl, e2 = +abx32b, hgap = gbcc/2, fint = 0, fintx = fbcc
bcx32b21: sbend, type = "0.788D11.50", l = lbx32bl, angle = -abx32bl, e1 = -abx32b, hgap = gbcc/2, fint = fbcc, fintx = 0
bcx32b22: sbend, type = "0.788D11.50", l = lbx32bs, angle = -abx32bs, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc
bcx32b31: sbend, type = "0.788D11.50", l = lbx32bs, angle = -abx32bs, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0
bcx32b32: sbend, type = "0.788D11.50", l = lbx32bl, angle = -abx32bl, e2 = -abx32b, hgap = gbcc/2, fint = 0, fintx = fbcc
bcx32b41: sbend, type = "0.788D11.50", l = lbx32bl, angle = +abx32bl, e1 = +abx32b, hgap = gbcc/2, fint = fbcc, fintx = 0
bcx32b42: sbend, type = "0.788D11.50", l = lbx32bs, angle = +abx32bs, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc

! define unsplit SBENs for BMAD ... not used by MAD

bcx32b1: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbx32b, angle = +abx32b, e1 = 0, fint = fbcc, e2 = +abx32b,
          fintx = fbcc
bcx32b2: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbx32b, angle = -abx32b, e1 = -abx32b, fint = fbcc, e2 = 0,
          fintx = fbcc
bcx32b3: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbx32b, angle = -abx32b, e1 = 0, fint = fbcc, e2 = -abx32b,
          fintx = fbcc
bcx32b4: sbend, type = "0.788D11.50", hgap = gbcc/2, l = lbx32b, angle = +abx32b, e1 = +abx32b, fint = fbcc, e2 = 0,
          fintx = fbcc

dcc32bo: drift, l = zdcc/cos(abx32b), type = "CSR"
dcc32bi: drift, l = zdcc, type = "CSR"

cc32bbeg: marker
cc32bend: marker



!Old split line:  BCX32B1_full : LINE=(BCX32B11,BCX32B12)

bcx32b1_full: line = (bcx32b1)


!Old split line:  BCX32B2_full : LINE=(BCX32B21,BCX32B22)

bcx32b2_full: line = (bcx32b2)


!Old split line:  BCX32B3_full : LINE=(BCX32B31,BCX32B32)

bcx32b3_full: line = (bcx32b3)


!Old split line:  BCX32B4_full : LINE=(BCX32B41,BCX32B42)

bcx32b4_full: line = (bcx32b4)

  CC32B   : LINE=(CC32BBEG,BCX32B1_full,DCC32Bo,BCX32B2_full,DCC32Bi,BCX32B3_full,DCC32Bo,BCX32B4_full,CC32BEND)

! ------------------------------------------------------------------------------
! wiggler for sync. light energy diagnostic (described in SLAC-PUB-3945)
! based on FACET optics model (M. Woodley)
! (series approximation for sinc(x)=sin(x)/x to enable setting with x=0)
! ------------------------------------------------------------------------------

gwig = 0.02032       !gap height
zwhp = 0.244         !half-pole Z length
zdwg = 0.126525      !pole-to-pole Z spacing
zwig = 4*zwhp+2*zdwg !total wiggler Z length

bwgs = 0                       !wiggler bend field (kG)
awgs = asin(bwgs*zwhp/(ef*cb)) !bend angle per half-pole
awgs2 = awgs*awgs
awgs4 = awgs2*awgs2
awgs6 = awgs4*awgs2
sincs = 1-awgs2/6+awgs4/120-awgs6/5040
lwgs = zwhp/sincs              !half-pole path length

awg1s = asin(sin(awgs)/2) !"short half" half-pole bend angle
awg1s2 = awg1s*awg1s
awg1s4 = awg1s2*awg1s2
awg1s6 = awg1s4*awg1s2
sinc1s = 1-awg1s2/6+awg1s4/120-awg1s6/5040
lwg1s = (zwhp/2)/sinc1s   !"short half" half-pole path length

awg2s = awgs-awg1s        !"long half" half-pole bend angle
lwg2s = lwgs-lwg1s        !"long half" half-pole path length

wig1s1: sbend, type = "@3,SLC wiggler", l = lwg1s, hgap = gwig/2, angle = awg1s, e1 = 0, e2 = 0, fint = 0.5, fintx = 0,
          ref_tilt = pi/2
wig1s2: sbend, type = "@3,SLC wiggler", l = lwg2s, hgap = gwig/2, angle = awg2s, e1 = 0, e2 = awgs, fint = 0,
          fintx = 0.5, ref_tilt = pi/2
wig2s1: sbend, type = "@3,SLC wiggler", l = lwgs, hgap = gwig/2, angle = -awgs, e1 = -awgs, e2 = 0, fint = 0.5,
          fintx = 0, ref_tilt = pi/2
wig2s2: sbend, type = "@3,SLC wiggler", l = lwgs, hgap = gwig/2, angle = -awgs, e1 = 0, e2 = -awgs, fint = 0,
          fintx = 0.5, ref_tilt = pi/2
wig3s1: sbend, type = "@3,SLC wiggler", l = lwg2s, hgap = gwig/2, angle = awg2s, e1 = awgs, e2 = 0, fint = 0.5,
          fintx = 0, ref_tilt = pi/2
wig3s2: sbend, type = "@3,SLC wiggler", l = lwg1s, hgap = gwig/2, angle = awg1s, e1 = 0, e2 = 0, fint = 0, fintx = 0.5,
          ref_tilt = pi/2

! define unsplit SBENs for BMAD ... not used by MAD

wig1s: sbend, type = "@3,SLC wiggler", hgap = gwig/2, l = lwgs, angle = +awgs, e1 = 0, fint = 0.5, e2 = +awgs,
          fintx = 0.5, ref_tilt = pi/2
wig2s: sbend, type = "@3,SLC wiggler", hgap = gwig/2, l = 2*lwgs, angle = -2*awgs, e1 = -awgs, fint = 0.5, e2 = -awgs,
          fintx = 0.5, ref_tilt = pi/2
wig3s: sbend, type = "@3,SLC wiggler", hgap = gwig/2, l = lwgs, angle = +awgs, e1 = +awgs, fint = 0.5, e2 = 0,
          fintx = 0.5, ref_tilt = pi/2

ldwgs = zdwg/cos(awgs)

dwgs: drift, l = ldwgs

ycwigs: vkicker, type = "@3,wiggler trim"

cntwigs: marker, type = "CENTER" !ELEGANT will correct the orbit here for CSR-steering



!Old split line:  WIG1S_full : LINE=(WIG1S1,WIG1S2)

wig1s_full: line = (wig1s)


!Old split line:  WIG2S_full : LINE=(WIG2S1,YCWIGS,WIG2S2)

wig2s_full: line = (wig2s)
ycwigs[superimpose] = T
ycwigs[ref] = wig2s


!Old split line:  WIG3S_full : LINE=(WIG3S1,WIG3S2)

wig3s_full: line = (wig3s)

  EWIGS : LINE=(WIG1S_full,DWGs,WIG2S_full,DWGs,WIG3S_full,CNTWIGS)

! replace deferred wiggler with a drift

dwigs: drift, l = zwig
dwigsa: drift, l = 1.135414
dwigsb: drift, l = dwigs[l]-dwigsa[l]-lplate

! ------------------------------------------------------------------------------
! SXR dogleg
! ------------------------------------------------------------------------------

! note: the K-values below are for SC beam; the settings for Cu beam are
! in the "LCLS2cu_main.mad8" file

kqdbl1 = -0.050357218829 !-0.050357323411
kqdbl2 = -0.559361220066 !-0.559361105837

qdbl1: quadrupole, type = "1.085Q4.31", l = lqe/2, k1 = kqdbl1, aperture = rqe
qdbl2: quadrupole, type = "1.085Q4.31", l = lqe/2, k1 = kqdbl2, aperture = rqe

kqdlb = 0.424676241757
kqdl11 = kqdlb

qdl11: quadrupole, type = "2Q10", l = lqr/2, k1 = kqdl11, aperture = rqr !reserve separate PS
qdl12: quadrupole, type = "2Q10", l = lqr/2, k1 = -kqdlb, aperture = rqr
qdl13: quadrupole, type = "2Q10", l = lqr/2, k1 = kqdlb, aperture = rqr
qdl14: quadrupole, type = "2Q10", l = lqr/2, k1 = -kqdlb, aperture = rqr
qdl15: quadrupole, type = "2Q10", l = lqr/2, k1 = kqdlb, aperture = rqr
qdl16: quadrupole, type = "2Q10", l = lqr/2, k1 = -kqdlb, aperture = rqr
qdl17: quadrupole, type = "2Q10", l = lqr/2, k1 = kqdlb, aperture = rqr
qdl18: quadrupole, type = "2Q10", l = lqr/2, k1 = -kqdlb, aperture = rqr
qdl19: quadrupole, type = "2Q10", l = lqr/2, k1 = kqdlb, aperture = rqr

kqdl20 = -0.487749576014
kqdl21 = -1.904149676641
