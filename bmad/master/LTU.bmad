! ------------------------------------------------------------------------------
! HXR BSY downstream of the merge bend
! ------------------------------------------------------------------------------

! note: the K-values below are for SC beam; the settings for Cu beam are
! in the "LCLS2cu_main.mad8" file

kq50q3 = 0.434154040462
kq4 = -0.217498744833
kq5 = 0.110634649191
kq6 = -0.107282100403
kqa0 = 0.096403505318

q50q3: quadrupole, type = "50Q3", l = 0.143254, aperture = 0.010325, k1 = kq50q3
q4: quadrupole, type = "0.91Q17.72", l = lqf/2, aperture = rqf, k1 = kq4
q5: quadrupole, type = "0.91Q17.72", l = lqf/2, aperture = rqf, k1 = kq5
q6: quadrupole, type = "0.91Q17.72", l = lqf/2, aperture = rqf, k1 = kq6
qa0: quadrupole, type = "0.91Q17.72", l = lqf/2, aperture = rqf, k1 = kqa0

cxq6: rcollimator, x_limit = 1.7e-3, y_limit = 20.e-3, type = "HCOLL", l = ljaw

pcbsy3: instrument, type = "BCS plate", l = lplate !shielding plate
pcbsy4: instrument, type = "BCS plate", l = lplate !shielding plate
pcbsy5: instrument, type = "BCS plate", l = lplate !shielding plate

lpc90 = 0.453644
lpc119 = 0.453644

pc90: ecollimator, x_limit = 10.2e-3, y_limit = 10.2e-3, l = lpc90 !existing protection collimator in BSY
pc119: ecollimator, x_limit = 10.2e-3, y_limit = 10.2e-3, l = lpc119 !existing protection collimator in BSY

! 2" ID BSY collimator -- part of 2-hole copper collimator d/s of A-line pulsed magnets

pcbsyh: ecollimator, x_limit = 25.4e-3, y_limit = 25.4e-3, type = "@1,MPS PC", l = 0.45

dm3: drift, l = 0.8438 !0.2196
dm4a: drift, l = 0.4410 !0.2114
dm4c: drift, l = 0.331133-ljaw/2
dm4d: drift, l = 1.168867-ljaw/2
dm4da: drift, l = 0.27685 !0.2832
dm4db: drift, l = dm4d[l]-dm4da[l]-lplate
dm4b: drift, l = 8.851641-dm4a[l]-dm4c[l]-dm4d[l]-ljaw-2.0+0.282226 !8.622041
dxca0: drift, l = 0.31
dyca0: drift, l = 0.509021 !0.279421
dm5: drift, l = 0.790979 !0.561379
dm6: drift, l = 0.567588
dmoni: drift, l = 0.009525

zq5 = 0.0 !adjust position of Q5
zq6 = 0.0 !adjust position of Q6

dbsy52d: drift, l = 0.5
dbsy53a: drift, l = 0.091696
dbsy53b: drift, l = 0.760705-0.15
dbsy53c: drift, l = 0.629945+0.15
dbsy53f: drift, l = 0.5
dbsy53d: drift, l = 4.0-dbsy53a[l]-dbsy53b[l]-dbsy53c[l]-dbsy53f[l]
dbsy53g: drift, l = 1.2
dbsy53ga: drift, l = 0.91293 !0.91928
dbsy53gb: drift, l = dbsy53g[l]-dbsy53ga[l]-lplate
dbsy53h: drift, l =  &
        34.45562-dbsy53g[l]-zbkrapm1-zbkrapm2-zbkrapm3-zbkrapm4-2*ldzapm1-2*ldzapm2-2*ldzapm3-ldzapm4-ldza01-ldza02-pcbsyh[l]-lpcapm1-lpcapm2-lpcapm3-lpcapm4+zq5

dbsy54a: drift, l = 0.5
dbsy54b: drift, l = 3.22454-zq5
dbsy54c: drift, l = 19.260056-dbsy54a[l]-dbsy54b[l]-zq5+zq6
dbsy55a: drift, l = 0.5
dbsy55b: drift, l = 4.226742
dbsy55c: drift, l = 8.016028-zq6 !8.022378
dbsy55d: drift, l = 6.466828 !6.473178
dbsy55e: drift, l =  & !21.432164
        21.826764-drfb[l]-dbsy55a[l]-dbsy55b[l]-lpc90-dbsy55c[l]-lplate-dbsy55d[l]-lpc119-zq6

bpmbsyq3: instrument, type = "Stripline-6" !per C. Iverson
rfbbsyq3: instrument, type = "@2,CavityS-1"
bpmbsyq4: instrument, type = "Stripline-7"
bpmbsyq5: instrument, type = "Stripline-7" !per C. Iverson
bpmbsyq6: instrument, type = "Stripline-7" !per C. Iverson
rfbbsyq6: instrument, type = "@2,CavityS-1"
bpmbsyqa0: instrument, type = "Stripline-7" !per C. Iverson

xcbsyq3: kicker, type = "class-4" !barcode=4602
xcbsyq5: kicker, type = "class-4" !barcode=2100
xca0: kicker, type = "class-4" !barcode=2195

ycbsyq4: kicker, type = "class-4" !barcode=4603
ycbsyq6: kicker, type = "class-4" !barcode=2107
yca0: kicker, type = "class-4" !barcode=2195

d2: instrument, type = "PPS stopper", l = 0.43 !stopper
st60: instrument, type = "PPS stopper", l = 0.76 !backup stopper
dm60: instrument, type = "PPS BTM"             !"disaster" BTM behind ST60
st61: instrument, type = "PPS stopper", l = 0.76 !backup stopper

bsyend: marker !FFTB side of muon plug wall: Z=3224.022426 (Z'=176.020508 m, X'=0.0 m, Y'=-0.821761 m)
dumpbsyh: marker !front face of BSY dump for HXR beam
muwall: marker !front face of muon wall for HXR beam
mrgaline: marker !merge point with A-line
rwwake3h: marker, type = "WAKE" !BSY/SPRDH beampipe wake applied here



!Old split line: line = (q50q3, q50q3)

q50q3_full: line = (q50q3)
q50q3[L] = 2*q50q3[L]


!Old split line: line = (q4, bpmbsyq4, q4)

q4_full: line = (q4)
q4[L] = 2*q4[L]
bpmbsyq4[superimpose] = T
bpmbsyq4[ref] = q4


!Old split line: line = (q5, bpmbsyq5, q5)

q5_full: line = (q5)
q5[L] = 2*q5[L]
bpmbsyq5[superimpose] = T
bpmbsyq5[ref] = q5


