mimbcs4: marker

btm1l: instrument !Burn-Through-Monitor behind PCPM1L
btm2l: instrument !Burn-Through-Monitor behind PCPM2L
dumpface: instrument !entrance face of main e- dump
btmdump: instrument !Burn-Through-Monitor of main e- dump

mqdmp: marker
dmpend: marker
dbmark38: marker !end of final undulator dump

arodmp1h = -arodmp1s
arodmp2h = -arodmp2s

rodmp1h: patch, tilt = arodmp1h
rodmp2h: patch, tilt = arodmp2h

dumpline: line = (begdmph_2, rodmp1h, bydsha, bydshb, ds1, byd1a, byd1b, ds, byd2a, byd2b, ds,  &
        byd3a, byd3b, dd1a, pcpm1l, btm1l, dd1b, mimdump, dd1c, mimbcs4, dd1d, ycdd, dd1e, pcpm2l &
        , btm2l, dd1f, qdmp1, qdmp1, dd12a, bpmqd, dd12b, mqdmp, dd12c, qdmp2, qdmp2, dd2a, xcdd &
        , dd2b, dd2c, dd3a, bpmdd, dd3b, otrdmp, dwsdumpa, rfbdd, dwsdumpb, wsdump, dwsdumpc,  &
        rodmp2h, dumpface, ddump, dmpend, btmdump, dbmark38, enddmph_2)

