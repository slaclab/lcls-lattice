abx32l = abx32-abx32s
lbx32l = lbx32-lbx32s

bcx3211: sbend, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l = lbx32s,  &
        angle = lbx32s * (+abx32s)/lbx32s
bcx3212: sbend, e2 = +abx32, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l =  &
        lbx32l, angle = lbx32l * (+abx32l)/lbx32l
bcx3221: sbend, e1 = -abx32, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l =  &
        lbx32l, angle = lbx32l * (-abx32l)/lbx32l
bcx3222: sbend, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l = lbx32s,  &
        angle = lbx32s * (-abx32s)/lbx32s
bcx3231: sbend, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l = lbx32s,  &
        angle = lbx32s * (-abx32s)/lbx32s
bcx3232: sbend, e2 = -abx32, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l =  &
        lbx32l, angle = lbx32l * (-abx32l)/lbx32l
bcx3241: sbend, e1 = +abx32, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l =  &
        lbx32l, angle = lbx32l * (+abx32l)/lbx32l
bcx3242: sbend, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l = lbx32s,  &
        angle = lbx32s * (+abx32s)/lbx32s

