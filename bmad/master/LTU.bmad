vbendb: line = (vbinb, by1ba, by1bb, dvb1b, qvb1b, bpmvb1b, qvb1b, d40cmc, ycvb1b, dvb2m80cmb,  &
        xcvb2b, d40cmc, qvb2b, bpmvb2b, qvb2b, dvb2b, qvb3b, bpmvb3b, qvb3b, d40cmc, ycvb3b,  &
        dvb1m40cmba, btm09b, dvb1m40cmbb, by2ba, by2bb, cntlt2s, vboutb)

vbsysb: line = (dycvm1, dqvm1, drqvm1, drqvm1, dqvm2ba, btm08b, dqvm2bb, drqvm2, drqvm2, dxcvm2,  &
        dvb25cm, vbendb, dvb25cmcb, xcvm3b, d25cm, qvm3b, bpmvm3b, qvm3b, dvbem25cmb, ycvm4b,  &
        d25cm, qvm4b, bpmvm4b, qvm4b, dvbem15cmb, d10cmb, d25cma)

