! ------------------------------------------------------------------------------
! HXR undulator match
! ------------------------------------------------------------------------------

! note: the below K-values are for SC beam; the settings for Cu beam are
!       in the "LCLS2cu_main.mad8" file

! note: the below K-values come from Y. Nosochkov's UNDH_KQ4_USDS.xsif file,
!       for E= 4.0 GeV and KHXU= 2.0 (IntgHX= 30.0 kG)

kqum1 = 0.217807105099
kqum2 = -0.260867145661
kqum3 = 0.462571229525
kqum4 = -0.415827146064

qum1: quadrupole, type = "1.26Q12", l = lqa/2, k1 = kqum1, aperture = rqa
qum2: quadrupole, type = "1.26Q12", l = lqa/2, k1 = kqum2, aperture = rqa
qum3: quadrupole, type = "1.26Q12", l = lqa/2, k1 = kqum3, aperture = rqa
qum4: quadrupole, type = "1.26Q12", l = lqa/2, k1 = kqum4, aperture = rqa

du1m80cma: drift, l = 0.16515
du1m80cmb: drift, l = du1m80cm[l]-du1m80cma[l]
d32cmc: drift, l = 0.30046
du2m120cm: drift, l = 4.730
dw2tdund: drift, l = 0.201537 !drift from BTH/UH wall-2 to TDUNDB u/s flange
d40cmwb: drift, l = 0.140042
d40cmwa: drift, l = d40cmw[l]-d40cmwb[l]

bpmum1: monitor, type = "Stripline-10"
bpmum2: monitor, type = "Stripline-10"
bpmum3: monitor, type = "Stripline-10"
bpmum4: monitor, type = "Stripline-10"

rfb07: monitor, type = "CavityX-1" !existing LCLS device
rfb08: monitor, type = "CavityX-1" !existing LCLS device

imundi: marker, type = "120Hz toroid" !FEL-undulator input toroid (existing LCLS device)

xcum1: hkicker, type = "class-4f" !fast-feedback (loop-5)
xcum3: hkicker, type = "class-4f" !fast-feedback (loop-5)

ycum2: vkicker, type = "class-4f" !fast-feedback (loop-5)
ycum4: vkicker, type = "class-4f" !fast-feedback (loop-5)

! Note: PCMUON is rolled 90 degree to have X-aperture smaller than Y-aperture
!       X-aperture violates standard BSC -- approved by P. Emma

 !PCMUON : ECOL,L=1.1684,XSIZE=8.64E-3/2,YSIZE=4.32E-3/2 !original muon scattering collimator after pre-undulator tune-up dump (ID from Rago: 7/18/08)
pcmuon: ecollimator, l = 1.1684, x_limit = 4.32e-3/2, y_limit = 8.64e-3/2 !90 deg rolled muon scattering collimator

tdund: instrument !LTU insertable block at und. extension entrance (w/ screen)

mm1: marker
mm2: marker
mm3: marker
eoblm: marker !future electro-optic bunch length monitor?
bltof: monitor !LTUH (gas-jet time-of-flight bunch length monitor)
muhwall1: marker !upstream end of BTH/UH wall-1
muhwall2: marker !upstream end of BTH/UH wall-2
vv999: marker, type = "installed" !new vacuum valve just upbeam of undulator
pfilt1: marker
dbmark37: marker !end of undulator match
rwwake4h: marker, type = "WAKE" !LTUH beampipe wake applied here



