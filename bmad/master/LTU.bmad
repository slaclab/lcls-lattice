! ------------------------------------------------------------------------------
! SXR dumpline
! ------------------------------------------------------------------------------

kqdmpb = -0.154946553294 !Yuri (E=4.0, K=5.0)

qdmp1b: quadrupole, type = "3.94Q17", l = lqp/2, k1 = kqdmpb, aperture = rqp
qdmp2b: quadrupole, type = "3.94Q17", l = lqp/2, k1 = kqdmpb, aperture = rqp

lbyds = 0.5   !effective straight length of dump soft bend 1.26D18.43
gbyds = 0.032 !full gap of dump soft bend
abyds = 6.e-4
leffbyds = lbyds*abyds/(2*sin(abyds/2)) !bend path length (m)

bydss1: sbend, type = "1.26D18.43", l = leffbyds/2, angle = abyds/2, hgap = gbyds/2, e1 = abyds/2, e2 = 0, fint = 0.5,
          fintx = 0, ref_tilt = pi/2
bydss2: sbend, type = "1.26D18.43", l = leffbyds/2, angle = abyds/2, hgap = gbyds/2, e1 = 0, e2 = abyds/2, fint = 0,
          fintx = 0.5, ref_tilt = pi/2

! define unsplit SBENs for BMAD ... not used by MAD

bydss: sbend, type = "1.26D18.43", hgap = gbyds/2, l = leffbyds, angle = abyds, e1 = abyds/2, fint = 0.5, e2 = abyds/2,
          fintx = 0.5, ref_tilt = pi/2

lbdm = 1.452  !effective straight bend length of main dump bends - from J. Tanabe (m)
gbdm = 0.043  !full gap (m) of main dump bends (SA-380-328-03 shows magnet half-gap = 0.866")
fbdm = 0.5513 !measured FINT
abdm = 0.02240073511             !angle per main dump bend (rad)
leffbdm = lbdm*abdm/(2*sin(abdm/2)) !bend path length (m)

byd1b1: sbend, type = "1.69VD55.1", l = leffbdm/2, angle = abdm/2, hgap = gbdm/2, e1 = abdm/2, e2 = 0, fint = fbdm,
          fintx = 0, ref_tilt = pi/2
byd1b2: sbend, type = "1.69VD55.1", l = leffbdm/2, angle = abdm/2, hgap = gbdm/2, e1 = 0, e2 = abdm/2, fint = 0.00,
          fintx = fbdm, ref_tilt = pi/2

byd2b1: sbend, type = "1.69VD55.1", l = leffbdm/2, angle = abdm/2, hgap = gbdm/2, e1 = abdm/2, e2 = 0, fint = fbdm,
          fintx = 0, ref_tilt = pi/2
byd2b2: sbend, type = "1.69VD55.1", l = leffbdm/2, angle = abdm/2, hgap = gbdm/2, e1 = 0, e2 = abdm/2, fint = 0.00,
          fintx = fbdm, ref_tilt = pi/2

byd3b1: sbend, type = "1.69VD55.1", l = leffbdm/2, angle = abdm/2, hgap = gbdm/2, e1 = abdm/2, e2 = 0, fint = fbdm,
          fintx = 0, ref_tilt = pi/2
byd3b2: sbend, type = "1.69VD55.1", l = leffbdm/2, angle = abdm/2, hgap = gbdm/2, e1 = 0, e2 = abdm/2, fint = 0.00,
          fintx = fbdm, ref_tilt = pi/2

! define unsplit SBENs for BMAD ... not used by MAD

byd1b: sbend, type = "1.69VD55.1", hgap = gbdm/2, l = leffbdm, angle = abdm, e1 = abdm/2, fint = fbdm, e2 = abdm/2,
          fintx = fbdm, ref_tilt = pi/2
byd2b: sbend, type = "1.69VD55.1", hgap = gbdm/2, l = leffbdm, angle = abdm, e1 = abdm/2, fint = fbdm, e2 = abdm/2,
          fintx = fbdm, ref_tilt = pi/2
byd3b: sbend, type = "1.69VD55.1", hgap = gbdm/2, l = leffbdm, angle = abdm, e1 = abdm/2, fint = fbdm, e2 = abdm/2,
          fintx = fbdm, ref_tilt = pi/2

pcpm1lb: ecollimator, l = lpcpm, x_limit = 14.2875e-3, y_limit = 14.2875e-3
pcpm2lb: ecollimator, l = lpcpm, x_limit = 38.1e-3, y_limit = 38.1e-3
pcebdb: ecollimator, l = 0, x_limit = 34.0e-3, y_limit = 34.0e-3, type = "gasket coll"

lds1 = 0.3158763
lds = 0.247946
ldmp1 = 11.516159251113 !BYD3/BYD3B to QDmp1/QDmp1B
ddmpv = -0.73352263654
ddwsdump = 0.248126313572 !set Z at DUMPFACEB

ds1: drift, l = lds1
ds: drift, l = lds
dd1ba: drift, l = 0.577681352129
dd1bb: drift, l = 1.000087502327
dd1bc: drift, l = 0.3048
dd1be: drift, l = 0.24963810293
dd1bf: drift, l = 0.409240108574
