! ------------------------------------------------------------------------------
! BSY downstream of scH merge bend (BXSP1H)
! ------------------------------------------------------------------------------

! note: the K-values below are for SC beam; the settings for Cu beam are
! in the "LCLS2cu_main.mad8" file

kq50q3 = 0.426937957729 ! 0.426937957729
kq4 = -0.219608310315 !-0.219608310249
kq5 = 0.110245649911 ! 0.11024564993
kq6 = -0.109735122424 !-0.109735122471
kqa0 = 0.096565286277 ! 0.096565286297

q50q3: quadrupole, type = "50Q3", l = 0.143254, k1 = kq50q3, aperture = 0.010325
q4: quadrupole, type = "0.91Q17.72", l = lqf/2, k1 = kq4, aperture = rqf
q5: quadrupole, type = "0.91Q17.72", l = lqf/2, k1 = kq5, aperture = rqf
q6: quadrupole, type = "0.91Q17.72", l = lqf/2, k1 = kq6, aperture = rqf
qa0: quadrupole, type = "0.91Q17.72", l = lqf/2, k1 = kqa0, aperture = rqf

! PM projections onto BSY beamline

sbkrapm = 1.055 !PM effective straight length (m)
abkrapm0 = -0.276615046502e-2 !PM bend angle (PM's have been decommissioned)
zbkrapm1 = sbkrapm*cos(abkrapm0*1/2)
zbkrapm2 = sbkrapm*cos(abkrapm0*3/2)
zbkrapm3 = sbkrapm*cos(abkrapm0*5/2)
zbkrapm4 = sbkrapm*cos(abkrapm0*7/2)

! PM drifts projected onto BSY beamline

ldapm = 0.5951 !space between two PMs along (decommissioned) A-line trajectory
lpcapm = 0.1824 !length of PM collimator along BSY beamline
ldzapm1 = (ldapm*cos(1*abkrapm0)-lpcapm)/2
ldzapm2 = (ldapm*cos(2*abkrapm0)-lpcapm)/2
ldzapm3 = (ldapm*cos(3*abkrapm0)-lpcapm)/2
ldzapm4 = (ldapm*cos(4*abkrapm0)-lpcapm)/2
lda01 = 0.1971765
lda02 = 4.371494-lda01-1.35/cos(4*abkrapm0)
ldza01 = lda01*cos(4*abkrapm0)
ldza02 = lda02*cos(4*abkrapm0)
lpcbsyh = 0.45
lpc90 = 0.453644
lpc119 = 0.453644

zq5 = 0.0 !adjust position of Q5
zq6 = 0.0 !adjust position of Q6

dbsy53a: drift, l = 0.091696
dbsy53b: drift, l = 0.610705
dbsy53c: drift, l = 0.779945
dbsy53f: drift, l = 0.5
dbsy53d: drift, l = 4.0-dbsy53a[l]-dbsy53b[l]-dbsy53c[l]-dbsy53f[l]
dbsy53g: drift, l = 1.2
dbsy53ga: drift, l = 0.91293
dbsy53gb: drift, l = dbsy53g[l]-dbsy53ga[l]-lplate
dbkrapm1a: drift, l = zbkrapm1/2
dbkrapm1b: drift, l = zbkrapm1/2
dzapm1: drift, l = ldzapm1
dbkrapm2a: drift, l = zbkrapm2/2
dbkrapm2b: drift, l = zbkrapm2/2
dzapm2a: drift, l = ldzapm2/2
dscapm2: drift, l = 0
dzapm2b: drift, l = ldzapm2/2
dzapm2: drift, l = ldzapm2
dbkrapm3a: drift, l = zbkrapm3/2
dbkrapm3b: drift, l = zbkrapm3/2
dzapm3: drift, l = ldzapm3
dbkrapm4a: drift, l = zbkrapm4/2
dbkrapm4b: drift, l = zbkrapm4/2
dzapm4: drift, l = ldzapm4
dza01: drift, l = ldza01
dza02: drift, l = ldza02
dbsy53h: drift,
          l = 34.45562-dbsy53g[l]-zbkrapm1-zbkrapm2-zbkrapm3-zbkrapm4 -2*ldzapm1-2*ldzapm2-2*ldzapm3-ldzapm4-ldza01-ldza02  &
         -lpcbsyh-4*lpcapm +zq5
dbsy54a: drift, l = 0.5
dbsy54b: drift, l = 3.22454 -zq5
dbsy54c: drift, l = 19.260056-dbsy54a[l]-dbsy54b[l] -zq5+zq6
dbsy55a: drift, l = 0.5
dbsy55b: drift, l = 4.226742
dbsy55c: drift, l = 8.016028 -zq6
dbsy55d: drift, l = 6.466828
dbsy55e: drift, l = 21.826764-drfb[l]-dbsy55a[l]-dbsy55b[l]-lpc90 -dbsy55c[l]-lplate-dbsy55d[l]-lpc119 -zq6
dm3: drift, l = 0.8438
dm4a: drift, l = 0.441
dm4c: drift, l = 0.331133-ljaw/2
dm4d: drift, l = 1.168867-ljaw/2
dm4da: drift, l = 0.27685
dm4db: drift, l = dm4d[l]-dm4da[l]-lplate
dm4b: drift, l = 8.851641-dm4a[l]-dm4c[l]-dm4d[l]-ljaw-1.717774
dxca0: drift, l = 0.31
dyca0: drift, l = 0.509021
dm5: drift, l = 0.790979
dm6: drift, l = 0.567588
dmoni: drift, l = 0.009525

bpmbsyq3: monitor, type = "Stripline-6" !per C. Iverson
rfbbsyq3: monitor, type = "@2,CavityS-1"
bpmbsyq4: monitor, type = "Stripline-7"
bpmbsyq5: monitor, type = "Stripline-7" !per C. Iverson
bpmbsyq6: monitor, type = "Stripline-7" !per C. Iverson
rfbbsyq6: monitor, type = "@2,CavityS-1"
bpmbsyqa0: monitor, type = "Stripline-7" !per C. Iverson

