! wiggler for sync. light energy diagnostic (described in SLAC-PUB-3945)
! based on FACET optics model (M. Woodley)
! (series approximation for sinc(x)=sin(x)/x to enable setting with x=0)

bwgh = 0                       !wiggler bend field (kG)
awgh = asin(bwgh*zwhp/(ef*cb)) !bend angle per half-pole
awgh2 = awgh*awgh
awgh4 = awgh2*awgh2
awgh6 = awgh4*awgh2
sinch = 1-awgh2/6+awgh4/120-awgh6/5040
lwgh = zwhp/sinch              !half-pole path length

awg1h = asin(sin(awgh)/2) !"short half" half-pole bend angle
awg1h2 = awg1h*awg1h
awg1h4 = awg1h2*awg1h2
awg1h6 = awg1h4*awg1h2
sinc1h = 1-awg1h2/6+awg1h4/120-awg1h6/5040
lwg1h = (zwhp/2)/sinc1h   !"short half" half-pole path length

awg2h = awgh-awg1h        !"long half" half-pole bend angle
lwg2h = lwgh-lwg1h        !"long half" half-pole path length

wig1h1: sbend, type = "@3,SLC wiggler", l = lwg1h, hgap = gwig/2, angle = awg1h, e1 = 0, e2 = 0, fint = 0.5, fintx = 0,
          ref_tilt = pi/2
wig1h2: sbend, type = "@3,SLC wiggler", l = lwg2h, hgap = gwig/2, angle = awg2h, e1 = 0, e2 = awgh, fint = 0,
          fintx = 0.5, ref_tilt = pi/2
wig2h1: sbend, type = "@3,SLC wiggler", l = lwgh, hgap = gwig/2, angle = -awgh, e1 = -awgh, e2 = 0, fint = 0.5,
          fintx = 0, ref_tilt = pi/2
wig2h2: sbend, type = "@3,SLC wiggler", l = lwgh, hgap = gwig/2, angle = -awgh, e1 = 0, e2 = -awgh, fint = 0,
          fintx = 0.5, ref_tilt = pi/2
wig3h1: sbend, type = "@3,SLC wiggler", l = lwg2h, hgap = gwig/2, angle = awg2h, e1 = awgh, e2 = 0, fint = 0.5,
          fintx = 0, ref_tilt = pi/2
wig3h2: sbend, type = "@3,SLC wiggler", l = lwg1h, hgap = gwig/2, angle = awg1h, e1 = 0, e2 = 0, fint = 0, fintx = 0.5,
          ref_tilt = pi/2

! define unsplit SBENs for BMAD ... not used by MAD

wig1h: sbend, type = "@3,SLC wiggler", hgap = gwig/2, l = lwgh, angle = +awgh, e1 = 0, fint = 0.5, e2 = +awgh,
          fintx = 0.5, ref_tilt = pi/2
wig2h: sbend, type = "@3,SLC wiggler", hgap = gwig/2, l = 2*lwgh, angle = -2*awgh, e1 = -awgh, fint = 0.5, e2 = -awgh,
          fintx = 0.5, ref_tilt = pi/2
wig3h: sbend, type = "@3,SLC wiggler", hgap = gwig/2, l = lwgh, angle = +awgh, e1 = +awgh, fint = 0.5, e2 = 0,
          fintx = 0.5, ref_tilt = pi/2

ldwgh = zdwg/cos(awgh)

dwgh: drift, l = ldwgh

ycwigh: vkicker, type = "@3,wiggler trim"



