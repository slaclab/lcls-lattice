! ------------------------------------------------------------------------------
! SXR R56 compensating chicanes
! - use series approximation for sinc(x)=sin(x)/x to allow zero field
! ------------------------------------------------------------------------------

! Brhof  : beam rigidity at chicane (kG-m)
! GBCC   : gap height (m)
! ZBCC   : magnet Z-length along axis (m)
! ZDCC   : Z-space between magnets (m)
! BBX..  : chicane bend field (kG) at 4 GeV
! ABX..  : chicane bend angle (rad)
! LBX..  : chicane bend path length (m)
! ABX..S : "short" half chicane bend angle (rad)
! ABX..L : "long" half chicane bend angle (rad)
! LBX..S : "short" half chicane bend path length (m)
! LBX..L : "long" half chicane bend path length (m)

bbx31b = 5.0450*ef/4.0*1.15
arg31b = zbcc*bbx31b/brhof
abx31b = asin(arg31b)
abx31b_2 = abx31b*abx31b
abx31b_4 = abx31b_2*abx31b_2
abx31b_6 = abx31b_4*abx31b_2
sinc31b = 1-abx31b_2/6+abx31b_4/120-abx31b_6/5040
lbx31b = zbcc/sinc31b
abx31bs = asin(arg31b/2)
abx31bs_2 = abx31bs*abx31bs
abx31bs_4 = abx31bs_2*abx31bs_2
abx31bs_6 = abx31bs_4*abx31bs_2
sinc31bs = 1-abx31bs_2/6+abx31bs_4/120-abx31bs_6/5040
lbx31bs = zbcc/(2*sinc31bs)
abx31bl = abx31b-abx31bs
lbx31bl = lbx31b-lbx31bs

bcx31b11: sbend, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l = lbx31bs &
        , angle = lbx31bs * (+abx31bs)/lbx31bs
bcx31b12: sbend, e2 = +abx31b, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l =  &
        lbx31bl, angle = lbx31bl * (+abx31bl)/lbx31bl
bcx31b21: sbend, e1 = -abx31b, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l =  &
        lbx31bl, angle = lbx31bl * (-abx31bl)/lbx31bl
bcx31b22: sbend, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l = lbx31bs &
        , angle = lbx31bs * (-abx31bs)/lbx31bs
bcx31b31: sbend, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l = lbx31bs &
        , angle = lbx31bs * (-abx31bs)/lbx31bs
bcx31b32: sbend, e2 = -abx31b, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l =  &
        lbx31bl, angle = lbx31bl * (-abx31bl)/lbx31bl
bcx31b41: sbend, e1 = +abx31b, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l =  &
        lbx31bl, angle = lbx31bl * (+abx31bl)/lbx31bl
bcx31b42: sbend, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l = lbx31bs &
        , angle = lbx31bs * (+abx31bs)/lbx31bs

! define unsplit SBENs for BMAD ... not used by MAD

bcx31b1: sbend, hgap = gbcc/2, e1 = 0, fint = fbcc, e2 = +abx31b, type = "0.788D11.50", l =  &
        lbx31b, angle = lbx31b * (+abx31b)/lbx31b
bcx31b2: sbend, hgap = gbcc/2, e1 = -abx31b, fint = fbcc, e2 = 0, type = "0.788D11.50", l =  &
        lbx31b, angle = lbx31b * (-abx31b)/lbx31b
bcx31b3: sbend, hgap = gbcc/2, e1 = 0, fint = fbcc, e2 = -abx31b, type = "0.788D11.50", l =  &
        lbx31b, angle = lbx31b * (-abx31b)/lbx31b
bcx31b4: sbend, hgap = gbcc/2, e1 = +abx31b, fint = fbcc, e2 = 0, type = "0.788D11.50", l =  &
        lbx31b, angle = lbx31b * (+abx31b)/lbx31b

dcc31bo: drift, l = zdcc/cos(abx31b), type = "CSR"
dcc31bi: drift, l = zdcc, type = "CSR"

cc31bbeg: marker
cc31bend: marker

bcx31b1_full: line = (bcx31b11, bcx31b12)
bcx31b2_full: line = (bcx31b21, bcx31b22)
bcx31b3_full: line = (bcx31b31, bcx31b32)
bcx31b4_full: line = (bcx31b41, bcx31b42)

cc31b: line = (cc31bbeg, bcx31b1_full, dcc31bo, bcx31b2_full, dcc31bi, bcx31b3_full, dcc31bo,  &
        bcx31b4_full, cc31bend)

bbx32b = 5.0450*ef/4.0*1.15
arg32b = zbcc*bbx32b/brhof
abx32b = asin(arg32b)
abx32b_2 = abx32b*abx32b
abx32b_4 = abx32b_2*abx32b_2
abx32b_6 = abx32b_4*abx32b_2
sinc32b = 1-abx32b_2/6+abx32b_4/120-abx32b_6/5040
lbx32b = zbcc/sinc32b
abx32bs = asin(arg32b/2)
abx32bs_2 = abx32bs*abx32bs
abx32bs_4 = abx32bs_2*abx32bs_2
abx32bs_6 = abx32bs_4*abx32bs_2
sinc32bs = 1-abx32bs_2/6+abx32bs_4/120-abx32bs_6/5040
lbx32bs = zbcc/(2*sinc32bs)
abx32bl = abx32b-abx32bs
lbx32bl = lbx32b-lbx32bs

bcx32b11: sbend, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l = lbx32bs &
        , angle = lbx32bs * (+abx32bs)/lbx32bs
bcx32b12: sbend, e2 = +abx32b, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l =  &
        lbx32bl, angle = lbx32bl * (+abx32bl)/lbx32bl
bcx32b21: sbend, e1 = -abx32b, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l =  &
        lbx32bl, angle = lbx32bl * (-abx32bl)/lbx32bl
bcx32b22: sbend, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l = lbx32bs &
        , angle = lbx32bs * (-abx32bs)/lbx32bs
bcx32b31: sbend, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l = lbx32bs &
        , angle = lbx32bs * (-abx32bs)/lbx32bs
bcx32b32: sbend, e2 = -abx32b, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l =  &
        lbx32bl, angle = lbx32bl * (-abx32bl)/lbx32bl
bcx32b41: sbend, e1 = +abx32b, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l =  &
        lbx32bl, angle = lbx32bl * (+abx32bl)/lbx32bl
bcx32b42: sbend, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l = lbx32bs &
        , angle = lbx32bs * (+abx32bs)/lbx32bs

! define unsplit SBENs for BMAD ... not used by MAD

bcx32b1: sbend, hgap = gbcc/2, e1 = 0, fint = fbcc, e2 = +abx32b, type = "0.788D11.50", l =  &
        lbx32b, angle = lbx32b * (+abx32b)/lbx32b
bcx32b2: sbend, hgap = gbcc/2, e1 = -abx32b, fint = fbcc, e2 = 0, type = "0.788D11.50", l =  &
        lbx32b, angle = lbx32b * (-abx32b)/lbx32b
bcx32b3: sbend, hgap = gbcc/2, e1 = 0, fint = fbcc, e2 = -abx32b, type = "0.788D11.50", l =  &
        lbx32b, angle = lbx32b * (-abx32b)/lbx32b
bcx32b4: sbend, hgap = gbcc/2, e1 = +abx32b, fint = fbcc, e2 = 0, type = "0.788D11.50", l =  &
        lbx32b, angle = lbx32b * (+abx32b)/lbx32b

dcc32bo: drift, l = zdcc/cos(abx32b), type = "CSR"
dcc32bi: drift, l = zdcc, type = "CSR"

cc32bbeg: marker
cc32bend: marker

bcx32b1_full: line = (bcx32b11, bcx32b12)
bcx32b2_full: line = (bcx32b21, bcx32b22)
bcx32b3_full: line = (bcx32b31, bcx32b32)
bcx32b4_full: line = (bcx32b41, bcx32b42)

cc32b: line = (cc32bbeg, bcx32b1_full, dcc32bo, bcx32b2_full, dcc32bi, bcx32b3_full, dcc32bo,  &
        bcx32b4_full, cc32bend)

! ------------------------------------------------------------------------------
! wiggler for sync. light energy diagnostic (described in SLAC-PUB-3945)
! based on FACET optics model (M. Woodley)
! (series approximation for sinc(x)=sin(x)/x to enable setting with x=0)
! ------------------------------------------------------------------------------

gwig = 0.02032       !gap height
zwhp = 0.244         !half-pole Z length
zdwg = 0.126525      !pole-to-pole Z spacing
zwig = 4*zwhp+2*zdwg !total wiggler Z length

bwgs = 1.e-12                  !wiggler bend field (kG)
awgs = asin(bwgs*zwhp/(ef*cb)) !bend angle per half-pole
awgs2 = awgs*awgs
awgs4 = awgs2*awgs2
awgs6 = awgs4*awgs2
sincs = 1-awgs2/6+awgs4/120-awgs6/5040
lwgs = zwhp/sincs              !half-pole path length

awg1s = asin(sin(awgs)/2) !"short half" half-pole bend angle
awg1s2 = awg1s*awg1s
awg1s4 = awg1s2*awg1s2
awg1s6 = awg1s4*awg1s2
sinc1s = 1-awg1s2/6+awg1s4/120-awg1s6/5040
lwg1s = (zwhp/2)/sinc1s   !"short half" half-pole path length

awg2s = awgs-awg1s        !"long half" half-pole bend angle
lwg2s = lwgs-lwg1s        !"long half" half-pole path length

wig1s1: sbend, hgap = gwig/2, e1 = 0, e2 = 0, fint = 0.5, fintx = 0, type = "@3,SLC wiggler",  &
        ref_tilt = pi/2, l = lwg1s, angle = lwg1s * awg1s/lwg1s
wig1s2: sbend, hgap = gwig/2, e1 = 0, e2 = awgs, fint = 0, fintx = 0.5, type = "@3,SLC wiggler",  &
        ref_tilt = pi/2, l = lwg2s, angle = lwg2s * awg2s/lwg2s
wig2s1: sbend, hgap = gwig/2, e1 = -awgs, e2 = 0, fint = 0.5, fintx = 0, type = "@3,SLC wiggler" &
        , ref_tilt = pi/2, l = lwgs, angle = lwgs * (-awgs)/lwgs
wig2s2: sbend, hgap = gwig/2, e1 = 0, e2 = -awgs, fint = 0, fintx = 0.5, type = "@3,SLC wiggler" &
        , ref_tilt = pi/2, l = lwgs, angle = lwgs * (-awgs)/lwgs
wig3s1: sbend, hgap = gwig/2, e1 = awgs, e2 = 0, fint = 0.5, fintx = 0, type = "@3,SLC wiggler",  &
        ref_tilt = pi/2, l = lwg2s, angle = lwg2s * awg2s/lwg2s
wig3s2: sbend, hgap = gwig/2, e1 = 0, e2 = 0, fint = 0, fintx = 0.5, type = "@3,SLC wiggler",  &
        ref_tilt = pi/2, l = lwg1s, angle = lwg1s * awg1s/lwg1s

! define unsplit SBENs for BMAD ... not used by MAD

wig1s: sbend, hgap = gwig/2, e1 = 0, fint = 0.5, e2 = +awgs, type = "@3,SLC wiggler", ref_tilt =  &
        pi/2, l = lwgs, angle = lwgs * (+awgs)/lwgs
wig2s: sbend, hgap = gwig/2, e1 = -awgs, fint = 0.5, e2 = -awgs, type = "@3,SLC wiggler",  &
        ref_tilt = pi/2, l = 2*lwgs, angle = 2*lwgs * (-2*awgs)/(2*lwgs)
wig3s: sbend, hgap = gwig/2, e1 = +awgs, fint = 0.5, e2 = 0, type = "@3,SLC wiggler", ref_tilt =  &
        pi/2, l = lwgs, angle = lwgs * (+awgs)/lwgs

ldwgs = zdwg/cos(awgs)

dwgs: drift, l = ldwgs

ycwigs: kicker, type = "@3,wiggler trim"

cntwigs: marker, type = "CENTER" !ELEGANT will correct the orbit here for CSR-steering

wig1s_full: line = (wig1s1, wig1s2)
wig2s_full: line = (wig2s1, ycwigs, wig2s2)
wig3s_full: line = (wig3s1, wig3s2)

ewigs: line = (wig1s_full, dwgs, wig2s_full, dwgs, wig3s_full, cntwigs)

! replace deferred wiggler with a drift

dwigs: drift, l = zwig
dwigsa: drift, l = 1.135414
dwigsb: drift, l = dwigs[l]-dwigsa[l]-lplate

! ------------------------------------------------------------------------------
! SXR dogleg
! ------------------------------------------------------------------------------

! note: the K-values below are for SC beam; the settings for Cu beam are
! in the "LCLS2cu_main.mad8" file

kqdbl1 = -0.048819823179
kqdbl2 = -0.560812460035

qdbl1: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqdbl1
qdbl2: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqdbl2

kqdlb = 0.424676241757
kqdl11 = kqdlb

qdl11: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqdl11 !reserve separate PS
qdl12: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = -kqdlb
qdl13: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqdlb
qdl14: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = -kqdlb
qdl15: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqdlb
qdl16: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = -kqdlb
qdl17: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqdlb
qdl18: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = -kqdlb
qdl19: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kqdlb

kqdl20 = -0.487979625759
kqdl21 = -1.904057641444
kqdl22 = 2.191453247156

qdl20: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqdl20
qdl21: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqdl21
qdl22: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqdl22

ksdl1 = -8.734519131209
ksdl2 = -24.395452957066

sdl1: sextupole, type = "@1,1.38S3.00", l = lsb/2, aperture = rsb, k2 = ksdl1
sdl2: sextupole, type = "@1,1.38S3.00", l = lsb/2, aperture = rsb, k2 = ksdl2

!=!  COMMENT
!=!  COMMENT
!=!    VALUE, (Cb*Ef)*KSDL1*LSb,(Cb*10)*KSDL1*LSb
!=!    VALUE, (Cb*Ef)*KSDL2*LSb,(Cb*10)*KSDL2*LSb
!=!  ENDCOMMENT

lb3b = 2.656     !1.06D103.3T effective length (m)
gb3b = 1.06*in2m !1.06D103.3T gap height (m)
ab3pb = 0.018633330237
ab3mb = -ab3pb
leffb3b = lb3b*ab3pb/(2*sin(ab3pb/2)) !full bend eff. path length (m)

bx31b1: sbend, hgap = gb3b/2, e1 = ab3mb/2, e2 = 0, fint = 0.4297, fintx = 0.0, type =  &
        "1.06D103.3T", l = leffb3b/2, angle = leffb3b/2 * ab3mb/2/(leffb3b/2)
bx31b2: sbend, hgap = gb3b/2, e1 = 0, e2 = ab3mb/2, fint = 0.0, fintx = 0.4297, type =  &
        "1.06D103.3T", l = leffb3b/2, angle = leffb3b/2 * ab3mb/2/(leffb3b/2)
bx32b1: sbend, hgap = gb3b/2, e1 = ab3pb/2, e2 = 0, fint = 0.4297, fintx = 0.0, type =  &
        "1.06D103.3T", l = leffb3b/2, angle = leffb3b/2 * ab3pb/2/(leffb3b/2)
bx32b2: sbend, hgap = gb3b/2, e1 = 0, e2 = ab3pb/2, fint = 0.0, fintx = 0.4297, type =  &
        "1.06D103.3T", l = leffb3b/2, angle = leffb3b/2 * ab3pb/2/(leffb3b/2)

! define unsplit SBENs for BMAD ... not used by MAD

bx31b: sbend, hgap = gb3b/2, e1 = ab3mb/2, fint = 0.4297, e2 = ab3mb/2, type = "1.06D103.3T", l &
         = leffb3b, angle = leffb3b * ab3mb/leffb3b
bx32b: sbend, hgap = gb3b/2, e1 = ab3pb/2, fint = 0.4297, e2 = ab3pb/2, type = "1.06D103.3T", l &
         = leffb3b, angle = leffb3b * ab3pb/leffb3b

! SXR single beam dumper vertical kicker, BPM, spoiler and in-line dump

lkiks = 1.0601 !kicker coil length per magnet (m) [41.737 in from SA-380-330-02, rev. 0]
abykiks = 1e-20  !=0.889371410732E-3 when BYKIKS1,2 are turned on

bykik1s1: sbend, e1 = abykiks/4, e2 = 0, fint = 0.5, fintx = 0, hgap = 25.4e-3, type =  &
        "1.92K41.2", ref_tilt = pi/2, l = lkiks/2, angle = lkiks/2 * abykiks/4/(lkiks/2)
bykik1s2: sbend, e1 = 0, e2 = abykiks/4, fint = 0, fintx = 0.5, hgap = 25.4e-3, type =  &
        "1.92K41.2", ref_tilt = pi/2, l = lkiks/2, angle = lkiks/2 * abykiks/4/(lkiks/2)

bykik2s1: sbend, e1 = abykiks/4, e2 = 0, fint = 0.5, fintx = 0, hgap = 25.4e-3, type =  &
        "1.92K41.2", ref_tilt = pi/2, l = lkiks/2, angle = lkiks/2 * abykiks/4/(lkiks/2)
bykik2s2: sbend, e1 = 0, e2 = abykiks/4, fint = 0, fintx = 0.5, hgap = 25.4e-3, type =  &
        "1.92K41.2", ref_tilt = pi/2, l = lkiks/2, angle = lkiks/2 * abykiks/4/(lkiks/2)

! define unsplit SBENs for BMAD ... not used by MAD

bykik1s: sbend, hgap = 25.4e-3, e1 = abykiks/4, fint = 0.5, e2 = abykiks/4, type = "1.92K41.2",  &
        ref_tilt = pi/2, l = lkiks, angle = lkiks * abykiks/2/lkiks
bykik2s: sbend, hgap = 25.4e-3, e1 = abykiks/4, fint = 0.5, e2 = abykiks/4, type = "1.92K41.2",  &
        ref_tilt = pi/2, l = lkiks, angle = lkiks * abykiks/2/lkiks

bpmbyks: instrument, type = "Stripline-5"
spoilers: instrument           !TDKIKS dump spoiler (1 mm Ti)
tdkiks: instrument, l = 0.6096 !vertical off-axis in-line dump

ldbldl = 3.0 ! length of LTU doublet including drifts

wall: drift, l = 16.764 !length of muon wall
dwalla: drift, l = 1.840975 !distance from face of muon wall to face of BSY dump
dwallb: drift, l = wall[l]-dwalla[l]
ddbldlb: drift, l = 0.5+(lqa-lqe)/2
ddbldlc: drift, l = 0.4
ddbldld: drift, l = (lqa-lqe)/2
ddbldla: drift, l = 0.5*(ldbldl-2*lqe-ddbldlb[l]-2*ddbldlc[l]-ddbldld[l]-ljaw)
ddbldla1: drift, l = 0.654660
ddbldla2: drift, l = 2*ddbldla[l]-ddbldla1[l]

ldlcel = 25.5
ldl6b = 0.4
ldl0a = ldlcel/2-lqa-ldl6b
ldl0b = ldlcel/2-lqa-ldl6b+(lqa-lqr)
ldl0ba = 0.1953
ldl0bb = 3.213005+(lqa-lqr)/2-ldl0ba
ldl0bc = ldl0b-ldl0ba-ldl0bb
ldl1b = 2.9815+(lqa-lqr)/2
ldl1ba = 1.316489-lplate !1.317304
ldl1bc = 0.1953
ldl1bb = ldl1b-ldl1ba-lplate-ldl1bc
ldl2b = ldl0b+ldl6b-ldl1b-lb3b+(leffb3b-lb3b)*3
ldl2ba = 0.1953
ldl2bb = ldl2b-ldl2ba
ldl4b = 1.996-ldl6b+(lqa-lqe)
ldl3b = ldl0a-lqa-ldl4b-2*ldl6b+1.0+2*(lqa-lqe)
ldl5b = 0.498+(lqa-lqe)/2
ldl7b = 0.93209
ldl8b = ldl0b-ldl7b-ljaw
ldl8c = 1.0
ldl8ca = 0.1953
ldl8cb = ldl8c-ldl8ca
ldl8d = ldl0b-ldl8c-zwig
 !LDL8da := 0.019865 !251052
 !LDL8db := LDL8d-LDL8da
ldl9b = ldl0b-ldl6b
ldl9ba = 6.045762 !5.076366+(LQA-LQR)/2 +2.7012019
ldl9bb = ldl9b-ldl9ba
ldl10b = 1.230797
ldl10ba = 0.81
ldl10bb = ldl10b-ldl10ba
ldl11b = ldl0b-ldl10b-ljaw
ldl11ba = 0.162952
ldl11bb = ldl11b-ldl11ba
ldl13b = 0.4
ldl12b = ldl0b-ldl13b-ldl7b-ljaw
dldl14b = 0.0
ldl14b = 0.4815+(lqa-lqe)/2+dldl14b
ldl16b = 0.5
ldl15b = ldl2b-ldl16b-2.0
ldl15ba = 0.1953
ldl15bb = 1.224657+(lqa-lqr)/2-ldl15ba
ldl15bc = ldl15b-ldl15ba-ldl15bb
ldl17b = 0.5
ldl18b = ldl3b-ldl17b-2.0
ldl18ba = 1.076255 !1.139755
ldl18bb = ldl18b-ldl18ba-lplate
ldl19ba = 0.1953
ldl19bb = 6.150346 !221641 !6.201146
ldl19bc = ldl0b-ldl19ba-ldl19bb-lplate
ldl20b = ldl0b+1.002-(lqa-lqr)/2

ddl0b: drift, l = ldl0b
ddl0ba: drift, l = ldl0ba
ddl0bb: drift, l = ldl0bb
ddl0bc: drift, l = ldl0bc
ddl1b: drift, l = ldl1b
ddl1ba: drift, l = ldl1ba
ddl1bb: drift, l = ldl1bb
ddl1bc: drift, l = ldl1bc
