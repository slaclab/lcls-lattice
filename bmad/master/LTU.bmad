        dxl2btm, pc12b, btm12b, dbtm2yc, yce32b, dqeaa, qe32b_full, drfb, rfbe32b, dqeby1, dcy32b &
        , dqeby2, ws32b, d40cm, de3m80cmb, xce33b, dqeab, qe33b_full, dqec, de3m40cm, yce34b,  &
        dqea, qe34b_full, drfb, rfbe34b, dqec1, ws33b, d40cm, de3m80cm, xce35b, dqeac, qe35b_full &
        , xleap2b, yce36b, dqea, qe36b_full, drfb, rfbe36b, dqeby1, dcy36b, dqeby2, ws34b, d40cm)

ecellb: line = (qe31b, dqec, dqec, qe32b, qe32b, dqec, dqec, qe31b)

! ------------------------------------------------------------------------------
! SXR undulator match
! ------------------------------------------------------------------------------

! note: the below K-values come from Y. Nosochkov's UNDS_KQ5_US.xsif file,
!       for E= 4.0 GeV and KSXU= 5.0 (IntgSX= 30.0 kG)

! note: the below K-values are for SC beam; the settings for Cu beam are
!       in the "LCLS2cu_main.mad8" file

kqum1b = 0.311729673613
kqum2b = -0.13
kqum3b = 0.384569277452
kqum4b = -0.522052682614

qum1b: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqum1b
qum2b: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqum2b
qum3b: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqum3b
qum4b: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqum4b

du1m80cm: drift, l = 4.550
dcx37: drift, l = 0.08
dcy38: drift, l = 0.08
d32cmcb: drift, l = 1.30046+(lqa-lqe)/2+0.5
dum1a: drift, l = 0.49
dum1b: drift, l = 0.47046
d32cm: drift, l = 0.32
du2m120cmb: drift, l = 3.730+(lqa-lqe)-0.5
d32cma: drift, l = 0.42046
dum2a: drift, l = 0.37
dum2b: drift, l = 0.47046
du3m80cm: drift, l = 7.29046
du3m80cmb: drift, l = du3m80cm[l]+(lqa-lqe)
dum3a: drift, l = 0.38
dum3b: drift, l = 0.47046
d40cma: drift, l = 1.807939
du4m120cm: drift, l = 1.362521
du4m120cmb: drift, l = du4m120cm[l]+(lqa-lqe)
dum4a: drift, l = 0.50
dum4b: drift, l = 0.59746
du5m80cm: drift, l = 0.5
du5m80cmb: drift, l = du5m80cm[l]+(lqa-lqe)/2
duhwall1: drift, l = 0.250825 !length of BTH/UH wall-1
duhvest: drift, l = 2.009175 !length of BTH/UH vestibule
duhvesta: drift, l = 1.605684
duhvestb: drift, l = duhvest[l]-duhvesta[l]
duhwall2: drift, l = 0.250825 !length of BTH/UH wall-2
dw2tdundb: drift, l = 3.001537+0.060429 !drift from BTH/UH wall-2 to TDUNDB u/s flange
dtdund1: drift, l = 0.855853 !from u/s TDUND flange to TDUND center
dtdund2: drift, l = 0.347853 !from TDUND center to d/s TDUND flange
dpcmuon: drift, l = 0.031498
dmuon1: drift, l = 0.154859+0.05
dmuon1b: drift, l = 0.154859+0.05-0.060429
dmuon3b: drift, l = 0.310592-0.05

dw2tdb1: drift, l = 61.51*in2m-wigxl[l]
dw2tdb2: drift, l = dw2tdundb[l]-dw2tdb1[l]-2*wigxl[l]
 !VALUE, DW2TDb1[L],DW2TDb2[L]
 !VALUE, DW2TDb1[L]+2*WIGXL[L]+DW2TDb2[L],DW2TDUNDb[L]

bpmum1b: instrument, type = "Stripline-2"
bpmum2b: instrument, type = "Stripline-2"
bpmum3b: instrument, type = "Stripline-2"
bpmum4b: instrument, type = "Stripline-2"

xcum1b: kicker, type = "class-4f" !fast-feedback (loop-5)
xcum3b: kicker, type = "class-4f" !fast-feedback (loop-5)

ycum2b: kicker, type = "class-4f" !fast-feedback (loop-5)
ycum4b: kicker, type = "class-4f" !fast-feedback (loop-5)

tdundb: instrument !LTU insertable block at und. extension entrance (w/ screen)

! Note: PCMUONb Y-aperture violates standard BSC -- approved by P. Emma

pcmuonb: ecollimator, x_limit = 8.64e-3/2, y_limit = 4.32e-3/2, l = 1.1684 !muon scattering collimator

vv999b: marker !vacuum valve just upbeam of undulator - TBD
pfilt1b: marker
mm1b: marker
mm2b: marker
mm3b: marker
muwallb: marker !front face of muon wall for SXR beam
dumpbsys: marker !front face of BSY dump for SXR beam
bsyendb: marker !FFTB side of muon plug wall
rwwake3s: marker, type = "WAKE" !SPRDS/BSY beampipe wake applied here
muhwall1b: marker !upstream end of BTH/UH wall-1
muhwall2b: marker !upstream end of BTH/UH wall-2
dbmark37b: marker !end of undulator match
rwwake4s: marker, type = "WAKE" !LTUS beampipe wake applied here



