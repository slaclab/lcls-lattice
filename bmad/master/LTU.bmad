! ==============================================================================
! XLEAP-II devices
! ==============================================================================

! ------------------------------------------------------------------------------
! recycled XLEAP type-4 correctors
! ------------------------------------------------------------------------------

ycxl1: kicker, type = "class-4"
xcxl1: kicker, type = "class-4"
ycxl2: kicker, type = "class-4"
xcxl2: kicker, type = "class-4"

! ------------------------------------------------------------------------------
! recycled LCLS undulators
! ------------------------------------------------------------------------------

! definition of Eu is in LCLS2sc_master.xsif and LCLS2cu_master.xsif

gamxl = eu/mc2       !Lorentz energy factor [ ]
kund = 50           !undulator parameter (rms) [ ]
lamu = 0.40         !undulator period [m]
lseg = 3.400        !undulator segment length [m]
lue = 0.035        !undulator termination length (approx) [m]
lund = lseg-2*lue !undulator segment length without terminations [m]
lundh = lund/2       !undulator segment half-length [m]

! natural undulator focusing "k" in y-plane [m^-2]

kqund = setxleap2*(kund*2*pi/lamu/sqrt(2)/gamxl)^2

! handle K_und->0 (undulator moved out of beam) by expressing R34 as an
! approximate SINC function

argu = lundh*sqrt(kqund)
argu2 = argu*argu
argu4 = argu2*argu2
argu6 = argu4*argu2
sincargu = 1-argu2/6+argu4/120-argu6/5040 !~sinc(ARGu)=sin(ARGu)/ARGu
r34u = lundh*sincargu

! undulator segment modeled as R-matrix to include vertical natural focusing
! over all but its edge terminations:

umxl: taylor, type = "LCLS-I", l = lundh, {1: 1.0, 1 0 0 0 0 0}, {1: lundh, 0 1 0 0 0 0}, {2: 0.0 &
        , 1 0 0 0 0 0}, {2: 1.0, 0 1 0 0 0 0}, {3: cos(argu), 0 0 1 0 0 0}, {3: r34u, 0 0 0 1 0 0 &
        }, {4: -sin(argu)*sqrt(kqund), 0 0 1 0 0 0}, {4: cos(argu), 0 0 0 1 0 0}

umxl1: umxl
umxl2: umxl
umxl3: umxl
umxl4: umxl

shrt = 0.470                                 !standard short break length [m]
lrfbu = 0                                     !undulator RF-BPM only implemented as zero length monitor
lbr1 = 6.889e-2                              !und-seg to quad [m]
lbr3 = 9.111e-2                              !quad to BPM [m]
lbr4 = 5.8577e-2                             !radiation monitor to segment [m]
lbrwm = 7.1683e-2                             !BFW to radiation monitor [m]
lbrs = shrt-lrfbu-0.078-lbr1-lbr3-lbr4-lbrwm !standard short break length (BPM-to-quad distance) [m]

dlbfw = 3.6016-3.63815 !BFW location adjustment per H. Loos

dbrs: drift, l = lbrs-dlbfw  !standard short undulator drift from BPM to segment
dbwm: drift, l = lbrwm+dlbfw !BFW to radiation monitor drift
db4: drift, l = lbr4        !radiation monitor to segment drift
dt: drift, l = lue         !undulator segment small terminations modeled as drift
duu: drift, l = 0.238/2     !undulator pair half-drift

drfbxl: drift, l = lrfbu !RFBPMs associated with XLEAP-II undulators removed

! flip RF BPMs

drfbf = 0.61*in2m
duuf: drift, l = duu[l]+drfbf
dbrsf: drift, l = dbrs[l]-drfbf



!Old split line: line = (umxl1, umxl1)

umxl1_full: line = (umxl1)
umxl1[L] = 2*umxl1[L]


!Old split line: line = (umxl2, umxl2)

umxl2_full: line = (umxl2)
umxl2[L] = 2*umxl2[L]


!Old split line: line = (umxl3, umxl3)

umxl3_full: line = (umxl3)
umxl3[L] = 2*umxl3[L]


!Old split line: line = (umxl4, umxl4)

umxl4_full: line = (umxl4)
umxl4[L] = 2*umxl4[L]

xl2und1: line = (drfbxl, dbrsf, dbwm, db4, dt, umxl1_full, dt)
xl2und2: line = (drfbxl, dbrsf, dbwm, db4, dt, umxl2_full, dt)
xl2und3: line = (drfbxl, dbrsf, dbwm, db4, dt, umxl3_full, dt)
xl2und4: line = (drfbxl, dbrsf, dbwm, db4, dt, umxl4_full, dt)

lxl2und = 2*(drfbxl[l]+dbrs[l]+dbwm[l]+db4[l]+dt[l]+umxl1[l]+umxl1[l]+dt[l])+2*duu[l]

! drifts around undulator pair

lxl3132 = dqebx[l]+dcx31b[l]+dqebx2[l]+de3aba[l]
dxlua: drift, l = (lxl3132-lxl2und)/2
dxlub: drift, l = lxl3132-lxl2und-dxlua[l]
 !VALUE, DXLUa[L],DXLUb[L]

dxlua1: drift, l = 0.404978
dxlua2: drift, l = 0.395986
dxlua3: drift, l = dxlua[l]-dxlua1[l]-dxlua2[l]
dxlua3f: drift, l = dxlua3[l]+drfbf !flip RF BPM

! ------------------------------------------------------------------------------
! original XLEAP self-seeding chicane (normally OFF)
! ------------------------------------------------------------------------------

! - from RadiaBeam (C-bends; 0.75 T peak field; 1 degree max)
! - use series approximation for sinc(x)=sin(x)/x to allow ABXL=0
! - deflects toward +X (to the left/north/wall)
! - Dieter Walz designation: 1.575D14-C (pole-width rather than gap height)

! GBXL  : 0.433D14-C gap height (m)
! ZBXL  : 0.433D14-C "Z" length (m)
! FBXL  : measured fringe field
! ABXL  : chicane bend angle (rad)
! BBXL  : chicane bend field (kG)
! LBXL  : chicane bend path length (m)
! ABXLs : "short" half chicane bend angle (rad)
! LBXLs : "short" half chicane bend path length (m)
! ABXLl : "long" half chicane bend angle (rad)
! LBXLl : "long" half chicane bend path length (m)

! BCXXL1 gets an X-offset of  -5 mm (toward the aisle)
! BCXXL2 gets an X-offset of -12 mm (toward the aisle)
! BCXXL3 gets an X-offset of -12 mm (toward the aisle)
! BCXXL4 gets an X-offset of  -5 mm (toward the aisle)

gbxl = 0.011
zbxl = 0.364
fbxl = 0.5
abxl0 = 0.0174 !R56=0.56 mm
abxl = abxl0*setxleap2
bbxl = brhof*sin(abxl)/zbxl
abxl_2 = abxl*abxl
abxl_4 = abxl_2*abxl_2
abxl_6 = abxl_4*abxl_2
sincabxl = 1-abxl_2/6+abxl_4/120-abxl_6/5040 !~sinc(ABXL)=sin(ABXL)/ABXL
lbxl = zbxl/sincabxl
abxls = asin(sin(abxl)/2)
abxls_2 = abxls*abxls
abxls_4 = abxls_2*abxls_2
abxls_6 = abxls_4*abxls_2
sincabxls = 1-abxls_2/6+abxls_4/120-abxls_6/5040 !~sinc(ABXLs)=sin(ABXLs)/ABXLs
lbxls = zbxl/(2*sincabxls)
abxll = abxl-abxls
lbxll = lbxl-lbxls

bcxxl11: sbend, hgap = gbxl/2, e1 = 0, fint = fbxl, fintx = 0, type = "0.433D14-C", l = lbxls,  &
        angle = lbxls * (-abxls)/lbxls
bcxxl12: sbend, hgap = gbxl/2, fint = 0, e2 = -abxl, fintx = fbxl, type = "0.433D14-C", l = lbxll &
        , angle = lbxll * (-abxll)/lbxll
bcxxl21: sbend, hgap = gbxl/2, e1 = +abxl, fint = fbxl, fintx = 0, type = "0.433D14-C", l = lbxll &
        , angle = lbxll * (+abxll)/lbxll
bcxxl22: sbend, hgap = gbxl/2, fint = 0, e2 = 0, fintx = fbxl, type = "0.433D14-C", l = lbxls,  &
        angle = lbxls * (+abxls)/lbxls
bcxxl31: sbend, hgap = gbxl/2, e1 = 0, fint = fbxl, fintx = 0, type = "0.433D14-C", l = lbxls,  &
        angle = lbxls * (+abxls)/lbxls
bcxxl32: sbend, hgap = gbxl/2, fint = 0, e2 = +abxl, fintx = fbxl, type = "0.433D14-C", l = lbxll &
        , angle = lbxll * (+abxll)/lbxll
bcxxl41: sbend, hgap = gbxl/2, e1 = -abxl, fint = fbxl, fintx = 0, type = "0.433D14-C", l = lbxll &
        , angle = lbxll * (-abxll)/lbxll
bcxxl42: sbend, hgap = gbxl/2, fint = 0, e2 = 0, fintx = fbxl, type = "0.433D14-C", l = lbxls,  &
        angle = lbxls * (-abxls)/lbxls

! define unsplit SBENs for BMAD ... not used by MAD

bcxxl1: sbend, hgap = gbxl/2, e1 = 0, fint = fbxl, e2 = -abxl, type = "0.433D14-C", l = lbxl,  &
        angle = lbxl * (-abxl)/lbxl
bcxxl2: sbend, hgap = gbxl/2, e1 = +abxl, fint = fbxl, e2 = 0, type = "0.433D14-C", l = lbxl,  &
        angle = lbxl * (+abxl)/lbxl
bcxxl3: sbend, hgap = gbxl/2, e1 = 0, fint = fbxl, e2 = +abxl, type = "0.433D14-C", l = lbxl,  &
        angle = lbxl * (+abxl)/lbxl
bcxxl4: sbend, hgap = gbxl/2, e1 = -abxl, fint = fbxl, e2 = 0, type = "0.433D14-C", l = lbxl,  &
        angle = lbxl * (-abxl)/lbxl

! magnet-to-magnet path lengths

zdxlo = 1.046-zbxl !outer bend-to-bend Z distance (m)
zdxli = 0.520-zbxl !inner bend-to-bend Z distance (m)

dxlo: drift, l = zdxlo/cos(abxl)
dxli: drift, l = zdxli/2

lbcxl = 4*zbxl+2*zdxlo+zdxli !chicane length

! MARKers

bcxlssbeg: marker
bcxlssmid: marker
bcxlssend: marker

! beamline

bcxxl1_full: line = (bcxxl11, bcxxl12)
bcxxl2_full: line = (bcxxl21, bcxxl22)
bcxxl3_full: line = (bcxxl31, bcxxl32)
bcxxl4_full: line = (bcxxl41, bcxxl42)

bcxlss: line = (bcxlssbeg, bcxxl1_full, dxlo, bcxxl2_full, dxli, bcxlssmid, dxli, bcxxl3_full,  &
        dxlo, bcxxl4_full, bcxlssend)

! drifts around chicane and undulator pair

lxl3536 = dqebx[l]+dcx35b[l]+dqebx2[l]+de3[l]

dxluc: drift, l = 3.5
dxlud: drift, l = 1.0
dxlue: drift, l = lxl3536-dxluc[l]-lbcxl-dxlud[l]-lxl2und
 !VALUE, DXLUc[L],DXLUd[L],DXLUe[L]

dxlud1: drift, l = 0.323714
dxlud2: drift, l = 0.393700
dxlud3: drift, l = dxlud[l]-dxlud1[l]-dxlud2[l]
dxlud3f: drift, l = dxlud3[l]+drfbf !flip RF BPM

! ------------------------------------------------------------------------------
! original XLEAP wiggler
! ------------------------------------------------------------------------------

! wiggler is modeled as R-matrix to include natural vertical focusing;
! it is nominally OFF (opened to full gap, with Kwig~2); at minimum gap, Kwig=50

kwig = 34                                        !wiggler parameter [m^-1]
lamw = 0.34                                      !wiggler period [m]
lwigh = 2.38/2                                    !wiggler half-length [m]
gamw = eu/mc2                                    !Lorentz energy factor in wiggler [ ]
kqwig = setxleap2*(2*pi*kwig/lamw/sqrt(2)/gamw)^2 !natural vertical focusing "k" [m^-2]

! handle Kwig->0 by expressing R34 as an approximate SINC function

argw = lwigh*sqrt(kqwig)
argw2 = argw*argw
argw4 = argw2*argw2
argw6 = argw4*argw2
sincargw = 1-argw2/6+argw4/120-argw6/5040 !~sinc(ARGw)=sin(ARGw)/ARGw
r34w = lwigh*sincargw

wigxl: taylor, type = "variable gap", l = lwigh, {1: 1.0, 1 0 0 0 0 0}, {1: lwigh, 0 1 0 0 0 0} &
        , {2: 0.0, 1 0 0 0 0 0}, {2: 1.0, 0 1 0 0 0 0}, {3: cos(argw), 0 0 1 0 0 0}, {3: r34w,  &
        0 0 0 1 0 0}, {4: -sin(argw)*sqrt(kqwig), 0 0 1 0 0 0}, {4: cos(argw), 0 0 0 1 0 0}

 !VALUE, WIGXL[R11],WIGXL[R12],WIGXL[R21],WIGXL[R22]
 !VALUE, WIGXL[R33],WIGXL[R34],WIGXL[R43],WIGXL[R44]

