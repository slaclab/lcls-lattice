ycdl21: kicker, type = "class-4"

cedl13: rcollimator, x_limit = 8.5e-3, y_limit = 20.e-3, type = "HCOLL", l = ljaw
cedl17: rcollimator, x_limit = 8.5e-3, y_limit = 20.e-3, type = "HCOLL", l = ljaw

cybdl: rcollimator, y_limit = 1.2e-3, x_limit = 20.e-3, type = "VCOLL", l = ljaw
cydl16: rcollimator, y_limit = 1.1e-3, x_limit = 20.e-3, type = "VCOLL", l = ljaw

! muon collimators after SBD TDKIKS in-line dump
pctdkik1s: ecollimator, x_limit = 11.1125e-3, y_limit = 11.1125e-3, type = "BCS PC", l = lpctdkik
pctdkik2s: ecollimator, x_limit = 11.1125e-3, y_limit = 11.1125e-3, type = "BCS PC", l = lpctdkik
pctdkik3s: ecollimator, x_limit = 11.1125e-3, y_limit = 11.1125e-3, type = "@5,BCS PC", l =  &
        lpctdkik
pctdkik4s: ecollimator, x_limit = 11.1125e-3, y_limit = 11.1125e-3, type = "@5,BCS PC", l =  &
        lpctdkik

otrdl18: instrument, type = "@3,OTR"

pc01b: instrument, type = "BCS plate", l = lplate
btm01b: instrument, type = "PPS BTM"
pc03b: instrument, type = "BCS plate", l = lplate
btm03b: instrument, type = "PPS BTM"
pc04b: instrument, type = "BCS plate", l = lplate
btm04b: instrument, type = "PPS BTM"
pc06b: instrument, type = "BCS plate", l = lplate
btm06b: instrument, type = "PPS BTM"
pc07b: instrument, type = "BCS plate", l = lplate
btm07b: instrument, type = "PPS BTM"

