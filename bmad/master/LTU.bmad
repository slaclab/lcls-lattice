! ------------------------------------------------------------------------------
! BSY upstream of the scH merge bend (BXSP1H)
! ------------------------------------------------------------------------------

kq30701 = -0.396181540351 !-0.396231018339
kq30801 = 0.480061954868 ! 0.480592172519
kq50q1 = -0.231094130006 !-0.231522300458
kq50q2 = 0.101722563756 ! 0.102074332053

q50q1: quadrupole, type = "2Q10", l = lqr/2, k1 = kq50q1, aperture = rqr
q50q2: quadrupole, type = "50Q2", l = 0.162151, k1 = kq50q2, aperture = 0.010325

ldbsy01 = 5.995 !from beginning of BSY to Station 100
dbsy01a: drift, l = 0.7286
dbsy01b: drift, l = 0.25005
dbsy01c: drift, l = 0.25005
dbsy01d: drift, l = 0.4143
dbsy01e: drift, l = 2.9046 !0.807+0.6+1.4976
dbsy01f: drift, l = 0.31575
dbsy01g: drift, l = 0.31575
dbsy01h: drift, l = 0.7975
dbsy01i: drift, l = 0.0184

ldbsy50 = 2.144276 !Station 100 to center of Q50Q1
dbsy50: drift, l = ldbsy50-lqr/2
dbsy50a: drift, l = 0.5782
dbsy50b: drift, l = dbsy50[l]-dbsy50a[l]

dbsy02: drift, l = 0.456124
dbsy02b: drift, l = 0.2199
dbsy02a: drift, l = dbsy02[l]-dbsy02b[l]

dbsy51: drift, l = 5.521976
dbsy51b: drift, l = 0.5
dbsy51a: drift, l = dbsy51[l]-dbsy51b[l]

dbsy52: drift, l = 54.883314
dbsy52a: drift, l = 0.079149
dbsy52b: drift, l = 1.799589 !2.420851
dbsy52d: drift, l = 0.5
dbsy52c: drift,
          l =  &
         dbsy52[l]-dbsy52a[l]-dbsy52b[l]-lbrcusdc1-dckdc1[l]-lbkrcus-dckdc2[l]-lbrcusdc2-dcusblra[l]-dcusblrb[l]-lblrcus-lbxsph- &
         dbsy52d[l]

dbsy52c1: drift, l = 1.174422 !to SWIVEL point
dbsy52c2: drift, l = dbsy52c[l]-dbsy52c1[l]

bpmbsyq1: monitor, type = "Stripline-5" !changed from "-6" to fit 2Q10
bpmbsyq2: monitor, type = "Stripline-6" !per C. Iverson

ycbsyq1: vkicker, type = "class-4" !barcode=4600

xcbsyq2: hkicker, type = "class-4" !barcode=4601

imbsy1: marker, type = "BCS toroid" !Bergoz toroid
imbsy2: marker, type = "BCS toroid" !Bergoz toroid
imbsy3: marker, type = "BCS toroid" !Bergoz toroid

imbsy1b: marker, type = "BCS backup toroid" !PEP2 backup toroid for IMBSY1
imbsy2b: marker, type = "BCS backup toroid" !PEP2 backup toroid for IMBSY2
imbsy3b: marker, type = "BCS backup toroid" !PEP2 backup toroid for IMBSY3

imbsy34: marker, type = "toroid" !diagnostic toroid - existing LCLS device

lpcbsy = 0.3 !TBD

bsybeg: marker
fftborgn: marker
s100: marker !station 100
zlin15: marker !station-100 (or "S100"): Z=3048.0 (Z'=X'=Y'=0.0 m)
bsy1beg: marker
swivel: marker !"swivel point"
bsy1end: marker

! wooden BSY door (separates LI30 from BSY)

wooddoor: marker



