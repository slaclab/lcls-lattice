! wiggler for sync. light energy diagnostic (described in SLAC-PUB-3945)
! based on FACET optics model (M. Woodley)
! (series approximation for sinc(x)=sin(x)/x to enable setting with x=0)

bwgh = 1.e-12                  !wiggler bend field (kG)
awgh = asin(bwgh*zwhp/(ef*cb)) !bend angle per half-pole
awgh2 = awgh*awgh
awgh4 = awgh2*awgh2
awgh6 = awgh4*awgh2
sinch = 1-awgh2/6+awgh4/120-awgh6/5040
lwgh = zwhp/sinch              !half-pole path length

awg1h = asin(sin(awgh)/2) !"short half" half-pole bend angle
awg1h2 = awg1h*awg1h
awg1h4 = awg1h2*awg1h2
awg1h6 = awg1h4*awg1h2
sinc1h = 1-awg1h2/6+awg1h4/120-awg1h6/5040
lwg1h = (zwhp/2)/sinc1h   !"short half" half-pole path length

awg2h = awgh-awg1h        !"long half" half-pole bend angle
lwg2h = lwgh-lwg1h        !"long half" half-pole path length

wig1ha: sbend, hgap = gwig/2, e1 = 0, e2 = 0, fint = 0.5, fintx = 0, type = "@3,SLC wiggler",  &
        ref_tilt = pi/2, l = lwg1h, angle = lwg1h * awg1h/lwg1h
wig1hb: sbend, hgap = gwig/2, e1 = 0, e2 = awgh, fint = 0, fintx = 0.5, type = "@3,SLC wiggler",  &
        ref_tilt = pi/2, l = lwg2h, angle = lwg2h * awg2h/lwg2h
wig2ha: sbend, hgap = gwig/2, e1 = -awgh, e2 = 0, fint = 0.5, fintx = 0, type = "@3,SLC wiggler" &
        , ref_tilt = pi/2, l = lwgh, angle = lwgh * (-awgh)/lwgh
wig2hb: sbend, hgap = gwig/2, e1 = 0, e2 = -awgh, fint = 0, fintx = 0.5, type = "@3,SLC wiggler" &
        , ref_tilt = pi/2, l = lwgh, angle = lwgh * (-awgh)/lwgh
wig3ha: sbend, hgap = gwig/2, e1 = awgh, e2 = 0, fint = 0.5, fintx = 0, type = "@3,SLC wiggler",  &
        ref_tilt = pi/2, l = lwg2h, angle = lwg2h * awg2h/lwg2h
wig3hb: sbend, hgap = gwig/2, e1 = 0, e2 = 0, fint = 0, fintx = 0.5, type = "@3,SLC wiggler",  &
        ref_tilt = pi/2, l = lwg1h, angle = lwg1h * awg1h/lwg1h

ldwgh = zdwg/cos(awgh)

dwgh: drift, l = ldwgh

ycwigh: kicker, type = "@3,wiggler trim"

ewigh: line = (wig1ha, wig1hb, dwgh, wig2ha, ycwigh, wig2hb, dwgh, wig3ha, wig3hb, cntwigh)

