pcbsy5: instrument, type = "BCS plate", l = lplate !shielding plate
st61: instrument, type = "PPS stopper", l = 0.76   !backup stopper

pcapm1: ecollimator, type = "MPS PC", l = lpcapm, x_limit = 44.45e-3, y_limit = 6.35e-3
pcapm2: ecollimator, type = "MPS PC", l = lpcapm, x_limit = 44.45e-3, y_limit = 6.35e-3
pcapm3: ecollimator, type = "MPS PC", l = lpcapm, x_limit = 44.45e-3, y_limit = 6.35e-3
pcapm4: ecollimator, type = "MPS PC", l = lpcapm, x_limit = 44.45e-3, y_limit = 6.35e-3
pcbsyh: ecollimator, type = "@1,MPS PC", l = 0.45, x_limit = 25.4e-3, y_limit = 25.4e-3 !installed, then removed
pc90: ecollimator, l = lpc90, x_limit = 10.2e-3, y_limit = 10.2e-3 !existing protection collimator in BSY
pc119: ecollimator, l = lpc119, x_limit = 10.2e-3, y_limit = 10.2e-3 !existing protection collimator in BSY

cxq6: rcollimator, type = "HCOLL", l = ljaw, x_limit = 1.7e-3, y_limit = 20.e-3

muwall: marker !front face of muon wall for HXR beam
dumpbsyh: marker !front face of BSY dump for HXR beam
bsyend: marker !LTUH side of muon plug wall: Z=3224.022426 (Z'=176.020508 m, X'=0.0 m, Y'=-0.821761 m)
rwwake3h: marker, type = "WAKE" !BSY/SPRDH beampipe wake applied here



