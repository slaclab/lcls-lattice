dd12a: drift, l = 0.25-0.0079372+0.06
dd12b: drift, l = 0.0079372
dd12c: drift, l = 0.25+0.06
dd2a: drift, l = 0.4+0.0634916+0.0115084
dd2c: drift, l = 1.0
dd2b: drift, l = 8.1507760-lqd/2+ddmpv-dd2c[l]+0.06
dd3a: drift, l = 0.3+0.049684+0.001583
dd3b: drift, l = 0.3-0.001583-0.1447026
dwsdumpa: drift, l = 0.44156/2
dwsdumpa1: drift, l = 0.07596510786
dwsdumpa2: drift, l = dwsdumpa[l]-dwsdumpa1[l]
dwsdumpb: drift, l = 0.44156-dwsdumpa[l]
dwsdumpc: drift, l = 2.038949 +ddwsdump
ddump: drift, l = 61.120*in2m !length of EBD dump (per A. Ibrahimov)

bpmqdb: monitor, type = "Stripline-11" !RFBQDB : MONI, TYPE="@2,CavityL-1"
bpmddb: monitor, type = "Stripline-8"
rfbddb: monitor, type = "@2,CavityL-1"

xcddb: hkicker, type = "class-5"

ycddb: vkicker, type = "class-5"

