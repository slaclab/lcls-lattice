! ==============================================================================
! HXR LTU and dump
! ==============================================================================

! ------------------------------------------------------------------------------
! HXR R56 compensating chicanes
! - use series approximation for sinc(x)=sin(x)/x to allow zero field
! ------------------------------------------------------------------------------

! Brhof  : beam rigidity at chicane (kG-m)
! GBCC   : gap height (m)
! ZBCC   : magnet Z-length along axis (m)
! ZDCC   : Z-space between magnets (m)
! BBX..  : chicane bend field (kG) at 4 GeV
! ABX..  : chicane bend angle (rad)
! LBX..  : chicane bend path length (m)
! ABX..S : "short" half chicane bend angle (rad)
! ABX..L : "long" half chicane bend angle (rad)
! LBX..S : "short" half chicane bend path length (m)
! LBX..L : "long" half chicane bend path length (m)

bbx31 = 0.0*ef/4.0
arg31 = zbcc*bbx31/brhof
abx31 = asin(arg31)
abx31_2 = abx31*abx31
abx31_4 = abx31_2*abx31_2
abx31_6 = abx31_4*abx31_2
sinc31 = 1.0-abx31_2/6+abx31_4/120-abx31_6/5040
lbx31 = zbcc/sinc31
abx31s = asin(arg31/2)
abx31s_2 = abx31s*abx31s
abx31s_4 = abx31s_2*abx31s_2
abx31s_6 = abx31s_4*abx31s_2
sinc31s = 1.0-abx31s_2/6+abx31s_4/120-abx31s_6/5040
lbx31s = zbcc/(2*sinc31s)
abx31l = abx31-abx31s
lbx31l = lbx31-lbx31s

bcx311a: sbend, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "@2,0.788D11.50", l =  &
        lbx31s, angle = lbx31s * (+abx31s)/lbx31s
bcx311b: sbend, e2 = +abx31, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "@2,0.788D11.50", l =  &
        lbx31l, angle = lbx31l * (+abx31l)/lbx31l
bcx312a: sbend, e1 = -abx31, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "@2,0.788D11.50", l =  &
        lbx31l, angle = lbx31l * (-abx31l)/lbx31l
bcx312b: sbend, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "@2,0.788D11.50", l =  &
        lbx31s, angle = lbx31s * (-abx31s)/lbx31s
bcx313a: sbend, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "@2,0.788D11.50", l =  &
        lbx31s, angle = lbx31s * (-abx31s)/lbx31s
bcx313b: sbend, e2 = -abx31, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "@2,0.788D11.50", l =  &
        lbx31l, angle = lbx31l * (-abx31l)/lbx31l
bcx314a: sbend, e1 = +abx31, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "@2,0.788D11.50", l =  &
        lbx31l, angle = lbx31l * (+abx31l)/lbx31l
bcx314b: sbend, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "@2,0.788D11.50", l =  &
        lbx31s, angle = lbx31s * (+abx31s)/lbx31s

dcc31o: drift, l = zdcc/cos(abx31), type = "CSR"
dcc31i: drift, l = zdcc, type = "CSR"

cc31beg: marker
cc31end: marker

cc31: line = (cc31beg, bcx311a, bcx311b, dcc31o, bcx312a, bcx312b, dcc31i, bcx313a, bcx313b,  &
        dcc31o, bcx314a, bcx314b, cc31end)

bbx32 = 2.3628*sqrt(2.0)*ef/4.0*1.15
arg32 = zbcc*bbx32/brhof
abx32 = asin(arg32)
abx32_2 = abx32*abx32
abx32_4 = abx32_2*abx32_2
abx32_6 = abx32_4*abx32_2
sinc32 = 1-abx32_2/6+abx32_4/120-abx32_6/5040
lbx32 = zbcc/sinc32
abx32s = asin(arg32/2)
abx32s_2 = abx32s*abx32s
abx32s_4 = abx32s_2*abx32s_2
abx32s_6 = abx32s_4*abx32s_2
sinc32s = 1-abx32s_2/6+abx32s_4/120-abx32s_6/5040
lbx32s = zbcc/(2*sinc32s)
abx32l = abx32-abx32s
lbx32l = lbx32-lbx32s

bcx321a: sbend, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l = lbx32s,  &
        angle = lbx32s * (+abx32s)/lbx32s
bcx321b: sbend, e2 = +abx32, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l =  &
        lbx32l, angle = lbx32l * (+abx32l)/lbx32l
bcx322a: sbend, e1 = -abx32, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l =  &
        lbx32l, angle = lbx32l * (-abx32l)/lbx32l
bcx322b: sbend, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l = lbx32s,  &
        angle = lbx32s * (-abx32s)/lbx32s
bcx323a: sbend, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l = lbx32s,  &
        angle = lbx32s * (-abx32s)/lbx32s
bcx323b: sbend, e2 = -abx32, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l =  &
        lbx32l, angle = lbx32l * (-abx32l)/lbx32l
bcx324a: sbend, e1 = +abx32, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l =  &
        lbx32l, angle = lbx32l * (+abx32l)/lbx32l
bcx324b: sbend, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l = lbx32s,  &
        angle = lbx32s * (+abx32s)/lbx32s

dcc32o: drift, l = zdcc/cos(abx32), type = "CSR"
dcc32i: drift, l = zdcc, type = "CSR"

cc32beg: marker
cc32end: marker

cc32: line = (cc32beg, bcx321a, bcx321b, dcc32o, bcx322a, bcx322b, dcc32i, bcx323a, bcx323b,  &
        dcc32o, bcx324a, bcx324b, cc32end)

bbx35 = 2.3628*ef/4.0*1.15
arg35 = zbcc*bbx35/brhof
abx35 = asin(arg35)
abx35_2 = abx35*abx35
abx35_4 = abx35_2*abx35_2
abx35_6 = abx35_4*abx35_2
sinc35 = 1-abx35_2/6+abx35_4/120-abx35_6/5040
lbx35 = zbcc/sinc35
abx35s = asin(arg35/2)
abx35s_2 = abx35s*abx35s
abx35s_4 = abx35s_2*abx35s_2
abx35s_6 = abx35s_4*abx35s_2
sinc35s = 1-abx35s_2/6+abx35s_4/120-abx35s_6/5040
lbx35s = zbcc/(2*sinc35s)
abx35l = abx35-abx35s
lbx35l = lbx35-lbx35s

bcx351a: sbend, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l = lbx35s,  &
        angle = lbx35s * (+abx35s)/lbx35s
bcx351b: sbend, e2 = +abx35, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l =  &
        lbx35l, angle = lbx35l * (+abx35l)/lbx35l
bcx352a: sbend, e1 = -abx35, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l =  &
        lbx35l, angle = lbx35l * (-abx35l)/lbx35l
bcx352b: sbend, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l = lbx35s,  &
        angle = lbx35s * (-abx35s)/lbx35s
bcx353a: sbend, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l = lbx35s,  &
        angle = lbx35s * (-abx35s)/lbx35s
bcx353b: sbend, e2 = -abx35, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l =  &
        lbx35l, angle = lbx35l * (-abx35l)/lbx35l
bcx354a: sbend, e1 = +abx35, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "0.788D11.50", l =  &
        lbx35l, angle = lbx35l * (+abx35l)/lbx35l
bcx354b: sbend, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "0.788D11.50", l = lbx35s,  &
        angle = lbx35s * (+abx35s)/lbx35s

dcc35o: drift, l = zdcc/cos(abx35), type = "CSR"
dcc35i: drift, l = zdcc, type = "CSR"

cc35beg: marker
cc35end: marker

cc35: line = (cc35beg, bcx351a, bcx351b, dcc35o, bcx352a, bcx352b, dcc35i, bcx353a, bcx353b,  &
        dcc35o, bcx354a, bcx354b, cc35end)

bbx36 = 2.3628*ef/4.0*1.15
