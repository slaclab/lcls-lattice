ws31b: marker, type = "fast" !LTU emittance
ws32b: marker, type = "fast" !LTU emittance
ws33b: marker, type = "fast" !LTU emittance
ws34b: marker, type = "fast" !LTU emittance

btm10b: instrument, type = "BCS BTM"
btm11b: instrument, type = "BCS BTM"
btm12b: instrument, type = "BCS BTM"
btm13b: instrument, type = "BCS BTM"
btm14b: instrument, type = "BCS BTM"

dcx31b: drift, l = 0.08
dcy32b: drift, l = 0.08
dcx35b: drift, l = 0.08
dcy36b: drift, l = 0.08

dbmark36b: marker !center of WS31B

! ==============================================================================
! XLEAP-II devices
! ==============================================================================

! ------------------------------------------------------------------------------
! recycled LCLS undulators
! ------------------------------------------------------------------------------

gamxl = eu/mc2       !Lorentz energy factor [ ]
kund = 50           !undulator parameter (rms) [ ]
lamu = 0.40         !undulator period [m]
lseg = 3.400        !undulator segment length [m]
lue = 0.035        !undulator termination length (approx) [m]
lund = lseg-2*lue !undulator segment length without terminations [m]
lundh = lund/2       !undulator segment half-length [m]

! natural undulator focusing "k" in y-plane [m^-2]

kqund = setxleap2*(kund*2*pi/lamu/sqrt(2)/gamxl)^2

! handle K_und->0 (undulator moved out of beam) by expressing R34 as an
! approximate SINC function

argu = lundh*sqrt(kqund)
argu2 = argu*argu
argu4 = argu2*argu2
argu6 = argu4*argu2
sincargu = 1-argu2/6+argu4/120-argu6/5040 !~sinc(ARGu)=sin(ARGu)/ARGu
r34u = lundh*sincargu

! undulator segment modeled as R-matrix to include vertical natural focusing
! over all but its edge terminations:

umxlh: taylor, type = "LCLS-I", l = lundh, {1: 1.0, 1 0 0 0 0 0}, {1: lundh, 0 1 0 0 0 0}, {2:  &
        0.0, 1 0 0 0 0 0}, {2: 1.0, 0 1 0 0 0 0}, {3: cos(argu), 0 0 1 0 0 0}, {3: r34u,  &
        0 0 0 1 0 0}, {4: -sin(argu)*sqrt(kqund), 0 0 1 0 0 0}, {4: cos(argu), 0 0 0 1 0 0}

umxl1h: umxlh
umxl2h: umxlh
umxl3h: umxlh
umxl4h: umxlh

shrt = 0.470                                 !standard short break length [m]
lrfbu = 0                                     !undulator RF-BPM only implemented as zero length monitor
lbr1 = 6.889e-2                              !und-seg to quad [m]
lbr3 = 9.111e-2                              !quad to BPM [m]
lbr4 = 5.8577e-2                             !radiation monitor to segment [m]
lbrwm = 7.1683e-2                             !BFW to radiation monitor [m]
lbrs = shrt-lrfbu-0.078-lbr1-lbr3-lbr4-lbrwm !standard short break length (BPM-to-quad distance) [m]

dlbfw = 3.6016-3.63815 !BFW location adjustment per H. Loos

dbrs: drift, l = lbrs-dlbfw  !standard short undulator drift from BPM to segment
dbwm: drift, l = lbrwm+dlbfw !BFW to radiation monitor drift
db4: drift, l = lbr4        !radiation monitor to segment drift
dt: drift, l = lue         !undulator segment small terminations modeled as drift
duu: drift, l = 0.238/2     !undulator pair half-drift

rfbxl1: instrument, l = lrfbu, type = "01_um_res" !undulator BPM
rfbxl2: instrument, l = lrfbu, type = "01_um_res" !undulator BPM
rfbxl3: instrument, l = lrfbu, type = "01_um_res" !undulator BPM
rfbxl4: instrument, l = lrfbu, type = "01_um_res" !undulator BPM

bfwxl1: instrument !Beam Finder Wire
bfwxl2: instrument !Beam Finder Wire
bfwxl3: instrument !Beam Finder Wire
bfwxl4: instrument !Beam Finder Wire

xl2und1: line = (rfbxl1, dbrs, bfwxl1, dbwm, db4, dt, umxl1h, umxl1h, dt)
xl2und2: line = (rfbxl2, dbrs, bfwxl2, dbwm, db4, dt, umxl2h, umxl2h, dt)
xl2und3: line = (rfbxl3, dbrs, bfwxl3, dbwm, db4, dt, umxl3h, umxl3h, dt)
xl2und4: line = (rfbxl4, dbrs, bfwxl4, dbwm, db4, dt, umxl4h, umxl4h, dt)

lxl2und = 2*(rfbxl1[l]+dbrs[l]+bfwxl1[l]+dbwm[l]+db4[l]+dt[l]+umxl1h[l]+umxl1h[l]+dt[l])+2*duu[l]

! drifts around undulator pair

lxl3132 = dqebx[l]+dcx31b[l]+dqebx2[l]+de3aba[l]
dxlua: drift, l = (lxl3132-lxl2und)/2
dxlub: drift, l = lxl3132-lxl2und-dxlua[l]
 !VALUE, DXLUa[L],DXLUb[L]

! ------------------------------------------------------------------------------
! original XLEAP self-seeding chicane (normally OFF)
! ------------------------------------------------------------------------------

! - from RadiaBeam (C-bends; 0.75 T peak field; 1 degree max)
! - use series approximation for sinc(x)=sin(x)/x to allow ABXL=0
! - deflects toward -X (to the right/south/aisle)

! GBXL  : 1D19.7 gap height (m)
! ZBXL  : 1D19.7 "Z" length (m)
! FBXL  : measured fringe field
! ABXL  : chicane bend angle (rad)
! BBXL  : chicane bend field (kG)
! LBXL  : chicane bend path length (m)
! ABXLs : "short" half chicane bend angle (rad)
! LBXLs : "short" half chicane bend path length (m)
! ABXLl : "long" half chicane bend angle (rad)
! LBXLl : "long" half chicane bend path length (m)

! BCXXL1 gets an X-offset of  -5 mm (toward the aisle)
! BCXXL2 gets an X-offset of -12 mm (toward the aisle)
! BCXXL3 gets an X-offset of -12 mm (toward the aisle)
! BCXXL4 gets an X-offset of  -5 mm (toward the aisle)

gbxl = 0.008
zbxl = 0.364
fbxl = 0.5
abxl0 = 0.0174 !R56=0.56 mm
abxl = abxl0*setxleap2
bbxl = brhof*sin(abxl)/zbxl
abxl_2 = abxl*abxl
abxl_4 = abxl_2*abxl_2
abxl_6 = abxl_4*abxl_2
sincabxl = 1-abxl_2/6+abxl_4/120-abxl_6/5040 !~sinc(ABXL)=sin(ABXL)/ABXL
lbxl = zbxl/sincabxl
abxls = asin(sin(abxl)/2)
abxls_2 = abxls*abxls
abxls_4 = abxls_2*abxls_2
abxls_6 = abxls_4*abxls_2
sincabxls = 1-abxls_2/6+abxls_4/120-abxls_6/5040 !~sinc(ABXLs)=sin(ABXLs)/ABXLs
lbxls = zbxl/(2*sincabxls)
abxll = abxl-abxls
lbxll = lbxl-lbxls

bcxxl1a: sbend, hgap = gbxl/2, e1 = 0, fint = fbxl, fintx = 0, type = "0.3D14", l = lbxls, angle &
         = lbxls * (+abxls)/lbxls
bcxxl1b: sbend, hgap = gbxl/2, fint = 0, e2 = +abxll, fintx = fbxl, type = "0.3D14", l = lbxll,  &
        angle = lbxll * (+abxll)/lbxll
bcxxl2a: sbend, hgap = gbxl/2, e1 = -abxll, fint = fbxl, fintx = 0, type = "0.3D14", l = lbxll,  &
        angle = lbxll * (-abxll)/lbxll
bcxxl2b: sbend, hgap = gbxl/2, fint = 0, e2 = 0, fintx = fbxl, type = "0.3D14", l = lbxls, angle &
         = lbxls * (-abxls)/lbxls
bcxxl3a: sbend, hgap = gbxl/2, e1 = 0, fint = fbxl, fintx = 0, type = "0.3D14", l = lbxls, angle &
         = lbxls * (-abxls)/lbxls
bcxxl3b: sbend, hgap = gbxl/2, fint = 0, e2 = -abxll, fintx = fbxl, type = "0.3D14", l = lbxll,  &
        angle = lbxll * (-abxll)/lbxll
bcxxl4a: sbend, hgap = gbxl/2, e1 = +abxll, fint = fbxl, fintx = 0, type = "0.3D14", l = lbxll,  &
        angle = lbxll * (+abxll)/lbxll
bcxxl4b: sbend, hgap = gbxl/2, fint = 0, e2 = 0, fintx = fbxl, type = "0.3D14", l = lbxls, angle &
         = lbxls * (+abxls)/lbxls

! magnet-to-magnet path lengths

zdxlo = 1.046-zbxl !outer bend-to-bend Z distance (m)
zdxli = 0.520-zbxl !inner bend-to-bend Z distance (m)

dxlo: drift, l = zdxlo/cos(abxl)
dxli: drift, l = zdxli/2

lbcxl = 4*zbxl+2*zdxlo+zdxli !chicane length

! MARKers

bcxlssbeg: marker
bcxlssmid: marker
bcxlssend: marker

! beamline

bcxlss: line = (bcxlssbeg, bcxxl1a, bcxxl1b, dxlo, bcxxl2a, bcxxl2b, dxli, bcxlssmid, dxli,  &
        bcxxl3a, bcxxl3b, dxlo, bcxxl4a, bcxxl4b, bcxlssend)

! drifts around chicane and undulator pair

lxl3536 = dqebx[l]+dcx35b[l]+dqebx2[l]+de3[l]

dxluc: drift, l = 3.5
dxlud: drift, l = 1.0
dxlue: drift, l = lxl3536-dxluc[l]-lbcxl-dxlud[l]-lxl2und
 !VALUE, DXLUc[L],DXLUd[L],DXLUe[L]

! ------------------------------------------------------------------------------
! original XLEAP wiggler
! ------------------------------------------------------------------------------

! wiggler is modeled as R-matrix to include natural vertical focusing;
! it is nominally OFF (opened to full gap, with Kwig~2); at minimum gap, Kwig=50

kwig = 34                                        !wiggler parameter [m^-1]
lamw = 0.34                                      !wiggler period [m]
lwigh = 2.38/2                                    !wiggler half-length [m]
gamw = eu/mc2                                    !Lorentz energy factor in wiggler [ ]
kqwig = setxleap2*(2*pi*kwig/lamw/sqrt(2)/gamw)^2 !natural vertical focusing "k" [m^-2]

! handle Kwig->0 by expressing R34 as an approximate SINC function

argw = lwigh*sqrt(kqwig)
argw2 = argw*argw
argw4 = argw2*argw2
argw6 = argw4*argw2
sincargw = 1-argw2/6+argw4/120-argw6/5040 !~sinc(ARGw)=sin(ARGw)/ARGw
r34w = lwigh*sincargw

wigxlh: taylor, type = "variable gap", l = lwigh, {1: 1.0, 1 0 0 0 0 0}, {1: lwigh, 0 1 0 0 0 0} &
        , {2: 0.0, 1 0 0 0 0 0}, {2: 1.0, 0 1 0 0 0 0}, {3: cos(argw), 0 0 1 0 0 0}, {3: r34w,  &
        0 0 0 1 0 0}, {4: -sin(argw)*sqrt(kqwig), 0 0 1 0 0 0}, {4: cos(argw), 0 0 0 1 0 0}

 !VALUE, WIGXLh[R11],WIGXLh[R12],WIGXLh[R21],WIGXLh[R22]
 !VALUE, WIGXLh[R33],WIGXLh[R34],WIGXLh[R43],WIGXLh[R44]

! ------------------------------------------------------------------------------
! SXR emittance diagnostic beamline
! ------------------------------------------------------------------------------

edmchb: line = (d25cmb, d25cmc, dmm1m90cmba, btm10b, dmm1m90cmbb, xcem1b, dem1a, qem1b, bpmem1b,  &
        qem1b, dem1bab, dem1bbb, qem2b, bpmem2b, qem2b, dem2b, ycem2b, dmm3m80cmx, xcem3b, dem3a &
        , qem3b, bpmem3b, qem3b, dem3bb, qem3vb, qem3vb, dmm4m90cmba, btm11b, dmm4m90cmbb, ycem4b &
        , dem4a, qem4b, bpmem4b, qem4b, drfb, rfbem4b, dmm5ab, dmm5bb)

 !XLEAP2a : LINE=(DQEBx,DCX31B,DQEBx2,DE3aBa)
xleap2a: line = (dxlua, xl2und1, duu, duu, xl2und2, dxlub)

 !XLEAP2b : LINE=(DQEBx,DCX35B,DQEBx2,DE3)
xleap2b: line = (dxluc, bcxlss, dxlud, xl2und3, duu, duu, xl2und4, dxlue)

edsysb: line = (dbmark36b, ws31b, d40cm, de3mab, de3mbb, xce31b, dqea, qe31b, bpme31b, qe31b,  &
        xleap2a, btm12b, de3abb, yce32b, dqeaa, qe32b, bpme32b, qe32b, drfb, rfbe32b, dqeby1,  &
        dcy32b, dqeby2, ws32b, d40cm, de3m80cmb, xce33b, dqeab, qe33b, bpme33b, qe33b, dqecba,  &
        btm13b, dqecbb, de3m40cm, yce34b, dqea, qe34b, bpme34b, qe34b, drfb, rfbe34b, dqec1,  &
        ws33b, d40cm, de3m80cmba, btm14b, de3m80cmbb, xce35b, dqeac, qe35b, bpme35b, qe35b,  &
        xleap2b, yce36b, dqea, qe36b, bpme36b, qe36b, drfb, rfbe36b, dqeby1, dcy36b, dqeby2,  &
        ws34b, d40cm)

ecellb: line = (qe31b, dqec, dqec, qe32b, qe32b, dqec, dqec, qe31b)

! ------------------------------------------------------------------------------
! SXR undulator match
! ------------------------------------------------------------------------------

! note: the below K-values are for SC beam; the settings for Cu beam are
! in the "LCLS2cu_main.mad8" file

kqum1b = 0.347147476566
kqum2b = -0.13
kqum3b = 0.385625357669
kqum4b = -0.628348037766

qum1b: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqum1b
qum2b: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqum2b
qum3b: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqum3b
qum4b: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqum4b

du1m80cm: drift, l = 4.550
du1m80cmba: drift, l = 0.384174
du1m80cmbb: drift, l = du1m80cm[l]-du1m80cmba[l]
dcx37: drift, l = 0.08
dcy38: drift, l = 0.08
d32cmcb: drift, l = 1.30046+(lqa-lqe)/2+0.5
dum1a: drift, l = 0.49
dum1b: drift, l = 0.47046
d32cm: drift, l = 0.32
du2m120cmb: drift, l = 3.730+(lqa-lqe)-0.5
d32cma: drift, l = 0.42046
dum2a: drift, l = 0.37
dum2b: drift, l = 0.47046
du3m80cm: drift, l = 7.29046
du3m80cmb: drift, l = du3m80cm[l]+(lqa-lqe)
dum3a: drift, l = 0.38
dum3b: drift, l = 0.47046
d40cma: drift, l = 1.807939
du4m120cm: drift, l = 1.362521
du4m120cmb: drift, l = du4m120cm[l]+(lqa-lqe)
dum4a: drift, l = 0.50
dum4b: drift, l = 0.59746
du5m80cm: drift, l = 0.5
du5m80cmb: drift, l = du5m80cm[l]+(lqa-lqe)/2
duhwall1: drift, l = 0.250825 !length of BTH/UH wall-1
duhvest: drift, l = 2.009175 !length of BTH/UH vestibule
duhvesta: drift, l = 1.605684
duhvestb: drift, l = duhvest[l]-duhvesta[l]
duhwall2: drift, l = 0.250825 !length of BTH/UH wall-2
dw2tdundb: drift, l = 3.001537 !drift from BTH/UH wall-2 to TDUNDB u/s flange
dtdund1: drift, l = 0.855853 !from u/s TDUND flange to TDUND center
dtdund2: drift, l = 0.347853 !from TDUND center to d/s TDUND flange
dpcmuon: drift, l = 0.031498
dmuon1: drift, l = 0.154859+0.05
dmuon3b: drift, l = 0.310592-0.05

dw2tdb1: drift, l = 61.51*in2m-wigxlh[l]
dw2tdb2: drift, l = dw2tdundb[l]-dw2tdb1[l]-2*wigxlh[l]
 !VALUE, DW2TDb1[L],DW2TDb2[L]
 !VALUE, DW2TDb1[L]+2*WIGXLh[L]+DW2TDb2[L],DW2TDUNDb[L]

bpmum1b: instrument, type = "Stripline-2"
bpmum2b: instrument, type = "Stripline-2"
bpmum3b: instrument, type = "Stripline-2"
bpmum4b: instrument, type = "Stripline-2"

xcum1b: kicker, type = "class-4f" !fast-feedback (loop-5)
xcum3b: kicker, type = "class-4f" !fast-feedback (loop-5)

ycum2b: kicker, type = "class-4f" !fast-feedback (loop-5)
ycum4b: kicker, type = "class-4f" !fast-feedback (loop-5)

btm15b: instrument, type = "BCS BTM"
tdundb: instrument !LTU insertable block at und. extension entrance (w/ screen)

! Note: PCMUONb Y-aperture violates standard BSC -- approved by P. Emma

pcmuonb: ecollimator, x_limit = 8.64e-3/2, y_limit = 4.32e-3/2, l = 1.1684 !muon scattering collimator

vv999b: marker !vacuum valve just upbeam of undulator - TBD
pfilt1b: marker
mm1b: marker
mm2b: marker
mm3b: marker
muwallb: marker !front face of muon wall for SXR beam
dumpbsys: marker !front face of BSY dump for SXR beam
bsyendb: marker !FFTB side of muon plug wall
muhwall1b: marker !upstream end of BTH/UH wall-1
muhwall2b: marker !upstream end of BTH/UH wall-2
dbmark37b: marker !end of undulator match
rwwake5s: marker, type = "WAKE" !LTU beampipe wake applied here

 !LW2TDb : LINE=(DW2TDUNDb)
lw2tdb: line = (dw2tdb1, 2*wigxlh, dw2tdb2)

unmchb: line = (du1m80cmba, btm15b, du1m80cmbb, dcx37, d32cmcb, dum1a, qum1b, bpmum1b, qum1b,  &
        dum1b, xcum1b, d32cm, du2m120cmb, dcy38, d32cma, ycum2b, dum2a, qum2b, bpmum2b, qum2b,  &
        dum2b, du3m80cmb, xcum3b, dum3a, qum3b, bpmum3b, qum3b, dum3b, d40cma, du4m120cmb, ycum4b &
        , dum4a, qum4b, bpmum4b, qum4b, dum4b, du5m80cmb, d40cmw, muhwall1b, duhwall1, duhvest,  &
        muhwall2b, duhwall2, lw2tdb, dtdund1, tdundb, dtdund2, dpcmuon, pcmuonb, dmuon1, vv999b,  &
        dmuon3b, mm3b, pfilt1b, dbmark37b)

ltusc: line = (mm1b, dl2sc, vbsysb, mm2b, edmchb, edsysb, unmchb)

bsyltusc: line = (muwallb, dwalla, dumpbsys, dwallb, bsyendb, endsps, dbldl21, ltusc, rwwake5s)

! ------------------------------------------------------------------------------
! SXR dumpline
! ------------------------------------------------------------------------------

kqdmpb = -0.154946553294

qdmp1b: quadrupole, type = "3.94Q17", l = lqp/2, aperture = rqp, k1 = kqdmpb
qdmp2b: quadrupole, type = "3.94Q17", l = lqp/2, aperture = rqp, k1 = kqdmpb

lbyds = 0.5   !effective straight length of dump soft bend 1.26D18.43
gbyds = 0.032 !full gap of dump soft bend
abyds = 6.e-4
leffbyds = lbyds*abyds/(2*sin(abyds/2)) !bend path length (m)

bydssa: sbend, hgap = gbyds/2, e1 = abyds/2, e2 = 0, fint = 0.5, fintx = 0.0, type = "1.26D18.43" &
        , ref_tilt = pi/2, l = leffbyds/2, angle = leffbyds/2 * abyds/2/(leffbyds/2)
bydssb: sbend, hgap = gbyds/2, e1 = 0, e2 = abyds/2, fint = 0.0, fintx = 0.5, type = "1.26D18.43" &
        , ref_tilt = pi/2, l = leffbyds/2, angle = leffbyds/2 * abyds/2/(leffbyds/2)

lbdm = 1.452  !effective straight bend length of main dump bends - from J. Tanabe (m)
gbdm = 0.043  !full gap (m) of main dump bends (SA-380-328-03 shows magnet half-gap = 0.866")
fbdm = 0.5513 !measured FINT
abdm = 0.02240073511             !angle per main dump bend (rad)
leffbdm = lbdm*abdm/(2*sin(abdm/2)) !bend path length (m)

byd1ba: sbend, hgap = gbdm/2, e1 = abdm/2, e2 = 0, fint = fbdm, fintx = 0.00, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)
byd1bb: sbend, hgap = gbdm/2, e1 = 0, e2 = abdm/2, fint = 0.00, fintx = fbdm, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)

byd2ba: sbend, hgap = gbdm/2, e1 = abdm/2, e2 = 0, fint = fbdm, fintx = 0.00, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)
byd2bb: sbend, hgap = gbdm/2, e1 = 0, e2 = abdm/2, fint = 0.00, fintx = fbdm, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)

byd3ba: sbend, hgap = gbdm/2, e1 = abdm/2, e2 = 0, fint = fbdm, fintx = 0.00, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)
byd3bb: sbend, hgap = gbdm/2, e1 = 0, e2 = abdm/2, fint = 0.00, fintx = fbdm, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)

pcpm1lb: ecollimator, x_limit = 14.2875e-3, y_limit = 14.2875e-3, l = lpcpm
pcpm2lb: ecollimator, x_limit = 38.1e-3, y_limit = 38.1e-3, l = lpcpm

lds1 = 0.3158763
lds = 0.247946
ldmp1 = 11.516159251113 !BYD3/BYD3B to QDmp1/QDmp1B
ddmpv = -0.73352263654
ddwsdump = 0.248126313572 !set Z at DUMPFACEB

ds1: drift, l = lds1
ds: drift, l = lds
dd1ba: drift, l = 0.577681352129
dd1bb: drift, l = 1.000087502327
dd1bc: drift, l = 0.3048
dd1be: drift, l = 0.24963810293
dd1bf: drift, l = 0.409240108574
