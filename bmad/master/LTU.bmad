!Old split line: line = (qum4b, bpmum4b, qum4b)

qum4b_full: line = (qum4b)
qum4b[L] = 2*qum4b[L]
bpmum4b[superimpose] = T
bpmum4b[ref] = qum4b

unmchb: line = (du1m80cm, dcx37, d32cmcb, dum1a, qum1b_full, dum1b, xcum1b, d32cm, du2m120cmb,  &
        dcy38, d32cma, ycum2b, dum2a, qum2b_full, dum2b, du3m80cmb, xcum3b, dum3a, qum3b_full,  &
        dum3b, d40cma, du4m120cmb, ycum4b, dum4a, qum4b_full, dum4b, du5m80cmb, d40cmw, muhwall1b &
        , duhwall1, duhvest, muhwall2b, duhwall2, lw2tdb, dtdund1, tdundb, dtdund2, dpcmuon,  &
        pcmuonb, dmuon1b, vv999b)

ltusc: line = (mm1b, dl2sc, vbsysb, mm2b, edmchb, edsysb, unmchb)

preunds: line = (dmuon3b, mm3b, pfilt1b, dbmark37b)

bsyltusc: line = (muwallb, dwalla, dumpbsys, dwallb, bsyendb, endsps, dbldl21, ltusc, preunds)

! ------------------------------------------------------------------------------
! SXR dumpline
! ------------------------------------------------------------------------------

kqdmpb = -0.155745965723 !-0.15522011426

qdmp1b: quadrupole, type = "3.94Q17", l = lqp/2, aperture = rqp, k1 = kqdmpb
qdmp2b: quadrupole, type = "3.94Q17", l = lqp/2, aperture = rqp, k1 = kqdmpb

lbyds = 0.5   !effective straight length of dump soft bend 1.26D18.43
gbyds = 0.032 !full gap of dump soft bend
abyds = 6.e-4
leffbyds = lbyds*abyds/(2*sin(abyds/2)) !bend path length (m)

bydss1: sbend, hgap = gbyds/2, e1 = abyds/2, e2 = 0, fint = 0.5, fintx = 0.0, type = "1.26D18.43" &
        , ref_tilt = pi/2, l = leffbyds/2, angle = leffbyds/2 * abyds/2/(leffbyds/2)
bydss2: sbend, hgap = gbyds/2, e1 = 0, e2 = abyds/2, fint = 0.0, fintx = 0.5, type = "1.26D18.43" &
        , ref_tilt = pi/2, l = leffbyds/2, angle = leffbyds/2 * abyds/2/(leffbyds/2)

! define unsplit SBENs for BMAD ... not used by MAD

bydss: sbend, hgap = gbyds/2, e1 = abyds/2, fint = 0.5, e2 = abyds/2, type = "1.26D18.43",  &
        ref_tilt = pi/2, l = leffbyds, angle = leffbyds * abyds/leffbyds

lbdm = 1.452  !effective straight bend length of main dump bends - from J. Tanabe (m)
gbdm = 0.043  !full gap (m) of main dump bends (SA-380-328-03 shows magnet half-gap = 0.866")
fbdm = 0.5513 !measured FINT
abdm = 0.02240073511             !angle per main dump bend (rad)
leffbdm = lbdm*abdm/(2*sin(abdm/2)) !bend path length (m)

byd1b1: sbend, hgap = gbdm/2, e1 = abdm/2, e2 = 0, fint = fbdm, fintx = 0.0, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)
byd1b2: sbend, hgap = gbdm/2, e1 = 0, e2 = abdm/2, fint = 0.00, fintx = fbdm, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)

byd2b1: sbend, hgap = gbdm/2, e1 = abdm/2, e2 = 0, fint = fbdm, fintx = 0.0, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)
byd2b2: sbend, hgap = gbdm/2, e1 = 0, e2 = abdm/2, fint = 0.00, fintx = fbdm, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)

byd3b1: sbend, hgap = gbdm/2, e1 = abdm/2, e2 = 0, fint = fbdm, fintx = 0.0, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)
byd3b2: sbend, hgap = gbdm/2, e1 = 0, e2 = abdm/2, fint = 0.00, fintx = fbdm, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)

! define unsplit SBENs for BMAD ... not used by MAD

byd1b: sbend, hgap = gbdm/2, e1 = abdm/2, fint = fbdm, e2 = abdm/2, type = "1.69VD55.1", ref_tilt &
         = pi/2, l = leffbdm, angle = leffbdm * abdm/leffbdm
byd2b: sbend, hgap = gbdm/2, e1 = abdm/2, fint = fbdm, e2 = abdm/2, type = "1.69VD55.1", ref_tilt &
         = pi/2, l = leffbdm, angle = leffbdm * abdm/leffbdm
byd3b: sbend, hgap = gbdm/2, e1 = abdm/2, fint = fbdm, e2 = abdm/2, type = "1.69VD55.1", ref_tilt &
         = pi/2, l = leffbdm, angle = leffbdm * abdm/leffbdm

pcpm1lb: ecollimator, x_limit = 14.2875e-3, y_limit = 14.2875e-3, l = lpcpm
pcpm2lb: ecollimator, x_limit = 38.1e-3, y_limit = 38.1e-3, l = lpcpm

lds1 = 0.3158763
lds = 0.247946
ldmp1 = 11.516159251113 !BYD3/BYD3B to QDmp1/QDmp1B
ddmpv = -0.73352263654
ddwsdump = 0.248126313572 !set Z at DUMPFACEB

ds1: drift, l = lds1
ds: drift, l = lds
dd1ba: drift, l = 0.577681352129
dd1bb: drift, l = 1.000087502327
dd1bc: drift, l = 0.3048
dd1be: drift, l = 0.24963810293
dd1bf: drift, l = 0.409240108574
dd1bd: drift, l = ldmp1-(dd1ba[l]+pcpm1lb[l]+dd1bb[l]+dd1bc[l]+dd1be[l]+pcpm2lb[l]+dd1bf[l])
dd12a: drift, l = 0.25-0.0079372+0.06
dd12b: drift, l = 0.0079372
dd12c: drift, l = 0.25+0.06
dd2a: drift, l = 0.4+0.0634916+0.0115084
dd2c: drift, l = 1.0
dd2b: drift, l = 8.1507760-lqd/2+ddmpv-dd2c[l]+0.06
dd3a: drift, l = 0.3+0.049684+0.001583
dd3b: drift, l = 0.3-0.001583-0.1447026
dwsdumpa: drift, l = 0.44156/2
dwsdumpb: drift, l = 0.44156-dwsdumpa[l]
dwsdumpc: drift, l = 2.038949+ddwsdump
ddump: drift, l = 61.120*in2m !length of EBD dump (per A. Ibrahimov)

bpmqdb: instrument, type = "Stripline-8" !RFBQDB : MONI, TYPE="@2,CavityL-1"
bpmddb: instrument, type = "Stripline-8"
rfbddb: instrument, type = "@2,CavityL-1"

xcddb: kicker, type = "class-5"

ycddb: kicker, type = "class-5"

otrdmpb: instrument, type = "@1,OTR" !Dump screen

wsdumpb: marker, type = "@3,special"

mimbcs4b: marker

btm1lb: instrument !Burn-Through-Monitor behind PCPM1LB
btm2lb: instrument !Burn-Through-Monitor behind PCPM2LB
dumpfaceb: instrument !entrance face of main e- dump
btmdumpb: instrument !Burn-Through-Monitor of main e- dump

mqdmpb: marker
dmpendb: marker
dbmark38b: marker !end of final undulator dump

arodmp1s = -0.174519678252
arodmp2s = 0.174913455104

rodmp1s: patch, tilt = arodmp1s
rodmp2s: patch, tilt = arodmp2s

bydss_full: line = (bydss1, bydss2)
byd1b_full: line = (byd1b1, byd1b2)
byd2b_full: line = (byd2b1, byd2b2)
byd3b_full: line = (byd3b1, byd3b2)



!Old split line: line = (qdmp1b, qdmp1b)

qdmp1b_full: line = (qdmp1b)
qdmp1b[L] = 2*qdmp1b[L]


!Old split line: line = (qdmp2b, qdmp2b)

qdmp2b_full: line = (qdmp2b)
qdmp2b[L] = 2*qdmp2b[L]

dumplineb: line = (begdmps_2, rodmp1s, bydss_full, ds1, byd1b_full, ds, byd2b_full, ds,  &
        byd3b_full, dd1ba, pcpm1lb, btm1lb, dd1bb, dd1bc, mimbcs4b, dd1bd, ycddb, dd1be, pcpm2lb &
        , btm2lb, dd1bf, qdmp1b_full, dd12a, bpmqdb, dd12b, mqdmpb, dd12c, qdmp2b_full, dd2a,  &
        xcddb, dd2b, dd2c, dd3a, bpmddb, dd3b, otrdmpb, dwsdumpa, rfbddb, dwsdumpb, wsdumpb,  &
        dwsdumpc, rodmp2s, dumpfaceb, ddump, dmpendb, btmdumpb, dbmark38b, enddmps_2)

! ==============================================================================
! HXR LTU and dump
! ==============================================================================

! ------------------------------------------------------------------------------
! HXR R56 compensating chicanes
! - use series approximation for sinc(x)=sin(x)/x to allow zero field
! ------------------------------------------------------------------------------

! Brhof  : beam rigidity at chicane (kG-m)
! GBCC   : gap height (m)
! ZBCC   : magnet Z-length along axis (m)
! ZDCC   : Z-space between magnets (m)
! BBX..  : chicane bend field (kG) at 4 GeV
! ABX..  : chicane bend angle (rad)
! LBX..  : chicane bend path length (m)
! ABX..S : "short" half chicane bend angle (rad)
! ABX..L : "long" half chicane bend angle (rad)
! LBX..S : "short" half chicane bend path length (m)
! LBX..L : "long" half chicane bend path length (m)

bbx31 = 0.0*ef/4.0
arg31 = zbcc*bbx31/brhof
abx31 = asin(arg31)
abx31_2 = abx31*abx31
abx31_4 = abx31_2*abx31_2
abx31_6 = abx31_4*abx31_2
sinc31 = 1.0-abx31_2/6+abx31_4/120-abx31_6/5040
lbx31 = zbcc/sinc31
abx31s = asin(arg31/2)
abx31s_2 = abx31s*abx31s
abx31s_4 = abx31s_2*abx31s_2
abx31s_6 = abx31s_4*abx31s_2
sinc31s = 1.0-abx31s_2/6+abx31s_4/120-abx31s_6/5040
lbx31s = zbcc/(2*sinc31s)
abx31l = abx31-abx31s
lbx31l = lbx31-lbx31s

bcx3111: sbend, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "@2,0.788D11.50", l =  &
        lbx31s, angle = lbx31s * (+abx31s)/lbx31s
bcx3112: sbend, e2 = +abx31, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "@2,0.788D11.50", l =  &
        lbx31l, angle = lbx31l * (+abx31l)/lbx31l
bcx3121: sbend, e1 = -abx31, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "@2,0.788D11.50", l =  &
        lbx31l, angle = lbx31l * (-abx31l)/lbx31l
bcx3122: sbend, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "@2,0.788D11.50", l =  &
        lbx31s, angle = lbx31s * (-abx31s)/lbx31s
bcx3131: sbend, e1 = 0, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "@2,0.788D11.50", l =  &
        lbx31s, angle = lbx31s * (-abx31s)/lbx31s
bcx3132: sbend, e2 = -abx31, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "@2,0.788D11.50", l =  &
        lbx31l, angle = lbx31l * (-abx31l)/lbx31l
bcx3141: sbend, e1 = +abx31, hgap = gbcc/2, fint = fbcc, fintx = 0, type = "@2,0.788D11.50", l =  &
        lbx31l, angle = lbx31l * (+abx31l)/lbx31l
bcx3142: sbend, e2 = 0, hgap = gbcc/2, fint = 0, fintx = fbcc, type = "@2,0.788D11.50", l =  &
        lbx31s, angle = lbx31s * (+abx31s)/lbx31s

! define unsplit SBENs for BMAD ... not used by MAD

bcx311: sbend, hgap = gbcc/2, e1 = 0, fint = fbcc, e2 = +abx31, type = "@2,0.788D11.50", l =  &
        lbx31, angle = lbx31 * (+abx31)/lbx31
bcx312: sbend, hgap = gbcc/2, e1 = -abx31, fint = fbcc, e2 = 0, type = "@2,0.788D11.50", l =  &
        lbx31, angle = lbx31 * (-abx31)/lbx31
bcx313: sbend, hgap = gbcc/2, e1 = 0, fint = fbcc, e2 = -abx31, type = "@2,0.788D11.50", l =  &
        lbx31, angle = lbx31 * (-abx31)/lbx31
bcx314: sbend, hgap = gbcc/2, e1 = +abx31, fint = fbcc, e2 = 0, type = "@2,0.788D11.50", l =  &
        lbx31, angle = lbx31 * (+abx31)/lbx31

dcc31o: drift, l = zdcc/cos(abx31), type = "CSR"
dcc31i: drift, l = zdcc, type = "CSR"

cc31beg: marker
cc31end: marker

bcx311_full: line = (bcx3111, bcx3112)
bcx312_full: line = (bcx3121, bcx3122)
bcx313_full: line = (bcx3131, bcx3132)
bcx314_full: line = (bcx3141, bcx3142)

cc31: line = (cc31beg, bcx311_full, dcc31o, bcx312_full, dcc31i, bcx313_full, dcc31o, bcx314_full &
        , cc31end)

bbx32 = 2.3628*sqrt(2.0)*ef/4.0*1.15
arg32 = zbcc*bbx32/brhof
abx32 = asin(arg32)
abx32_2 = abx32*abx32
abx32_4 = abx32_2*abx32_2
abx32_6 = abx32_4*abx32_2
