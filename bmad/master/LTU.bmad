! drifts for BYKIKS system

ldbyks = ldlcel/2-lqr !DL cell drift length

dbyks01: drift, l = ddl10ba[l]       !QDL16 to CYDL16
dbyks02: drift, l = ddl10bb[l]       !CYDL16 to BPMDL16
dbyks03: drift, l = ddl11ba[l]+0.25  !BPMDL16 to BTM04B
dbyks05: drift, l = 0.609226-lkiks/2 !(BYKIK1S to BYKIK2S)/2
dbyks06: drift, l = 4.340223         !BYKIK2S to XCDL17
dbyks07: drift, l = 0.634128         !XCDL17 to BPMDL17
dbyks08: drift, l = 0.415873         !BPMDL17 to QDL17
dbyks04: drift, l =  &        !BTM04B to BYKIK1S
        ldbyks-dbyks01[l]-ljaw-dbyks02[l]-dbyks03[l]-2*(lkiks+dbyks05[l])-dbyks06[l]-dbyks07[l]-dbyks08[l]

dbyks11: drift, l = 0.51      !QDL17 to CEDL17
dbyks12: drift, l = 0.735832  !CEDL17 to BTM05B
dbyks13: drift, l = 0.687668  !BTM05B to SPOILERS
dbyks14: drift, l = 3.220859  !SPOILERS to TDKIKS
dbyks15: drift, l = 0.257426  !TDKIKS to PCTDKIKS1
dbyks16: drift, l = 0.266697  !PCTDKIKS to PCTDKIKS
dbyks18: drift, l = 0.4       !OTRDL18 to YCDL18
dbyks19: drift, l = 0.4       !YCDL18 to QDL18
dbyks17: drift, l =  & !PCTDKIK4S to OTRDL18
        ldbyks-dbyks11[l]-ljaw-dbyks12[l]-dbyks13[l]-dbyks14[l]-tdkiks[l]-dbyks15[l]-4*lpctdkik-3*dbyks16[l]-dbyks18[l]-dbyks19[l]

