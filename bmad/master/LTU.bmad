edmch: line = (d25cmb, im36, d25cmc, dmm1m90cm, ycem1, dem1a, qem1_full, dem1c, qem2_full, dem2b &
        , xcem2, dmm3ma, pc07, btm07, dmm3mb, ycem3, dem3a, qem3_full, dem3b, qem3v_full,  &
        dmm4m90cm, xcem4, dem4a, qem4_full, drfb, rfbem4, dmm5a, pc08, btm08, dmm5b)

edsys: line = (dbmark36, ws31, d40cm, de3ma, pc09, btm09, de3mb, xce31, dqea, qe31_full, dqebx,  &
        dcx31, dqebx2, de3a, yce32, dqeaa, qe32_full, drfb, rfbe32, dqeby1, dcy32, dqeby2, ws32,  &
        d40cm, de3m80cmb, xce33, dqeab, qe33_full, dqeca, yagpsi, dqecb, otr33, de3m40cm, yce34,  &
        dqea, qe34_full, drfb, rfbe34, dqec1, ws33, d40cm, de3m80cm, xce35, dqeac, qe35_full,  &
        dqebx, dcx35, dqebx2, de3, yce36, dqea, qe36_full, drfb, rfbe36, dqeby1, dcy36, dqeby2,  &
        ws34, d40cmg, dws35, d40cmh)

! ------------------------------------------------------------------------------
! HXR undulator match
! ------------------------------------------------------------------------------

! note: the below K-values come from Y. Nosochkov's UNDH_KQ4_USDS.xsif file,
!       for E= 4.0 GeV and KHXU= 2.0 (IntgHX= 30.0 kG)

! note: the below K-values are for SC beam; the settings for Cu beam are
!       in the "LCLS2cu_main.mad8" file

kqum1 = 0.21295276718  ! 0.266446647337
kqum2 = -0.256692261825 !-0.257070322217
kqum3 = 0.472597881562 ! 0.249191553356
kqum4 = -0.42682658336  !-0.21849398386

qum1: quadrupole, type = "1.26Q12", l = lqa/2, aperture = rqa, k1 = kqum1
qum2: quadrupole, type = "1.26Q12", l = lqa/2, aperture = rqa, k1 = kqum2
qum3: quadrupole, type = "1.26Q12", l = lqa/2, aperture = rqa, k1 = kqum3
qum4: quadrupole, type = "1.26Q12", l = lqa/2, aperture = rqa, k1 = kqum4

du1m80cma: drift, l = 0.16515
du1m80cmb: drift, l = du1m80cm[l]-du1m80cma[l]
d32cmc: drift, l = 0.30046
du2m120cm: drift, l = 4.730
dw2tdund: drift, l = 0.201537 !drift from BTH/UH wall-2 to TDUNDB u/s flange
d40cmwb: drift, l = 0.140042
d40cmwa: drift, l = d40cmw[l]-d40cmwb[l]

bpmum1: instrument, type = "Stripline-10"
bpmum2: instrument, type = "Stripline-10"
bpmum3: instrument, type = "Stripline-10"
bpmum4: instrument, type = "Stripline-10"

rfb07: instrument, type = "CavityX-1" !existing LCLS device
rfb08: instrument, type = "CavityX-1" !existing LCLS device

imundi: marker, type = "120Hz toroid" !FEL-undulator input toroid (existing LCLS device)

xcum1: kicker, type = "class-4f" !fast-feedback (loop-5)
xcum3: kicker, type = "class-4f" !fast-feedback (loop-5)

ycum2: kicker, type = "class-4f" !fast-feedback (loop-5)
ycum4: kicker, type = "class-4f" !fast-feedback (loop-5)

! Note: PCMUON is rolled 90 degree to have X-aperture smaller than Y-aperture
!       X-aperture violates standard BSC -- approved by P. Emma

 !PCMUON : ECOL,L=1.1684,XSIZE=8.64E-3/2,YSIZE=4.32E-3/2 !original muon scattering collimator after pre-undulator tune-up dump (ID from Rago: 7/18/08)
pcmuon: ecollimator, x_limit = 4.32e-3/2, y_limit = 8.64e-3/2, l = 1.1684 !90 deg rolled muon scattering collimator

tdund: instrument !LTU insertable block at und. extension entrance (w/ screen)

mm1: marker
mm2: marker
mm3: marker
eoblm: marker !future electro-optic bunch length monitor?
bltof: instrument !LTUH (gas-jet time-of-flight bunch length monitor)
muhwall1: marker !upstream end of BTH/UH wall-1
muhwall2: marker !upstream end of BTH/UH wall-2
vv999: marker !new vacuum valve just upbeam of undulator
pfilt1: marker
dbmark37: marker !end of undulator match
rwwake4h: marker, type = "WAKE" !LTUH beampipe wake applied here



!Old split line: line = (qum1, bpmum1, qum1)

qum1_full: line = (qum1)
qum1[L] = 2*qum1[L]
bpmum1[superimpose] = T
bpmum1[ref] = qum1


!Old split line: line = (qum2, bpmum2, qum2)

qum2_full: line = (qum2)
qum2[L] = 2*qum2[L]
bpmum2[superimpose] = T
bpmum2[ref] = qum2


!Old split line: line = (qum3, bpmum3, qum3)

qum3_full: line = (qum3)
qum3[L] = 2*qum3[L]
bpmum3[superimpose] = T
bpmum3[ref] = qum3


!Old split line: line = (qum4, bpmum4, qum4)

qum4_full: line = (qum4)
qum4[L] = 2*qum4[L]
bpmum4[superimpose] = T
bpmum4[ref] = qum4

unmch: line = (du1m80cma, dws36, du1m80cmb, dcx37, d32cmc, xcum1, dum1a, qum1_full, dum1b, d32cm &
        , du2m120cm, dcy38, d32cma, ycum2, dum2a, qum2_full, dum2b, du3m80cm, xcum3, dum3a,  &
        qum3_full, dum3b, d40cma, eoblm, du4m120cm, ycum4, dum4a, qum4_full, dum4b, rfb07,  &
        du5m80cm, imundi, d40cmwa, bltof, d40cmwb, muhwall1, duhwall1, duhvesta, rfb08, duhvestb &
        , muhwall2, duhwall2, dw2tdund, dtdund1, tdund, dtdund2, dpcmuon, pcmuon, dmuon1, vv999)

preundh: line = (dmuon3, rfbhx12, dmuon4, mm3, pfilt1, dbmark37)

ltu: line = (vbsys, mm1, doglg2a, doglg2b, mm2, edmch, edsys, unmch, rwwake4h, endltuh, begundh,  &
        preundh)

! ------------------------------------------------------------------------------
! HXR dumpline
! ------------------------------------------------------------------------------

kqdmp = -0.155212710055

qdmp1: quadrupole, type = "3.94Q17", l = lqp/2, aperture = rqp, k1 = kqdmp
qdmp2: quadrupole, type = "3.94Q17", l = lqp/2, aperture = rqp, k1 = kqdmp

bydsh1: sbend, hgap = gbyds/2, e1 = abyds/2, e2 = 0, fint = 0.5, fintx = 0.0, type = "1.26D18.43" &
        , ref_tilt = pi/2, l = leffbyds/2, angle = leffbyds/2 * abyds/2/(leffbyds/2)
bydsh2: sbend, hgap = gbyds/2, e1 = 0, e2 = abyds/2, fint = 0.0, fintx = 0.5, type = "1.26D18.43" &
        , ref_tilt = pi/2, l = leffbyds/2, angle = leffbyds/2 * abyds/2/(leffbyds/2)

! define unsplit SBENs for BMAD ... not used by MAD

bydsh: sbend, hgap = gbyds/2, e1 = abyds/2, fint = 0.5, e2 = abyds/2, type = "1.26D18.43",  &
        ref_tilt = pi/2, l = leffbyds, angle = leffbyds * abyds/leffbyds

byd11: sbend, hgap = gbdm/2, e1 = abdm/2, e2 = 0, fint = 0.57, fintx = 0.00, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)
byd12: sbend, hgap = gbdm/2, e1 = 0, e2 = abdm/2, fint = 0.00, fintx = 0.57, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)

byd21: sbend, hgap = gbdm/2, e1 = abdm/2, e2 = 0, fint = 0.57, fintx = 0.00, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)
byd22: sbend, hgap = gbdm/2, e1 = 0, e2 = abdm/2, fint = 0.00, fintx = 0.57, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)

byd31: sbend, hgap = gbdm/2, e1 = abdm/2, e2 = 0, fint = 0.57, fintx = 0.00, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)
byd32: sbend, hgap = gbdm/2, e1 = 0, e2 = abdm/2, fint = 0.00, fintx = 0.57, type = "1.69VD55.1" &
        , ref_tilt = pi/2, l = leffbdm/2, angle = leffbdm/2 * abdm/2/(leffbdm/2)

! define unsplit SBENs for BMAD ... not used by MAD

byd1: sbend, hgap = gbdm/2, e1 = abdm/2, fint = 0.57, e2 = abdm/2, type = "1.69VD55.1", ref_tilt &
         = pi/2, l = leffbdm, angle = leffbdm * abdm/leffbdm
byd2: sbend, hgap = gbdm/2, e1 = abdm/2, fint = 0.57, e2 = abdm/2, type = "1.69VD55.1", ref_tilt &
         = pi/2, l = leffbdm, angle = leffbdm * abdm/leffbdm
byd3: sbend, hgap = gbdm/2, e1 = abdm/2, fint = 0.57, e2 = abdm/2, type = "1.69VD55.1", ref_tilt &
         = pi/2, l = leffbdm, angle = leffbdm * abdm/leffbdm

pcpm1l: ecollimator, x_limit = 14.2875e-3, y_limit = 14.2875e-3, l = lpcpm
pcpm2l: ecollimator, x_limit = 38.1e-3, y_limit = 38.1e-3, l = lpcpm

dd1a: drift, l = 0.577681302427
dd1b: drift, l = 1.000087502327
dd1c: drift, l = 0.3048
dd1e: drift, l = 0.249638105611
dd1f: drift, l = 0.409240058046
dd1d: drift, l = ldmp1-(dd1a[l]+pcpm1l[l]+dd1b[l]+dd1c[l]+dd1e[l]+pcpm2l[l]+dd1f[l])

bpmqd: instrument, type = "Stripline-8" !RFBQD : MONI, TYPE="@2,CavityL-1"
bpmdd: instrument, type = "Stripline-8"
rfbdd: instrument, type = "@2,CavityL-1"

xcdd: kicker, type = "class-5"

ycdd: kicker, type = "class-5"

otrdmp: instrument, type = "OTR" !Dump screen

wsdump: marker, type = "@3,special"

 !IMDUMP  : MARKER, TYPE="BCS toroid" !BCS toroid in dumpline after Y-bends
 !IMBCS4  : MARKER, TYPE="BCS toroid" !BCS comparator toroid (ACM) in dumpline after Y-bends

mimdump: marker
mimbcs4: marker

btm1l: instrument !Burn-Through-Monitor behind PCPM1L
btm2l: instrument !Burn-Through-Monitor behind PCPM2L
dumpface: instrument !entrance face of main e- dump
btmdump: instrument !Burn-Through-Monitor of main e- dump

mqdmp: marker
dmpend: marker
dbmark38: marker !end of final undulator dump

arodmp1h = -arodmp1s
arodmp2h = -arodmp2s

rodmp1h: patch, tilt = arodmp1h
rodmp2h: patch, tilt = arodmp2h

bydsh_full: line = (bydsh1, bydsh2)
byd1_full: line = (byd11, byd12)
byd2_full: line = (byd21, byd22)
byd3_full: line = (byd31, byd32)



!Old split line: line = (qdmp1, qdmp1)

qdmp1_full: line = (qdmp1)
qdmp1[L] = 2*qdmp1[L]


!Old split line: line = (qdmp2, qdmp2)

qdmp2_full: line = (qdmp2)
qdmp2[L] = 2*qdmp2[L]

dumpline: line = (begdmph_2, rodmp1h, bydsh_full, ds1, byd1_full, ds, byd2_full, ds, byd3_full,  &
        dd1a, pcpm1l, btm1l, dd1b, mimdump, dd1c, mimbcs4, dd1d, ycdd, dd1e, pcpm2l, btm2l, dd1f &
        , qdmp1_full, dd12a, bpmqd, dd12b, mqdmp, dd12c, qdmp2_full, dd2a, xcdd, dd2b, dd2c, dd3a &
        , bpmdd, dd3b, otrdmp, dwsdumpa, rfbdd, dwsdumpb, wsdump, dwsdumpc, rodmp2h, dumpface,  &
        ddump, dmpend, btmdump, dbmark38, enddmph_2)

