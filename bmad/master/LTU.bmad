!Old split line: line = (qe33, bpme33, qe33)

qe33_full: line = (qe33)
qe33[L] = 2*qe33[L]
bpme33[superimpose] = T
bpme33[ref] = qe33


!Old split line: line = (qe34, bpme34, qe34)

