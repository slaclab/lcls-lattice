! ==============================================================================
! XLEAP-II devices
! ==============================================================================

! ------------------------------------------------------------------------------
! recycled XLEAP type-4 correctors
! ------------------------------------------------------------------------------

ycxl1: vkicker, type = "class-4"
xcxl1: hkicker, type = "class-4"
ycxl2: vkicker, type = "class-4"
xcxl2: hkicker, type = "class-4"

! ------------------------------------------------------------------------------
! modified (recycled) LCLS undulators
! ------------------------------------------------------------------------------

kund = 0          !undulator parameter (rms) [ ]
lamu = 0.40       !undulator period [m]
lseg = 3.400      !wiggler length [m]
lue = 0.035      !wiggler termination length (approx) [m]
lund = lseg-2*lue !wiggler length without terminations [m]
lundh = lund/2     !wiggler half-length [m]

!=!  comment !special definition for Matlab model
!=!  comment !special definition for Matlab model
!=!    gamXL    := Eu/mc2
!=!    kqund    := (Kund*2*pi/lamu/sqrt(2)/gamXL)^2
!=!    ARGu     := Lundh*sqrt(kqund)
!=!    ARGu2    := ARGu*ARGu
!=!    ARGu4    := ARGu2*ARGu2
!=!    ARGu6    := ARGu4*ARGu2
!=!    SINCARGu := 1-ARGu2/6+ARGu4/120-ARGu6/5040 !~sinc(ARGu)=sin(ARGu)/ARGu
!=!    R34u     := Lundh*SINCARGu
!=!    UMXLh    : MATR, TYPE="LCLS-I", L=Lundh, &
!=!      R11 = 1.0, &
!=!      R12 = Lundh, &
!=!      R21 = 0.0, &
!=!      R22 = 1.0, &
!=!      R33 = cos(Lundh*sqrt(kqund)), & !use this exact syntax!
!=!      R34 = R34u, &
!=!      R43 = -sin(Lundh*sqrt(kqund))*sqrt(kqund), &
!=!      R44 = cos(Lundh*sqrt(kqund))
!=!    UMXL1h : UMXLh
!=!    UMXL3h : UMXLh
!=!    UMXL4h : UMXLh
!=!  endcomment

 !comment

  ! half-wiggler modeled as an R-matrix which includes vertical focusing
  ! and horizontal defocusing per Ago Martinelli (see wigXL2.m);

  ! define XLEAP-II wigglers (as DRIFTs)

r11xl1 = 1.0
r12xl1 = lundh
r21xl1 = 0.0
r22xl1 = 1.0
r33xl1 = 1.0
r34xl1 = lundh
r43xl1 = 0.0
r44xl1 = 1.0

!new:
!new: !------- XLEAP-II wigglers -------
!new: umxl0h: wiggler,
!new:         type = "LCLS-I",
!new:         L_period = 0.555,
!new:         n_period = 6,
!new:         b_max = 0, ! = K * 2*pi*m_electron / (c_light * 0.55),
!new:         L = 6*0.555
!new:         !ds_step = 0.55*10
!new:
!new: umxl0h[L] = umxl0h[L]/2 ! Will be doubled in desplitting process.
!new: !---------------------------------
!new:
!new: umxl1h: umxl0h
!new:
umxl1h: taylor, type = "LCLS-I", l = lundh, tt11 = r11xl1, tt12 = r12xl1, tt21 = r21xl1, tt22 = r22xl1, tt33 = r33xl1,
          tt34 = r34xl1, tt43 = r43xl1, tt44 = r44xl1

r11xl3 = 1.0
r12xl3 = lundh
r21xl3 = 0.0
r22xl3 = 1.0
r33xl3 = 1.0
r34xl3 = lundh
r43xl3 = 0.0
r44xl3 = 1.0

!new:
!new: umxl3h: umxl0h
umxl3h: taylor, type = "LCLS-I", l = lundh, tt11 = r11xl3, tt12 = r12xl3, tt21 = r21xl3, tt22 = r22xl3, tt33 = r33xl3,
          tt34 = r34xl3, tt43 = r43xl3, tt44 = r44xl3

r11xl4 = 1.0
r12xl4 = lundh
r21xl4 = 0.0
r22xl4 = 1.0
r33xl4 = 1.0
r34xl4 = lundh
r43xl4 = 0.0
r44xl4 = 1.0

!new:
!new: umxl4h: umxl0h
umxl4h: taylor, type = "LCLS-I", l = lundh, tt11 = r11xl4, tt12 = r12xl4, tt21 = r21xl4, tt22 = r22xl4, tt33 = r33xl4,
          tt34 = r34xl4, tt43 = r43xl4, tt44 = r44xl4
 !endcomment

  UMXL1_full : LINE=(UMXL1h,UMXL1h)
  UMXL3_full : LINE=(UMXL3h,UMXL3h)
  UMXL4_full : LINE=(UMXL4h,UMXL4h)

! ------------------------------------------------------------------------------
! original XLEAP wiggler
! ------------------------------------------------------------------------------

! wiggler is modeled as R-matrix to include natural vertical focusing;
! it is nominally OFF (opened to full gap, with Kwig~2); at minimum gap, Kwig=50

kwig = 34                                        !wiggler parameter [m^-1]
lamw = 0.34                                      !wiggler period [m]
lwigh = 2.38/2                                    !wiggler half-length [m]
gamw = eu/mc2                                    !Lorentz energy factor in wiggler [ ]
kqwig = setxl2wig*(2*pi*kwig/lamw/sqrt(2)/gamw)^2 !natural vertical focusing "k" [m^-2]

! handle Kwig->0 by expressing R34 as an approximate SINC function

argw = lwigh*sqrt(kqwig)
argw2 = argw*argw
argw4 = argw2*argw2
argw6 = argw4*argw2
sincargw = 1-argw2/6+argw4/120-argw6/5040 !~sinc(ARGw)=sin(ARGw)/ARGw
r34w = lwigh*sincargw

wigxlh: taylor, type = "variable gap", l = lwigh, tt11 = 1.0, tt12 = lwigh, tt21 = 0, tt22 = 1.0, tt33 = cos(argw),
          tt34 = r34w, tt43 = -sin(argw)*sqrt(kqwig), tt44 = cos(argw)

 !VALUE, WIGXLh[R11],WIGXLh[R12],WIGXLh[R21],WIGXLh[R22]
 !VALUE, WIGXLh[R33],WIGXLh[R34],WIGXLh[R43],WIGXLh[R44]

  WIGXL_full : LINE=(WIGXLh,WIGXLh)

! ------------------------------------------------------------------------------
! new XLEAP-II quadrupoles (to mitigate focusing of wigglers)
! ------------------------------------------------------------------------------

kqfxl1 = 0
kqfxl2 = 0

qfxl1: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqfxl1
qfxl2: quadrupole, type = "1.085Q4.31", l = lqe/2, aperture = rqe, k1 = kqfxl2



!Old split line:  QFXL1_full : LINE=(QFXL1,QFXL1)

qfxl1_full: line = (qfxl1)
qfxl1[L] = 2*qfxl1[L]


!Old split line:  QFXL2_full : LINE=(QFXL2,QFXL2)

qfxl2_full: line = (qfxl2)
qfxl2[L] = 2*qfxl2[L]

! wiggler pairs

duqxl1: drift, l = 0.2166+0.1777551
duqxl1w: drift, l = 0.2166+0.475-0.1777551
duqxl2: drift, l = 0.2166

  UMXLpair1 : LINE=(UMXL1_full,DUQXL1,QFXL1_full,DUQXL1W,WIGXL_full)
  UMXLpair2 : LINE=(UMXL3_full,DUQXL2,QFXL2_full,DUQXL2,UMXL4_full)

! ------------------------------------------------------------------------------
! original XLEAP self-seeding chicane (normally OFF)
! ------------------------------------------------------------------------------

! - from RadiaBeam (C-bends; 0.75 T peak field; 1 degree max)
! - use series approximation for sinc(x)=sin(x)/x to allow ABXL=0
! - deflects toward +X (to the left/north/wall)
! - Dieter Walz designation: 1.575D14-C (pole-width rather than gap height)

! GBXL  : 0.433D14-C gap height (m)
! ZBXL  : 0.433D14-C "Z" length (m)
! FBXL  : measured fringe field
! ABXL  : chicane bend angle (rad)
! BBXL  : chicane bend field (kG)
! LBXL  : chicane bend path length (m)
! ABXLs : "short" half chicane bend angle (rad)
! LBXLs : "short" half chicane bend path length (m)
! ABXLl : "long" half chicane bend angle (rad)
! LBXLl : "long" half chicane bend path length (m)

! BCXXL1 gets an X-offset of  -5 mm (toward the aisle)
! BCXXL2 gets an X-offset of -12 mm (toward the aisle)
! BCXXL3 gets an X-offset of -12 mm (toward the aisle)
! BCXXL4 gets an X-offset of  -5 mm (toward the aisle)

gbxl = 0.011
zbxl = 0.364
fbxl = 0.5
abxl0 = 0.0174 !R56=0.56 mm
abxl = abxl0*setxl2ss
bbxl = brhof*sin(abxl)/zbxl
abxl_2 = abxl*abxl
abxl_4 = abxl_2*abxl_2
abxl_6 = abxl_4*abxl_2
sincabxl = 1-abxl_2/6+abxl_4/120-abxl_6/5040 !~sinc(ABXL)=sin(ABXL)/ABXL
lbxl = zbxl/sincabxl
abxls = asin(sin(abxl)/2)
abxls_2 = abxls*abxls
abxls_4 = abxls_2*abxls_2
abxls_6 = abxls_4*abxls_2
sincabxls = 1-abxls_2/6+abxls_4/120-abxls_6/5040 !~sinc(ABXLs)=sin(ABXLs)/ABXLs
lbxls = zbxl/(2*sincabxls)
abxll = abxl-abxls
lbxll = lbxl-lbxls

bcxxl11: sbend, type = "0.433D14-C", l = lbxls, angle = -abxls, hgap = gbxl/2, e1 = 0, fint = fbxl, fintx = 0
bcxxl12: sbend, type = "0.433D14-C", l = lbxll, angle = -abxll, hgap = gbxl/2, fint = 0, e2 = -abxl, fintx = fbxl
bcxxl21: sbend, type = "0.433D14-C", l = lbxll, angle = +abxll, hgap = gbxl/2, e1 = +abxl, fint = fbxl, fintx = 0
bcxxl22: sbend, type = "0.433D14-C", l = lbxls, angle = +abxls, hgap = gbxl/2, fint = 0, e2 = 0, fintx = fbxl
bcxxl31: sbend, type = "0.433D14-C", l = lbxls, angle = +abxls, hgap = gbxl/2, e1 = 0, fint = fbxl, fintx = 0
bcxxl32: sbend, type = "0.433D14-C", l = lbxll, angle = +abxll, hgap = gbxl/2, fint = 0, e2 = +abxl, fintx = fbxl
bcxxl41: sbend, type = "0.433D14-C", l = lbxll, angle = -abxll, hgap = gbxl/2, e1 = -abxl, fint = fbxl, fintx = 0
bcxxl42: sbend, type = "0.433D14-C", l = lbxls, angle = -abxls, hgap = gbxl/2, fint = 0, e2 = 0, fintx = fbxl

! define unsplit SBENs for BMAD ... not used by MAD

bcxxl1: sbend, type = "0.433D14-C", hgap = gbxl/2, l = lbxl, angle = -abxl, e1 = 0, fint = fbxl, e2 = -abxl, fintx = fbxl
bcxxl2: sbend, type = "0.433D14-C", hgap = gbxl/2, l = lbxl, angle = +abxl, e1 = +abxl, fint = fbxl, e2 = 0, fintx = fbxl
bcxxl3: sbend, type = "0.433D14-C", hgap = gbxl/2, l = lbxl, angle = +abxl, e1 = 0, fint = fbxl, e2 = +abxl, fintx = fbxl
bcxxl4: sbend, type = "0.433D14-C", hgap = gbxl/2, l = lbxl, angle = -abxl, e1 = -abxl, fint = fbxl, e2 = 0, fintx = fbxl

! magnet-to-magnet path lengths

zdxlo = 1.046-zbxl !outer bend-to-bend Z distance (m)
zdxli = 0.520-zbxl !inner bend-to-bend Z distance (m)

dxlo: drift, l = zdxlo/cos(abxl)
dxli: drift, l = zdxli/2

lbcxl = 4*zbxl+2*zdxlo+zdxli !chicane length

! MARKers

bcxlssbeg: marker
bcxlssmid: marker
bcxlssend: marker

! beamline



!Old split line:  BCXXL1_full : LINE=(BCXXL11,BCXXL12)

bcxxl1_full: line = (bcxxl1)


!Old split line:  BCXXL2_full : LINE=(BCXXL21,BCXXL22)

bcxxl2_full: line = (bcxxl2)


!Old split line:  BCXXL3_full : LINE=(BCXXL31,BCXXL32)

bcxxl3_full: line = (bcxxl3)


!Old split line:  BCXXL4_full : LINE=(BCXXL41,BCXXL42)

bcxxl4_full: line = (bcxxl4)

  BCXLSS : LINE=(BCXLSSBEG, BCXXL1_full,DXLo,BCXXL2_full,DXLi,BCXLSSMID,DXLi,BCXXL3_full,DXLo,BCXXL4_full,BCXLSSEND)

! drifts around undulator pairs and chicane

dxlua1: drift, l = 0.404978
dxlua2: drift, l = 0.395986
dumxl12u: drift, l = 0.566965333333
dumxl12d: drift, l = 1.422304333333+0.475
