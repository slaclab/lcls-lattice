cntlt1s: marker, type = "CENTER"

bx31b_full: line = (bx31b1, bx31b2)
bykik1s_full: line = (bykik1s1, bykik1s2)
bykik2s_full: line = (bykik2s1, bykik2s2)
bx32b_full: line = (bx32b1, bx32b2)



