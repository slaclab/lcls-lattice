! NOTE: change mirrors from MULT to INST for Matlab model generator creation!

a1y = -0.03662
a2y = -0.101767726243 !calculated with atan2
a3y = 0.016246118946 !fitted
a4x = 0.019693602
a5x = 0.019693602
a6x = -0.024

mr1k1_bend: multipole, type = "MIRROR", k0l = a1y, t0 = pi / 2
sp1k1_mono: multipole, type = "MONOCHROMATOR", k0l = a2y, t0 = pi / 2
mr3k1_grating: multipole, type = "GRATING", k0l = a3y, t0 = pi / 2
mr1k3_txi: multipole, type = "MIRROR", k0l = a4x
mr2k3_txi: multipole, type = "MIRROR", k0l = a5x
mr1k4_soms: multipole, type = "MIRROR", k0l = a6x

 !MR1K1_BEND    : INST, TYPE="MIRROR"
 !SP1K1_MONO    : INST, TYPE="MONOCHROMATOR"
 !MR3K1_GRATING : INST, TYPE="GRATING"
 !MR1K3_TXI     : INST, TYPE="MIRROR"
 !MR2K3_TXI     : INST, TYPE="MIRROR"
 !MR1K4_SOMS    : INST, TYPE="MIRROR"

