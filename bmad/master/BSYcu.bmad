
! *** OPTICS=AD_ACCEL-01JUN2026s ***

! ==============================================================================
! Modification History
! ------------------------------------------------------------------------------
! 19-APR-2024, M. Woodley
!  * remove decommissioned BSYALINE and LCLS2cuA LINE's
! ------------------------------------------------------------------------------
! 04-OCT-2018, M. Woodley
!  * include alternative DC extraction into CUSXR:
!    - define new drifts DBRCUSdc1A,B and DBRCUSdc2A,B (3D8.8MK3's)
!    - change definition of beamline CLTH2 (gets 0.40745 m longer)
! ------------------------------------------------------------------------------
! 21-FEB-2018, M. Woodley
!  * add BSYLTUHXTES and LCLS2cuHXTES line definitions
! 25-JAN-2018, M. Woodley
!  * remove PCBSY2/BTMBSY2 per A. Ibrahimov
! ------------------------------------------------------------------------------
! 05-MAY-2017, M. Woodley
!  * pulsed correctors XCAPM2/YCAPM2 will be timed to affect the straight-ahead
!    LTUH beam, but not the A-line beam
! ------------------------------------------------------------------------------
! 24-FEB-2017, Y. Nosochkov
!  * update some drift names
! ------------------------------------------------------------------------------
! 02-NOV-2016, Y. Nosochkov
!  * update BSYH2 definition for use with A-line pulsed magnets
! ------------------------------------------------------------------------------
! 24-JUN-2016, Y. Nosochkov
!  * update beamline definitions to avoid duplication with other files
! ------------------------------------------------------------------------------

! ------------------------------------------------------------------------------
! from copper linac
! ------------------------------------------------------------------------------

  CLTH0 : LINE=(BEGCLTH_0,BSYBEG,BSYS100,S100SXRA,ENDCLTH_0)

  CLTH1 : LINE=(BEGCLTH_1,S100SXRB,ENDCLTH_1)

dbrcusdc1a: drift, l = zbrcusdc/2
dbrcusdc1b: drift, l = zbrcusdc/2
dbkrcusa: drift, l = bkrcusa[l]
dbkrcusb: drift, l = bkrcusb[l]
dbrcusdc2a: drift, l = zbrcusdc/2
dbrcusdc2b: drift, l = zbrcusdc/2
dblrcusa: drift, l = blrcusa[l]
dblrcusb: drift, l = blrcusb[l]
dbxsp1ha: drift, l = bxsp1ha[l]
dbxsp1hb: drift, l = bxsp1hb[l]

  CLTH2 : LINE=(BEGCLTH_2,DBRCUSdc1A,DBRCUSdc1B,DCKdc1,DBKRCUSA,DBKRCUSB,DCKdc2,DBRCUSdc2A,DBRCUSdc2B,DCUSBLRA,BPMCUS,
         DCUSBLRB,DBLRCUSA,DBLRCUSB,DBSY52c1,SWIVEL,DBSY52c2,DBXSP1HA,DBXSP1HB,BSY1END,ENDCLTH_2)

! ------------------------------------------------------------------------------

  CLTS : LINE=(BEGCLTS,KCUSXR,DLCUSXR,ENDCLTS)

  BSYS : LINE=(BEGBSYS,BYPM2,MUWALLB,DWALLA,DUMPBSYS,DWALLB,BSYENDB,RWWAKE3S,ENDBSYS)

! ------------------------------------------------------------------------------

  LTUS : LINE=(DBLDL21,LTUSC,RWWAKE4S,ENDLTUS,BEGUNDS,PREUNDS)
  LTUH : LINE=(LTU)

  BSYLTUH     : LINE=(CLTH0,CLTH1,CLTH2,BSYH,LTUH,HXRUND,DUMPLINE)
  BSYLTUHS    : LINE=(CLTH0,CLTH1,CLTH2,BSYH,LTUH,HXRUND,SFTDUMP)
  BSYLTUS     : LINE=(CLTH0,CLTH1,CLTS,BSYS,LTUS,SXRUND,DUMPLINEB)
  BSYLTUSS    : LINE=(CLTH0,CLTH1,CLTS,BSYS,LTUS,SXRUND,SFTDUMPB)
  BSYLTUHXTES : LINE=(CLTH0,CLTH1,CLTH2,BSYH,LTUH,HXRUND,SFTDUMP1,HXTES_1,HXTES_2)
  BSYLTUHTXI  : LINE=(CLTH0,CLTH1,CLTH2,BSYH,LTUH,HXRUND,SFTDUMP1,HXTES_1,HXTES_3)

  LCLS2cuC     : LINE=(DL1,L1,BC1,L2,BC2,L3) !common
  LCLS2cuH     : LINE=(LCLS2cuC,BSYLTUH)     !to HXR
  LCLS2cuHS    : LINE=(LCLS2cuC,BSYLTUHS)    !to HXR safety dump
  LCLS2cuS     : LINE=(LCLS2cuC,BSYLTUS)     !to SXR
  LCLS2cuSS    : LINE=(LCLS2cuC,BSYLTUSS)    !to SXR safety dump
  LCLS2cuHXTES : LINE=(LCLS2cuC,BSYLTUHXTES) !to HXR XTES system
  LCLS2cuHTXI  : LINE=(LCLS2cuC,BSYLTUHTXI)  !to HXR XTES-TXI system

! ------------------------------------------------------------------------------

