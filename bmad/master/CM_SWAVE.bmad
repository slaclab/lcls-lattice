cavl028: lcavity, cavity_type = standing_wave, rf_frequency = 1300 * 1e6, l = lcavl, aperture = lcavr, type = "J1.3-21",
          voltage = g028*lcavl * 1e6, phi0 = p028/360

g031 = gradl1
p031 = phasl1
g032 = gradl1
p032 = phasl1
g033 = gradl1
p033 = phasl1
g034 = gradl1
p034 = phasl1
g035 = gradl1
p035 = phasl1
g036 = gradl1
p036 = phasl1
g037 = gradl1
