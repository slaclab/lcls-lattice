g038 = gradl1
p038 = phasl1

cavl031: lcavity, cavity_type = standing_wave, rf_frequency = 1300 * 1e6, l = lcavl, aperture = lcavr, type = "J1.3-20",
          voltage = g031*lcavl * 1e6, phi0 = p031/360
cavl032: lcavity, cavity_type = standing_wave, rf_frequency = 1300 * 1e6, l = lcavl, aperture = lcavr, type = "J1.3-20",
          voltage = g032*lcavl * 1e6, phi0 = p032/360
cavl033: lcavity, cavity_type = standing_wave, rf_frequency = 1300 * 1e6, l = lcavl, aperture = lcavr, type = "J1.3-20",
          voltage = g033*lcavl * 1e6, phi0 = p033/360
cavl034: lcavity, cavity_type = standing_wave, rf_frequency = 1300 * 1e6, l = lcavl, aperture = lcavr, type = "J1.3-20",
          voltage = g034*lcavl * 1e6, phi0 = p034/360
cavl035a: lcavity, cavity_type = standing_wave, rf_frequency = 1300 * 1e6, l = lcavla, aperture = lcavr,
