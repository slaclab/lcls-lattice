! ==============================================================================
! ultrafast stripline kickers for LCLS Multibunch project
! ------------------------------------------------------------------------------

lufkick = 0.300 !electrical length (m)

bky21929: instrument, type = "0.79K11.8", l = lufkick
bkx21957: instrument, type = "0.79K11.8", l = lufkick
bky22929: instrument, type = "0.79K11.8", l = lufkick
bkx22957: instrument, type = "0.79K11.8", l = lufkick

d219a: drift, l = 0.4609-lufkick/2
d219b: drift, l = 0.5439-lufkick
d219c: drift, l = daq4[l]-d219a[l]-lufkick-d219b[l]-lufkick
d229a: drift, l = d219a[l]
d229b: drift, l = d219b[l]
d229c: drift, l = d219c[l]

