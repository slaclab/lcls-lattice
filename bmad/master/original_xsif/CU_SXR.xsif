  CALL, FILENAME="LCLS2cu_master.xsif" !calls other xsif files

  QM22,    K1=-0.589570998224
  Q24901A, K1= 1.082580150374
  Q24901B, K1= 1.082580150374
  Q25201,  K1= 0.688761727353
  Q25301,  K1=-0.476435254001
  Q25401,  K1= 0.428715988011
  Q25501,  K1=-0.39999856091
  QBP33,   K1=-0.644563496901
  QBP34,   K1= 0.595165383865
  QDBL1,   K1=-1.066849469579
  QDBL2,   K1= 0.618084331747
  QDL11,   K1= 0.358720317054
  QSXh16,  K1= 0.58425577059
  QSXh19,  K1=-0.916613463141
  QSXh21,  K1= 1.112461107836
  QSXh24,  K1=-1.11933302972

  COMMENT !to generate SURVEY
    USE, CU_SXR !start at gun
    ! initial energy: E00
    ! initial SURVEY: Xi, 0, Zi, ADLi, 0, 0
