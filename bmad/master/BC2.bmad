
! *** OPTICS=AD_ACCEL-05OCT20 ***

! LCLS2sc bunch compressor chicane #2

! ==============================================================================
! Modification History
! ------------------------------------------------------------------------------
! 23-MAY-2019, M. Woodley
!  * move ENDBC2B to u/s face of QE201 per T. Maxwell
! 12-APR-2019, M. Woodley
!  * rename some MARKERs (to avoid conflicts with LCLS)
! ------------------------------------------------------------------------------
! 05-SEP-2017, M. Woodley
!  * rename: BPM21->BPM21B, CEBC2->CE21B, WS21->WS21B
!  * move BZ21B 0.076976 m upstream per F. Carillo
!  * move QE201/BPME201 0.050338 m downstream per F. Carillo
! 16-AUG-2017, M. Woodley
!  * set FINT for BC2 bends to 0.6287 per Magnetic Measurements data
! ------------------------------------------------------------------------------
! 28-FEB-2017, M. Woodley
!  * relocate YC2C00, YCE201, XCE202, YCE203, and XCE204 per F. Carillo
! ------------------------------------------------------------------------------
! 28-NOV-2016, M. Woodley
!  * merge LCLS-II' version 28NOV16 with LCLS2sc version 04NOV16
! ------------------------------------------------------------------------------
! 26-AUG-2016, M. Woodley
!  * add two 1.259Q3.5 quadrupoles to EMIT2
!  * create double-waist in EMIT2 for emittance measurement
! 01-JUL-2016, M. Woodley
!  * LCLS-II-HE
!  * remove COL2 and replace with direct match into L3
! ------------------------------------------------------------------------------
! 03-JUN-2016, M. Woodley
!  * change deferment level to 0 for XCC204, YCC207, and XCC208
!  * move XCC210 to d/s side of QC210 ... shorten L3 u/s PSC drift
! ------------------------------------------------------------------------------
! 23-FEB-2016, M. Woodley
!  * push extra drift from L2 d/s PSC into D2C00 (DPSC2d[L]+D2C00[L]=constant)
!  * per F. Carillo: move XC2C00 u/s 11 cm, BZ21B d/s 18 cm, XCC210 u/s 14 cm
! ------------------------------------------------------------------------------
! 01-OCT-2015, M. Woodley
!  * fix negative D2C00a drift length error by shortening DPSC2D drift; set
!    D2C00a length to zero
!  * undefer CEBC2
!  * change TYPE of OTRs and YAGs per Henrik's PRD
! ------------------------------------------------------------------------------
! 19-JUN-2015, M. Woodley
!  * device locations per F. Carrillo
!  * undefer BPM21 and OTR21B
!  * defer collimators CYC21, CXC21, CYC23, and CXC23
!  * undefer WSC202, WSC204, WSC206, and WSC208
!  * collimator gaps per P. Emma
! ------------------------------------------------------------------------------
! 20-MAR-2015, M. Woodley
!  * device locations per F. Carillo
!  * set WS21 deferment to level 3; set OTR21B deferment to level 0
!  * set collimator lengths (tungsten) and gaps per LCLSII-2.4-PR-0095-R0
! ------------------------------------------------------------------------------
! 12-DEC-2014, M. Woodley
!  * change RFB21 (defer=2) to BPM21 (defer=0)
! ------------------------------------------------------------------------------
! 28-OCT-2014, M. Woodley
!  * move COL2 collimators 7 inches closer to their associated quadrupoles
! ------------------------------------------------------------------------------
! 15-OCT-2014, M. Woodley
!  * increase central drift of BC1 chicane from 1.0926 m to 1.75 m; add OTR21B
!  * remove 0.6574 m (1.75 m - 1.0926 m) from COL2 to keep L1-L2 separation
!    constant
!  * add 6 stripline BPMs to COL2 ... omitted when we switched to 45 degree
!    FODO cells
!  * adjust deferment/deprecation levels
! ------------------------------------------------------------------------------
! 07-AUG-2014, M. Woodley
!  * diagnostics complement per "Electron Beam Diagnostics Systems" PRD
!    (LCLSII-2.7-PR-0170)
!  * change bending direction in BC2 chicane ... toward the aisle
!  * OTR in BC2 chicane replaced with wire scanner; BPM replaced with RF BPM
!  * COL2 collimation system now consists of four 45 degree FODO cells with 3
!    pairs of collimators separated by 45 degrees (22 m betas at collimators);
!    FODO cell length is 12 m
!  * TCAV(Y) added d/s of BC2
!  * in-line emittance measurement system incorporated into COL2
!  * decorate device TYPE attributes to indicate non-baseline status
! 17-APR-2014, M. Woodley
!  * add "CNT" MARKERs after dispersive areas (ELEGANT CENTERing)
! ------------------------------------------------------------------------------
! 28-MAR-2014, M. Woodley
!  * remove elements associated with now-defunct DIAG2 diagnostic line
!  * element names changed to conform to nomenclature PRD
! ------------------------------------------------------------------------------
! 14-JAN-2014, M. Woodley
!  * change BC2 dipole names from "BX2*" to "BXC2*"
! ------------------------------------------------------------------------------

! ==============================================================================
! SBEN
! ------------------------------------------------------------------------------

! BC2 chicane
! - approximate on-axis effective length per R. Carr (01-AUG-05 PE)
! - use series approximation for sinc(x)=sin(x)/x to allow BXh=0

! GB2   : 1D19.7 gap height (m)
! ZB2   : 1D19.7 "Z" length (m)
! FB2   : measured fringe field
! AB2   : chicane bend angle (rad)
! BB2   : chicane bend field (kG)
! LB2   : chicane bend path length (m)
! AB2S  : "short" half chicane bend angle (rad)
! LB2S  : "short" half chicane bend path length (m)
! AB2L  : "long" half chicane bend angle (rad)
! LB2L  : "long" half chicane bend path length (m)

gb2 = 0.03335
zb2 = 0.549
fb2 = 0.6287
ab2 = 0.043924602172 !R56=0.03955
bb2 = brho2*sin(ab2)/zb2
ab2_2 = ab2*ab2
ab2_4 = ab2_2*ab2_2
ab2_6 = ab2_4*ab2_2
sincab2 = 1-ab2_2/6+ab2_4/120-ab2_6/5040 !~sinc(AB2)=sin(AB2)/AB2
lb2 = zb2/sincab2
ab2s = asin(sin(ab2)/2)
ab2s_2 = ab2s*ab2s
ab2s_4 = ab2s_2*ab2s_2
ab2s_6 = ab2s_4*ab2s_2
sincab2s = 1-ab2s_2/6+ab2s_4/120-ab2s_6/5040 !~sinc(AB2S)=sin(AB2S)/AB2S
lb2s = zb2/(2*sincab2s)
ab2l = ab2-ab2s
lb2l = lb2-lb2s

bcx21a: sbend, hgap = gb2/2, e1 = 0, fint = fb2, fintx = 0, type = "1D19.7", l = lb2s, angle =  &
        lb2s * (+ab2s)/lb2s
bcx21b: sbend, hgap = gb2/2, fint = 0, e2 = +ab2, fintx = fb2, type = "1D19.7", l = lb2l, angle &
         = lb2l * (+ab2l)/lb2l
bcx22a: sbend, hgap = gb2/2, e1 = -ab2, fint = fb2, fintx = 0, type = "1D19.7", l = lb2l, angle &
         = lb2l * (-ab2l)/lb2l
bcx22b: sbend, hgap = gb2/2, fint = 0, e2 = 0, fintx = fb2, type = "1D19.7", l = lb2s, angle =  &
        lb2s * (-ab2s)/lb2s
bcx23a: sbend, hgap = gb2/2, e1 = 0, fint = fb2, fintx = 0, type = "1D19.7", l = lb2s, angle =  &
        lb2s * (-ab2s)/lb2s
bcx23b: sbend, hgap = gb2/2, fint = 0, e2 = -ab2, fintx = fb2, type = "1D19.7", l = lb2l, angle &
         = lb2l * (-ab2l)/lb2l
bcx24a: sbend, hgap = gb2/2, e1 = +ab2, fint = fb2, fintx = 0, type = "1D19.7", l = lb2l, angle &
         = lb2l * (+ab2l)/lb2l
bcx24b: sbend, hgap = gb2/2, fint = 0, e2 = 0, fintx = fb2, type = "1D19.7", l = lb2s, angle =  &
        lb2s * (+ab2s)/lb2s

! define unsplit SBENs for BMAD ... not used by MAD

bcx21: sbend, hgap = gb2/2, e1 = 0, fint = fb2, e2 = +ab2, type = "1D19.7", l = lb2, angle =  &
        lb2 * (+ab2)/lb2
bcx22: sbend, hgap = gb2/2, e1 = -ab2, fint = fb2, e2 = 0, type = "1D19.7", l = lb2, angle =  &
        lb2 * (-ab2)/lb2
bcx23: sbend, hgap = gb2/2, e1 = 0, fint = fb2, e2 = -ab2, type = "1D19.7", l = lb2, angle =  &
        lb2 * (-ab2)/lb2
bcx24: sbend, hgap = gb2/2, e1 = +ab2, fint = fb2, e2 = 0, type = "1D19.7", l = lb2, angle =  &
        lb2 * (+ab2)/lb2

! ==============================================================================
! QUAD
! ------------------------------------------------------------------------------

! L2 to BC2 chicane

kq2c01 = 0.509106837432

q2c01: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kq2c01

! BC2 chicane

kcq21 = 0
kcq22 = 0

cq21b: quadrupole, type = "1.69Q3.4", l = lqc/2, aperture = rqc, k1 = kcq21
cq22b: quadrupole, type = "1.69Q3.4", l = lqc/2, aperture = rqc, k1 = kcq22

! match into L3

kqe201 = -1.311184352548
kqe202 = 1.991949996436
kqe203 = -1.816251165989
kqe204 = 1.650789479355

qe201: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqe201
qe202: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqe202
qe203: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqe203
qe204: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqe204

! ==============================================================================
! DRIF
! ------------------------------------------------------------------------------

! L2 to BC2 chicane

d2c00: drift, l = 1.150310011609
d2c01: drift, l = 0.5

d2c00b: drift, l = 0.338951
d2c00c: drift, l = 0.321049
d2c00a: drift, l = d2c00[l]-d2c00b[l]-d2c00c[l]
d2c01a: drift, l = 0.133
d2c01b: drift, l = d2c01[l]-d2c01a[l]

! BC2 chicane

zdc2o = 10.4092-zb2 !BXC21 exit to BCX22 entrance
zdc2i = 2.299-zb2   !BXC22 exit to BCX23 entrance

dc2o: drift, l = zdc2o/cos(ab2), type = "CSR"
dc2i: drift, l = zdc2i, type = "CSR"

zdc2oa = 2.009462     !BXC21 exit to CQ21B center
zdc2ob = zdc2o-zdc2oa !CQ21B center to BCX22 entrance
zdc2od = 2.009462     !CQ22B center to BXC24 entrance
zdc2oc = zdc2o-zdc2od !BXC23 exit to CQ22B center

dc2oa: drift, l = zdc2oa/cos(ab2)-lqc/2, type = "CSR"
dc2ob: drift, l = zdc2ob/cos(ab2)-lqc/2, type = "CSR"
dc2ih: drift, l = dc2i[l]/2, type = "CSR"
dc2ia: drift, l = 0.3795, type = "CSR"       !0.35
dc2ib: drift, l = 0.165-ljaw/2, type = "CSR" !0.35
dc2ic: drift, l = 0.183-ljaw/2, type = "CSR" !0.35
dc2id: drift, l = 0.598, type = "CSR"        !0.35
dc2ie: drift, l = 0.4245, type = "CSR"       !0.35
dc2oc: drift, l = zdc2oc/cos(ab2)-lqc/2, type = "CSR"
dc2od: drift, l = zdc2od/cos(ab2)-lqc/2, type = "CSR"

! match into L3

lemit2 = 28.859648

de200: drift, l = 1.050338
de201: drift, l = 4.906343360384
de202a: drift, l = 10.974020455558
de203: drift, l = 3.0
de204: drift, l = 0.670516558157
de202b: drift, l = lemit2-4*lqx-de200[l]-de201[l]-de202a[l]-de203[l]-de204[l]
de202: drift, l = de202a[l]+de202b[l]

de200a: drift, l = 0.687372
de200b: drift, l = de200[l]-de200a[l]
de201a: drift, l = 0.321044
de201b: drift, l = 0.328618
de201c: drift, l = de201[l]-de201a[l]-de201b[l]
de202a1: drift, l = 0.321864
de202a2: drift, l = de202a[l]-de202a1[l]
de203a: drift, l = 0.321044
de203b: drift, l = de203[l]-de203a[l]
de204a: drift, l = 0.321864
de204b: drift, l = de204[l]-de204a[l]

! ==============================================================================
! BPMs
! ------------------------------------------------------------------------------

bpm2c01: instrument, type = "Stripline-1"
bpme201: instrument, type = "Stripline-1"
bpme202: instrument, type = "Stripline-1"
bpme203: instrument, type = "Stripline-1"
bpme204: instrument, type = "Stripline-1"

rfb2c01: instrument, type = "@2,CavityS-1"
bpm21b: instrument, type = "Stripline-8"  !RFB21 : MONI, TYPE="@2,CavityL-1"

! ==============================================================================
! XCORs
! ------------------------------------------------------------------------------

xc2c00: kicker, type = "class-4"
xce202: kicker, type = "class-4"
xce204: kicker, type = "class-4"

! ==============================================================================
! YCORs
! ------------------------------------------------------------------------------

yc2c00: kicker, type = "class-4"
yce201: kicker, type = "class-4"
yce203: kicker, type = "class-4"

! ==============================================================================
! marker points, etc.
! ------------------------------------------------------------------------------

! collimator

ce21b: rcollimator, x_limit = 13.3e-3, l = ljaw, type = "HCOLL"    !X momentum collimator

! instruments

otr21b: instrument, type = "OTR BC"  !BC2 energy spread
ws21b: marker, type = "@3,fast" !BC2 energy spread
bz21b: instrument, type = "CSR"     !CSR-based relative bunch length monitor
im21b: marker, type = "ICT"     !Beam Current Monitor
wsemit2: marker, type = "fast"    !post-BC2 emittance

! markers

bc2bcbeg: marker
bc2bcmid: marker
cntbc2: marker, type = "CENTER"
bc2bcend: marker

! ==============================================================================
! BEAMLINE
! ------------------------------------------------------------------------------

bcx21_full: line = (bcx21)
!old: bcx21_full: line = (bcx21a, bcx21b)
bcx22_full: line = (bcx22)
!old: bcx22_full: line = (bcx22a, bcx22b)
bcx23_full: line = (bcx23)
!old: bcx23_full: line = (bcx23a, bcx23b)
bcx24_full: line = (bcx24)
!old: bcx24_full: line = (bcx24a, bcx24b)



!Old split line: line = (q2c01, bpm2c01, q2c01)

q2c01_full: line = (q2c01)
q2c01[L] = 2*q2c01[L]
bpm2c01[superimpose] = T
bpm2c01[ref] = q2c01


!Old split line: line = (cq21b, cq21b)

cq21b_full: line = (cq21b)
cq21b[L] = 2*cq21b[L]


!Old split line: line = (cq22b, cq22b)

cq22b_full: line = (cq22b)
cq22b[L] = 2*cq22b[L]


!Old split line: line = (qe201, bpme201, qe201)

qe201_full: line = (qe201)
qe201[L] = 2*qe201[L]
bpme201[superimpose] = T
bpme201[ref] = qe201


!Old split line: line = (qe202, bpme202, qe202)

qe202_full: line = (qe202)
qe202[L] = 2*qe202[L]
bpme202[superimpose] = T
bpme202[ref] = qe202


!Old split line: line = (qe203, bpme203, qe203)

qe203_full: line = (qe203)
qe203[L] = 2*qe203[L]
bpme203[superimpose] = T
bpme203[ref] = qe203


!Old split line: line = (qe204, bpme204, qe204)

qe204_full: line = (qe204)
qe204[L] = 2*qe204[L]
bpme204[superimpose] = T
bpme204[ref] = qe204

bc2i0: line = (d2c00, q2c01, q2c01, d2c01)

bc2i: line = (d2c00a, xc2c00, d2c00b, yc2c00, d2c00c, q2c01_full, d2c01a, rfb2c01, d2c01b)

bc2c0: line = (bc2bcbeg, bcx21a, bcx21b, dc2o, bcx22a, bcx22b, dc2ih, bc2bcmid, dc2ih, bcx23a,  &
        bcx23b, dc2o, bcx24a, bcx24b, bc2bcend)

bc2c: line = (bc2bcbeg, bcx21_full, dc2oa, cq21b_full, dc2ob, bcx22_full, dc2ia, bpm21b, dc2ib,  &
        ce21b, dc2ic, otr21b, dc2id, ws21b, dc2ie, bcx23_full, dc2oc, cq22b_full, dc2od,  &
        bcx24_full, cntbc2, bc2bcend)

bc2: line = (begbc2b, bc2i, bc2c)

emit2: line = (de200a, bz21b, de200b, endbc2b, begemit2, qe201_full, de201a, yce201, de201b,  &
        im21b, de201c, qe202_full, de202a1, xce202, de202a2, wsemit2, de202b, qe203_full, de203a &
        , yce203, de203b, qe204_full, de204a, xce204, de204b, endemit2)

! ------------------------------------------------------------------------------

