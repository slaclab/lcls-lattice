  BC2 : LINE=(BC2i,BC2c,BC2o)

  EMIT2 : LINE=(BEGEMIT2,QE201_full,DE201a,YCE201,DE201b,IM21B,DE201c,QE202_full,DE202a1,XCE202,DE202a2,WSEMIT2,DE202b,
         QE203_full,DE203a,YCE203,DE203b,QE204_full,DE204a,XCE204,DE204b,ENDEMIT2)

