! ==============================================================================
! SBEN
! ------------------------------------------------------------------------------

! BC2 chicane
! - approximate on-axis effective length per R. Carr (01-AUG-05 PE)
! - use series approximation for sinc(x)=sin(x)/x to allow BXh=0

! GB2   : 1D19.7 gap height (m)
! ZB2   : 1D19.7 "Z" length (m)
! FB2   : measured fringe field
! AB2   : chicane bend angle (rad)
! BB2   : chicane bend field (kG)
! LB2   : chicane bend path length (m)
! AB2S  : "short" half chicane bend angle (rad)
! LB2S  : "short" half chicane bend path length (m)
! AB2L  : "long" half chicane bend angle (rad)
! LB2L  : "long" half chicane bend path length (m)

gb2 = 0.03335
zb2 = 0.549
fb2 = 0.6287
ab2 = 0.046846250848 !R56=0.045
bb2 = brho2*sin(ab2)/zb2
ab2_2 = ab2*ab2
ab2_4 = ab2_2*ab2_2
ab2_6 = ab2_4*ab2_2
sincab2 = 1-ab2_2/6+ab2_4/120-ab2_6/5040 !~sinc(AB2)=sin(AB2)/AB2
lb2 = zb2/sincab2
ab2s = asin(sin(ab2)/2)
ab2s_2 = ab2s*ab2s
ab2s_4 = ab2s_2*ab2s_2
ab2s_6 = ab2s_4*ab2s_2
sincab2s = 1-ab2s_2/6+ab2s_4/120-ab2s_6/5040 !~sinc(AB2S)=sin(AB2S)/AB2S
lb2s = zb2/(2*sincab2s)
ab2l = ab2-ab2s
lb2l = lb2-lb2s

bcx21a: sbend, type = "1D19.7", l = lb2s, angle = +ab2s, hgap = gb2/2, e1 = 0, fint = fb2, fintx = 0
bcx21b: sbend, type = "1D19.7", l = lb2l, angle = +ab2l, hgap = gb2/2, fint = 0, e2 = +ab2, fintx = fb2
bcx22a: sbend, type = "1D19.7", l = lb2l, angle = -ab2l, hgap = gb2/2, e1 = -ab2, fint = fb2, fintx = 0
bcx22b: sbend, type = "1D19.7", l = lb2s, angle = -ab2s, hgap = gb2/2, fint = 0, e2 = 0, fintx = fb2
bcx23a: sbend, type = "1D19.7", l = lb2s, angle = -ab2s, hgap = gb2/2, e1 = 0, fint = fb2, fintx = 0
bcx23b: sbend, type = "1D19.7", l = lb2l, angle = -ab2l, hgap = gb2/2, fint = 0, e2 = -ab2, fintx = fb2
bcx24a: sbend, type = "1D19.7", l = lb2l, angle = +ab2l, hgap = gb2/2, e1 = +ab2, fint = fb2, fintx = 0
bcx24b: sbend, type = "1D19.7", l = lb2s, angle = +ab2s, hgap = gb2/2, fint = 0, e2 = 0, fintx = fb2

! define unsplit SBENs for BMAD ... not used by MAD

bcx21: sbend, type = "1D19.7", hgap = gb2/2, l = lb2, angle = +ab2, e1 = 0, fint = fb2, e2 = +ab2, fintx = fb2
bcx22: sbend, type = "1D19.7", hgap = gb2/2, l = lb2, angle = -ab2, e1 = -ab2, fint = fb2, e2 = 0, fintx = fb2
bcx23: sbend, type = "1D19.7", hgap = gb2/2, l = lb2, angle = -ab2, e1 = 0, fint = fb2, e2 = -ab2, fintx = fb2
bcx24: sbend, type = "1D19.7", hgap = gb2/2, l = lb2, angle = +ab2, e1 = +ab2, fint = fb2, e2 = 0, fintx = fb2

! ==============================================================================
! QUAD
! ------------------------------------------------------------------------------

! L2 to BC2 chicane

kq2c01 = 0.510742626723

q2c01: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kq2c01

! BC2 chicane

kcq21 = 0
kcq22 = 0

cq21b: quadrupole, type = "1.69Q3.4", l = lqc/2, aperture = rqc, k1 = kcq21
cq22b: quadrupole, type = "1.69Q3.4", l = lqc/2, aperture = rqc, k1 = kcq22

! match into L3

kqe201 = -1.302578004949
kqe202 = 1.990185768694
kqe203 = -2.035694933515
kqe204 = 1.984107437335

qe201: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqe201
qe202: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqe202
qe203: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqe203
qe204: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqe204

! ==============================================================================
! DRIF
! ------------------------------------------------------------------------------

! L2 to BC2 chicane

d2c00: drift, l = 3.108252011609
d2c01: drift, l = 0.5

d2c00a: drift, l = 0.039882
d2c00c: drift, l = 0.338951
d2c00d: drift, l = 0.321049
d2c00b: drift, l = d2c00[l]-d2c00a[l]-d2c00c[l]-d2c00d[l]
d2c01a: drift, l = 0.133
d2c01b: drift, l = d2c01[l]-d2c01a[l]

! BC2 chicane

zdc2o = 10.4092-zb2 !BXC21 exit to BCX22 entrance
zdc2i = 2.299-zb2   !BXC22 exit to BCX23 entrance

dc2o: drift, l = zdc2o/cos(ab2), type = "CSR"
dc2i: drift, l = zdc2i, type = "CSR"

zdc2oa = 2.009462     !BXC21 exit to CQ21B center
zdc2ob = zdc2o-zdc2oa !CQ21B center to BCX22 entrance
zdc2od = 2.009462     !CQ22B center to BXC24 entrance
zdc2oc = zdc2o-zdc2od !BXC23 exit to CQ22B center

dc2oa: drift, l = zdc2oa/cos(ab2)-lqc/2, type = "CSR"
dc2ob: drift, l = zdc2ob/cos(ab2)-lqc/2, type = "CSR"
dc2ih: drift, l = dc2i[l]/2, type = "CSR"
dc2ia: drift, l = 0.3795, type = "CSR"       !0.35
dc2ib: drift, l = 0.165-ljaw/2, type = "CSR" !0.35
dc2ic: drift, l = 0.183-ljaw/2, type = "CSR" !0.35
dc2id: drift, l = 0.598, type = "CSR"        !0.35
dc2ie: drift, l = 0.4245, type = "CSR"       !0.35
dc2oc: drift, l = zdc2oc/cos(ab2)-lqc/2, type = "CSR"
dc2od: drift, l = zdc2od/cos(ab2)-lqc/2, type = "CSR"

! BC2 chicane to EMIT2

d2c02: drift, l = 1.050338

d2c02a: drift, l = 0.687372
d2c02b: drift, l = d2c02[l]-d2c02a[l]

! match into L3

lemit2 = 31.224348 !28.859648+2.3627

de201: drift, l = 4.906343360384
de202a: drift, l = 10.974020455558
de203: drift, l = 3.0
de204: drift, l = 3.035216558157 !3.033216558157
de202b: drift, l = lemit2-4*lqx-d2c02[l]-de201[l]-de202a[l]-de203[l]-de204[l]
de202: drift, l = de202a[l]+de202b[l]

de201a: drift, l = 0.321044
de201b: drift, l = 0.328618
de201c: drift, l = de201[l]-de201a[l]-de201b[l]
de202a1: drift, l = 0.321864
de202a2: drift, l = de202a[l]-de202a1[l]
de203a: drift, l = 0.321044
de203b: drift, l = de203[l]-de203a[l]
de204a: drift, l = 0.321864
de204b: drift, l = de204[l]-de204a[l]

! ==============================================================================
! BPMs
! ------------------------------------------------------------------------------

bpm2c01: monitor, type = "Stripline-1"
bpme201: monitor, type = "Stripline-1"
bpme202: monitor, type = "Stripline-1"
bpme203: monitor, type = "Stripline-1"
bpme204: monitor, type = "Stripline-1"

rfb2c01: monitor, type = "@2,CavityS-1"
bpm21b: monitor, type = "Stripline-8"  !RFB21 : MONI, TYPE="@2,CavityL-1"

! ==============================================================================
! XCORs
! ------------------------------------------------------------------------------

xc2c00: hkicker, type = "class-4"
xce202: hkicker, type = "class-4"
xce204: hkicker, type = "class-4"

! ==============================================================================
! YCORs
! ------------------------------------------------------------------------------

yc2c00: vkicker, type = "class-4"
yce201: vkicker, type = "class-4"
yce203: vkicker, type = "class-4"

! ==============================================================================
! marker points, etc.
! ------------------------------------------------------------------------------

! collimator

ce21b: rcollimator, l = ljaw, x_limit = 13.3e-3, type = "HCOLL"    !X momentum collimator

! instruments

otr21b: monitor, type = "OTR BC"  !BC2 energy spread
ws21b: marker, type = "@3,fast" !BC2 energy spread
bz21b: monitor, type = "CSR"     !CSR-based relative bunch length monitor
im21b: marker, type = "ICT"     !Beam Current Monitor
wsemit2: marker, type = "fast"    !post-BC2 emittance

! markers

bc2bcbeg: marker
bc2bcmid: marker
cntbc2: marker, type = "CENTER"
bc2bcend: marker

