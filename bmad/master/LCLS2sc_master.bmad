xf = xoff
 !Yf     :=  1.899339708765 !1.897939159495 -0.3*SIN(2*AVB)
 !Zf     := -267.7180471454 !-267.4180504124 -0.3*COS(2*AVB)
yf = 1.899339708719 !1.897939159495 -0.3*SIN(2*AVB)
zf = -267.7180471432 !-267.4180504124 -0.3*COS(2*AVB)
thetaf = 0
phif = 2*avb
psif = 0

