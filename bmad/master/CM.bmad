! ==============================================================================
! QUAD
! ------------------------------------------------------------------------------

lcmq = 0.23     !cryomodule quadrupole length
rcmq = 0.0762/2 !cryomodule quadrupole pole-tip radius

kqcmfodo1 = 0.274030631043 !L1: 45 degrees/cell
kqcmfodo2 = 0.185334132537 !L2: 30 degrees/cell
kqcmfodo3 = 0.185334132537 !L3: 30 degrees/cell

! L0

kqcm01 = 0.378216482077

qcm01: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = kqcm01

! L1

qcm02: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = -0.350806201565 !-KQCMfodo1
qcm03: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = 0.239632137591 ! KQCMfodo1

! L2

qcm04: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = -0.337961546572 !-KQCMfodo2
qcm05: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = 0.301393830753 ! KQCMfodo2
qcm06: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = -0.198247592167 !-KQCMfodo2
qcm07: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = 0.17137444971  ! KQCMfodo2
qcm08: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = -0.171719110362 !-KQCMfodo2
qcm09: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = 0.174074499842 ! KQCMfodo2
qcm10: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = -0.174836643616 !-KQCMfodo2
qcm11: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = 0.176449016841 ! KQCMfodo2
qcm12: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = -0.181553095532 !-KQCMfodo2
qcm13: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = 0.062968975261 ! KQCMfodo2
qcm14: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = -0.176070484188 !-KQCMfodo2
qcm15: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = 0.067235224924 ! KQCMfodo2

! L3

qcm16: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = -0.316668486163 !-KQCMfodo3
qcm17: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = 0.258400025669 ! KQCMfodo3
qcm18: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = -0.210508915484 !-KQCMfodo3
qcm19: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = 0.193498338564 ! KQCMfodo3
qcm20: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = -0.187169022374 !-KQCMfodo3
qcm21: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = kqcmfodo3
qcm22: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = -kqcmfodo3
qcm23: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = kqcmfodo3
qcm24: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = -0.190499689122 !-KQCMfodo3
qcm25: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = 0.18176432291  ! KQCMfodo3
qcm26: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = -0.181491332809 !-KQCMfodo3
qcm27: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = 0.190245621895 ! KQCMfodo3
qcm28: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = -kqcmfodo3
qcm29: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = 0.185719761489 ! KQCMfodo3
qcm30: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = -0.188023739028 !-KQCMfodo3
qcm31: quadrupole, type = "cryo", l = lcmq/2, aperture = rcmq, k1 = 0.194636647003 ! KQCMfodo3
