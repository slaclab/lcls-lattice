! QUAD
! ------------------------------------------------------------------------------

lcmq = 0.23     !cryomodule quadrupole length
rcmq = 0.0762/2 !cryomodule quadrupole pole-tip radius

kqcmfodo1 = 0.274030631043 !L1: 45 degrees/cell
kqcmfodo2 = 0.185334132537 !L2: 30 degrees/cell
kqcmfodo3 = 0.185334132537 !L3: 30 degrees/cell

! L0

kqcm01 = 0.378216482077

qcm01: quadrupole, type = "cryo F1.3-19", l = lcmq/2, aperture = rcmq, k1 = kqcm01

! L1

qcm02: quadrupole, type = "cryo J1.3-21", l = lcmq/2, aperture = rcmq, k1 = -0.378467749242 !-KQCMfodo1
qcm03: quadrupole, type = "cryo J1.3-20", l = lcmq/2, aperture = rcmq, k1 = 0.232219173255 ! KQCMfodo1

