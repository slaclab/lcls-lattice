! ==============================================================================
! DRIF
! ------------------------------------------------------------------------------

! ------------------------------------------------------------------------------
! 1.3 GHz cryomodule
! ------------------------------------------------------------------------------

! from Joshua Kaluzny spreadsheet (2015_11_19)

lgv2cav = 0.79731 !u/s gate valve to cavity #1    !0.79981
lcav2cav = 1.38360 !intra-CM cavity to cavity
lcav2bpm = 0.81139 !cavity #8 to BPM
lbpm2quad = 0.26444 !BPM to quadrupole
lquad2gv = 0.35186 !quadrupole to d/s gate valve   !0.35436
lgv2hom = 0.16577 !d/s gate valve to HOM absorber !0.16327
lhom2gv = 0.14442 !HOM absorber to u/s gate valve !0.14192

! derived dimensions

lcav2quad = lcav2bpm+lbpm2quad     !cavity #8 quadrupole
lcav2gv = lcav2quad+lquad2gv     !cavity #8 to d/s gate valve
lcav2hom = lcav2gv+lgv2hom        !cavity #8 to HOM absorber
lgv2gv = lgv2hom+lhom2gv        !d/s gate valve to u/s gate valve
lcm2cm = lcav2gv+lgv2gv+lgv2cav !inter-CM cavity-to-cavity

! cryomodule drifts

dcm1: drift, l = lgv2cav-lcavl/2
dcm2: drift, l = lcav2cav-lcavl
dcm3: drift, l = lcav2bpm-lcavl/2
dcm4: drift, l = lbpm2quad-lcmq/2
dcm5: drift, l = lquad2gv-lcmq/2
dcmcm1: drift, l = lgv2hom
dcmcm2: drift, l = lhom2gv

dcm4b: drift, l = 0.03
dcm4a: drift, l = dcm4[l]-dcm4b[l]

! ------------------------------------------------------------------------------
! 1.3 GHz cryomodule to 3.9 GHz cryomodule
! ------------------------------------------------------------------------------

lhom2hgv = 0.14282 !HOM absorber to u/s gate valve !0.17021

dcmcmh1: drift, l = lgv2hom
dcmcmh2: drift, l = lhom2hgv

! ------------------------------------------------------------------------------
! 3.9 GHz cryomodule dimensions
! ------------------------------------------------------------------------------

! new (18-May-16)

lgv2hcav = 1.14660 !u/s gate valve to cavity #1
lhcav2hcav = 0.63416 !intra-CMH cavity to cavity
lhcav2bpm = 0.49684 !cavity #8 to BPM
lhbpm2gv = 0.16449 !BPM to d/s gate valve (no magnet package)
lhgv2hhom = 0.16888 !d/s gate valve to HOM absorber
lhhom2hgv = 0.13857 !HOM absorber to u/s gate valve

! derived dimensions

lhcav2gv = lhcav2bpm+lhbpm2gv !cavity #8 to d/s gate valve

! cryomodule drifts

dcmh0: drift, l = 1.14662-ccavl/2
dcmh1: drift, l = lgv2hcav-ccavl/2
dcmh2: drift, l = lhcav2hcav-ccavl
dcmh3: drift, l = lhcav2bpm-ccavl/2
dcmh4: drift, l = lhbpm2gv
dcmhcmh1: drift, l = lhgv2hhom
dcmhcmh2: drift, l = lhhom2hgv

! ------------------------------------------------------------------------------
! end caps, stay-clears, and L3 vacuum break
! ------------------------------------------------------------------------------

! end cap and feed cap dimensions, mechanical stay-clear, and differential
! vacuum pumping stay-clear (mostly from drawing SD-375-000-99-02)

dcap0u: drift, l = 0.49294 !EC-U to CSP01 = 6.965000 !0.49044
dcap0d: drift, l = 1.89015 !CSP01 to FC-1 = 7.328290 !1.88765
dmsc0d: drift, l = 1.829
dpsc1u: drift, l = 2.52295
dmsc1u: drift, l = 1.829
dcap1u: drift, l = 0.87294 !FC-2 to CSP02 = 7.345000 !0.87044
dcap1d: drift, l = 1.75429 !CSPH2 to FC-3 = 6.333200
dmsc1d: drift, l = 1.829
dpsc1d: drift, l = 1.91205                           !1.91297
dpsc2u: drift, l = 2.1388
dmsc2u: drift, l = 1.829
dcap2u: drift, l = 0.87294 !FC-4 to CSP04 = 7.345000 !0.87044
dcap2d: drift, l = 1.58968 !CSP15 to FC-5 = 7.193590
dmsc2d: drift, l = 1.829
dpsc2d: drift, l = 1.91806
dpsc3u: drift, l = 2.32295
dmsc3u: drift, l = 1.829
dcap3u: drift, l = 0.87294 !FC-6 to CSP16 = 7.345000 !0.87044
dbreak: drift, l = 2.54931
dcap3d: drift, l = 1.72438 !CSP35 to EC-D = 7.328290
dmsc3d: drift, l = 1.464
dpsc3d: drift, l = 2.67004

! beamline flanges

lblf = 0.0889 !beamline flange to cap face (m)

dmsc1ub: drift, l = lblf
dmsc1ua: drift, l = dmsc1u[l]-dmsc1ub[l]
dmsc1da: drift, l = lblf
dmsc1db: drift, l = dmsc1d[l]-dmsc1da[l]
dmsc2ub: drift, l = lblf
dmsc2ua: drift, l = dmsc2u[l]-dmsc2ub[l]
dmsc2da: drift, l = lblf
dmsc2db: drift, l = dmsc2d[l]-dmsc2da[l]
dmsc3ub: drift, l = lblf
dmsc3ua: drift, l = dmsc3u[l]-dmsc3ub[l]
dmsc3da: drift, l = lblf
dmsc3db: drift, l = dmsc3d[l]-dmsc3da[l]

! split L0 downstream endcap drift for ASTRA treaty point (15 m from cathode)

lastra = 0.378513

dcap0da: drift, l = lastra
dcap0db: drift, l = dcap0d[l]-dcmcm1[l]-dcap0da[l]

! vacuum components after L0 endcap

dmsc0da: drift, l = lblf
dmsc0db: drift, l = 1.231893
dmsc0dc: drift, l = 0.1016
dmsc0dd: drift, l = 0.156107
dmsc0de: drift, l = dmsc0d[l]-dmsc0da[l]-dmsc0db[l]-dmsc0dc[l]-dmsc0dd[l]

! miscellaneous definitions

lcryol = dcm1[l]+8*lcavl+7*dcm2[l]+dcm3[l]+dcm4[l]+lcmq+dcm5[l]
lcryoc = dcmh1[l]+8*ccavl+7*dcmh2[l]+dcmh3[l]+dcmh4[l]
ldcmfodo = lcryol+lgv2gv-lcmq

!=!  COMMENT
!=!  COMMENT
!=!    VALUE, DCM1[L],DCM2[L],DCM3[L],DCM4[L],DCM5[L],DCMCM1[L],DCMCM2[L]
!=!    VALUE, DCMH1[L],DCMH2[L],DCMH3[L],DCMH4[L]
!=!    VALUE, LcryoL,LcryoC,LDCMfodo,LDCMfodo+Lcmq
!=!  ENDCOMMENT

