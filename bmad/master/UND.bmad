! SXRSS-II BOD's

du4sa: drift, l = 0.117258
bod10: instrument, type = "Overlap Detector"
du4sb: drift, l = du4s[l]-du4sa[l]
du7sa: drift, l = 0.078508
bod12: instrument, type = "Overlap Detector"
du7sb: drift, l = du7s[l]-du7sa[l]

