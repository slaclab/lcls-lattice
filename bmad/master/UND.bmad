  CBCHICANE1 : LINE=(HXRCB1BEG,D0CB1,BCXCBX11_full,D1CB1a,MCBX4,D1CB1b,YAGCBX42,D1CB1c,BCXCBX12_full,DCHCB1,CENTER1,
         DCHCB1,BCXCBX13_full,D2CBa1,PRCBX40,D2CBa2,BODCBX40,D2CBb,BCXCBX14_full,D3CB1,HXRCB1END)

  CBCHICANE2 : LINE=(HXRCB2BEG,D0CB2,BCXCBX21_full,D1CB2a,DSSCBX11,D1CB2b,MCBX1,D1CB2c,BCXCBX22_full,DCHCB2,CENTER2,
         DCHCB2,BCXCBX23_full,D2CB,BCXCBX24_full,D3CB2,HXRCB2END)

! ------------------------------------------------------------------------------

! DBFEL (install later)

 !ZB3toC1 := 0.32356 !3rd bend center to DBFEL crystal #1
 !ZB3toC4 := 0.77365 !3rd bend center to DBFEL crystal #4

 !D2CBa : DRIF, L=(ZB3toC1-ZB6/2)/COS(AB6)
 !D2CBb : DRIF, L=(ZB3toC4-ZB3toC1)/COS(AB6)
 !D2CBd : DRIF, L=0.0 +dSmdw
 !D2CBc : DRIF, L=D2CB[L]-D2CBa[L]-D2CBb[L]-D2CBd[L]

 !CRYSTAL11 : INST !1.55 mm
 !CRYSTAL12 : INST !1.55 mm
 !CRYSTAL21 : INST !1.55 mm
 !CRYSTAL22 : INST !1.55 mm

