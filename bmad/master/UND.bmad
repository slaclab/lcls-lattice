        sxcel20, sxcel21, sxcel22, sxcel23, sxcel24, sxcel25, sxxterm)

! ------------------------------------------------------------------------------
! SXR undulator
! ------------------------------------------------------------------------------
! - Author: Heinz-Dieter Nuhn, Stanford Linear Accelerator Center
! - Last edited Mar 03, 2014
! - 7.2 mm miminum Undulator Gap; only constant break length each
! - include natural vertical focusing over all but edge terminations
! ------------------------------------------------------------------------------
! - IntgSX  = integrated quadrupole gradient
! - GQFSX   = QF and QD gradients can be made different to compensate for
!             undulator focussing ...
! - GQDSX   = ... but since undulator focussing depends on gamma^2, compensation
!             will only work for one energy
! - kQFSX   = QF undulator quadrupole focusing "k"
! - kQDSX   = QD undulator quadrupole focusing "k"
! - LDUSEGS = SXR Undulator segment length
! - luSXU   = SXR Undulator period
! - NpSXU   = SXR Undulator period count
! - LSXUCR  = SXR Undulator magnetic length
! - LSXUe   = SXR Undulator spacing between magnet array and strongback end
! - KSXU    = SXR Undulator parameter (rms); range 2-5.5
! - kQSX    = natural SXR undulator focusing "k" in y-plane
! ------------------------------------------------------------------------------

 !IntgSX :   definition moved to LCLS2sc_main.xsif and LCLS2cu_main.xsif
gqfsx = intgsx/lqu/10*1.0           !T/m
gqdsx = -intgsx/lqu/10*1.0           !T/m
kqfsx = 1.e-9*gqfsx*c_light/gamu/mc2 !m^-2
kqdsx = 1.e-9*gqdsx*c_light/gamu/mc2 !m^-2
kqdsxm = -2.295714281502              !-1.28484

qsxh26: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh27: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh28: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh29: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh30: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh31: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh32: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh33: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh34: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh35: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh36: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh37: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh38: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh39: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh40: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh41: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh42: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh43: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh44: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh45: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh46: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh47: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsxm

lusxu = 0.039                            !m
npsxu = 87
lsxucr = lusxu*npsxu                      !m
lsxue = (ldusegs-lsxucr)/2               !m
lsxuh = lsxucr/2
ksxu = 5.0
kqsx = (ksxu*2*pi/lusxu/sqrt(2)/gamu)^2 !m^-2


!------- SXR Undulator -------
my_umasxh_k = 5.0
umasxh: wiggler, 
        type = "VGHPU",
        L_period = 0.039, 
        n_period = 87, 
        b_max = my_umasxh_k * 2*pi*m_electron / (c_light * 0.039), 
        L = 87*0.039, 
        ds_step = 0.039*10
        
umasxh[L] = umasxh[L]/2 ! Will be doubled in desplitting process. 
!---------------------------------
!old: umasxh: taylor, type = "VGHPU", l = lsxuh, {1: 1.0, 1 0 0 0 0 0}, {1: lsxuh, 0 1 0 0 0 0}, {2:  &
!old         0.0, 1 0 0 0 0 0}, {2: 1.0, 0 1 0 0 0 0}, {3: cos(lsxuh*sqrt(kqsx)), 0 0 1 0 0 0}, {3:  &
!old         sin(lsxuh*sqrt(kqsx))/sqrt(kqsx), 0 0 0 1 0 0}, {4: -sin(lsxuh*sqrt(kqsx))*sqrt(kqsx),  &
!old         0 0 1 0 0 0}, {4: cos(lsxuh*sqrt(kqsx)), 0 0 0 1 0 0}, {5: 1.0, 0 0 0 0 1 0}, {6: 1.0,  &
!old         0 0 0 0 0 1}

umasxh26: umasxh
umasxh27: umasxh
umasxh28: umasxh
umasxh29: umasxh
umasxh30: umasxh
umasxh31: umasxh
umasxh32: umasxh
umasxh33: umasxh
umasxh34: umasxh
umasxh36: umasxh
umasxh37: umasxh
umasxh38: umasxh
