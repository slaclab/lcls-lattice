! ------------------------------------------------------------------------------
! HXR undulator exit section
! ------------------------------------------------------------------------------

tcx01: lcavity, rf_frequency = xbandf * 1e6, type = "TRANS_DEFL", l = 1.0/2, cavity_type = traveling_wave !horizontal deflection
tcx02: lcavity, rf_frequency = xbandf * 1e6, type = "TRANS_DEFL", l = 1.0/2, cavity_type = traveling_wave !horizontal deflection

! note: the below K-values are for SC beam; the settings for Cu beam are
! in the "LCLS2cu_main.mad8" file

kque1 = 0.178719376702 ! 0.178908931125 !Yuri (E=4.0, K=2.0)
kque2 = -0.136231234699                  !Yuri (E=4.0, K=2.0)

que1: quadrupole, type = "3.25Q20", l = lqd/2, k1 = kque1, aperture = rqd
que2: quadrupole, type = "3.25Q20", l = lqd/2, k1 = kque2, aperture = rqd

dzhxtes = 0.749541186639e-6 !set MDLWALL at 685 m exactly to align with HXR XTES system

due2c: drift, l = due2cb[l]+(lqr-lqd)/2 !0.555
due3a: drift, l = 0.375504 +(lqp-lqd)/2 +0.11496 -0.063643
due3b: drift, l = 1.2630495 -0.11496 +0.063643
dbkxdmph: drift, l = lbkxdmp !placeholder for x-kicker in HXR dumpline
dpcvv: drift, l = 0.397
dvvtcx: drift, l = 0.32
dtcx12: drift, l = 0.373/2
dtcxsp: drift, l = 0.381
due4: drift, l = 0.394 !DUE4b[L] +(LQR-LQD)/2
due5a: drift, l = 0.477799 +(lqp-lqd)/2 +0.012675 -0.063653
due5b: drift, l = 0.264 -0.012675 +0.063653
due5c: drift, l = 0.2674
due5e: drift, l = 0.252825-due5d[l]-due5f[l]-dzhxtes
ddlwall: drift, l = 0.250825+dzhxtes !length of dumpline thermal barrier wall

bpmue1: monitor, type = "Stripline-13" !RFBUE1 : MONI, TYPE="@2,CavityS-1"
bpmue2: monitor, type = "Stripline-13" !RFBUE2 : MONI, TYPE="@2,CavityS-1"

xcue2: hkicker, type = "class-4"
xcd3: hkicker, type = "class-5"

ycue1: vkicker, type = "class-4"
ycd3: vkicker, type = "class-5"

pctcx: ecollimator, x_limit = 4.5e-3, y_limit = 4.5e-3 !XTCAV photon collimator (9 mm aperture)
pcpm0: ecollimator, l = lpcpm, x_limit = 17.5e-3, y_limit = 17.5e-3

ph31: instrument, type = "2805 MHz" !post-undulator phase measurement RF cavity (existing LCLS device)
ph32: instrument, type = "2805 MHz" !post-undulator phase measurement RF cavity (existing LCLS device)
ph33: instrument, type = "2604 MHz" !post-undulator phase measurement RF cavity (high rate)
ph34: instrument, type = "2604 MHz" !post-undulator phase measurement RF cavity (high rate)
true1: instrument, type = "@5" !Be foil inserter (THz) -- existing LCLS device
sptcx: instrument !XTCAV spoiler
btmque: instrument !Burn-Through-Monitor
btm0: instrument !Burn-Through-Monitor behind the PCPM0

uebeg: marker
vv36: marker !treaty-point vacuum valve just downbeam of undulator
mimundo: marker
vvtcx: marker !XTCAV vacuum valve
mtcx01: marker !entrance to TCX01 (for ELEGANT WATCH point)
mtcx: marker !centerline between TCX01 and TCX02 (for matching)
mimbcs3: marker
mdlwall: marker !front face of dumpline thermal barrier wall
ueend: marker
dlstart: marker !start of dumpline
vv37: marker !vac. valve in dumpline



!Old split line:  TCX01_full : LINE=(TCX01,TCX01)

tcx01_full: line = (tcx01)
tcx01[L] = 2*tcx01[L]
tcx01_svy: null_ele, superimpose, ref=tcx01


!Old split line:  TCX02_full : LINE=(TCX02,TCX02)

tcx02_full: line = (tcx02)
tcx02[L] = 2*tcx02[L]
tcx02_svy: null_ele, superimpose, ref=tcx02



!Old split line:  QUE1_full : LINE=(QUE1,QUE1)

que1_full: line = (que1)
que1[L] = 2*que1[L]
que1_svy: null_ele, superimpose, ref=que1


!Old split line:  QUE2_full : LINE=(QUE2,QUE2)

que2_full: line = (que2)
que2[L] = 2*que2[L]
que2_svy: null_ele, superimpose, ref=que2

  UNDEXIT : LINE=(BEGDMPH_1,UEbeg,DUE1d,VV36,DUE1b,MIMUNDO,DUE1c,DUE2a,YCUE1,DUE2b,PH31,DUE2d,PH32,DUE2d,PH33,DUE2d,
         PH34,DUE2e,XCUE2,DUE2c,QUE1_full,DUE3a,BPMUE1,DUE3b,TRUE1,DUE3c,DBKXDMPH,DUE3c,PCTCX,DPCVV,VVTCX,DVVTCX,MTCX01,
         TCX01_full,DTCX12,MTCX,DTCX12,TCX02_full,DTCXSP,SPTCX,DUE4,QUE2_full,DUE5a,BPMUE2,DUE5b,BTMQUE,DUE5c,PCPM0,DUE5f,BTM0,
         DUE5d,MIMBCS3,DUE5e,MDLWALL,DDLWALL,UEend,DLstart,DSB0a,YCD3,DSB0b,XCD3,DSB0c,VV37,DSB0d,DSB0e,ENDDMPH_1)

  HXRUND : LINE=(HXR,UNDEXIT)

