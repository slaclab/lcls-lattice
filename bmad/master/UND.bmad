! ==============================================================================
! SXR undulator and extension (north)
! ==============================================================================

! ------------------------------------------------------------------------------
! SXR undulator PPM phase shifter
! - Author: Heinz-Dieter Nuhn, Stanford Linear Accelerator Center
! - Last edited September 06, 2017
! - 10.0 mm miminum Undulator Gap
! ------------------------------------------------------------------------------
! - LPSSX  = SXR Phase Shifter length
! - luPSSX = SXR Phase Shifter period
! - PIPSSX = SXR Phase Shifter phase integral
! - KPSSX  = SXR Phase Shifter Undulator parameter (rms); range 1.34-3.59
! - kQPSSX = natural SXR Phase Shifter undulator focusing "k" in y-plane
! ------------------------------------------------------------------------------

 !Eu     :  definition moved to LCLS2sc_master.xsif and LCLS2cu_master.xsif
gamu = eu/mc2                             !Lorentz energy factor in undulator [ ]
lpssx = 0.0825                             !m
lupssx = 0.075                              !m
lpssxh = lpssx/2
pipssx = 3814                               !T^2mm^3 (180-3814)
kpssx = 1.e-9*c_light/mc2*sqrt(2.e-9*pipssx/lupssx)
kqpssx = (kpssx*2*pi/lupssx/sqrt(2)/gamu)^2 !m^-2


!------- SXR Phase Shifter -------
!
! B_max = 2pi/lambda * sqrt(2*PHASE_INTEGRAL / L)
! 
pssxh_phase_integral = 3814e-9  !T^2 m^3, maximum, from: T^2mm^3 (180-3814)
pssxh_L        = 0.0825   ! m 
pssxh_L_period = 0.075 ! m 
pssxh: wiggler, type = "phase shifter", 
    L = pssxh_L,
    b_max = 2*pi / pssxh_L_period * sqrt(2 * pssxh_phase_integral / pssxh_L  ),
    n_period = 1
pssxh[L] = pssxh[L]/2 ! Will be doubled in desplitting process. 
!---------------------------------
!old: pssxh: taylor, type = "phase shifter", l = lpssxh, tt11 = 1.0, tt12 = lpssxh, tt21 = 0, tt22 = 1.0,
!old           tt33 = cos(lpssxh*sqrt(kqpssx)), tt34 = sin(lpssxh*sqrt(kqpssx))/sqrt(kqpssx),
!old           tt43 = -sin(lpssxh*sqrt(kqpssx))*sqrt(kqpssx), tt44 = cos(lpssxh*sqrt(kqpssx)), tt55 = 1.0, tt66 = 1.0

pssxh26: pssxh
pssxh27: pssxh
pssxh28: pssxh
pssxh29: pssxh
pssxh30: pssxh
pssxh31: pssxh
pssxh32: pssxh
pssxh33: pssxh
pssxh34: pssxh
pssxh36: pssxh
pssxh37: pssxh
pssxh38: pssxh
pssxh39: pssxh
pssxh40: pssxh
pssxh41: pssxh
pssxh42: pssxh
pssxh43: pssxh
pssxh44: pssxh
pssxh45: pssxh
pssxh46: pssxh

! ------------------------------------------------------------------------------
! SXR drifts
! ------------------------------------------------------------------------------

ldusegs = 3.4
ldu1s = 0.1
ldu2s = 0.03
ldu3s = 0.25-lpssxh -0.04 -0.005
ldu4s = (0.25-lpssxh-0.5*lqu)/2 +0.04 +0.005
ldu5s = (0.25-lpssxh-0.5*lqu)/2
ldu6s = 0.12-lqu/2-lrfbub/2 +0.01
ldu7s = 0.25-lrfbub/2 -0.01
dldu0s = 0.0 !fine tune Z in undulator
ldu0s = 2.1359-ldu6s-ldu7s-lqu +dldu0s

du0s: drift, l = ldu0s
du1s: drift, l = ldu1s
du2s: drift, l = ldu2s
du3s: drift, l = ldu3s
du4s: drift, l = ldu4s
du5s: drift, l = ldu5s
du6s: drift, l = ldu6s
du7s: drift, l = ldu7s

due1ab: drift, l = 0.9-lrfbub -0.057
due1e: drift, l = 0.057

! ==============================================================================
! XLEAP-II devices
! ==============================================================================

! ------------------------------------------------------------------------------
! original XLEAP wiggler
! ------------------------------------------------------------------------------

! wiggler is modeled as R-matrix to include natural vertical focusing;
! it is nominally OFF (opened to full gap, with Kwig~2); at minimum gap, Kwig=50

kwig = 34                                        !wiggler parameter [m^-1]
lamw = 0.34                                      !wiggler period [m]
lwigh = 2.38/2                                    !wiggler half-length [m]
gamw = eu/mc2                                    !Lorentz energy factor in wiggler [ ]
kqwig = setxleap2*(2*pi*kwig/lamw/sqrt(2)/gamw)^2 !natural vertical focusing "k" [m^-2]

! handle Kwig->0 by expressing R34 as an approximate SINC function

argw = lwigh*sqrt(kqwig)
argw2 = argw*argw
argw4 = argw2*argw2
argw6 = argw4*argw2
sincargw = 1-argw2/6+argw4/120-argw6/5040 !~sinc(ARGw)=sin(ARGw)/ARGw
r34w = lwigh*sincargw

wigxlh: taylor, type = "variable gap", l = lwigh, tt11 = 1.0, tt12 = lwigh, tt21 = 0, tt22 = 1.0, tt33 = cos(argw),
          tt34 = r34w, tt43 = -sin(argw)*sqrt(kqwig), tt44 = cos(argw)

 !VALUE, WIGXLh[R11],WIGXLh[R12],WIGXLh[R21],WIGXLh[R22]
 !VALUE, WIGXLh[R33],WIGXLh[R34],WIGXLh[R43],WIGXLh[R44]

dusegs18a: drift, l = (ldusegs-2*wigxlh[l])/2
dusegs18b: drift, l = ldusegs-dusegs18a[l]-2*wigxlh[l]
 !VALUE, DUSEGS18a[L],DUSEGS18b[L]
 !VALUE, DUSEGS18a[L]+2*WIGXLh[L]+DUSEGS18b[L],LDUSEGS



!Old split line: LINE=(WIGXLh,WIGXLh)

wigxlh_full: line = (wigxlh)
wigxlh[L] = 2*wigxlh[L]
  DUSEGS18    : LINE=(DUSEGS18a,WIGXLh_full,DUSEGS18b)

! ------------------------------------------------------------------------------
! SXR extension quads
! ------------------------------------------------------------------------------

! note: the below K-values come from Y. Nosochkov's UNDS_KQ5_US.xsif file,
!       for E= 4.0 GeV and KSXU= 5.0 (IntgXS= 30.0 kG)

! note: the below K-values are for SC beam; the settings for Cu beam are
!       in the "LCLS2cu_main.mad8" file

kqsx16 = 0.386434780667
kqsx19 = -0.894006742269
kqsx21 = 1.22862150816
kqsx24 = -1.251292803834

qsxh16: quadrupole, type = "0.433Q3.1", l = lqu/2, k1 = kqsx16, aperture = rqu
qsxh19: quadrupole, type = "0.433Q3.1", l = lqu/2, k1 = kqsx19, aperture = rqu
qsxh21: quadrupole, type = "0.433Q3.1", l = lqu/2, k1 = kqsx21, aperture = rqu
qsxh24: quadrupole, type = "0.433Q3.1", l = lqu/2, k1 = kqsx24, aperture = rqu

! ------------------------------------------------------------------------------
! SXR extension X-steering coils in quads
! ------------------------------------------------------------------------------

xcsx16: hkicker, type = "type-U"
xcsx19: hkicker, type = "type-U"
xcsx21: hkicker, type = "type-U"
xcsx24: hkicker, type = "type-U"

! ------------------------------------------------------------------------------
! SXR extension Y-steering coils in quads
! ------------------------------------------------------------------------------

ycsx16: vkicker, type = "type-U"
ycsx19: vkicker, type = "type-U"
ycsx21: vkicker, type = "type-U"
ycsx24: vkicker, type = "type-U"

! ------------------------------------------------------------------------------
! SXR extension BPMs
! ------------------------------------------------------------------------------

rfbsx16: monitor, l = lrfbub, type = "CavityX-1"
drfbs17: drift, l = lrfbub
drfbs18: drift, l = lrfbub
rfbsx19: monitor, l = lrfbub, type = "CavityX-1"
drfbs20: drift, l = lrfbub
rfbsx21: monitor, l = lrfbub, type = "CavityX-1"
drfbs22: drift, l = lrfbub
drfbs23: drift, l = lrfbub
rfbsx24: monitor, l = lrfbub, type = "CavityX-1"
rfbsx25: monitor, l = lrfbub, type = "CavityX-1"

sxxstart: marker !start of soft X-ray extension system
sxxterm: marker !end of soft X-ray extension system
sxrstart: marker !start of undulator system
rwwake5s: marker, type = "WAKE" !SXR beampipe wake applied here
sxrterm: marker !~end of undulator system
muqs: marker
mphs: marker



!Old split line: LINE=(QSXh16,XCSX16,YCSX16,QSXh16)

qsxh16_full: line = (qsxh16)
qsxh16[L] = 2*qsxh16[L]
xcsx16[superimpose] = T
xcsx16[ref] = qsxh16
ycsx16[superimpose] = T
ycsx16[ref] = qsxh16
dqsx17: drift, l = lqu
dqsx18: drift, l = lqu


!Old split line: LINE=(QSXh19,XCSX19,YCSX19,QSXh19)

qsxh19_full: line = (qsxh19)
qsxh19[L] = 2*qsxh19[L]
xcsx19[superimpose] = T
xcsx19[ref] = qsxh19
ycsx19[superimpose] = T
ycsx19[ref] = qsxh19
dqsx20: drift, l = lqu


!Old split line: LINE=(QSXh21,XCSX21,YCSX21,QSXh21)

qsxh21_full: line = (qsxh21)
qsxh21[L] = 2*qsxh21[L]
xcsx21[superimpose] = T
xcsx21[ref] = qsxh21
ycsx21[superimpose] = T
ycsx21[ref] = qsxh21
dqsx22: drift, l = lqu
dqsx23: drift, l = lqu


!Old split line: LINE=(QSXh24,XCSX24,YCSX24,QSXh24)

qsxh24_full: line = (qsxh24)
qsxh24[L] = 2*qsxh24[L]
xcsx24[superimpose] = T
xcsx24[ref] = qsxh24
ycsx24[superimpose] = T
ycsx24[ref] = qsxh24
dqsx25: drift, l = lqu

dpssx17: drift, l = lpssx
dpssx18: drift, l = lpssx
dpssx19: drift, l = lpssx
dpssx20: drift, l = lpssx
dpssx21: drift, l = lpssx
dpssx22: drift, l = lpssx
dpssx23: drift, l = lpssx
dpssx24: drift, l = lpssx
dpssx25: drift, l = lpssx

  SXBRK17 : LINE=(DU3s,DPSSX17,DU4s,DU5s,DQSX17     ,DU6s,DRFBS17,DU7s)
  SXBRK18 : LINE=(DU3s,DPSSX18,DU4s,DU5s,DQSX18     ,DU6s,DRFBS18,DU7s)
