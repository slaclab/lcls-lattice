 !Eu   :  definition moved to LCLS2sc_master.xsif and LCLS2cu_master.xsif
gamu = eu/mc2 !Lorentz energy factor in undulator [ ]

! ------------------------------------------------------------------------------
! SXR definitions
! ------------------------------------------------------------------------------

! ##############################################################################
! SXR: short-period undulator and phase shifter definitions (LCLS-II)
! ##############################################################################

! ------------------------------------------------------------------------------
! undulator segment
! ------------------------------------------------------------------------------
! - Author: Heinz-Dieter Nuhn, Stanford Linear Accelerator Center
! - Last edited Mar 03, 2014
! - 7.2 mm miminum Undulator Gap; only constant break length each
! - include natural vertical focusing over all but edge terminations
! ------------------------------------------------------------------------------
! - LDUSEGS = SXR Undulator segment length
! - luSXU   = SXR Undulator period
! - NpSXU   = SXR Undulator period count
! - LSXUCR  = SXR Undulator magnetic length
! - LSXUe   = SXR Undulator spacing between magnet array and strongback end
! - KSXU    = SXR Undulator parameter (rms); range 2-5.5
! - kQSX    = natural SXR undulator focusing "k" in y-plane
! ------------------------------------------------------------------------------

ldusegs = 3.4
lusxu = 0.039                            !m
npsxu = 87
lsxucr = lusxu*npsxu                      !m
lsxue = (ldusegs-lsxucr)/2               !m
lsxuh = lsxucr/2
ksxu = 5.5 !5.0
kqsx = (ksxu*2*pi/lusxu/sqrt(2)/gamu)^2 !m^-2

!new:
!new: !------- SXR Undulator -------
!new: my_umasxh_k = 5.0
!new: umasxh: wiggler,
!new:         type = "VGHPU",
!new:         L_period = 0.039,
!new:         n_period = 87,
!new:         b_max = my_umasxh_k * 2*pi*m_electron / (c_light * 0.039),
!new:         L = 87*0.039,
!new:         ds_step = 0.039*10
!new:
!new: umasxh[L] = umasxh[L]/2 ! Will be doubled in desplitting process.
!new: !---------------------------------
umasxh: taylor, type = "VGHPU39", l = lsxuh, tt11 = 1.0, tt12 = lsxuh, tt21 = 0, tt22 = 1.0,
          tt33 = cos(lsxuh*sqrt(kqsx)), tt34 = sin(lsxuh*sqrt(kqsx))/sqrt(kqsx), tt43 = -sin(lsxuh*sqrt(kqsx))*sqrt(kqsx),
          tt44 = cos(lsxuh*sqrt(kqsx)), tt55 = 1.0, tt66 = 1.0

! ------------------------------------------------------------------------------
! PPM phase shifter
! - Author: Heinz-Dieter Nuhn, Stanford Linear Accelerator Center
! - Last edited September 06, 2017
! - 10.0 mm miminum Undulator Gap
! ------------------------------------------------------------------------------
! - LPSSX  = SXR Phase Shifter length
! - luPSSX = SXR Phase Shifter period
! - PIPSSX = SXR Phase Shifter phase integral
! - KPSSX  = SXR Phase Shifter Undulator parameter (rms); range 1.34-3.59
! - kQPSSX = natural SXR Phase Shifter undulator focusing "k" in y-plane
! ------------------------------------------------------------------------------

lpssx = 0.0825                             !m
lupssx = 0.075                              !m
lpssxh = lpssx/2
pipssx = 1800 !3814                         !T^2mm^3 (180-3814)
kpssx = 1.e-9*c_light/mc2*sqrt(2.e-9*pipssx/lupssx)
kqpssx = (kpssx*2*pi/lupssx/sqrt(2)/gamu)^2 !m^-2

!new:
!new: !------- SXR Phase Shifter -------
!new: !
!new: ! B_max = 2pi/lambda * sqrt(2*PHASE_INTEGRAL / L)
!new: !
!new: pssxh_phase_integral = 3814e-9  !T^2 m^3, maximum, from: T^2mm^3 (180-3814)
!new: pssxh_L        = 0.0825   ! m
!new: pssxh_L_period = 0.075 ! m
!new: pssxh: wiggler, type = "phase shifter",
!new:     L = pssxh_L,
!new:     b_max = 2*pi / pssxh_L_period * sqrt(2 * pssxh_phase_integral / pssxh_L  ),
!new:     n_period = 1
!new: pssxh[L] = pssxh[L]/2 ! Will be doubled in desplitting process.
!new: !---------------------------------
pssxh: taylor, type = "PS75", l = lpssxh, tt11 = 1.0, tt12 = lpssxh, tt21 = 0, tt22 = 1.0,
          tt33 = cos(lpssxh*sqrt(kqpssx)), tt34 = sin(lpssxh*sqrt(kqpssx))/sqrt(kqpssx),
          tt43 = -sin(lpssxh*sqrt(kqpssx))*sqrt(kqpssx), tt44 = cos(lpssxh*sqrt(kqpssx)), tt55 = 1.0, tt66 = 1.0

! ------------------------------------------------------------------------------
! FODO cell drifts
! ------------------------------------------------------------------------------
! - DTSXU = SXU undulator segment small terminations modeled as drift
! ------------------------------------------------------------------------------

ldu1s = 0.1
ldu2s = 0.03
ldu3s = 0.25-lpssxh -0.04 -0.005
ldu4s = (0.25-lpssxh-0.5*lqu)/2 +0.04 +0.005
ldu5s = (0.25-lpssxh-0.5*lqu)/2
ldu6s = 0.12-lqu/2-lrfbub/2 +0.01
ldu7s = 0.25-lrfbub/2 -0.01
dldu0s = 0.0 !fine tune Z in undulator
ldu0s = 2.1359-ldu6s-ldu7s-lqu +dldu0s

dtsxu: drift, l = lsxue
du0s: drift, l = ldu0s
du1s: drift, l = ldu1s
du2s: drift, l = ldu2s
du3s: drift, l = ldu3s
du4s: drift, l = ldu4s
du5s: drift, l = ldu5s
du6s: drift, l = ldu6s
du7s: drift, l = ldu7s
due1ab: drift, l = 0.9-lrfbub -0.057
due1e: drift, l = 0.057

du0sa: drift, l = 0.814408 !0.7908811950945
du0sb: drift, l = du0s[l]-du0sa[l]-lrfbub

du3sa: drift, l = 0.114
du3sb: drift, l = du3s[l]-du3sa[l]
du4sa: drift, l = 0.117258
du4sb: drift, l = du4s[l]-du4sa[l]

! ##############################################################################
! SXR: long-period undulator and phase shifter definitions (LCLS-II-HE)
! ##############################################################################

! ------------------------------------------------------------------------------
! undulator segment
! - Author: Heinz-Dieter Nuhn, Stanford Linear Accelerator Center
! - Last edited June 22, 2020 (LCLS-II-HE)
! - 7.2 mm miminum Undulator Gap; only constant break length each
! - include natural vertical focusing over all but edge terminations
! ------------------------------------------------------------------------------
! - LDUSEGS_ = SXR Undulator segment length
! - luSXU_   = SXR Undulator period
! - NpSXU_   = SXR Undulator period count
! - LSXUCR_  = SXR Undulator magnetic length
! - LSXUe_   = SXR Undulator spacing between magnet array and strongback end
! - KSXU_    = SXR Undulator parameter (rms); range 2-5.5
! - kQSX_    = natural SXR undulator focusing "k" in y-plane
! ------------------------------------------------------------------------------

ldusegs_ = 3.4
lusxu_ = 0.056                              !m
npsxu_ = 60
lsxucr_ = lusxu_*npsxu_                      !m
lsxue_ = (ldusegs_-lsxucr_)/2               !m
lsxuh_ = lsxucr_/2
ksxu_ = 4.5 !8.3
kqsx_ = (ksxu_*2*pi/lusxu_/sqrt(2)/gamu)^2 !m^-2

umasxh_: taylor, type = "VGHPU56", l = lsxuh_, tt11 = 1.0, tt12 = lsxuh_, tt21 = 0, tt22 = 1.0,
          tt33 = cos(lsxuh_*sqrt(kqsx_)), tt34 = sin(lsxuh_*sqrt(kqsx_))/sqrt(kqsx_),
          tt43 = -sin(lsxuh_*sqrt(kqsx_))*sqrt(kqsx_), tt44 = cos(lsxuh_*sqrt(kqsx_)), tt55 = 1.0, tt66 = 1.0

! ------------------------------------------------------------------------------
! PPM phase shifter
! - Author: Heinz-Dieter Nuhn, Stanford Linear Accelerator Center
! - Last edited September 06, 2017
! - 10.0 mm miminum Undulator Gap
! ------------------------------------------------------------------------------
! - LPSSX_  = SXR Phase Shifter length
! - luPSSX_ = SXR Phase Shifter period
! - PIPSSX_ = SXR Phase Shifter phase integral
! - KPSSX_  = SXR Phase Shifter Undulator parameter (rms); range 1.34-3.59
! - kQPSSX_ = natural SXR Phase Shifter undulator focusing "k" in y-plane
! ------------------------------------------------------------------------------

lpssx_ = 0.1073                               !m
lupssx_ = 0.0975                               !m
lpssxh_ = lpssx_/2
pipssx_ = 1800 !5700                           !T^2mm^3
kpssx_ = 1.e-9*c_light/mc2*sqrt(2.e-9*pipssx_/lupssx_)
kqpssx_ = (kpssx_*2*pi/lupssx_/sqrt(2)/gamu)^2 !m^-2

pssxh_: taylor, type = "PS97.5", l = lpssxh_, tt11 = 1.0, tt12 = lpssxh_, tt21 = 0, tt22 = 1.0,
          tt33 = cos(lpssxh_*sqrt(kqpssx_)), tt34 = sin(lpssxh_*sqrt(kqpssx_))/sqrt(kqpssx_),
          tt43 = -sin(lpssxh_*sqrt(kqpssx_))*sqrt(kqpssx_), tt44 = cos(lpssxh_*sqrt(kqpssx_)), tt55 = 1.0, tt66 = 1.0

! ------------------------------------------------------------------------------
! FODO cell drifts
! ------------------------------------------------------------------------------
! - DTSXU_ = SXU undulator segment small terminations modeled as drift
! ------------------------------------------------------------------------------

ldu3s_ = 0.25-lpssxh_-0.04-0.005-0.010996
ldu4s_ = (0.25-lpssxh_-0.5*lqu)/2+0.04+0.005-0.0062+0.010996
ldu5s_ = (0.25-lpssxh_-0.5*lqu)/2+0.0062

dtsxu_: drift, l = lsxue_
du3s_: drift, l = ldu3s_
du4s_: drift, l = ldu4s_
du5s_: drift, l = ldu5s_
du4sb_: drift, l = du4s_[l]-du4sa[l]
du3sb_: drift, l = du3s_[l]-du3sa[l]

