! ------------------------------------------------------------------------------
! HXRSS self-seeding chicane (LCLSII-3.2-PR-0102-R1)
! ------------------------------------------------------------------------------

! NOTEs:
! - in LCLS: BXHS1-4
! - Bmax = 1.9 kG-m @ 6 A (~24 mm beam offset)
! - use series approximation for sinc(x)=sin(x)/x to allow BLB4=0
! - deflects toward -X (to the right/south/wall)
! - bends away from coil side

! BCXHS1 gets an X-offset of  0    mm (toward the wall)
! BCXHS2 gets an X-offset of -2.39 mm (toward the wall)
! BCXHS3 gets an X-offset of -2.39 mm (toward the wall)
! BCXHS4 gets an X-offset of  0    mm (toward the wall)

brho4 = cb*eu                             !beam rigidity at chicane (kG-m)
gb4 = 0.315*in2m                        !full gap height [m]
zb4 = 14.315*in2m                       !on-axis effective length is 14" + gap (rule-of-thumb)
fb4 = 0.5                               !not measured
ab4 = +3.02786616797e-3*sethxrss        !bend angle (rad) for R56=+15.0 um
blb4 = brho4*ab4                         !integrated strength (1.377623 kG-m @ 13.64 GeV)
ab4_2 = ab4*ab4
ab4_4 = ab4_2*ab4_2
ab4_6 = ab4_4*ab4_2
sincab4 = 1-ab4_2/6+ab4_4/120-ab4_6/5040    !~sinc(AB4)=sin(AB4)/AB4
lb4 = zb4/sincab4                       !chicane bend path length (m)
ab4s = asin(sin(ab4)/2)                  !"short" half chicane bend angle (rad)
ab4s_2 = ab4s*ab4s
ab4s_4 = ab4s_2*ab4s_2
ab4s_6 = ab4s_4*ab4s_2
sincab4s = 1-ab4s_2/6+ab4s_4/120-ab4s_6/5040 !~sinc(AB4s)=sin(AB4s)/AB4s
lb4s = (zb4/2)/sincab4s                  !"short" half chicane bend path length (m)
ab4l = ab4-ab4s                          !"long" half chicane bend angle (rad)
lb4l = lb4-lb4s                          !"long" half chicane bend path length (m)

bcxhs1a: sbend, type = "0.315D14-C", hgap = gb4/2, l = lb4s, angle = +ab4s, e1 = 0, fint = fb4, fintx = 0
bcxhs1b: sbend, type = "0.315D14-C", hgap = gb4/2, l = lb4l, angle = +ab4l, e2 = +ab4, fint = 0, fintx = fb4
bcxhs2a: sbend, type = "0.315D14-C", hgap = gb4/2, l = lb4l, angle = -ab4l, e1 = -ab4, fint = fb4, fintx = 0
bcxhs2b: sbend, type = "0.315D14-C", hgap = gb4/2, l = lb4s, angle = -ab4s, e2 = 0, fint = 0, fintx = fb4
bcxhs3a: sbend, type = "0.315D14-C", hgap = gb4/2, l = lb4s, angle = -ab4s, e1 = 0, fint = fb4, fintx = 0
bcxhs3b: sbend, type = "0.315D14-C", hgap = gb4/2, l = lb4l, angle = -ab4l, e2 = -ab4, fint = 0, fintx = fb4
bcxhs4a: sbend, type = "0.315D14-C", hgap = gb4/2, l = lb4l, angle = +ab4l, e1 = +ab4, fint = fb4, fintx = 0
bcxhs4b: sbend, type = "0.315D14-C", hgap = gb4/2, l = lb4s, angle = +ab4s, e2 = 0, fint = 0, fintx = fb4

! define unsplit SBENs for BMAD ... not used by MAD

bcxhs1: sbend, type = "0.315D14-C", hgap = gb4/2, l = lb4, angle = +ab4, e1 = 0, fint = fb4, e2 = +ab4, fintx = fb4
bcxhs2: sbend, type = "0.315D14-C", hgap = gb4/2, l = lb4, angle = -ab4, e1 = -ab4, fint = fb4, e2 = 0, fintx = fb4
bcxhs3: sbend, type = "0.315D14-C", hgap = gb4/2, l = lb4, angle = -ab4, e1 = 0, fint = fb4, e2 = -ab4, fintx = fb4
bcxhs4: sbend, type = "0.315D14-C", hgap = gb4/2, l = lb4, angle = +ab4, e1 = +ab4, fint = fb4, e2 = 0, fintx = fb4

 !LHssB2Bo := 0.939 !outer bend center-to-center (PRD Table 3)
 !LHssB2Bi := 0.936 !inner bend center-to-center (PRD Table 3)

lhssb2bo = 0.957   !outer bend center-to-center (PRD Table 3)
lhssb2bi = 0.936   !inner bend center-to-center (PRD Table 3)

d1: drift, l = (lhssb2bo-zb4)/cos(ab4)
dch: drift, l = (lhssb2bi-zb4)/2
dmono: drift, l = (ldusegh-2*lhssb2bo-lhssb2bi-zb4)/2

hxrssbeg: marker
diamond: instrument
hxrssend: marker



!Old split line:  BCXHS1_full : LINE=(BCXHS1a,BCXHS1b)

bcxhs1_full: line = (bcxhs1)


!Old split line:  BCXHS2_full : LINE=(BCXHS2a,BCXHS2b)

bcxhs2_full: line = (bcxhs2)


!Old split line:  BCXHS3_full : LINE=(BCXHS3a,BCXHS3b)

bcxhs3_full: line = (bcxhs3)


!Old split line:  BCXHS4_full : LINE=(BCXHS4a,BCXHS4b)

bcxhs4_full: line = (bcxhs4)

  HCHICANE : LINE=(HXRSSBEG,DMONO,BCXHS1_full,D1,BCXHS2_full,DCH,DIAMOND,DCH,BCXHS3_full,D1,BCXHS4_full,DMONO,HXRSSEND)

! ------------------------------------------------------------------------------
! CBXFEL chicanes (off-project)
! ------------------------------------------------------------------------------

! NOTEs:
! - Bmax = 3.5 kG-m @ 12 A (approximately)
! - Emax = 10.35 GeV for CBXFEL project (8.6 GeV for DBFEL project)
! - use series approximation for sinc(x)=sin(x)/x to allow AB6=0
! - deflects toward +X (to the left/north/aisle)
! - bends toward coil side of C-dipoles
! - use Everson Tesla (ETI) "0.276D14-C" dipoles (356 mm core, 7 mm gap)

ecmax = 10.35        !6.3-10.35 GeV
brho6 = cb*ecmax     !beam rigidity at CBXFEL chicanes (kG-m)
bl6max = 3.5         !kG-m @ ~12 A (measured)
ab6max = bl6max/brho6 !rad

gb6 = 0.007                             !full gap height [m]
zb6 = 0.368                             !on-axis effective length (per ETI)
fb6 = 1.0408                            !measured
ab6 = +ab6max*setcbxfel                 !bend angle (rad)
ab6_2 = ab6*ab6
ab6_4 = ab6_2*ab6_2
ab6_6 = ab6_4*ab6_2
sincab6 = 1-ab6_2/6+ab6_4/120-ab6_6/5040    !~sinc(AB6)=sin(AB6)/AB6
lb6 = zb6/sincab6                       !chicane bend path length (m)
ab6s = asin(sin(ab6)/2)                  !"short" half chicane bend angle (rad)
ab6s_2 = ab6s*ab6s
ab6s_4 = ab6s_2*ab6s_2
ab6s_6 = ab6s_4*ab6s_2
sincab6s = 1-ab6s_2/6+ab6s_4/120-ab6s_6/5040 !~sinc(AB6s)=sin(AB6s)/AB6s
lb6s = (zb6/2)/sincab6s                  !"short" half chicane bend path length (m)
ab6l = ab6-ab6s                          !"long" half chicane bend angle (rad)
lb6l = lb6-lb6s                          !"long" half chicane bend path length (m)

bcxcbx11a: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6s, angle = -ab6s, e1 = 0, fint = fb6, fintx = 0
bcxcbx11b: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6l, angle = -ab6l, e2 = -ab6, fint = 0, fintx = fb6
bcxcbx12a: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6l, angle = +ab6l, e1 = +ab6, fint = fb6, fintx = 0
bcxcbx12b: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6s, angle = +ab6s, e2 = 0, fint = 0, fintx = fb6
bcxcbx13a: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6s, angle = +ab6s, e1 = 0, fint = fb6, fintx = 0
bcxcbx13b: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6l, angle = +ab6l, e2 = +ab6, fint = 0, fintx = fb6
bcxcbx14a: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6l, angle = -ab6l, e1 = -ab6, fint = fb6, fintx = 0
bcxcbx14b: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6s, angle = -ab6s, e2 = 0, fint = 0, fintx = fb6

bcxcbx21a: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6s, angle = -ab6s, e1 = 0, fint = fb6, fintx = 0
bcxcbx21b: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6l, angle = -ab6l, e2 = -ab6, fint = 0, fintx = fb6
bcxcbx22a: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6l, angle = +ab6l, e1 = +ab6, fint = fb6, fintx = 0
bcxcbx22b: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6s, angle = +ab6s, e2 = 0, fint = 0, fintx = fb6
bcxcbx23a: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6s, angle = +ab6s, e1 = 0, fint = fb6, fintx = 0
bcxcbx23b: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6l, angle = +ab6l, e2 = +ab6, fint = 0, fintx = fb6
bcxcbx24a: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6l, angle = -ab6l, e1 = -ab6, fint = fb6, fintx = 0
bcxcbx24b: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6s, angle = -ab6s, e2 = 0, fint = 0, fintx = fb6

! define unsplit SBENs for BMAD ... not used by MAD

bcxcbx11: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6, angle = -ab6, e1 = 0, fint = fb6, e2 = -ab6, fintx = fb6
bcxcbx12: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6, angle = +ab6, e1 = +ab6, fint = fb6, e2 = 0, fintx = fb6
bcxcbx13: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6, angle = +ab6, e1 = 0, fint = fb6, e2 = +ab6, fintx = fb6
bcxcbx14: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6, angle = -ab6, e1 = -ab6, fint = fb6, e2 = 0, fintx = fb6

bcxcbx21: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6, angle = -ab6, e1 = 0, fint = fb6, e2 = -ab6, fintx = fb6
bcxcbx22: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6, angle = +ab6, e1 = +ab6, fint = fb6, e2 = 0, fintx = fb6
bcxcbx23: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6, angle = +ab6, e1 = 0, fint = fb6, e2 = +ab6, fintx = fb6
bcxcbx24: sbend, type = "0.276D14-C", hgap = gb6/2, l = lb6, angle = -ab6, e1 = -ab6, fint = fb6, e2 = 0, fintx = fb6

 !Ztotal  := 134.391*in2m  !total system length
 !Zuseg   := 3.372032      !undulator segment length
zb2bo = 1.23035       !outer bend center-to-center
zb2bi = 0.535763      !inner bend center-to-center

zcbxc1 = 3.504082 !0.1+(D0CB1[L]+ZB6/2+ZB2Bo+ZB2Bi+ZB2Bo+ZB6/2)
zcbxc2 = 3.504089 !0.1+(D0CB2[L]+ZB6/2+ZB2Bo+ZB2Bi+ZB2Bo+ZB6/2)

d0cb1: drift, l = 0.264603-(du1h[l]+du2h[l]+zb6/2) !0.26456
d1cb1: drift, l = (zb2bo-zb6)/cos(ab6)
d1cb1a: drift, l = (0.656216-zb6/2)/cos(ab6)
d1cb1b: drift, l = 0.1059/cos(ab6)
d1cb1c: drift, l = d1cb1[l]-d1cb1a[l]-d1cb1b[l]
dchcb1: drift, l = (zb2bi-zb6)/2
d2cb: drift, l = d1cb1[l]
d2cba: drift, l = 0.568799
d2cbb: drift, l = d2cb[l]-d2cba[l]
d3cb1: drift, l = zcbxc1-(d0cb1[l]+zb6/2+zb2bo+zb2bi+zb2bo+zb6/2)
du3hcb1: drift, l = 0.203362-d3cb1[l] !2*DU3h[L]+0.133428 ! 0.102780
du4hcb1: drift, l = du4h[l]-0.000176 !-0.025003
du5hcb1: drift, l = du5h[l]+0.000741 !-0.133252 !-0.108382

d0cb2: drift, l = 0.264610-(du1h[l]+du2h[l]+zb6/2) !0.26456
d1cb2: drift, l = d1cb1[l]
d1cb2a: drift, l = (0.605122666708-zb6/2)/cos(ab6)
d1cb2b: drift, l = 0.05019/cos(ab6)
d1cb2c: drift, l = d1cb2[l]-d1cb2a[l]-d1cb2b[l]
dchcb2: drift, l = dchcb1[l]
d3cb2: drift, l = zcbxc2-(d0cb2[l]+zb6/2+zb2bo+zb2bi+zb2bo+zb6/2)
du3hcb2: drift, l = 0.203362-d3cb2[l] !DU3h[L]+0.184427
du4hcb2: drift, l = du4h[l]-0.000176 !-0.025003
du5hcb2: drift, l = du5h[l]+0.000734 !-0.133259 !-0.108382

