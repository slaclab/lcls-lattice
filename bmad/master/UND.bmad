! ------------------------------------------------------------------------------
! miscellaneous SXR cell stuff
! ------------------------------------------------------------------------------

! SXRSS-II BOD's

bod10: monitor, type = "YAG" !Beam Overlap Device
du7sa: drift, l = 0.078508
bod12: monitor, type = "YAG" !Beam Overlap Device
du7sb: drift, l = du7s[l]-du7sa[l]

! PEPPEx components

pepxang = 0.105263157895e-2 !offset beam toward aisle (south)

 !DU7sc     : DRIF, L=0.184
 !FSPEPX1   : INST, TYPE="fast shutter"
 !DU7sd     : DRIF, L=DU7s[L]-DU7sc[L]
xcpepx1: hkicker, type = "2.19 Gap Type 4", kick = -pepxang*setpepx
du7se: drift, l = 0.074
vgpepx1: marker, type = "vacuum gauges"
vgccpepx1: instrument, type = "cold cathode"
vgprpepx1: instrument, type = "pirani"
du7sf: drift, l = du7s[l]-du7se[l]
dusegs50a: drift, l = 0.064
xcpepx2: hkicker, type = "2.19 Gap Type 4", kick = +pepxang*setpepx
dusegs50b: drift, l = 0.586
zppepx: instrument, type = "zone plate"
dusegs50c: drift, l = 0.29
vppepx1: marker, type = "ion pump"
dusegs50d: drift, l = 0.224
xcpepx3: hkicker, type = "2.19 Gap Type 4", kick = +pepxang*setpepx
dusegs50e: drift, l = 0.95
xcpepx4: hkicker, type = "2.19 Gap Type 4", kick = -pepxang*setpepx
dusegs50f: drift, l = 0.6
gjpepx: instrument, type = "gas jet"
dusegs50g: drift, l = dusegs50[l]-dusegs50a[l]-dusegs50b[l]-dusegs50c[l]-dusegs50d[l]-dusegs50e[l]-dusegs50f[l]
due1ab1: drift, l = 0.121
vppepx2: marker, type = "ion pump"
due1ab2: drift, l = due1ab[l]-due1ab1[l]

