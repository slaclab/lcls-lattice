! ------------------------------------------------------------------------------
! SXRSS self-seeding chicane (LCLSII-3.2-PR-0101-R0 doesn't specify chicane
! requirements ... use LCLS PRD SLAC-I-081-101-003-00-R000)
! NOTE: chicane slides across the aisle from LCLS to SXR; now bends toward the
!       (north) wall, away from the aisle
! ------------------------------------------------------------------------------

! NOTEs:
! - in LCLS: BXSS1-4
! - nominal beam energy range is 3.35-4.74 GeV
! - minimum energy is 2.6 GeV; maximum energy is 5.2 GeV
! - Bmax = 2.56 kG-m @ 9 A (20 mm maximum beam offset)
! - use series approximation for sinc(x)=sin(x)/x to allow AB5=0
! - deflects toward +X (to the left/north/wall)
! - bends toward coil side
! - Dieter Walz designation: 1.575D14-C (pole-width rather than gap height)

! BCXSS1 gets an X-offset of +1.0 mm (toward the wall)
! BCXSS2 gets an X-offset of +9.7 mm (toward the wall)
! BCXSS3 gets an X-offset of +9.7 mm (toward the wall)
! BCXSS4 gets an X-offset of +1.0 mm (toward the wall)

brho5 = cb*eu                             !beam rigidity at chicane (kG-m)
gb5 = 0.315*in2m                        !full gap height [m]
zb5 = 14.315*in2m                       !on-axis effective length is 14" + gap (rule-of-thumb)
fb5 = 0.5                               !not measured
ab5 = -0.014249046471*setsxrss          !bend angle (rad) for dX=+17.0 mm
blb5 = brho5*ab5                         !integrated strength (-1.901188 kG-m @ 4 GeV)
ab5_2 = ab5*ab5
ab5_4 = ab5_2*ab5_2
ab5_6 = ab5_4*ab5_2
sincab5 = 1-ab5_2/6+ab5_4/120-ab5_6/5040    !~sinc(AB5)=sin(AB5)/AB5
lb5 = zb5/sincab5                       !chicane bend path length (m)
ab5s = asin(sin(ab5)/2)                  !"short" half chicane bend angle (rad)
ab5s_2 = ab5s*ab5s
ab5s_4 = ab5s_2*ab5s_2
ab5s_6 = ab5s_4*ab5s_2
sincab5s = 1-ab5s_2/6+ab5s_4/120-ab5s_6/5040 !~sinc(AB5s)=sin(AB5s)/AB5s
lb5s = zb5/(2*sincab5s)                  !"short" half chicane bend path length (m)
ab5l = ab5-ab5s                          !"long" half chicane bend angle (rad)
lb5l = lb5-lb5s                          !"long" half chicane bend path length (m)

bcxss1a: sbend, hgap = gb5/2, e1 = 0, fint = 0.5, fintx = 0, type = "0.315D14-C", l = lb5s, angle &
         = lb5s * (+ab5s)/lb5s
bcxss1b: sbend, hgap = gb5/2, e2 = +ab5, fint = 0, fintx = 0.5, type = "0.315D14-C", l = lb5l,  &
        angle = lb5l * (+ab5l)/lb5l
bcxss2a: sbend, hgap = gb5/2, e1 = -ab5, fint = 0.5, fintx = 0, type = "0.315D14-C", l = lb5l,  &
        angle = lb5l * (-ab5l)/lb5l
bcxss2b: sbend, hgap = gb5/2, e2 = 0, fint = 0, fintx = 0.5, type = "0.315D14-C", l = lb5s, angle &
         = lb5s * (-ab5s)/lb5s
bcxss3a: sbend, hgap = gb5/2, e1 = 0, fint = 0.5, fintx = 0, type = "0.315D14-C", l = lb5s, angle &
         = lb5s * (-ab5s)/lb5s
bcxss3b: sbend, hgap = gb5/2, e2 = -ab5, fint = 0, fintx = 0.5, type = "0.315D14-C", l = lb5l,  &
        angle = lb5l * (-ab5l)/lb5l
bcxss4a: sbend, hgap = gb5/2, e1 = +ab5, fint = 0.5, fintx = 0, type = "0.315D14-C", l = lb5l,  &
        angle = lb5l * (+ab5l)/lb5l
bcxss4b: sbend, hgap = gb5/2, e2 = 0, fint = 0, fintx = 0.5, type = "0.315D14-C", l = lb5s, angle &
         = lb5s * (+ab5s)/lb5s

! define unsplit SBENs for BMAD ... not used by MAD

bcxss1: sbend, hgap = gb5/2, e1 = 0, fint = 0.5, e2 = +ab5, type = "0.315D14-C", l = lb5, angle &
         = lb5 * (+ab5)/lb5
bcxss2: sbend, hgap = gb5/2, e1 = -ab5, fint = 0.5, e2 = 0, type = "0.315D14-C", l = lb5, angle &
         = lb5 * (-ab5)/lb5
bcxss3: sbend, hgap = gb5/2, e1 = 0, fint = 0.5, e2 = -ab5, type = "0.315D14-C", l = lb5, angle &
         = lb5 * (-ab5)/lb5
bcxss4: sbend, hgap = gb5/2, e1 = +ab5, fint = 0.5, e2 = 0, type = "0.315D14-C", l = lb5, angle &
         = lb5 * (+ab5)/lb5

lsssb2bo = 1.193 !outer bend center-to-center (PRD Table 3)
lsssb2bi = 0.52  !inner bend center-to-center (PRD Table 3)

zd1s = lsssb2bo-zb5
zd1sa = 0.44
zd1sb = 0.049
zd1sc = zd1s-(zd1sa+zd1sb)
zd1sd = 0.077
zd1se = 0.185
zd1sf = 0.128
zd1sg = zd1s-(zd1sd+zd1se+zd1sf)

dmonos: drift, l = (3.4-2*lsssb2bo-lsssb2bi-zb5)/2
d1sa: drift, l = zd1sa/cos(ab5)
d1sb: drift, l = zd1sb/cos(ab5)
d1sc: drift, l = zd1sc/cos(ab5)
d1sd: drift, l = zd1sd/cos(ab5)
d1se: drift, l = zd1se/cos(ab5)
d1sf: drift, l = zd1sf/cos(ab5)
d1sg: drift, l = zd1sg/cos(ab5)
dchs: drift, l = (lsssb2bi-zb5)/2

sxrssbeg: marker
gsxs1: instrument, type = "grating"
msxs1: instrument, type = "mirror"
cntrs: marker
slsxs1: instrument, type = "slit"
msxs2: instrument, type = "mirror"
msxs3: instrument, type = "mirror"
sxrssend: marker

bcxss1_full: line = (bcxss1)
!old: bcxss1_full: line = (bcxss1a, bcxss1b)
bcxss2_full: line = (bcxss2)
!old: bcxss2_full: line = (bcxss2a, bcxss2b)
bcxss3_full: line = (bcxss3)
!old: bcxss3_full: line = (bcxss3a, bcxss3b)
bcxss4_full: line = (bcxss4)
!old: bcxss4_full: line = (bcxss4a, bcxss4b)

schicane: line = (sxrssbeg, dmonos, bcxss1_full, d1sa, gsxs1, d1sb, msxs1, d1sc, bcxss2_full,  &
        dchs, cntrs, dchs, bcxss3_full, d1sd, slsxs1, d1se, msxs2, d1sf, msxs3, d1sg, bcxss4_full &
        , dmonos, sxrssend)

