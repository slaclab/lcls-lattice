
! *** OPTICS=AD_ACCEL-09JUN2025s ***

! LCLS2cu various parts upstream of BSY

! ==============================================================================
! Modification History
! ------------------------------------------------------------------------------
! 17-NOV-2024, M. Woodley
!  * use reduced-W LI22/LI23 lattice
! 06-SEP-2024, M. Woodley
!  * set phase advance between pairs of ultra-fast kickers to 270 degrees
! ------------------------------------------------------------------------------
! 05-APR-2022, M. Woodley
!  * change TYPE of BX01 and BX02 to "1.182D6.82T"; change TYPE of BC1 dipoles
!    to "1.69D6.28T"
! ------------------------------------------------------------------------------
! 08-NOV-2021, M. Woodley
!  * defer BXKIK (decommissioned) at level 9 for Matlab model
! ------------------------------------------------------------------------------
! 04-MAR-2021, M. Woodley
!  * set FREQ=2856 for TCAV0 and TCAV3
! ------------------------------------------------------------------------------
! 31-AUG-2020, M. Woodley
!  * set TYPE="type-4al" for YC21174, XC21175, XC21302, and YC21303
! ------------------------------------------------------------------------------
! 26-JUL-2019, M. Woodley
!  * set L1 and L2 phases, and L1 X-band amplitude, per Y. Ding
! ------------------------------------------------------------------------------
! 30-JAN-2019, M. Woodley
!  * move area BEG/END MARKERs to common.xsif
!  * DL1 becomes two areas (DL1_1 and DL1_2)
!  * rename MRK/FIN MARKERs at BC1 and BC2 to proper area boundary names
! ------------------------------------------------------------------------------
! 07-JAN-2019, M. Woodley
!  * rename some LI21 correctors to avoid name conflicts with LCLS-II
!    per T. Maxwell
!  * define BC1 and BC2 bend angles (rather than B-fields) to allow constant
!    R56 when energy changes
!  * remove "52-line stuff"
! ------------------------------------------------------------------------------
! 08-MAY-2017, M. Woodley
!  * add 0.000001 m to DM19 to force Z=2059.732900 m at ZLIN04 and to line up
!    sector boundaries; reduce DAQ17 by the same amount to compensate
! 01-MAR-2017, M. Woodley
!  * WS24 is actually installed (per LCLS)
! ------------------------------------------------------------------------------
! 23-NOV-2016, Y. Nosochkov
!  * update KQ30801 value
! ------------------------------------------------------------------------------
! 04-NOV-2016, M. Woodley
!  * change "1.259Q3.5" to "1.26Q3.5"
!  * change Everson-Tesla 2.362Q3.5 (r=30mm) to SigmaPhi 1.69Q3.4 (bore=43mm)
!  * remove definition of DRIFT "DAQ6A"
! ------------------------------------------------------------------------------
! 28-OCT-2014, M. Woodley
!  * redefine drift DAQ17 to end at LI30 IV30-9 (Z=3042.005)
! ==============================================================================

lsol1 = 0.200 !needed for DL01a definition

! ==============================================================================
! Longitudinal misalignments observed after installation and difficult to fix:
! Added to MAD file (but not drawings) so that optics comes out right (1/11/07).
! ------------------------------------------------------------------------------

dz_qa11 = 3.42e-3 !quad is too far downstream when dz>0
dz_q21201 = -2.39e-3 !quad is too far downstream when dz>0
dz_q21301 = 5.73e-3 !quad is too far downstream when dz>0
dz_qm14 = 2.17e-3 !quad is too far downstream when dz>0
dz_qm15 = 2.48e-3 !quad is too far downstream when dz>0

! ==============================================================================
! lcavitys
! ------------------------------------------------------------------------------

! global lcavity parameters

dlwlx = 0.5948  !X-band structure length from input-coupler center to output-coupler center, each with tooling balls (m)
dlwl10 = 3.0441  !"10  ft" (29 Sband wavelengths; 87 DLWG cavities)
dlwl9 = 2.8692  !"9.41 ft" (27 1/3 Sband wavelengths; 82 DLWG cavities)
dlwl7 = 2.1694  !"7   ft" (20 2/3 Sband wavelengths; 62 DLWG cavities)
p25 = 1       !25% power factor
p50 = sqrt(2) !50% power factor

! L0 energy profile (model the one 3-m L0b section only)

l0phase = -1.1              !L0b S-band rf phase (deg)
del0a = gev2mev*(e0i-e00) !total L0a energy gain (MeV)
del0b = gev2mev*(ei-e0i)  !total L0b energy gain (MeV)
phil0 = l0phase/360       !radians/2pi
 !gfac0   := 3.130139          !flange-to-flange length of dual-feed L0-a and L0-b RF structures [m]
gfac0 = 3.095244          !flange-to-flange length (121.86" Oct. 18, '05) of dual-feed L0-a and L0-b RF structures [m]
gradl0a = del0a/(gfac0*cos(phil0*twopi))
gradl0b = del0b/(gfac0*cos(phil0*twopi))

! L1 energy profile

l1phase = -21.5             !L1 S-band rf phase (deg)
l1xphase = -160.0             !L1 X-band rf phase (deg)
del1 = gev2mev*(ebc1-ei) !total L1 energy gain (MeV)
del1x = 20.0              !L1 X-band amplitude (MeV)
phil1 = l1phase/360       !radians/2pi
phil1x = l1xphase/360      !radians/2pi
gfac1 = p50*dlwl9+p25*dlwl9+p25*dlwl10
gradl1 = (del1-del1x*cos(phil1x*twopi))/(gfac1*cos(phil1*twopi))
 !VALUE, gradL1

! L2 energy profile

l2phase = -33.5               !L2 rf phase (deg)
del2 = gev2mev*(ebc2-ebc1) !total L2 energy gain (MeV)
phil2 = l2phase/360         !radians/2pi
gfac2 = 110*p25*dlwl10+1*p50*dlwl10
gradl2 = del2/(gfac2*cos(phil2*twopi))
 !VALUE, gradL2

! L3 energy profile

l3phase = 0.0               !L3 rf phase (deg)
del3 = gev2mev*(ef-ebc2) !total L3 energy gain (MeV)
phil3 = l3phase/360       !radians/2pi
gfac3 = 161*p25*dlwl10+12*p50*dlwl10+3*p25*dlwl9+4*p25*dlwl7
gradl3 = 15.833405341033 !16.7 !LI25_LI26
 !VALUE, gradL3

l1x___1: lcavity, type = "X1_Xband", rf_frequency = xbandf * 1e6, l = dlwlx/2, voltage = del1x/2 * 1e6, phi0 = phil1x,
          cavity_type = traveling_wave, descrip = "mad8_key:lcav"
l1x___2: lcavity, type = "X1_Xband", rf_frequency = xbandf * 1e6, l = dlwlx/2, voltage = del1x/2 * 1e6, phi0 = phil1x,
          cavity_type = traveling_wave, descrip = "mad8_key:lcav"

! L0 sections

l0a___1: lcavity, type = "DUALFEED", rf_frequency = sbandf * 1e6, l = 0.0586460, voltage = gradl0a*0.0586460 * 1e6,
          phi0 = phil0, cavity_type = traveling_wave, descrip = "mad8_key:lcav"
l0a___2: lcavity, type = "DUALFEED", rf_frequency = sbandf * 1e6, l = 0.1993540, voltage = gradl0a*0.1993540 * 1e6,
          phi0 = phil0, cavity_type = traveling_wave, descrip = "mad8_key:lcav"
l0a___3: lcavity, type = "DUALFEED", rf_frequency = sbandf * 1e6, l = 0.6493198, voltage = gradl0a*0.6493198 * 1e6,
          phi0 = phil0, cavity_type = traveling_wave, descrip = "mad8_key:lcav"
l0a___4: lcavity, type = "DUALFEED", rf_frequency = sbandf * 1e6, l = 0.6403022, voltage = gradl0a*0.6403022 * 1e6,
          phi0 = phil0, cavity_type = traveling_wave, descrip = "mad8_key:lcav"
l0a___5: lcavity, type = "DUALFEED", rf_frequency = sbandf * 1e6, l = 1.1518464, voltage = gradl0a*1.1518464 * 1e6,
          phi0 = phil0, cavity_type = traveling_wave, descrip = "mad8_key:lcav"
l0a___6: lcavity, type = "DUALFEED", rf_frequency = sbandf * 1e6, l = 0.3348566, voltage = gradl0a*0.3348566 * 1e6,
          phi0 = phil0, cavity_type = traveling_wave, descrip = "mad8_key:lcav"
l0a___7: lcavity, type = "DUALFEED", rf_frequency = sbandf * 1e6, l = 0.0609190, voltage = gradl0a*0.0609190 * 1e6,
          phi0 = phil0, cavity_type = traveling_wave, descrip = "mad8_key:lcav"

l0b___1: lcavity, type = "DUALFEED", rf_frequency = sbandf * 1e6, l = 0.0586460, voltage = gradl0b*0.0586460 * 1e6,
          phi0 = phil0, cavity_type = traveling_wave, descrip = "mad8_key:lcav"
l0b___2: lcavity, type = "DUALFEED", rf_frequency = sbandf * 1e6, l = 0.3371281, voltage = gradl0b*0.3371281 * 1e6,
          phi0 = phil0, cavity_type = traveling_wave, descrip = "mad8_key:lcav"
l0b___3: lcavity, type = "DUALFEED", rf_frequency = sbandf * 1e6, l = 1.1518479, voltage = gradl0b*1.1518479 * 1e6,
          phi0 = phil0, cavity_type = traveling_wave, descrip = "mad8_key:lcav"
l0b___4: lcavity, type = "DUALFEED", rf_frequency = sbandf * 1e6, l = 1.1515630, voltage = gradl0b*1.1515630 * 1e6,
          phi0 = phil0, cavity_type = traveling_wave, descrip = "mad8_key:lcav"
l0b___5: lcavity, type = "DUALFEED", rf_frequency = sbandf * 1e6, l = 0.3351400, voltage = gradl0b*0.3351400 * 1e6,
          phi0 = phil0, cavity_type = traveling_wave, descrip = "mad8_key:lcav"
l0b___6: lcavity, type = "DUALFEED", rf_frequency = sbandf * 1e6, l = 0.0609190, voltage = gradl0b*0.0609190 * 1e6,
          phi0 = phil0, cavity_type = traveling_wave, descrip = "mad8_key:lcav"

flnga1: marker, descrip = "mad8_key:mark" !upstream   face of L0a entrance flange
flnga2: marker, descrip = "mad8_key:mark" !downstream face of L0a exit flange
flngb1: marker, descrip = "mad8_key:mark" !upstream   face of L0b entrance flange
flngb2: marker, descrip = "mad8_key:mark" !downstream face of L0b exit flange

! transverse deflecting cavities

tcav0: lcavity, type = "TRANS_DEFL", rf_frequency = 2856 * 1e6, l = 0.6680236/2, cavity_type = traveling_wave, !flange-to-flange (then split in two)
          descrip = "mad8_key:lcav"
tcav3: lcavity, type = "TRANS_DEFL", rf_frequency = 2856 * 1e6, l = 2.438/2, cavity_type = traveling_wave,
          descrip = "mad8_key:lcav"

! decommissioned kicker magnet

bxkika: sbend, type = "@9,1.92K41.2", l = lkik/2, hgap = gkik, descrip = "mad8_key:sben"
bxkikb: sbend, type = "@9,1.92K41.2", l = lkik/2, hgap = gkik, descrip = "mad8_key:sben"

! define unsplit SBENs for BMAD ... not used by MAD

bxkik: sbend, type = "@9,1.92K41.2", l = lkik, hgap = gkik, descrip = "mad8_key:sben"

! ==============================================================================
! BENDs
! ------------------------------------------------------------------------------

! global BEND parameters

dlbh = 0.0144     !increase to lengthen BXH1-4 eff. length (m)
lbh = 0.110+dlbh !5D3.9 "Z" length (m)   laser-heater chicane bends approx. effective length (R. Carr, 01-AUG-05 -PE)
gbh = 30e-3      !5D3.9 gap height (m)
lb0 = 0.2032     !1.182D6.82T "Z" length (m)
gb0 = 30e-3      !1.182D6.82T gap height (m)
lb1 = 0.2032     !1.69D6.28T "Z" length (m)
gb1 = 43.28e-3   !1.69D6.28T gap height (m)
lb2 = 0.5490     !1D19.7 "Z" length (m)      !changed from 0.540 m to 0.549 on Sep. 28, '07 based on magnetic measurements - PE
gb2 = 33.35e-3   !1D19.7 gap height (m)
 !LB3  := 2.623      !4D102.36T effective length (m)
 !GB3  := 0.023      !4D102.36T gap height (m)
 !LVB  := 1.025      !3D39 vertical bend effective length (m)
 !GVB  := 0.034925   !vertical bend gap width (m)

! GTL !gun spectrometer from BXG to Faraday cup and dump
! ===

rbxg = 0.1963       !BXG bend radius (measured) [m]
abxg = 85.0*raddeg  !bend angle of BXG dipole [deg*RADDEG = rad]
ebxg = 24.25*raddeg !BXG pole-face rot. edge angle of BXG dipole [deg*RADDEG = rad]
gbxg = 0.043        !BXG magnet full gap height (m)
lbxg = rbxg*abxg    !path length of BXG dipole when ON (= R*theta) [m]

 !VALUE, LBXG

bxga: sbend, type = "BXG", l = lbxg/2, hgap = gbxg/2, angle = abxg/2, e1 = ebxg, fint = 0.492, e2 = 0, fintx = 0, !1st-half of gun spectrometer bend
          descrip = "mad8_key:sben"
bxgb: sbend, type = "BXG", l = lbxg/2, hgap = gbxg/2, angle = abxg/2, e1 = 0, fint = 0, e2 = ebxg, fintx = 0.492, !2nd-half of gun spectrometer bend
          descrip = "mad8_key:sben"

! define unsplit SBENs for BMAD ... not used by MAD

bxg: sbend, type = "BXG", hgap = gbxg/2, l = lbxg, angle = abxg, e1 = ebxg, fint = 0.492, e2 = ebxg, fintx = 0.492,
          descrip = "mad8_key:sben"

dxg0: drift, l = rbxg*sin(abxg/2), descrip = "mad8_key:drif"  !drift, w/BXG off, from BXG entrance face to its z-projected center
 !DXGA : SBEN, L=1E-9/2, ANGLE=0/2 !1st-half of gun-spec bend (set to ~zero length and strength, with longitudinal position as bend's center)
 !DXGB : SBEN, L=1E-9/2, ANGLE=0/2 !2nd-half of gun-spec bend (set to ~zero length and strength, with longitudinal position as bend's center)

dbxg: drift, l = 0.132618358755-1e-9, descrip = "mad8_key:drif" !replaces DXG0/DXGA/DXGB

rqgx = 0.020 !QG quadrupole pole-tip radius [m]
lqgx = 0.076 !QG quadrupole effective length [m]

cq01: multipole, type = "QSOL", k1l = 0, descrip = "mad8_key:mult"     !correction quad in 1st solenoid at gun (nominally set to 0)
sq01: multipole, type = "QSOL", k1l = 0,t1, descrip = "mad8_key:mult" !correction skew-quad in 1st solenoid at gun (nominally set to 0)

qg02: quadrupole, type = "QG", l = lqgx/2, aperture = rqgx, k1 = -35.485404325427, descrip = "mad8_key:quad"
qg03: quadrupole, type = "QG", l = lqgx/2, aperture = rqgx, k1 = 80.16050904389, descrip = "mad8_key:quad"

dgs1: drift, l = 0.1900-lqgx/2-20e-6-0.0155757, descrip = "mad8_key:drif"
dgs2: drift, l = (0.2300-lqgx)/2+20e-6, descrip = "mad8_key:drif"
dgs3: drift, l = (0.2300-lqgx)/2-20e-6, descrip = "mad8_key:drif"
dgs4: drift, l = 0.1680-lqgx/2-0.00283, descrip = "mad8_key:drif"
dgs5: drift, l = 0.0300-0.02271, descrip = "mad8_key:drif"
dgs6: drift, l = 0.0240-0.00402, descrip = "mad8_key:drif"
dgs7: drift, l = 0.05, descrip = "mad8_key:drif"

xcg1: hkicker, type = "class-G", descrip = "mad8_key:hkic"
xcg2: hkicker, type = "class-G", descrip = "mad8_key:hkic"
ycg1: vkicker, type = "class-G", descrip = "mad8_key:vkic"
ycg2: vkicker, type = "class-G", descrip = "mad8_key:vkic"

bpmg1: monitor, type = "25_um_res", descrip = "mad8_key:moni"
crg1: instrument, descrip = "mad8_key:inst"                   !Cerenkov radiator bunch length monitor
yagg1: monitor, type = "YAG", descrip = "mad8_key:moni"       !6-MeV spectrometer screen
fcg1: instrument, descrip = "mad8_key:inst"                   !gun-spec. Faraday cup w/screen



!Old split line:  BXG_full : LINE=(BXGa,BXGb)

bxg_full: line = (bxg)



!Old split line:  QG02_full : LINE=(QG02,XCG1,YCG1,QG02)

qg02_full: line = (qg02)
qg02[L] = 2*qg02[L]
xcg1[superimpose] = T
xcg1[ref] = qg02
ycg1[superimpose] = T
ycg1[ref] = qg02


!Old split line:  QG03_full : LINE=(QG03,XCG2,YCG2,QG03)

qg03_full: line = (qg03)
qg03[L] = 2*qg03[L]
xcg2[superimpose] = T
xcg2[ref] = qg03
ycg2[superimpose] = T
ycg2[ref] = qg03

  GSPEC   : LINE=(BEGGSPEC,BXG_full,DGS1,QG02_full,DGS2,BPMG1,DGS3,QG03_full,DGS4,YAGG1,DGS5,CRG1,DGS6,FCG1,DGS7,
         DBMARK97,ENDGSPEC)

! 135-MeV Spectrometer
! ====================

dx01a: sbend, l = lb0/2, angle = 1e-9, descrip = "mad8_key:sben" !1st half of BX01 magnet switched off here
dx01b: sbend, l = lb0/2, angle = 1e-9, descrip = "mad8_key:sben" !2nd half of BX01 magnet switched off here

dbx01a: drift, l = 0.1016, descrip = "mad8_key:drif" !replaces DX01A
dbx01b: drift, l = 0.1016, descrip = "mad8_key:drif" !replaces DX01B

lbs = 0.5435        !measured effective length along curved trajectory (m)
gbs = 34e-3         !gap height (m)
abs = injdeg*raddeg !injection line angle (rad)
bxsej = -7.29*raddeg

bxsa: sbend, type = "BXS", l = lbs/2, hgap = gbs/2, angle = abs/2, e1 = bxsej, fint = 0.391, e2 = 0, fintx = 0,
          descrip = "mad8_key:sben"
bxsb: sbend, type = "BXS", l = lbs/2, hgap = gbs/2, angle = abs/2, e1 = 0, fint = 0, e2 = bxsej, fintx = 0.391,
          descrip = "mad8_key:sben"

! define unsplit SBENs for BMAD ... not used by MAD

bxs: sbend, type = "BXS", hgap = gbs/2, l = lbs, angle = abs, e1 = bxsej, fint = 0.391, e2 = bxsej, fintx = 0.391,
          descrip = "mad8_key:sben"

kqs01 = 9.682244191676
kqs02 = -5.648980372134

qs01: quadrupole, type = "ETA", l = lqx/2, aperture = rqx, k1 = kqs01, descrip = "mad8_key:quad"
qs02: quadrupole, type = "ETA", l = lqx/2, aperture = rqx, k1 = kqs02, descrip = "mad8_key:quad"

ds0: drift, l = 0.5583996, descrip = "mad8_key:drif"
ds0a: drift, l = 0.1691504, descrip = "mad8_key:drif"
ds0b: drift, l = 0.4615/2, descrip = "mad8_key:drif"
ds1a: drift, l = 0.0890085, descrip = "mad8_key:drif"
ds1b: drift, l = 0.1451215, descrip = "mad8_key:drif"
ds1c: drift, l = 0.171796, descrip = "mad8_key:drif"
ds1d: drift, l = 0.251824, descrip = "mad8_key:drif"
ds2: drift, l = 0.478250, descrip = "mad8_key:drif"
ds3a: drift, l = 0.199626, descrip = "mad8_key:drif"
ds3b: drift, l = 0.200374, descrip = "mad8_key:drif"
ds4: drift, l = 0.287275, descrip = "mad8_key:drif"
ds6a: drift, l = 0.2575952, descrip = "mad8_key:drif"
ds6b: drift, l = 0.2273298-0.008205, descrip = "mad8_key:drif"
ds7: drift, l = 0.3801874+0.008205-0.02, descrip = "mad8_key:drif"
ds8: drift, l = 0.1976126+0.02, descrip = "mad8_key:drif"
ds9: drift, l = 0.3378194, descrip = "mad8_key:drif"

bpms1: monitor, type = "20_um_res", descrip = "mad8_key:moni"
bpms2: monitor, type = "20_um_res", descrip = "mad8_key:moni"
bpms3: monitor, type = "20_um_res", descrip = "mad8_key:moni"

vvs1: marker, descrip = "mad8_key:mark"                  !135-MeV spectrometer vacuum valve
yags1: monitor, type = "YAG", descrip = "mad8_key:moni"      !1st 135-MeV spectrometer YAG-screen - center of device in MAD is defined as center of YAG crystal, not mirror
ims1: marker, descrip = "mad8_key:mark"                  !135-MeV spectrometer toroid
yags2: monitor, type = "YAG", descrip = "mad8_key:moni"      !2nd 135-MeV spectrometer YAG-screen - center of device in MAD is defined as center of YAG crystal, not mirror
otrs1: monitor, type = "OTR", descrip = "mad8_key:moni"      !135-MeV spectrometer OTR-screen
sdmp: instrument, descrip = "mad8_key:inst"                  ! gun-spec. dump (exact location? - 11/09/05)

xcs1: hkicker, type = "class-1a", descrip = "mad8_key:hkic"
ycs1: vkicker, type = "class-1a", descrip = "mad8_key:vkic"
xcs2: hkicker, type = "class-1a", descrip = "mad8_key:hkic"
ycs2: vkicker, type = "class-1a", descrip = "mad8_key:vkic"



!Old split line:  BXS_full : LINE=(BXSa,BXSb)

bxs_full: line = (bxs)



!Old split line:  QS01_full : LINE=(QS01,BPMS2,QS01)

qs01_full: line = (qs01)
qs01[L] = 2*qs01[L]
bpms2[superimpose] = T
bpms2[ref] = qs01


!Old split line:  QS02_full : LINE=(QS02,QS02)

qs02_full: line = (qs02)
qs02[L] = 2*qs02[L]

  SCS1 : LINE=(XCS1,YCS1)
  SCS2 : LINE=(XCS2,YCS2)

  SPECBL  : LINE=(BEGSPEC,DBX01a,DBX01b,DS0,SCS1,DS0a,DS0b,DS1a,VVS1,DS1b,YAGS1,DS1c,BPMS1,DS1d,BXS_full,DS2,QS01_full,
         DS3a,SCS2,DS3b,QS02_full,DS4,IMS1,DS6a,BPMS3,DS6b,YAGS2,DS7,OTRS1,DS8,DS9,SDMP,DBMARK98,ENDSPEC)

! DL1
! ===

adl1 = injdeg*raddeg            !injection line angle (rad)

ab0 = adl1/2                 !full bend angle (rad)
leffb0 = lb0*ab0/(2*sin(ab0/2)) !full bend path length (m)
aeb0 = ab0/2                  !edge angles

bx01a: sbend, type = "1.182D6.82T", l = leffb0/2, hgap = gb0/2, angle = ab0/2, e1 = aeb0, fint = 0.45, fintx = 0,
          descrip = "mad8_key:sben"
bx01b: sbend, type = "1.182D6.82T", l = leffb0/2, hgap = gb0/2, angle = ab0/2, e2 = aeb0, fint = 0, fintx = 0.45,
          descrip = "mad8_key:sben"
bx02a: sbend, type = "1.182D6.82T", l = leffb0/2, hgap = gb0/2, angle = ab0/2, e1 = aeb0, fint = 0.45, fintx = 0,
          descrip = "mad8_key:sben"
bx02b: sbend, type = "1.182D6.82T", l = leffb0/2, hgap = gb0/2, angle = ab0/2, e2 = aeb0, fint = 0, fintx = 0.45,
          descrip = "mad8_key:sben"

! define unsplit SBENs for BMAD ... not used by MAD

bx01: sbend, type = "1.182D6.82T", hgap = gb0/2, l = leffb0, angle = ab0, e1 = aeb0, fint = 0.45, e2 = aeb0,
          fintx = 0.45, descrip = "mad8_key:sben"
