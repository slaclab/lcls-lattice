         = lbh1l * (-abh1l)/lbh1l
bxh2b: sbend, hgap = gbh/2, fint = 0, e2 = 0, fintx = 0.400, type = "5D3.9", l = lbh1s, angle =  &
        lbh1s * (-abh1s)/lbh1s
bxh3a: sbend, hgap = gbh/2, e1 = 0, fint = 0.400, fintx = 0, type = "5D3.9", l = lbh1s, angle =  &
        lbh1s * (-abh1s)/lbh1s
