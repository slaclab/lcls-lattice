! wire scanners

ws01: marker, type = "slow", descrip = "mad8_key:mark" !DL1- emittance
ws02: marker, type = "fast", descrip = "mad8_key:mark" !DL1- emittance
ws03: marker, type = "fast", descrip = "mad8_key:mark" !DL1- emittance
ws04: marker, type = "slow", descrip = "mad8_key:mark" !DL1- energy spread
ws11: marker, type = "slow", descrip = "mad8_key:mark" !BC1+ emittance
ws12: marker, type = "slow", descrip = "mad8_key:mark" !BC1+ emittance
ws13: marker, type = "slow", descrip = "mad8_key:mark" !BC1+ emittance
 !WS21    : MARKER, TYPE="slow" !LI24 emittance
 !WS22    : MARKER, TYPE="slow" !LI24 emittance
 !WS23    : MARKER, TYPE="slow" !LI24 emittance
ws24: marker, type = "slow", descrip = "mad8_key:mark" !BC2- emittance
dws21: marker, descrip = "mad8_key:mark"              !someday will be a wire-scanner again?
dws22: marker, descrip = "mad8_key:mark"              !someday will be a wire-scanner again?
dws23: marker, descrip = "mad8_key:mark"              !someday will be a wire-scanner again?
 !DWS24   : MARK              !someday will be a wire-scanner again?
