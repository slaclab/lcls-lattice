dl01a4: drift, l = 0.0170+0.0014, descrip = "mad8_key:drif"
dl01a5: drift, l = 0.0132-0.00223, descrip = "mad8_key:drif"
dl01b: drift, l = 0.0825, descrip = "mad8_key:drif"
dl01c: drift, l = 0.1340-0.00353-0.003175, descrip = "mad8_key:drif"
dl01d: drift, l = 0.1008464-0.0155757, descrip = "mad8_key:drif"
dl01h: drift, l = 0.0581886, descrip = "mad8_key:drif"
dl01e: drift, l = 0.2286-dxg0[l]-0.00536+0.0155757, descrip = "mad8_key:drif"
dl01f: drift, l = 0.1353+0.00708, descrip = "mad8_key:drif"
dl01f2: drift, l = 0.0277+0.00167, descrip = "mad8_key:drif"
dl01g: drift, l = 0.0740-0.00341, descrip = "mad8_key:drif"
dl02a1: drift, l = 0.060294605, descrip = "mad8_key:drif" !0.066356+0.0021436-0.008205
dl02a2: drift, l = 0.104580+0.008205, descrip = "mad8_key:drif"
dl02a3: drift, l = 0.098776-lqx/2+0.028834, descrip = "mad8_key:drif"
dl02b1: drift, l = 0.169672-lqx/2-0.028834+0.007646, descrip = "mad8_key:drif"
dl02b2: drift, l = 0.185928-lqx/2-0.007646+0.001610, descrip = "mad8_key:drif"
dl02c: drift, l = 0.121498-lqx/2-0.001610, descrip = "mad8_key:drif"

! Heater-Chicane:

lsrhtr_on = 1 !set to 0 for laser heater bends & undulator OFF and 1 for ON (nominal)

abh1 = -0.131709391614*lsrhtr_on !heater-chicane bend angle (rad)
bbh1 = brhoi*sin(abh1)/lbh !heater-chicane bend field for 35-mm etaX_pk (kG) (-4.75393301417)
rbh1 = brhoi/bbh1          !heater-chicane bend radius (m)
lbh1 = rbh1*abh1           !heater-chicane bend path length (m)
abh1s = asin((lbh/2)/rbh1)  !"short" half heater-chicane bend angle (rad)
lbh1s = rbh1*abh1s          !"short" half heater-chicane bend path length (m)
abh1l = abh1-abh1s          !"long" half heater-chicane bend angle (rad)
lbh1l = rbh1*abh1l          !"long" half heater-chicane bend path length (m)

dh00: drift, l = 0.13453045-dlbh/2, descrip = "mad8_key:drif"
dh01: drift, l = (0.155-dlbh)/cos(abh1), type = "CSR", descrip = "mad8_key:drif"
dh02a: drift, l = 0.06717020-dlbh/2, type = "CSR", descrip = "mad8_key:drif"
!new:
!new: ! Shorten so that lh_und has an integer number of poles
!new: dh03a: drift, l = 0.09290825 - ( 10*0.054 - 0.506263 ) /2, type = "CSR"
dh03a: drift, l = 0.09290825, type = "CSR", descrip = "mad8_key:drif"
!new:
!new: ! Shorten so that lh_und has an integer number of poles
!new: dh03b: drift, l = 0.08401830- ( 10*0.054 - 0.506263 ) /2, type = "CSR"
dh03b: drift, l = 0.08401830, type = "CSR", descrip = "mad8_key:drif"
dh02b: drift, l = 0.09503020-dlbh/2, type = "CSR", descrip = "mad8_key:drif"
dh06: drift, l = 0.13010070-dlbh/2, type = "CSR", descrip = "mad8_key:drif"

htrund: instrument, descrip = "mad8_key:inst"

bxh1a: sbend, type = "5D3.9", l = lbh1s, angle = +abh1s, hgap = gbh/2, e1 = 0, fint = 0.400, fintx = 0,
          descrip = "mad8_key:sben"
bxh1b: sbend, type = "5D3.9", l = lbh1l, angle = +abh1l, hgap = gbh/2, fint = 0, e2 = +abh1, fintx = 0.400,
          descrip = "mad8_key:sben"
bxh2a: sbend, type = "5D3.9", l = lbh1l, angle = -abh1l, hgap = gbh/2, e1 = -abh1, fint = 0.400, fintx = 0,
          descrip = "mad8_key:sben"
bxh2b: sbend, type = "5D3.9", l = lbh1s, angle = -abh1s, hgap = gbh/2, fint = 0, e2 = 0, fintx = 0.400,
          descrip = "mad8_key:sben"
bxh3a: sbend, type = "5D3.9", l = lbh1s, angle = -abh1s, hgap = gbh/2, e1 = 0, fint = 0.400, fintx = 0,
          descrip = "mad8_key:sben"
bxh3b: sbend, type = "5D3.9", l = lbh1l, angle = -abh1l, hgap = gbh/2, fint = 0, e2 = -abh1, fintx = 0.400,
          descrip = "mad8_key:sben"
bxh4a: sbend, type = "5D3.9", l = lbh1l, angle = +abh1l, hgap = gbh/2, e1 = +abh1, fint = 0.400, fintx = 0,
          descrip = "mad8_key:sben"
bxh4b: sbend, type = "5D3.9", l = lbh1s, angle = +abh1s, hgap = gbh/2, fint = 0, e2 = 0, fintx = 0.400,
          descrip = "mad8_key:sben"

! define unsplit SBENs for BMAD ... not used by MAD

bxh1: sbend, type = "5D3.9", hgap = gbh/2, l = lbh1, angle = +abh1, e1 = 0, fint = 0.400, e2 = +abh1, fintx = 0.400,
          descrip = "mad8_key:sben"
bxh2: sbend, type = "5D3.9", hgap = gbh/2, l = lbh1, angle = -abh1, e1 = -abh1, fint = 0.400, e2 = 0, fintx = 0.400,
          descrip = "mad8_key:sben"
bxh3: sbend, type = "5D3.9", hgap = gbh/2, l = lbh1, angle = -abh1, e1 = 0, fint = 0.400, e2 = -abh1, fintx = 0.400,
          descrip = "mad8_key:sben"
bxh4: sbend, type = "5D3.9", hgap = gbh/2, l = lbh1, angle = +abh1, e1 = +abh1, fint = 0.400, e2 = 0, fintx = 0.400,
          descrip = "mad8_key:sben"

! Laser-Heater Undulator Model:

lam = 0.054                            !laser-heater undulator period [m]
lamr = 758e-9                           !heater laser wavelength [m]
gami = ei/mc2                           !Lorentz energy factor in laser-heater undulator [ ]
k_und = lsrhtr_on*sqrt(2*(lamr*2*gami^2/lam - 1)) !undulator K for laser heater und.
lhun = 0.506263                         !length of laser-heater undulator
lhunh = lhun/2
kqlh = (k_und*2*pi/lam/sqrt(2)/gami)^2  !natural undulator focusing "k" in y-plane [m^-2]

! handle K_und->0 by expressing R34 as an approximate SINC function

argh = lhunh*sqrt(kqlh)
argh2 = argh*argh
argh4 = argh2*argh2
argh6 = argh4*argh2
sincargh = 1-argh2/6+argh4/120-argh6/5040 !~sinc(ARGh)=sin(ARGh)/ARGh
r34h = lhunh*sincargh

! laser-heater undulator modeled as R-matrix to include vertical natural focusing:

!new: !,          &
!new: !------- Laser Heater Undulator for Copper Linac -------
!new: my_lh_und_k = 1.38523
!new: lh_und: wiggler,
!new:         type = "laser_heater_undulator",
!new:         L_period = 0.054,
!new:         n_period = 10,
!new:         b_max = my_lh_und_k * 2*pi*m_electron / (c_light * 0.054),
!new:          L = 10*0.054 ! Was: 0.506263,
!new:         ds_step = 0.054
!new:
!new: lh_und[L] = lh_und[L]/2 ! Will be doubled in desplitting process.
!new: !---------------------------------
!new:
lh_und: taylor, type = "LHund", l = lhunh, tt11 = 1.0, tt12 = lhunh, tt21 = 0, tt22 = 1.0, tt33 = cos(lhunh*sqrt(kqlh)),
          tt34 = r34h, tt43 = -sin(lhunh*sqrt(kqlh))*sqrt(kqlh), tt44 = cos(lhunh*sqrt(kqlh)), descrip = "mad8_key:matr"
   !R56 =  Lhunh/(gami^2)*(1+(K_und^2)/2)

 !VALUE, gami,kqlh,K_und
 !VALUE, LH_UND[R12],Lhun/2
 !VALUE, LH_UND[R33],cos(Lhun/2*sqrt(kqlh))
 !VALUE, LH_UND[R34],sin(Lhun/2*sqrt(kqlh))/sqrt(kqlh)
 !VALUE, LH_UND[R43],-sin(Lhun/2*sqrt(kqlh))*sqrt(kqlh)
 !VALUE, LH_UND[R44],cos(Lhun/2*sqrt(kqlh))
 !VALUE, LH_UND[R56],Lhun/2/(gami^2)*(1+(K_und^2)/2)

lhbeg: marker, descrip = "mad8_key:mark"
lhend: marker, descrip = "mad8_key:mark"

