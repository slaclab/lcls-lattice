! DRIFTs
! ------------------------------------------------------------------------------

! L1/2/3 FODO cells

d9: drift, l = dlwl9, descrip = "mad8_key:drif"
d10: drift, l = dlwl10, descrip = "mad8_key:drif"
daq1: drift, l = 0.0342, descrip = "mad8_key:drif"
daq2: drift, l = 0.027, descrip = "mad8_key:drif"

! injector geometry

lggun = 7.51*0.3048
lgl0 = 2*3.0441+1.0
lgbend = 0.95 + 2*0.3048     ! add 12" to either side of QB for more room (22JAN04 - PE)
lgemit = 9.000328707307
lgmatch = 1.5134597681

dggun: drift, l = lggun, descrip = "mad8_key:drif"
dgl0: drift, l = lgl0, descrip = "mad8_key:drif"

! L0

loadlock: drift, l = lggun-1.42, descrip = "mad8_key:drif"
dl00: drift, l = -loadlock[l], descrip = "mad8_key:drif" !from cathode back to u/s end of loadlock
dl01a: drift, l = 0.19601-lsol1/2, descrip = "mad8_key:drif"
dl01a1: drift, l = 0.07851, descrip = "mad8_key:drif"
dl01a2: drift, l = 0.11609, descrip = "mad8_key:drif"
