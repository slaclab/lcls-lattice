ws28144: marker, type = "slow", descrip = "mad8_key:mark" !LI28 emittance
ws28444: marker, type = "slow", descrip = "mad8_key:mark" !LI28 emittance
ws28744: marker, type = "slow", descrip = "mad8_key:mark" !LI28 emittance (existing; moved)

! profile monitors

yag01: monitor, type = "YAG", descrip = "mad8_key:moni" !gun (15.5 in from cathode, per J. Schmerge, June 17, 2003; -PE)
yag02: monitor, type = "YAG", descrip = "mad8_key:moni" !gun (need proper positions still - June 10, 2003)
yag03: monitor, type = "YAG", descrip = "mad8_key:moni" !after L0-a (~ 60 MeV) - center of device in MAD is defined as center of YAG crystal, not mirror
yag04: monitor, type = "YAG", descrip = "mad8_key:moni" !temporarily (Dec. '06 - July '07) placed in laser-heater region (135 MeV) - center of device in MAD is defined as center of YAG crystal, not mirror

ph01: instrument, descrip = "mad8_key:inst"                !phase measurement RF cavity between L0-a and L0-b
ph02: instrument, descrip = "mad8_key:inst"                !phase measurement RF cavity after BC1
ph03: instrument, descrip = "mad8_key:inst"                !phase measurement RF cavity after BC2
vv01: marker, descrip = "mad8_key:mark"                !vacuum valve near gun
vv02: marker, descrip = "mad8_key:mark"                !vacuum valve in injector
vv03: marker, descrip = "mad8_key:mark"                !vacuum valve in injector
vv04: marker, descrip = "mad8_key:mark"                !vacuum valve in injector
vvx1: marker, type = "MANUAL", descrip = "mad8_key:mark" !vacuum valve before X-band structure
vvx2: marker, type = "MANUAL", descrip = "mad8_key:mark" !vacuum valve after X-band structure
vv21: marker, descrip = "mad8_key:mark"                !vacuum valve in front of BC2
vv22: marker, descrip = "mad8_key:mark"                !vacuum valve after BC2
rst1: instrument, descrip = "mad8_key:inst"                !radiation stopper near WS02 in injector

otrh1: monitor, type = "OTR", descrip = "mad8_key:moni" !Laser-heater OTR screen just upbeam of heater-undulator (12NOV03 - PE)
otrh2: monitor, type = "OTR", descrip = "mad8_key:moni" !Laser-heater OTR screen just dnbeam of heater-undulator (12NOV03 - PE)
 !DOTRH1   : MARK             !Laser-heater OTR screen PLACE-HOLDER just upbeam of heater-undulator (not installed until summer 2008)
 !DOTRH2   : MARK             !Laser-heater OTR screen PLACE-HOLDER just dnbeam of heater-undulator (not installed until summer 2008)
otr1: monitor, type = "OTR", descrip = "mad8_key:moni" !DL1-emit
otr2: monitor, type = "OTR", descrip = "mad8_key:moni" !DL1-emit
otr3: monitor, type = "OTR", descrip = "mad8_key:moni" !DL1-emit
otr4: monitor, type = "OTR", descrip = "mad8_key:moni" !DL1 slice and proj. energy spread
otr11: monitor, type = "OTR", descrip = "mad8_key:moni" !BC1 energy spread
otr12: monitor, type = "OTR", descrip = "mad8_key:moni" !BC1 emittance
otr21: monitor, type = "OTR", descrip = "mad8_key:moni" !BC2 energy spread
 !OTR22    : MONITOR, TYPE="OTR" !moved to XLEAP (February 2017)
otr_tcav: monitor, type = "OTR", descrip = "mad8_key:moni" !LI25 longitudinal diagnostics

! bunch length monitors

bl11: monitor, descrip = "mad8_key:moni" !BC1+ (CSR-based relative bunch length monitor)
bl12: monitor, descrip = "mad8_key:moni" !BC1+ (ceramic gap-based relative bunch length monitor)
bl21: monitor, descrip = "mad8_key:moni" !BC2+ (CSR-based relative bunch length monitor)
bl22: monitor, descrip = "mad8_key:moni" !BC2+ (ceramic gap-based relative bunch length monitor)

! bunch charge monitors (toroids)
im01: marker, descrip = "mad8_key:mark" !L0
im02: marker, descrip = "mad8_key:mark" !L0
im03: marker, descrip = "mad8_key:mark" !DL1-
imbc1i: marker, descrip = "mad8_key:mark" !BC1 input toriod (comparator with IMBC1O)
imbc1o: marker, descrip = "mad8_key:mark" !BC1 output toroid (comparator with IMBC1I)
imbc2i: marker, descrip = "mad8_key:mark" !BC2 input toroid (comparator with IMBC2O)
imbc2o: marker, descrip = "mad8_key:mark" !BC2 output toroid (comparator with IMBC2I)

! other diagnostics

fc01: instrument, descrip = "mad8_key:inst" !L0 Faraday cup w/screen
am00: instrument, descrip = "mad8_key:inst" !gun laser normal incidence mirror
am01: instrument, descrip = "mad8_key:inst" !alignment mirror
cr01: instrument, descrip = "mad8_key:inst" !Cerenkov radiator bunch length monitor

! collimators

ce11: rcollimator, type = "HCOLL", descrip = "mad8_key:rcol" !adjustable energy (x) collimator in middle of BC1 chicane
ce21: rcollimator, type = "HCOLL", descrip = "mad8_key:rcol" !adjustable energy (x) collimator in middle of BC2 chicane

! dumps

td11: instrument, descrip = "mad8_key:inst" !BC1+ insertable block

! miscellany

sol1bk: solenoid, l = 0, ks = 0, descrip = "mad8_key:sole" !gun-bucking-solenoid (set to zero length and strength, with longitudinal unknown for now)
