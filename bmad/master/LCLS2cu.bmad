lws01_03 = 3.827458          !distance from WS01 to WS03 wire centers [m] (changed 06MAY05 -PE)
bmin0 = lws01_03/sqrt(3)/2 !betaX=betaY at WS02 where waist is located (12NOV03 -PE)
