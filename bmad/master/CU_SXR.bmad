qdl11[k1] = 0.358732502315
qum1b[k1] = 0.6048543022
qum2b[k1] = -0.879775666991
qum3b[k1] = 0.885017175465
qum4b[k1] = -0.530290818016
qsxh16[k1] = 0.453359672973
qsxh47[k1] = -1.5985
que1b[k1] = 0.252909229403
que2b[k1] = 0.0
qdmp1b[k1] = -0.15111165919
qdmp2b[k1] = -0.15111165919

