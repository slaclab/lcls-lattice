intgsx = 20.0 !kG
intghx = 12.0 !kG
efsc = 4.0 !GeV
eusc = 4.0 !GeV

call, file = LCLS2sc_master.bmad !calls other xsif files

  SC_DIAG0i : LINE=(LCLS2scI,HTR,DIAG0)

