! ==============================================================================
! quadrupoles
! ------------------------------------------------------------------------------

kqy = 0.060580505638 !45 degree bypass FODO

qfy: quadrupole, l = lqm/2, type = "PEPII", k1 = kqy, aperture = rqm !dummy magnet
qdy: quadrupole, l = lqm/2, type = "PEPII", k1 = -kqy, aperture = rqm !dummy magnet

kqbp25 = 0.070273904791
kqbp26 = -0.10552161126
kqbp27 = 0.11147451141
kqbp35 = -0.291127425582
kqbp28 = 0.323836147473

! note: the below K-values are for SC beam; the settings for Cu beam are
! in the "LCLS2cu_main.mad8" file

kqbp36 = 0.581885208949
kqbp30 = -0.589938332836
kqbp31 = 0.614211022315
kqbp32 = -0.490251186947
kqbp33 = -0.37247651207  !-0.372476510794
kqbp34 = 0.54911803358  ! 0.549118036482

qbp13: quadrupole, type = "2Q4", l = lqm/2, k1 = kqy, aperture = rqm
qbp14: quadrupole, type = "2Q4", l = lqm/2, k1 = -kqy, aperture = rqm
qbp15: quadrupole, type = "2Q4", l = lqm/2, k1 = kqy, aperture = rqm
qbp16: quadrupole, type = "2Q4", l = lqm/2, k1 = -kqy, aperture = rqm
qbp17: quadrupole, type = "2Q4", l = lqm/2, k1 = kqy, aperture = rqm
qbp18: quadrupole, type = "2Q4", l = lqm/2, k1 = -kqy, aperture = rqm
qbp19: quadrupole, type = "2Q4", l = lqm/2, k1 = kqy, aperture = rqm
qbp20: quadrupole, type = "2Q4", l = lqm/2, k1 = -kqy, aperture = rqm
qbp21: quadrupole, type = "2Q4", l = lqm/2, k1 = kqy, aperture = rqm
qbp22: quadrupole, type = "2Q4", l = lqm/2, k1 = -kqy, aperture = rqm
qbp23: quadrupole, type = "2Q4", l = lqm/2, k1 = kqy, aperture = rqm
qbp24: quadrupole, type = "2Q4", l = lqm/2, k1 = -kqy, aperture = rqm
qbp25: quadrupole, type = "2Q4", l = lqm/2, k1 = kqbp25, aperture = rqm
qbp26: quadrupole, type = "2Q4", l = lqm/2, k1 = kqbp26, aperture = rqm
qbp27: quadrupole, type = "2Q4", l = lqm/2, k1 = kqbp27, aperture = rqm
qbp35: quadrupole, type = "2Q4W", l = lqm/2, k1 = kqbp35, aperture = rqm
qbp28: quadrupole, type = "2Q4W", l = lqm/2, k1 = kqbp28, aperture = rqm
qbp36: quadrupole, type = "2Q4W", l = lqm/2, k1 = kqbp36, aperture = rqm
qbp30: quadrupole, type = "2Q4W", l = lqm/2, k1 = kqbp30, aperture = rqm
qbp31: quadrupole, type = "2Q4W", l = lqm/2, k1 = kqbp31, aperture = rqm
qbp32: quadrupole, type = "2Q4W", l = lqm/2, k1 = kqbp32, aperture = rqm
qbp33: quadrupole, type = "2Q4W", l = lqm/2, k1 = kqbp33, aperture = rqm
qbp34: quadrupole, type = "2Q4W", l = lqm/2, k1 = kqbp34, aperture = rqm

! ==============================================================================
! drifts
! ------------------------------------------------------------------------------

! bypass drifts which locate BPMs, XCORs, YCORs, WSs, and collimators w.r.t.
! bypass line "2Q4" QUADs

lcm2a = 31.2135115 !places upstream face of muon wall at proper z-location

zqbp35 = 28.5 !adjust position of QBP35
zqbp36 = 0.0 !adjust position of QBP36
zqbp30 = 0.0 !adjust position of QBP30
zqbp31 = 0.0 !adjust position of QBP31
zqbp32 = 0.0 !adjust position of QPB32
zqbp33 = 0.0 !adjust position of QBP33
zqbp34 = 0.0 !adjust position of QBP34
zmrgcus = 0.0 !adjust position of MRGCUSXR

! DCY : 1/2 dist. between bypass quads - from PEP-II deck

dcy: drift, l = (101.6-lqm)/2
dcysa: drift, l = 15.468697 !to sector boundary
dcysb: drift, l = dcy[l]-dcysa[l]
dcyc: drift, l = 15.28728 -zqbp30

! Sector 20 shield wall

dcysa1: drift, l = 4.976697
s20wall: drift, l = 2.0
dcysa2: drift, l = dcysa[l]-dcysa1[l]-s20wall[l]

! existing PEP-II HER Bypass Line (LI13-27)

d2q4a0: drift, l = 0.44518
d2q4b0: drift, l = 0.62865
d2q4c0: drift, l = 0.2286
d2q4d0: drift, l = dcy[l]-(d2q4a0[l]+d2q4b0[l]+d2q4c0[l])
d2q4j0: drift, l = 1.0
d2q4i0: drift, l = d2q4d0[l]-d2q4j0[l]
d2q4i20: drift, l = 0.1
d2q4i10: drift, l = d2q4i0[l]-d2q4i20[l]
d2q4e0: drift, l = 1.83107
d2q4f0: drift, l = d2q4d0[l]-(d2q4e0[l]+ljaw)
d2q4s0: drift, l = d2q4d0[l]-lqm/2 +zqbp35
d2q4sa0: drift, l = 64.904067
d2q4sb0: drift, l = d2q4s0[l]-d2q4sa0[l]

! LCLS-II (LI28 to muon wall)

! D2Q4a : QUAD to BPM
! D2Q4b : BPM to XCOR
! D2Q4c : XCOR to YCOR
! D2Q4d : a+b+c+d=DCY
! DQ24e : YCOR to COLL

d2q4a: drift, l = 0.4598
d2q4b: drift, l = 0.7433
 !D2Q4aa : DRIF, L=D2Q4a[L] -0.012
 !D2Q4ba : DRIF, L=D2Q4b[L] +0.012
d2q4ab: drift, l = d2q4a[l]+0.6096
d2q4c: drift, l = 0.2794
d2q4d: drift, l = dcy[l]-(d2q4a[l]+d2q4b[l]+d2q4c[l])

ddcyd = 0.0 !adjust Z at BSYEND
dcyd: drift, l = 35.977199997076 +ddcyd +zqbp31
dcydb: drift, l = 1.0
dcyda: drift, l = dcyd[l]-dcydb[l]-ljaw
dcyfa: drift, l = 1.0
dcyfb: drift, l = 0.5
dcyfc: drift, l = 1.0
dcyfd: drift, l = 5.952523028144 +0.3
dcyfe: drift, l = 12.43034602883-dcyfa[l]-dcyfb[l]-dcyfc[l]-dcyfd[l] +zqbp36
dcyfea: drift, l = 2.512 !3.0
dcyfeb: drift, l = dcyfe[l]-dcyfea[l]
dcyg: drift, l = 3.9034 -zqbp36+zqbp30

dbp1b: drift, l = 19.48139075
dbp2b: drift, l = 0
dbp3b: drift, l = 1.0
dbp3a: drift, l = 10.02938-lqm-(d2q4a[l]+d2q4b[l]+d2q4c[l])-dbp3b[l]-ljaw -zqbp33+zqbp34
dbp3aa: drift, l = 5.091435 !4.854935+0.2492
dbp3ab: drift, l = dbp3a[l]-dbp3aa[l]-lplate

ldcwl = 7.0
dcwlb: drift, l = 2.158425
dcwla: drift, l = ldcwl-lplate-dcwlb[l]

d2q4e: drift, l = 1.651 !1.27
d2q4f: drift, l = d2q4d[l]-(d2q4e[l]+ljaw)
d2q4h: drift, l = 2.4
d2q4g: drift, l = d2q4f[l]-d2q4h[l]
d2q4g2: drift, l = 0.1
d2q4g1: drift, l = d2q4g[l]-d2q4g2[l]
d2q4j: drift, l = 1.0
d2q4i: drift, l = d2q4d[l]-d2q4j[l]
d2q4i2: drift, l = 0.1
d2q4i1: drift, l = d2q4i[l]-d2q4i2[l]
d2q4k: drift, l = 2.0
d2q4l: drift, l = 4.47139075-(d2q4a[l]+d2q4b[l]+d2q4c[l])-zqbp31+zqbp32
d2q4lb: drift, l = 0.52015 -0.060376
d2q4la: drift, l = d2q4l[l]-d2q4lb[l]
d2q4laa: drift, l = 1.270097 !1.282797
d2q4lab: drift, l = d2q4la[l]-d2q4laa[l]-lplate
d2q4m: drift, l = 72.3206715-0.6096-(d2q4a[l]+d2q4b[l]+d2q4c[l])-lqm/2 -zqbp32+zqbp33
d2q4ma: drift, l = 61.387806499999-lbrcus-0.6096 -zqbp32+zmrgcus
d2q4ma1: drift, l = 6.364706 !6.128206+0.2492
d2q4ma2: drift, l = d2q4ma[l]-d2q4ma1[l]-lplate

lstebd = 11.75*in2m !length of EBD-type stopper !2*(3.125*in2m)
d2q4mb: drift, l = d2q4m[l]-d2q4ma[l]-lbrcus
d2q4mba: drift, l = 2.12069  !2.15244
d2q4mbb: drift, l = 4.916585 !5.018185
d2q4mbc: drift, l = 1.26655  !1.48925
d2q4mbd: drift, l = d2q4mb[l]-d2q4mba[l]-d2q4mbb[l]-d2q4mbc[l]-lplate-2*lstebd

d2q4o: drift, l = 8.58398-ldcwl -zqbp34
d2q4q: drift, l = 0.5
d2q4s: drift, l = d2q4d[l]-lqm/2 +zqbp35
d2q4sa: drift, l = 64.723997
d2q4sb: drift, l = d2q4s[l]-d2q4sa[l]
d2q4t: drift, l = d2q4d[l]-lqm/2 -zqbp35 -0.3

! ==============================================================================
! collimators
! ------------------------------------------------------------------------------

cxbp21: rcollimator, type = "HCOLL", l = ljaw, x_limit = 3.6e-3, y_limit = 20.e-3
cybp22: rcollimator, type = "VCOLL", l = ljaw, y_limit = 3.6e-3, x_limit = 20.e-3
cxbp25: rcollimator, type = "HCOLL", l = ljaw, x_limit = 3.5e-3, y_limit = 20.e-3
cybp26: rcollimator, type = "VCOLL", l = ljaw, y_limit = 3.8e-3, x_limit = 20.e-3
cxbp30: rcollimator, type = "HCOLL", l = ljaw, x_limit = 2.2e-3, y_limit = 20.e-3
cxbp34: rcollimator, type = "HCOLL", l = ljaw, x_limit = 2.2e-3, y_limit = 20.e-3

! ==============================================================================
! BPMs
! ------------------------------------------------------------------------------

bpmbp13: monitor, type = "Stripline-5"
bpmbp14: monitor, type = "Stripline-5"
bpmbp15: monitor, type = "Stripline-5"
bpmbp16: monitor, type = "Stripline-5"
bpmbp17: monitor, type = "Stripline-5"
bpmbp18: monitor, type = "Stripline-5"
bpmbp19: monitor, type = "Stripline-5"
bpmbp20: monitor, type = "Stripline-5"
bpmbp21: monitor, type = "Stripline-5"
bpmbp22: monitor, type = "Stripline-5"
bpmbp23: monitor, type = "Stripline-5" !2/22/11
bpmbp24: monitor, type = "Stripline-5" !to be replaced by RF BPM later
bpmbp25: monitor, type = "Stripline-5" !2/22/11
bpmbp26: monitor, type = "Stripline-5" !2/22/11
bpmbp27: monitor, type = "Stripline-5" !2/22/11
bpmbp28: monitor, type = "Stripline-5" !2/22/11
bpmbp35: monitor, type = "Stripline-5" !to be replaced by RF BPM later
bpmbp36: monitor, type = "Stripline-5"
bpmbp31: monitor, type = "Stripline-5"
bpmbp32: monitor, type = "Stripline-5"
bpmbp34: monitor, type = "Stripline-5"

rfbwsbp2: monitor, type = "@2,CavityS-1"
rfbwsbp3: monitor, type = "@2,CavityS-1"
rfbwsbp4: monitor, type = "@2,CavityS-1"
rfbbp24: monitor, type = "@2,CavityS-1" !4/23/14
rfbbp35: monitor, type = "@2,CavityS-1" !4/23/14
rfbbp30: monitor, type = "@2,CavityS-1"
rfbbp33: monitor, type = "@2,CavityS-1"

! ==============================================================================
! XCORs
! ------------------------------------------------------------------------------

! corrector types:
!   "Bypass"   = SA-344-116-01 (purple coil)
!   "Bypass#2" = SA-344-119-01 (blue coil)
!   "Bypass#3" = SA-344-117-01 (white coil)
!   "type-4"   = SA-238-040-86
!   "class-4"  = SA-238-040-86

xcbp13: hkicker, type = "Bypass"
xcbp14: hkicker, type = "Bypass"
xcbp15: hkicker, type = "Bypass"
xcbp16: hkicker, type = "Bypass"
