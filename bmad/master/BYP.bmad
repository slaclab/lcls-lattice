! ==============================================================================
! YCORs
! ------------------------------------------------------------------------------

! corrector types:
!   "Bypass"   = SA-344-116-01 (purple coil)
!   "Bypass#2" = SA-344-119-01 (blue coil)
!   "Bypass#3" = SA-344-117-01 (white coil)
!   "type-4"   = SA-238-040-86
!   "class-4"  = SA-238-040-86

ycbp13: vkicker, type = "Bypass"
ycbp14: vkicker, type = "Bypass"
ycbp15: vkicker, type = "Bypass"
ycbp16: vkicker, type = "Bypass"
ycbp17: vkicker, type = "Bypass"
ycbp18: vkicker, type = "Bypass"
ycbp19: vkicker, type = "Bypass"
ycbp20: vkicker, type = "Bypass"
ycbp21: vkicker, type = "Bypass"
ycbp22: vkicker, type = "Bypass"
ycbp23: vkicker, type = "type-4" !2/22/11
ycbp24: vkicker, type = "Bypass#2" !4/18/13
ycbp25: vkicker, type = "Bypass#2" !4/18/13
ycbp26: vkicker, type = "Bypass#2" !4/18/13
ycbp27: vkicker, type = "Bypass#2" !4/18/13
ycbp35: vkicker, type = "Bypass#2" !10/1/13
ycbp28: vkicker, type = "Bypass#2" !4/18/13
 !YCBP36 : VKIC, TYPE="class-4"  !remove
ycbp30: vkicker, type = "class-4"
ycbp31: vkicker, type = "class-4"
ycbp32: vkicker, type = "class-4"
ycbp33: vkicker, type = "class-4" !restore
ycbp34: vkicker, type = "class-4"

! ==============================================================================
! diagnostics, etc.
! ------------------------------------------------------------------------------

wsbp2: marker, type = "fast"
wsbp3: marker, type = "fast"
wsbp4: marker, type = "fast"

stbp34a: instrument, type = "PPS stopper", l = lstebd !LCLS EBD-type stopper
btmbp34a: instrument, type = "PPS BTM"               !Burn-Through-Monitor behind STBP34A
stbp34b: instrument, type = "PPS stopper", l = lstebd !LCLS EBD-type stopper
btmbp34b: instrument, type = "PPS BTM"               !Burn-Through-Monitor behind STBP34B

pcsp1s: instrument, l = lplate, type = "BCS plate" !shielding plate
pcsp2s: instrument, l = lplate, type = "BCS plate" !shielding plate
pcsp3s: instrument, l = lplate, type = "BCS plate" !shielding plate
pcsp4s: instrument, l = lplate, type = "BCS plate" !shielding plate

pcbp33: instrument, l = lplate, type = "BCS plate" !shielding plate (no BTM)

! ==============================================================================
! MARKER points
! ------------------------------------------------------------------------------

! MQBP23 : QBP23 (Q285330T) quad center (Z=2270.531303)
! S100B  : Station-100B is same Z as Station-100, but off axis in X & Y

mqbp13: marker !QBP13 FODO quad center ... Z=1254.531303 (a.k.a. "QB01")
mqbp23: marker
s100b: marker
rwwake2: marker, type = "WAKE" !bypass line beampipe wake applied here
ltusplit: marker !SXR/HXR/Dump split point
mrgcusxr: marker !merge point (with CUSXR)

! BSY wooden door

wooddoor_sps: marker

! sector boundaries (ZBEG=101.6*(n-1); ZEND=101.6*n)

bpn12end: marker
bpn13beg: marker
bpn13end: marker
