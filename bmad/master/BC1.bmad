ycc109: vkicker, type = "class-6"
ycc111: vkicker, type = "class-6"

! ==============================================================================
! marker points, etc.
! ------------------------------------------------------------------------------

! collimators
! (betatron X/Y half-gaps are 27/18 sigma for 1 um normalized emittance)

ce11b: rcollimator, l = ljaw, x_limit = 19.2e-3, type = "HCOLL"    !X momentum collimator
cyc11: rcollimator, l = ljaw, y_limit = 2.7e-3, type = "VCOLL"    !Y betatron collimator
cxc11: rcollimator, l = ljaw, x_limit = 2.7e-3, type = "HCOLL"    !X betatron collimator
CYC12: pipe, L = 0.06, type ="@4,VCOLL", descrip = "deferred RCOLLIMATOR" !Y betatron collimator
!old: cyc12: rcollimator, l = ljaw, y_limit = 2.7e-3, type = "@4,VCOLL"
CXC12: pipe, L = 0.06, type ="@4,HCOLL", descrip = "deferred RCOLLIMATOR" !X betatron collimator
!old: cxc12: rcollimator, l = ljaw, x_limit = 2.7e-3, type = "@4,HCOLL"
cyc13: rcollimator, l = ljaw, y_limit = 2.7e-3, type = "VCOLL"    !Y betatron collimator
cxc13: rcollimator, l = ljaw, x_limit = 2.7e-3, type = "HCOLL"    !X betatron collimator

! instruments

otr11b: monitor, type = "OTR BC"       !BC1 energy spread
WS11B: pipe, L = 0.0, type ="@3,fast", descrip = "deferred MARKER"      !BC1 energy spread
!old: ws11b: marker, type = "@3,fast"
bz11b: monitor, type = "CSR"          !CSR-based relative bunch length monitor
BZC1: pipe, L = 0.0, type ="@2,gap/diode", descrip = "deferred MONITOR" !relative bunch length monitor
!old: bzc1: monitor, type = "@2,gap/diode"
im11b: marker, type = "ICT"          !Beam Current Monitor
wsc104: marker, type = "fast"         !post-BC1 emittance
wsc106: marker, type = "fast"         !post-BC1 emittance
wsc108: marker, type = "fast"         !post-BC1 emittance
wsc110: marker, type = "fast"         !post-BC1 emittance

! markers

bc1bcbeg: marker
bc1bcmid: marker
cntbc1: marker, type = "CENTER"
bc1bcend: marker

