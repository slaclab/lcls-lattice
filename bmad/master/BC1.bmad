cyc11: rcollimator, l = ljaw, y_limit = 2.7e-3, x_limit = 20.e-3, type = "VCOLL", descrip = "mad8_key:rcol"    !Y betatron collimator
cxc11: rcollimator, l = ljaw, x_limit = 2.7e-3, y_limit = 20.e-3, type = "HCOLL", descrip = "mad8_key:rcol"    !X betatron collimator
cyc12: rcollimator, l = ljaw, y_limit = 2.7e-3, x_limit = 20.e-3, type = "@4,VCOLL", descrip = "mad8_key:rcol" !Y betatron collimator
cxc12: rcollimator, l = ljaw, x_limit = 2.7e-3, y_limit = 20.e-3, type = "@4,HCOLL", descrip = "mad8_key:rcol" !X betatron collimator
cyc13: rcollimator, l = ljaw, y_limit = 2.7e-3, x_limit = 20.e-3, type = "VCOLL", descrip = "mad8_key:rcol"    !Y betatron collimator
cxc13: rcollimator, l = ljaw, x_limit = 2.7e-3, y_limit = 20.e-3, type = "HCOLL", descrip = "mad8_key:rcol"    !X betatron collimator

! instruments

otr11b: monitor, type = "OTR BC", descrip = "mad8_key:moni"       !BC1 energy spread
ws11b: marker, type = "@3,fast", descrip = "mad8_key:mark"      !BC1 energy spread
bz11b: monitor, type = "CSR", descrip = "mad8_key:moni"          !CSR-based relative bunch length monitor
bzc1: monitor, type = "@2,gap/diode", descrip = "mad8_key:moni" !relative bunch length monitor
im11b: marker, type = "ICT", descrip = "mad8_key:mark"          !Beam Current Monitor
wsc104: marker, type = "fast", descrip = "mad8_key:mark"         !post-BC1 emittance
wsc106: marker, type = "fast", descrip = "mad8_key:mark"         !post-BC1 emittance
wsc108: marker, type = "fast", descrip = "mad8_key:mark"         !post-BC1 emittance
wsc110: marker, type = "fast", descrip = "mad8_key:mark"         !post-BC1 emittance

! markers

bc1bcbeg: marker, descrip = "mad8_key:mark"
bc1bcmid: marker, descrip = "mad8_key:mark"
cntbc1: marker, type = "CENTER", descrip = "mad8_key:mark"
bc1bcend: marker, descrip = "mad8_key:mark"

