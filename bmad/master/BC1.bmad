
! *** OPTICS=AD_ACCEL-14SEP22 ***

! LCLS2sc bunch compressor chicane #1

! ==============================================================================
! Modification History
! ------------------------------------------------------------------------------
! 17-JAN-2021, M. Woodley
!  * new standard configuration per Y. Ding
! ------------------------------------------------------------------------------
! 23-MAY-2019, M. Woodley
!  * move ENDBC1B to u/s face of QC101 per T. Maxwell
! 12-APR-2019, M. Woodley
!  * rename some MARKERs (to avoid conflicts with LCLS)
! ------------------------------------------------------------------------------
! 05-SEP-2017, M. Woodley
!  * rename: BPM11->BPM11B, CEBC1->CE11B, WS11->WS11B
!  * move BZ11B 0.12 m downstream per K. Fox
! ------------------------------------------------------------------------------
! 05-MAY-2017, M. Woodley
!  * use measured FINT=0.3893 for BC1 bends
! ------------------------------------------------------------------------------
! 04-NOV-2016, M. Woodley
!  * remove deferred items: kicker "BKYC1", septum "BLXC1", and TCAV "TCYC1"
!  * undefer XCC106, YCC109, and XCC110 (add-back list items)
!  * relocate COL1 correctors per K. Fox
! ------------------------------------------------------------------------------
! 07-JUN-2016, M. Woodley
!  * implement Kay Fox component moves (email 5/19)
!  * change deferment level to 0 for XCC106, YCC109, and XCC110
!  * move XCC112 to d/s side of QC112 ... shorten L2 u/s PSC drift
! ------------------------------------------------------------------------------
! 01-OCT-2015, M. Woodley
!  * undefer IM11B
!  * change TYPE of OTRs and YAGs per Henrik's PRD
! ------------------------------------------------------------------------------
! 19-JUN-2015, M. Woodley
!  * arrangement of devices at center of BC1 chicane copied from BC2
!  * undefer BPM11, OTR11B, BZ11B, and IM11B (change to ICT)
!  * undefer collimators CYC11, CXC11, CYC13, and CXC13
!  * collimator gaps per P. Emma
! ------------------------------------------------------------------------------
! 20-MAR-2015, M. Woodley
!  * rematch after changes in COL0
!  * set collimator lengths (tungsten) and gaps per LCLSII-2.4-PR-0095-R0
!  * set WS11 deferment to level 3; set OTR11B deferment to level 0
! ------------------------------------------------------------------------------
! 12-DEC-2014, M. Woodley
!  * increase space between Q1C01 and BCX11, and between BCX14 and QC101, per
!    N. Stewart; adjust inter-quad spacing between chicane and COL1 to keep
!    everything d/s of QC104 where it was
!  * change RFB11 (defer=2) to BPM11 (defer=0)
! ------------------------------------------------------------------------------
! 28-OCT-2014, M. Woodley
!  * move COL1 collimators 7 inches closer to their associated quadrupoles
! ------------------------------------------------------------------------------
! 15-OCT-2014, M. Woodley
!  * increase central drift of BC1 chicane from 0.8302 m to 1.75 m; add OTR11B
!  * shorten COL1 FODO cell to 8.0 m
!  * add 2 matching quadrupoles (each with a stripline BPM) to COL1
!  * add 6 stripline BPMs to COL1 ... omitted when we switched to 45 degree
!    FODO cells
!  * adjust deferment/deprecation levels
! ------------------------------------------------------------------------------
! 07-AUG-2014, M. Woodley
!  * diagnostics complement per "Electron Beam Diagnostics Systems" PRD
!    (LCLSII-2.7-PR-0170)
!  * OTR in BC1 chicane replaced with wire scanner; BPM replaced with RF BPM
!  * COL1 collimation system now consists of four 45 degree FODO cells with 3
!    pairs of collimators separated by 45 degrees (22 m betas at collimators);
!    FODO cell length is 12 m
!  * TCAV(Y), vertical kicker, and lambertson septum added d/s of BC1
!  * in-line emittance measurement system incorporated into COL1
!  * decorate device TYPE attributes to indicate non-baseline status
! 17-APR-2014, M. Woodley
!  * add "CNT" MARKERs after dispersive areas (ELEGANT CENTERing)
! ------------------------------------------------------------------------------
! 31-MAR-2014, M. Woodley
!  * replace chromatic BC1/DIAG1/COL1 match with BC1/COL1 non-chromatic match
!  * element names changed to conform to nomenclature PRD
! ------------------------------------------------------------------------------
! 14-JAN-2014, M. Woodley
!  * change BC1 dipole names from "BX1*" to "BXC1*"
! ------------------------------------------------------------------------------
! 16-OCT-2013, M. Woodley
!  * change BC1 dipole TYPE from "5D7.1" to "1.69D6.28T" ... no change in
!    physical parameters
! ------------------------------------------------------------------------------

! ==============================================================================
! SBEN
! ------------------------------------------------------------------------------

! BC1 chicane
! - approximate on-axis effective length per R. Carr (01-AUG-05 PE)
! - use series approximation for sinc(x)=sin(x)/x to allow BXh=0

! GB1   : 1.69D6.28T gap height (m)
! ZB1   : 1.69D6.28T "Z" length (m)
! FB1   : measured chicane bend FINT/FINTX
! BB1   : chicane bend field (kG) for R56= 0.055 m @ 250 MeV
! AB1   : chicane bend angle (rad)
! LB1   : chicane bend path length (m)
! AB1S  : "short" half chicane bend angle (rad)
! LB1S  : "short" half chicane bend path length (m)
! AB1L  : "long" half chicane bend angle (rad)
! LB1L  : "long" half chicane bend path length (m)

gb1 = 0.04328
zb1 = 0.2032
fb1 = 0.3893
ab1 = -0.10092088117 !R56=0.053
bb1 = brho1*sin(ab1)/zb1
ab1_2 = ab1*ab1
ab1_4 = ab1_2*ab1_2
ab1_6 = ab1_4*ab1_2
sincab1 = 1-ab1_2/6+ab1_4/120-ab1_6/5040 !~sinc(AB1)=sin(AB1)/AB1
lb1 = zb1/sincab1
ab1s = asin(sin(ab1)/2)
ab1s_2 = ab1s*ab1s
ab1s_4 = ab1s_2*ab1s_2
ab1s_6 = ab1s_4*ab1s_2
sincab1s = 1-ab1s_2/6+ab1s_4/120-ab1s_6/5040 !~sinc(AB1S)=sin(AB1S)/AB1S
lb1s = zb1/(2*sincab1s)
ab1l = ab1-ab1s
lb1l = lb1-lb1s

bcx11a: sbend, type = "1.69D6.28T", l = lb1s, angle = +ab1s, hgap = gb1/2, e1 = 0, fint = fb1, fintx = 0
bcx11b: sbend, type = "1.69D6.28T", l = lb1l, angle = +ab1l, hgap = gb1/2, fint = 0, e2 = +ab1, fintx = fb1
bcx12a: sbend, type = "1.69D6.28T", l = lb1l, angle = -ab1l, hgap = gb1/2, e1 = -ab1, fint = fb1, fintx = 0
bcx12b: sbend, type = "1.69D6.28T", l = lb1s, angle = -ab1s, hgap = gb1/2, fint = 0, e2 = 0, fintx = fb1
bcx13a: sbend, type = "1.69D6.28T", l = lb1s, angle = -ab1s, hgap = gb1/2, e1 = 0, fint = fb1, fintx = 0
bcx13b: sbend, type = "1.69D6.28T", l = lb1l, angle = -ab1l, hgap = gb1/2, fint = 0, e2 = -ab1, fintx = fb1
bcx14a: sbend, type = "1.69D6.28T", l = lb1l, angle = +ab1l, hgap = gb1/2, e1 = +ab1, fint = fb1, fintx = 0
bcx14b: sbend, type = "1.69D6.28T", l = lb1s, angle = +ab1s, hgap = gb1/2, fint = 0, e2 = 0, fintx = fb1

 !F := (ZB1/GB1)*(COS(AB1)/(SINCAB1*(1+SIN(AB1)*SIN(AB1))))
 !VALUE, AB1,F
 !VALUE, F*GB1*(AB1/LB1)*(1+SIN(AB1)*SIN(AB1))/COS(AB1)

! define unsplit SBENs for BMAD ... not used by MAD

bcx11: sbend, type = "1.69D6.28T", hgap = gb1/2, l = lb1, angle = +ab1, e1 = 0, fint = fb1, e2 = +ab1, fintx = fb1
bcx12: sbend, type = "1.69D6.28T", hgap = gb1/2, l = lb1, angle = -ab1, e1 = -ab1, fint = fb1, e2 = 0, fintx = fb1
bcx13: sbend, type = "1.69D6.28T", hgap = gb1/2, l = lb1, angle = -ab1, e1 = 0, fint = fb1, e2 = -ab1, fintx = fb1
bcx14: sbend, type = "1.69D6.28T", hgap = gb1/2, l = lb1, angle = +ab1, e1 = +ab1, fint = fb1, e2 = 0, fintx = fb1

! ==============================================================================
! QUAD
! ------------------------------------------------------------------------------

! L1 to BC1 chicane

kq1c01 = 0.970715924074

q1c01: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kq1c01

! BC1 chicane

kcq11 = 0
ksq13 = 0
kcq12 = 0

cq11b: quadrupole, type = "1.69Q3.4", l = lqc/2, aperture = rqc, k1 = kcq11
SQ13B: pipe, L = 0.08, type ="@4,Bertsche", descrip = "deferred QUADRUPOLE"
!old: sq13b: quadrupole, tilt = pi/4, type = "@4,Bertsche", l = lqsb/2, aperture = rqsb, k1 = ksq13
cq12b: quadrupole, type = "1.69Q3.4", l = lqc/2, aperture = rqc, k1 = kcq12

! collimation FODO

kqcoll1 = 1.787850470726  !45 degree FODO
! BminColl1 := 6.996145818354
! BmaxColl1 := 15.616293369747

qfcoll1: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqcoll1
qdcoll1: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = -kqcoll1

! COL1 collimation section

kqc101 = -0.469119554298
kqc102 = 2.153825172491
kqc103 = 0.0
kqc104 = -1.22065558752
kqc105 = -1.553140255506
kqc106 = kqcoll1
kqc107 = -kqcoll1
kqc108 = kqcoll1
kqc109 = -kqcoll1
kqc110 = 1.413351002508 ! KQColl1
kqc111 = -1.79638245063
kqc112 = 1.295987568842

qc101: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc101
qc102: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc102
qc103: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc103
qc104: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc104
qc105: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc105
qc106: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc106
qc107: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc107
qc108: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc108
qc109: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc109
qc110: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc110
qc111: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc111
qc112: quadrupole, type = "1.26Q3.5", l = lqx/2, aperture = rqx, k1 = kqc112

! ==============================================================================
! DRIF
! ------------------------------------------------------------------------------

! L1 to BC1 chicane

d1c00: drift, l = 0.144
d1c01: drift, l = 0.478

d1c01a: drift, l = 0.15
d1c01b: drift, l = d1c01[l]-d1c01a[l]

! BC1 chicane

zdc1o = 2.6381-zb1                   !BCX11 exit to BCX12 entrance
zdc1oa = 0.298542                     !BCX11 exit to CQ11B center
zdc1ob = 0.610858                     !CQ11B center to YCM12B center
zdc1oc = zdc1o-(zdc1oa+zdc1ob)        !YCM12B center to BCX12 entrance
zdc1od = 0.340947                     !BCX13 exit to SQ13B center
zdc1oe = 1.184953                     !SQ13B center to XCM12B center
zdc1of = 0.610458                     !XCM12B center to CQ12B center
zdc1og = zdc1o-(zdc1od+zdc1oe+zdc1of) !CQ12B center to BCX14 entrance

dc1o: drift, l = zdc1o/cos(ab1), type = "CSR"
dc1oa: drift, l = zdc1oa/cos(ab1)-lqc/2, type = "CSR"
dc1ob: drift, l = zdc1ob/cos(ab1)-lqc/2, type = "CSR"
dc1oc: drift, l = zdc1oc/cos(ab1), type = "CSR"
dc1i: drift, l = 1.75, type = "CSR"
dc1ih: drift, l = dc1i[l]/2, type = "CSR"
dc1ia: drift, l = 0.24867, type = "CSR"
dc1ib: drift, l = 0.16446-ljaw/2, type = "CSR"
dc1ic: drift, l = 0.1826-ljaw/2, type = "CSR"
dc1id: drift, l = 0.415, type = "CSR"
dc1ie: drift, l = dc1i[l]-dc1ia[l]-dc1ib[l]-ljaw-dc1ic[l]-dc1id[l], type = "CSR"

dc1od: drift, l = zdc1od/cos(ab1)-lqsb/2, type = "CSR"
dc1oe: drift, l = zdc1oe/cos(ab1)-lqsb/2, type = "CSR"
dc1of: drift, l = zdc1of/cos(ab1)-lqc/2, type = "CSR"
dc1og: drift, l = zdc1og/cos(ab1)-lqc/2, type = "CSR"

! collimation FODO

dcoll1: drift, l = 4.0-lqx

! COL1 collimation section

dc100: drift, l = 0.637
dc101: drift, l = 7.95
dc102: drift, l = 0.8
dc103: drift, l = 2.75
dc104: drift, l = 4.316831888391

dc100a: drift, l = 0.3
dc100b: drift, l = 0.1
dc100c: drift, l = dc100[l]-dc100a[l]-dc100b[l]
dc101a: drift, l = 0.214288
dc101b: drift, l = 0.169862
dc101c: drift, l = 0.25
dc101d: drift, l = dc101[l]-dc101a[l]-dc101b[l]-dc101c[l]
dc104a: drift, l = 0.38415
dc104c: drift, l = 0.1
dc104e: drift, l = 0.613
dc104d: drift, l = dcoll1[l]/2-ljaw-dc104e[l]
dc104b: drift, l = dc104[l]-dc104a[l]-dc104c[l]-dc104d[l]-ljaw-dc104e[l]
dc105a: drift, l = 0.38415
dc105c: drift, l = 0.613
dc105b: drift, l = dcoll1[l]-ljaw-dc105a[l]-dc105c[l]
dc106a: drift, l = 0.38415
dc106c: drift, l = 0.1
dc106b: drift, l = dcoll1[l]/2-dc106a[l]-dc106c[l]
dc106e: drift, l = 0.613
dc106d: drift, l = dcoll1[l]/2-ljaw-dc106e[l]
dc107a: drift, l = 0.38415
dc107c: drift, l = 0.613
dc107b: drift, l = dcoll1[l]-ljaw-dc107a[l]-dc107c[l]
dc108a: drift, l = 0.38415
dc108c: drift, l = 0.1
dc108b: drift, l = dcoll1[l]/2-dc108a[l]-dc108c[l]
dc108e: drift, l = 0.613
dc108d: drift, l = dcoll1[l]/2-ljaw-dc108e[l]
dc109a: drift, l = 0.38415
dc109c: drift, l = 0.613
dc109b: drift, l = dcoll1[l]-ljaw-dc109a[l]-dc109c[l]
dc110a: drift, l = 0.38415
dc110c: drift, l = 0.1
dc110b: drift, l = dcoll1[l]/2-dc110a[l]-dc110c[l]
dc110d: drift, l = dcoll1[l]/2
dc111a: drift, l = 0.38415
dc111b: drift, l = dcoll1[l]-dc111a[l]
dc112a: drift, l = 0.38415

! ==============================================================================
! BPMs
! ------------------------------------------------------------------------------

bpm1c01: monitor, type = "Stripline-1"
bpmc101: monitor, type = "Stripline-1"
bpmc102: monitor, type = "Stripline-1"
bpmc103: monitor, type = "Stripline-1"
bpmc104: monitor, type = "Stripline-1"
bpmc105: monitor, type = "Stripline-1"
bpmc106: monitor, type = "Stripline-1"
bpmc107: monitor, type = "Stripline-1"
bpmc108: monitor, type = "Stripline-1"
bpmc109: monitor, type = "Stripline-1"
bpmc110: monitor, type = "Stripline-1"
bpmc111: monitor, type = "Stripline-1"
bpmc112: monitor, type = "Stripline-1"

RFB1C01: pipe, L = 0.0, type ="@2,CavityS-1", descrip = "deferred MONITOR"
!old: rfb1c01: monitor, type = "@2,CavityS-1"
bpm11b: monitor, type = "Stripline-8"  !RFB11 : MONI, TYPE="@2,CavityL-1"
RFBC104: pipe, L = 0.0, type ="@2,CavityS-1", descrip = "deferred MONITOR"
!old: rfbc104: monitor, type = "@2,CavityS-1"
RFBC106: pipe, L = 0.0, type ="@2,CavityS-1", descrip = "deferred MONITOR"
!old: rfbc106: monitor, type = "@2,CavityS-1"
RFBC108: pipe, L = 0.0, type ="@2,CavityS-1", descrip = "deferred MONITOR"
!old: rfbc108: monitor, type = "@2,CavityS-1"
RFBC110: pipe, L = 0.0, type ="@2,CavityS-1", descrip = "deferred MONITOR"
!old: rfbc110: monitor, type = "@2,CavityS-1"

! ==============================================================================
! XCORs
! ------------------------------------------------------------------------------

xc1c00: hkicker, type = "class-1a"
xcm12b: hkicker, type = "class-6"
xcc101: hkicker, type = "class-6"
xcc104: hkicker, type = "class-6"
xcc106: hkicker, type = "class-6"
xcc108: hkicker, type = "class-6"
xcc110: hkicker, type = "class-6"
xcc112: hkicker, type = "class-6"

