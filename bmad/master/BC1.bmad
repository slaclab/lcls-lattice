ycc111: kicker, type = "class-6"

! ==============================================================================
! marker points, etc.
! ------------------------------------------------------------------------------

! collimators
! (betatron X/Y half-gaps are 27/18 sigma for 1 um normalized emittance)

ce11b: rcollimator, x_limit = 19.2e-3, l = ljaw, type = "HCOLL"    !X momentum collimator
cyc11: rcollimator, y_limit = 2.7e-3, l = ljaw, type = "VCOLL"    !Y betatron collimator
cxc11: rcollimator, x_limit = 2.7e-3, l = ljaw, type = "HCOLL"    !X betatron collimator
cyc12: rcollimator, y_limit = 2.7e-3, l = ljaw, type = "@4,VCOLL" !Y betatron collimator
cxc12: rcollimator, x_limit = 2.7e-3, l = ljaw, type = "@4,HCOLL" !X betatron collimator
cyc13: rcollimator, y_limit = 2.7e-3, l = ljaw, type = "VCOLL"    !Y betatron collimator
cxc13: rcollimator, x_limit = 2.7e-3, l = ljaw, type = "HCOLL"    !X betatron collimator

! instruments

otr11b: instrument, type = "OTR BC"       !BC1 energy spread
ws11b: marker, type = "@3,fast"      !BC1 energy spread
bz11b: instrument, type = "CSR"          !CSR-based relative bunch length monitor
bzc1: instrument, type = "@2,gap/diode" !relative bunch length monitor
im11b: marker, type = "ICT"          !Beam Current Monitor
wsc104: marker, type = "fast"         !post-BC1 emittance
wsc106: marker, type = "fast"         !post-BC1 emittance
wsc108: marker, type = "fast"         !post-BC1 emittance
wsc110: marker, type = "fast"         !post-BC1 emittance

! markers

bc1bcbeg: marker
bc1bcmid: marker
cntbc1: marker, type = "CENTER"
bc1bcend: marker

