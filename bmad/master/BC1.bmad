bpm1c01: instrument, type = "Stripline-1"
bpmc101: instrument, type = "Stripline-1"
bpmc102: instrument, type = "Stripline-1"
bpmc103: instrument, type = "Stripline-1"
bpmc104: instrument, type = "Stripline-1"
bpmc105: instrument, type = "Stripline-1"
