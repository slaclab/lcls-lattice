call, file = SXU_001_map.out

und: line=(und_map)

parameter[geometry] = open
parameter[e_tot]=3e9
parameter[particle]  = ELECTRON        
beginning[beta_a]   = 10
beginning[alpha_a]  = 0
beginning[beta_b]   = 10
beginning[alpha_b]  = 0
beginning[eta_x] = 0.0
beginning[eta_y] = 0.0
!bmad_com[rel_tol_adaptive_tracking] = 1e-5
!bmad_com[abs_tol_adaptive_tracking] = 1e-5

use, und
