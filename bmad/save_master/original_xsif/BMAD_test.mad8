  TITLE, "AD_ACCEL (January 23, 2019)" !combine LCLS and LCLS-II

! *** OPTICS=AD_ACCEL-23JAN19 ***

  OPTION, -ECHO, INFO, WARN, VERIFY
  ASSIGN, ECHO="test.echo"
  ASSIGN, PRINT="test.print"

  SETPLOT, XSIZE=25.4, YSIZE=20.32
  SETPLOT, LWIDTH=5, LSCALE=1.5, SSCALE=1.5, RSCALE=1.5, ASCALE=1.5

! ==============================================================================

 !SC_SXR   : superconducting linac to e- SXR dump
 !SC_SFTS  : superconducting linac to e- SXR safety dump
 !SC_HXR   : superconducting linac to e- HXR dump
 !SC_BSYD  : superconducting linac to BSY dump
 !SC_DIAG0 : superconducting linac to DIAG0
 !SC_DASEL : superconducting linac to End Station A (DASEL)

! ------------------------------------------------------------------------------

  COMMENT !SXR line (linac coordinates)
    CALL, FILENAME="SC_SXR.xsif"
    BEAM, ENERGY=E0
    USE, SC_SXR
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="test_survey.tape"
    BEAM, ENERGY=Ei
    USE, SC_SXRi
    PRINT, FULL
    TWISS, SAVE, BETX=BXi, ALFX=AXi, BETY=BYi, ALFY=AYi, TAPE="test_twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, FILE="test", RANGE=#S/DUMPFACEB
  ENDCOMMENT

! ------------------------------------------------------------------------------

  COMMENT !SXR line to safety dump (linac coordinates)
    CALL, FILENAME="SC_SFTS.xsif"
    BEAM, ENERGY=E0
    USE, SC_SFTS
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="test_survey.tape"
    BEAM, ENERGY=Ei
    USE, SC_SFTSi
    PRINT, FULL
    TWISS, BETX=BXi, ALFX=AXi, BETY=BYi, ALFY=AYi, TAPE="test_twiss.tape"
  ENDCOMMENT

! ------------------------------------------------------------------------------

  COMMENT !HXR line (linac coordinates)
    CALL, FILENAME="SC_HXR.xsif"
    BEAM, ENERGY=E0
    USE, SC_HXR
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="test_survey.tape"
    BEAM, ENERGY=Ei
    USE, SC_HXRi
    PRINT, FULL
    TWISS, SAVE, BETX=BXi, ALFX=AXi, BETY=BYi, ALFY=AYi, TAPE="test_twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, FILE="test", RANGE=#S/DUMPFACE
  ENDCOMMENT

! ------------------------------------------------------------------------------

  COMMENT !BSY dump line (linac coordinates)
    CALL, FILENAME="SC_BSYD.xsif"
    BEAM, ENERGY=E0
    USE, SC_BSYD
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="test_survey.tape"
    BEAM, ENERGY=Ei
    USE, SC_BSYDi
    PRINT, FULL
    TWISS, SAVE, BETX=BXi, ALFX=AXi, BETY=BYi, ALFY=AYi, TAPE="test_twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, FILE="test", RANGE=#S/DUMPBSY
  ENDCOMMENT

! ------------------------------------------------------------------------------

  COMMENT !DIAG0 diagnostic line (linac coordinates)
    CALL, FILENAME="SC_DIAG0.xsif"
    BEAM, ENERGY=E0
    USE, SC_DIAG0
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="test_survey.tape"
    BEAM, ENERGY=Ei
    USE, SC_DIAG0i
    PRINT, FULL
    TWISS, SAVE, BETX=BXi, ALFX=AXi, BETY=BYi, ALFY=AYi, TAPE="test_twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, FILE="test", RANGE=#S/#E
  ENDCOMMENT

! ------------------------------------------------------------------------------

  COMMENT !DASEL (linac coordinates)
    CALL, FILENAME="SC_DASEL.xsif"
    BEAM, ENERGY=E0
    USE, SC_DASEL
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="test_survey.tape"
    BEAM, ENERGY=Ei
    USE, SC_DASELi
    PRINT, FULL
    TWISS, SAVE, BETX=BXi, ALFX=AXi, BETY=BYi, ALFY=AYi, TAPE="test_twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=RBETX,RBETY, &
      STYLE=100, SPLINE, FILE="test", RANGE=#S/ENDBSYA_2
  ENDCOMMENT

! ==============================================================================

 !CU_HXR   : copper linac to e- HXR dump
 !CU_SFTH  : copper linac to e- HXR safety dump
 !CU_SXR   : copper linac to e- SXR dump
 !CU_ALINE : copper linac to End Station A
 !CU_GPSEC : copper linac to gun spectrometer
 !CU_SPEC  : copper linac to 135 MeV spectrometer

! ------------------------------------------------------------------------------

  COMMENT !HXR line (linac coordinates)
    CALL, FILENAME="CU_HXR.xsif"
    BEAM, ENERGY=E00
    USE, CU_HXR
    PRINT, FULL
    SURVEY, X0=Xi, Y0=0, Z0=Zi, THETA0=ADL1, TAPE="test_survey.tape"
    BEAM, ENERGY=E00
    TWISS, SAVE, BETX=CBETX, ALFX=CALFX, BETY=CBETY, ALFY=CALFY, &
      TAPE="test_twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEGDL1_1/DUMPFACE
  ENDCOMMENT

! ------------------------------------------------------------------------------

  COMMENT !HXR line to safety dump (linac coordinates)
    CALL, FILENAME="CU_SFTH.xsif"
    BEAM, ENERGY=E00
    USE, CU_SFTH
    PRINT, FULL
    SURVEY, X0=Xi, Y0=0, Z0=Zi, THETA0=ADL1, TAPE="test_survey.tape"
    BEAM, ENERGY=E00
    TWISS, BETX=CBETX, ALFX=CALFX, BETY=CBETY, ALFY=CALFY, &
      TAPE="test_twiss.tape"
  ENDCOMMENT

! ------------------------------------------------------------------------------

 !COMMENT !SXR line (linac coordinates)
    CALL, FILENAME="CU_SXR.xsif"
    BEAM, ENERGY=E00
    USE, CU_SXR
    PRINT, FULL
    SURVEY, X0=Xi, Y0=0, Z0=Zi, THETA0=ADL1, TAPE="test_survey.tape"
    BEAM, ENERGY=E00
    TWISS, SAVE, BETX=CBETX, ALFX=CALFX, BETY=CBETY, ALFY=CALFY, &
      TAPE="test_twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEGDL1_1/DUMPFACEB
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEGDL1_1/DUMPFACEB
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEGDL1_1/DUMPFACEB
 !ENDCOMMENT

! ------------------------------------------------------------------------------

  COMMENT !A-line (linac coordinates)
    CALL, FILENAME="CU_ALINE.xsif"
    BEAM, ENERGY=E00
    USE, CU_ALINE
    PRINT, FULL
    SURVEY, X0=Xi, Y0=0, Z0=Zi, THETA0=ADL1, TAPE="test_survey.tape"
    BEAM, ENERGY=E00
    TWISS, SAVE, BETX=CBETX, ALFX=CALFX, BETY=CBETY, ALFY=CALFY, &
      TAPE="test_twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=RBETX,RBETY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEGCLTH_0/ENDBSYA_2
  ENDCOMMENT

! ------------------------------------------------------------------------------

  COMMENT !gun spectrometer (linac coordinates)
    CALL, FILENAME="CU_GSPEC.xsif"
    BEAM, ENERGY=E00
    USE, CU_GSPEC
    PRINT, FULL
    SURVEY, X0=Xi, Y0=0, Z0=Zi, THETA0=ADL1, TAPE="test_survey.tape"
    BEAM, ENERGY=E00
    TWISS, BETX=CBETX, ALFX=CALFX, BETY=CBETY, ALFY=CALFY, &
      TAPE="test_twiss.tape"
  ENDCOMMENT

! ------------------------------------------------------------------------------

  COMMENT !135 MeV spectrometer (linac coordinates)
    CALL, FILENAME="CU_SPEC.xsif"
    BEAM, ENERGY=E00
    USE, CU_SPEC
    PRINT, FULL
    SURVEY, X0=Xi, Y0=0, Z0=Zi, THETA0=ADL1, TAPE="test_survey.tape"
    BEAM, ENERGY=E00
    TWISS, BETX=CBETX, ALFX=CALFX, BETY=CBETY, ALFY=CALFY, &
      TAPE="test_twiss.tape"
  ENDCOMMENT

! ==============================================================================

  STOP  