! ==============================================================================
! SXR undulator and extension (north)
! ==============================================================================

! ------------------------------------------------------------------------------
! SXR undulator PPM phase shifter
! - Author: Heinz-Dieter Nuhn, Stanford Linear Accelerator Center
! - Last edited September 06, 2017
! - 10.0 mm miminum Undulator Gap
! ------------------------------------------------------------------------------
! - LPSSX  = SXR Phase Shifter length
! - luPSSX = SXR Phase Shifter period
! - PIPSSX = SXR Phase Shifter phase integral
! - KPSSX  = SXR Phase Shifter Undulator parameter (rms); range 1.34-3.59
! - kQPSSX = natural SXR Phase Shifter undulator focusing "k" in y-plane
! ------------------------------------------------------------------------------

 !Eu     :  definition moved to LCLS2sc_master.xsif and LCLS2cu_master.xsif
gamu = eu/mc2                             !Lorentz energy factor in undulator [ ]
lpssx = 0.0825                             !m
lupssx = 0.075                              !m
lpssxh = lpssx/2
pipssx = 3814                               !T^2mm^3 (180-3814)
kpssx = 1.e-9*c_light/mc2*sqrt(2.e-9*pipssx/lupssx)
kqpssx = (kpssx*2*pi/lupssx/sqrt(2)/gamu)^2 !m^-2


!------- SXR Phase Shifter -------
!
! B_max = 2pi/lambda * sqrt(2*PHASE_INTEGRAL / L)
! 
pssx_phase_integral = 3814e-9  !T^2 m^3, maximum, from: T^2mm^3 (180-3814)
pssx_L        = 0.0825   ! m 
pssx_L_period = 0.075 ! m 
pssx: wiggler, type = "PSSX", 
    L = pssx_L,
    b_max = 2*pi / pssx_L_period * sqrt(2 * pssx_phase_integral / pssx_L  ),
    n_period = 1
pssx[L] = pssx[L]/2 ! Will be doubled in desplitting process. 
!---------------------------------
!old: pssx: taylor, type = "PSSX", l = lpssxh, {1: 1.0, 1 0 0 0 0 0}, {1: lpssxh, 0 1 0 0 0 0}, {2: 0.0 &
!old         , 1 0 0 0 0 0}, {2: 1.0, 0 1 0 0 0 0}, {3: cos(lpssxh*sqrt(kqpssx)), 0 0 1 0 0 0}, {3:  &
!old         sin(lpssxh*sqrt(kqpssx))/sqrt(kqpssx), 0 0 0 1 0 0}, {4:  &
!old         -sin(lpssxh*sqrt(kqpssx))*sqrt(kqpssx), 0 0 1 0 0 0}, {4: cos(lpssxh*sqrt(kqpssx)),  &
!old         0 0 0 1 0 0}, {5: 1.0, 0 0 0 0 1 0}, {6: 1.0, 0 0 0 0 0 1}

pssx26: pssx
pssx27: pssx
pssx28: pssx
pssx29: pssx
pssx30: pssx
pssx31: pssx
pssx32: pssx
pssx33: pssx
pssx34: pssx
pssx36: pssx
pssx37: pssx
pssx38: pssx
pssx39: pssx
pssx40: pssx
pssx41: pssx
pssx42: pssx
pssx43: pssx
pssx44: pssx
pssx45: pssx
pssx46: pssx

! ------------------------------------------------------------------------------
! SXR drifts
! ------------------------------------------------------------------------------

ldusegs = 3.4
ldu1s = 0.1
ldu2s = 0.03
ldu3s = 0.25-lpssxh-0.04-0.005
ldu4s = (0.25-lpssxh-0.5*lqu)/2+0.04+0.005
ldu5s = (0.25-lpssxh-0.5*lqu)/2
ldu6s = 0.12-lqu/2-lrfbub/2+0.01
ldu7s = 0.25-lrfbub/2-0.01
dldu0s = 0.0 !fine tune Z in undulator
ldu0s = 2.1359-ldu6s-ldu7s-lqu+dldu0s

du0s: drift, l = ldu0s
du1s: drift, l = ldu1s
du2s: drift, l = ldu2s
du3s: drift, l = ldu3s
du4s: drift, l = ldu4s
du5s: drift, l = ldu5s
du6s: drift, l = ldu6s
du7s: drift, l = ldu7s

due1ab: drift, l = 0.9-lrfbub-0.057
due1e: drift, l = 0.057

! ------------------------------------------------------------------------------
! SXR extension quads
! ------------------------------------------------------------------------------

! note: the below K-values are for SC beam; the settings for Cu beam are
! in the "LCLS2cu_main.mad8" file

kqsx16 = 0.589502458599 ! 0.584170476419
kqsx19 = -0.91531741252  !-0.916029555737
kqsx21 = 1.109876931688 ! 1.112214118849
kqsx24 = -1.085714742294 !-1.119664961437

qsx16: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqsx16
qsx19: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqsx19
qsx21: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqsx21
qsx24: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqsx24

! ------------------------------------------------------------------------------
! SXR extension X-steering coils in quads
! ------------------------------------------------------------------------------

xcsx16: kicker, type = "type-U"
xcsx19: kicker, type = "type-U"
xcsx21: kicker, type = "type-U"
xcsx24: kicker, type = "type-U"

! ------------------------------------------------------------------------------
! SXR extension Y-steering coils in quads
! ------------------------------------------------------------------------------

ycsx16: kicker, type = "type-U"
ycsx19: kicker, type = "type-U"
ycsx21: kicker, type = "type-U"
ycsx24: kicker, type = "type-U"

! ------------------------------------------------------------------------------
! SXR extension BPMs
! ------------------------------------------------------------------------------

rfbsx16: instrument, l = lrfbub, type = "CavityX-1"
drfbs17: drift, l = lrfbub
drfbs18: drift, l = lrfbub
rfbsx19: instrument, l = lrfbub, type = "CavityX-1"
drfbs20: drift, l = lrfbub
rfbsx21: instrument, l = lrfbub, type = "CavityX-1"
drfbs22: drift, l = lrfbub
drfbs23: drift, l = lrfbub
rfbsx24: instrument, l = lrfbub, type = "CavityX-1"
rfbsx25: instrument, l = lrfbub, type = "CavityX-1"

sxxstart: marker !start of soft X-ray extension system
sxxterm: marker !end of soft X-ray extension system
sxrstart: marker !start of undulator system
rwwake5s: marker, type = "WAKE" !SXR beampipe wake applied here
sxrterm: marker !~end of undulator system
muqs: marker
mphs: marker



!Old split line: line = (qsx16, xcsx16, ycsx16, qsx16)

qsx16_full: line = (qsx16)
qsx16[L] = 2*qsx16[L]
xcsx16[superimpose] = T
xcsx16[ref] = qsx16
ycsx16[superimpose] = T
ycsx16[ref] = qsx16
dqsx17: drift, l = lqu
dqsx18: drift, l = lqu


!Old split line: line = (qsx19, xcsx19, ycsx19, qsx19)

qsx19_full: line = (qsx19)
qsx19[L] = 2*qsx19[L]
xcsx19[superimpose] = T
xcsx19[ref] = qsx19
ycsx19[superimpose] = T
ycsx19[ref] = qsx19
dqsx20: drift, l = lqu


!Old split line: line = (qsx21, xcsx21, ycsx21, qsx21)

qsx21_full: line = (qsx21)
qsx21[L] = 2*qsx21[L]
xcsx21[superimpose] = T
xcsx21[ref] = qsx21
ycsx21[superimpose] = T
ycsx21[ref] = qsx21
dqsx22: drift, l = lqu
dqsx23: drift, l = lqu


!Old split line: line = (qsx24, xcsx24, ycsx24, qsx24)

qsx24_full: line = (qsx24)
qsx24[L] = 2*qsx24[L]
xcsx24[superimpose] = T
xcsx24[ref] = qsx24
ycsx24[superimpose] = T
ycsx24[ref] = qsx24
dqsx25: drift, l = lqu

dpssx17: drift, l = lpssx
dpssx18: drift, l = lpssx
dpssx19: drift, l = lpssx
dpssx20: drift, l = lpssx
dpssx21: drift, l = lpssx
dpssx22: drift, l = lpssx
dpssx23: drift, l = lpssx
dpssx24: drift, l = lpssx
dpssx25: drift, l = lpssx

sxbrk17: line = (du3s, dpssx17, du4s, du5s, dqsx17, du6s, drfbs17, du7s)
sxbrk18: line = (du3s, dpssx18, du4s, du5s, dqsx18, du6s, drfbs18, du7s)
sxbrk19: line = (du3s, dpssx19, du4s, du5s, qsx19_full, du6s, rfbsx19, du7s)
sxbrk20: line = (du3s, dpssx20, du4s, du5s, dqsx20, du6s, drfbs20, du7s)
sxbrk21: line = (du3s, dpssx21, du4s, du5s, qsx21_full, du6s, rfbsx21, du7s)
sxbrk22: line = (du3s, dpssx22, du4s, du5s, dqsx22, du6s, drfbs22, du7s)
sxbrk23: line = (du3s, dpssx23, du4s, du5s, dqsx23, du6s, drfbs23, du7s)
sxbrk24: line = (du3s, dpssx24, du4s, du5s, qsx24_full, du6s, rfbsx24, du7s)
sxbrk25: line = (du3s, dpssx25, du4s, du5s, dqsx25, du6s, rfbsx25, du7s)

dusegs17: drift, l = ldusegs
dusegs18: drift, l = ldusegs
dusegs19: drift, l = ldusegs
dusegs20: drift, l = ldusegs
dusegs21: drift, l = ldusegs
dusegs22: drift, l = ldusegs
dusegs23: drift, l = ldusegs
dusegs24: drift, l = ldusegs
dusegs25: drift, l = ldusegs

sxcel17: line = (du1s, du2s, dusegs17, sxbrk17)
sxcel18: line = (du1s, du2s, dusegs18, sxbrk18)
sxcel19: line = (du1s, du2s, dusegs19, sxbrk19) !Q+RFBPM
sxcel20: line = (du1s, du2s, dusegs20, sxbrk20)
sxcel21: line = (du1s, du2s, dusegs21, sxbrk21) !Q+RFBPM
sxcel22: line = (du1s, du2s, dusegs22, sxbrk22)
sxcel23: line = (du1s, du2s, dusegs23, sxbrk23)
sxcel24: line = (du1s, du2s, dusegs24, sxbrk24) !Q+RFBPM
sxcel25: line = (du1s, du2s, dusegs25, sxbrk25) !RFBPM

sxrxx: line = (begunds, sxxstart, du0s, qsx16_full, du6s, rfbsx16, du7s, sxcel17, sxcel18,  &
        sxcel19, sxcel20, sxcel21, sxcel22, sxcel23, sxcel24, sxcel25, sxxterm)

! ------------------------------------------------------------------------------
! SXR undulator
! ------------------------------------------------------------------------------
! - Author: Heinz-Dieter Nuhn, Stanford Linear Accelerator Center
! - Last edited Mar 03, 2014
! - 7.2 mm miminum Undulator Gap; only constant break length each
! - include natural vertical focusing over all but edge terminations
! ------------------------------------------------------------------------------
! - IntgSX  = integrated quadrupole gradient
! - GQFSX   = QF and QD gradients can be made different to compensate for
!             undulator focussing ...
! - GQDSX   = ... but since undulator focussing depends on gamma^2, compensation
!             will only work for one energy
! - kQFSX   = QF undulator quadrupole focusing "k"
! - kQDSX   = QD undulator quadrupole focusing "k"
! - LDUSEGS = SXR Undulator segment length
! - luSXU   = SXR Undulator period
! - NpSXU   = SXR Undulator period count
! - LSXUCR  = SXR Undulator magnetic length
! - LSXUe   = SXR Undulator spacing between magnet array and strongback end
! - KSXU    = SXR Undulator parameter (rms); range 2-5.5
! - kQSX    = natural SXR undulator focusing "k" in y-plane
! ------------------------------------------------------------------------------

 !IntgSX :   definition moved to LCLS2sc_main.xsif and LCLS2cu_main.xsif
gqfsx = intgsx/lqu/10*1.0           !T/m
gqdsx = -intgsx/lqu/10*1.0           !T/m
kqfsx = 1.e-9*gqfsx*c_light/gamu/mc2 !m^-2
kqdsx = 1.e-9*gqdsx*c_light/gamu/mc2 !m^-2
kqdsxm = -0.266792876891 !-0.406434161462

qsx26: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsx27: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsx28: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsx29: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsx30: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsx31: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsx32: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsx33: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsx34: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsx35: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsx36: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsx37: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsx38: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsx39: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsx40: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsx41: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsx42: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsx43: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsx44: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsx45: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsx46: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsx47: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsxm

lusxu = 0.039                            !m
npsxu = 87
lsxucr = lusxu*npsxu                      !m
lsxue = (ldusegs-lsxucr)/2               !m
lsxuh = lsxucr/2
ksxu = 5.0
kqsx = (ksxu*2*pi/lusxu/sqrt(2)/gamu)^2 !m^-2


!------- SXR Undulator -------
my_umasx_k = 5.0
umasx: wiggler, 
        type = "UMASX",
        L_period = 0.039, 
        n_period = 87, 
        b_max = my_umasx_k * 2*pi*m_electron / (c_light * 0.039), 
        L = 87*0.039, 
        ds_step = 0.039*10
        
umasx[L] = umasx[L]/2 ! Will be doubled in desplitting process. 
!---------------------------------
!old: umasx: taylor, type = "UMASX", l = lsxuh, {1: 1.0, 1 0 0 0 0 0}, {1: lsxuh, 0 1 0 0 0 0}, {2: 0.0 &
!old         , 1 0 0 0 0 0}, {2: 1.0, 0 1 0 0 0 0}, {3: cos(lsxuh*sqrt(kqsx)), 0 0 1 0 0 0}, {3:  &
!old         sin(lsxuh*sqrt(kqsx))/sqrt(kqsx), 0 0 0 1 0 0}, {4: -sin(lsxuh*sqrt(kqsx))*sqrt(kqsx),  &
!old         0 0 1 0 0 0}, {4: cos(lsxuh*sqrt(kqsx)), 0 0 0 1 0 0}, {5: 1.0, 0 0 0 0 1 0}, {6: 1.0,  &
!old         0 0 0 0 0 1}

umasx26: umasx
umasx27: umasx
umasx28: umasx
umasx29: umasx
umasx30: umasx
umasx31: umasx
umasx32: umasx
umasx33: umasx
