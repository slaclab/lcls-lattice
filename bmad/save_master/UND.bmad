! ------------------------------------------------------------------------------
! SXR undulator exit section
! ------------------------------------------------------------------------------

! note: the below K-values are for SC beam; the settings for Cu beam are
! in the "LCLS2cu_main.mad8" file

kque1b = -0.306247962224 !-0.297915551865
kque2b = 0.394195575969 ! 0.390984021273

que1b: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kque1b
que2b: quadrupole, type = "2Q10", l = lqr/2, aperture = rqr, k1 = kque2b

tcx01b: lcavity, rf_frequency = xbandf * 1e6, type = "@1,TRANS_DEFL", l = 1.0/2 !horiz. deflection
tcx02b: lcavity, rf_frequency = xbandf * 1e6, type = "@1,TRANS_DEFL", l = 1.0/2 !horiz. deflection

lbkxdmp = 1.0 !x-kicker length in dumpline
dbkxdmps: drift, l = lbkxdmp !placeholder for x-kicker in SXR dumpline

dzsxtes = 0.468389399848e-10 !set MDLWALLb at 685 m exactly to align with SXR XTES system
dzhxtes = 0.749541186639e-6  !set MDLWALL at 685 m exactly to align with HXR XTES system

due1d: drift, l = 0.1
due1b: drift, l = 1.5
due1c: drift, l = 0.5
due1ca: drift, l = 0.3
due1cb: drift, l = 0.188-0.012
due1cc: drift, l = due1c[l]-due1ca[l]-due1cb[l]
due2a: drift, l = 0.5
due2b: drift, l = 0.8
due2d: drift, l = 0.188-0.012
due2e: drift, l = 1.740055-due2b[l]-due2d[l]
due2cb: drift, l = 0.615+(lqp-lqr)/2
due3ab: drift, l = 0.375504+(lqp-lqr)/2-0.014955
due3bb: drift, l = 1.2630495+0.014955
due3c: drift, l = (1.7968755-lbkxdmp)/2
dpcvv: drift, l = 0.397
dvvtcx: drift, l = 0.32
dtcx12: drift, l = 0.373/2
dtcxsp: drift, l = 0.381
due4b: drift, l = 0.454+(lqp-lqr)/2
due5ab: drift, l = 0.477799+(lqp-lqr)/2-0.114162
due5bb: drift, l = 0.264+0.114162-0.1016+0.1016
due5cb: drift, l = 0.2674+0.1016-0.1016
due5d: drift, l = 0.137055-0.05
due5f: drift, l = 0.05
due5e: drift, l = 0.252825-due5d[l]-due5f[l]-dzhxtes
dsb0a: drift, l = 0.260150
dsb0b: drift, l = 0.344
dsb0c: drift, l = 0.32646
dsb0d: drift, l = 0.123366
ddsb0e = -0.403705866174e-3
dsb0e: drift, l = 0.1059327+ddsb0e
ddlwall: drift, l = 0.250825+dzhxtes !length of dumpline thermal barrier wall

due5eb: drift, l = 0.252825-due5d[l]-due5f[l]+dzsxtes
ddlwallb: drift, l = 0.250825-dzsxtes !length of dumpline thermal barrier wall

xcue2b: kicker, type = "class-4"
xcd3b: kicker, type = "class-5"

ycue1b: kicker, type = "class-4"
ycd3b: kicker, type = "class-5"

bpmue1b: instrument, type = "Stripline-5" !RFBUE1B : MONI, TYPE="@2,CavityS-1"
bpmue2b: instrument, type = "Stripline-5" !RFBUE2B : MONI, TYPE="@2,CavityS-1"
 !RFBUE3B : MONI, TYPE="@2,CavityS-1"

true1b: instrument, type = "@5" !Be foil inserter (THz)
sptcxb: instrument, type = "@1" !XTCAV spoiler
btmqueb: instrument !Burn-Through-Monitor
btm0b: instrument !Burn-Through-Monitor behind the PCPM0B

pctcxb: ecollimator, x_limit = 4.5e-3, y_limit = 4.5e-3, type = "@1" !XTCAV photon collimator (9 mm aperture)
pcpm0b: ecollimator, x_limit = 17.5e-3, y_limit = 17.5e-3, l = lpcpm

 !IMUNDOB : MARKER, TYPE="@0,BCS ACM" !BCS ACM

mimundob: marker

ph31b: instrument, type = "@0,2805 MHz" !post-undulator phase measurement RF cavity (low rate)
ph32b: instrument, type = "@0,2805 MHz" !post-undulator phase measurement RF cavity (low rate)
ph33b: instrument, type = "@1,2604 MHz" !post-undulator phase measurement RF cavity (high rate)
ph34b: instrument, type = "@1,2604 MHz" !post-undulator phase measurement RF cavity (high rate)

uebegb: marker
vvtcxb: marker !XTCAV vacuum valve
mtcx01b: marker !entrance to TCX01B (for ELEGANT WATCH point)
mtcxb: marker !centerline between TCX01B and TCX02B (for matching)
ueendb: marker
vv36b: marker !treaty-point vacuum valve just downbeam of undulator
vv37b: marker !vac. valve in dumpline
dlstartb: marker
mdlwallb: marker !front face of dumpline thermal barrier wall



!Old split line: line = (que1b, que1b)

que1b_full: line = (que1b)
que1b[L] = 2*que1b[L]


!Old split line: line = (que2b, que2b)

que2b_full: line = (que2b)
que2b[L] = 2*que2b[L]

undexitb: line = (begdmps_1, uebegb, due1d, vv36b, due1b, mimundob, due1ca, ph33b, due1cb, ph34b &
        , due1cc, due2a, ycue1b, due2b, ph31b, due2d, ph32b, due2e, xcue2b, due2cb, que1b_full,  &
        due3ab, bpmue1b, due3bb, true1b, due3c, dbkxdmps, due3c, pctcxb, dpcvv, vvtcxb, dvvtcx,  &
        mtcx01b, 2*tcx01b, dtcx12, mtcxb, dtcx12, 2*tcx02b, dtcxsp, sptcxb, due4b, que2b_full,  &
        due5ab, bpmue2b, due5bb, btmqueb, due5cb, pcpm0b, due5f, btm0b, due5d, due5eb, mdlwallb,  &
        ddlwallb, ueendb, dlstartb, dsb0a, ycd3b, dsb0b, xcd3b, dsb0c, vv37b, dsb0d, dsb0e,  &
        enddmps_1)

sxrund: line = (sxrxx, sxr, undexitb)

! ==============================================================================
! HXR HGVPU undulator (south)
! ==============================================================================

! ------------------------------------------------------------------------------
! HXR undulator PPM phase shifter
! - Author: Heinz-Dieter Nuhn, Stanford Linear Accelerator Center
! - Last edited September 06, 2017
! - 10.0 mm miminum Undulator Gap
! ------------------------------------------------------------------------------
! - LPSHX  = HXR Phase Shifter length
! - luPSHX = HXR Phase Shifter period
! - PIPSHX = HXR Phase Shifter phase integral
! - KPSHX  = HXR Phase Shifter Undulator parameter (rms); range 0.18-1.91
! - kQPSHX = natural HXR Phase Shifter undulator focusing "k" in y-plane
! ------------------------------------------------------------------------------

lpshx = 0.0495                             !m
lupshx = 0.045                              !m
lpshxh = lpshx/2
pipshx = 490                                !T^2mm^3 (80-490)
kpshx = 1.e-9*c_light/mc2*sqrt(2.e-9*pipshx/lupshx)
kqpshx = (kpshx*2*pi/lupshx/sqrt(2)/gamu)^2 !m^-2


!------- HXR Phase Shifter -------
!
! B_max = 2pi/lambda * sqrt(2*PHASE_INTEGRAL / L)
! 
pshx_phase_integral = 490e-9  !T^2 m^3, maximum, from: T^2mm^3 (80-490)
pshx_L        = 0.0495 ! m 
pshx_L_period = 0.045 ! m 
pshx: wiggler, type = "PSHX", 
    L = pshx_L,
    b_max = 2*pi / pshx_L_period * sqrt(2 * pshx_phase_integral / pshx_L  ),
    n_period = 1
pshx[L] = pshx[L]/2 ! Will be doubled in desplitting process. 
!---------------------------------
!old: pshx: taylor, type = "PSHXh", l = lpshxh, {1: 1.0, 1 0 0 0 0 0}, {1: lpshxh, 0 1 0 0 0 0}, {2:  &
!old         0.0, 1 0 0 0 0 0}, {2: 1.0, 0 1 0 0 0 0}, {3: cos(lpshxh*sqrt(kqpshx)), 0 0 1 0 0 0}, {3 &
!old         : sin(lpshxh*sqrt(kqpshx))/sqrt(kqpshx), 0 0 0 1 0 0}, {4:  &
!old         -sin(lpshxh*sqrt(kqpshx))*sqrt(kqpshx), 0 0 1 0 0 0}, {4: cos(lpshxh*sqrt(kqpshx)),  &
!old         0 0 0 1 0 0}, {5: 1.0, 0 0 0 0 1 0}, {6: 1.0, 0 0 0 0 0 1}

pshx13: pshx
pshx14: pshx
pshx15: pshx
pshx16: pshx
pshx17: pshx
pshx18: pshx
pshx19: pshx
pshx21: pshx
pshx22: pshx
pshx23: pshx
pshx24: pshx
pshx25: pshx
pshx26: pshx
pshx27: pshx
pshx29: pshx
pshx30: pshx
pshx31: pshx
pshx32: pshx
pshx33: pshx
pshx34: pshx
pshx35: pshx
pshx36: pshx
pshx37: pshx
pshx38: pshx
pshx39: pshx
pshx40: pshx
pshx41: pshx
pshx42: pshx
pshx43: pshx
pshx44: pshx
pshx45: pshx

! ------------------------------------------------------------------------------
! - Author: Heinz-Dieter Nuhn, Stanford Linear Accelerator Center
! - Edited Mar 03, 2014
! - Updated Dec 02, 2015 for HGVPU (Y. Nosochkov, D. Bruch)
! - 7.2 mm miminum Undulator Gap; only constant break length each
! - include natural horizontal focusing over all but edge terminations
! ------------------------------------------------------------------------------
! - IntgHX  = integrated quadrupole gradient
! - GQFHX   = QF and QD gradients can be made different to compensate for
!             undulator focussing ...
! - GQDHX   = ... but since undulator focussing depends on gamma^2, compensation
!             will only work for one energy
! - kQFHX   = QF undulator quadrupole focusing "k"
! - kQDHX   = QD undulator quadrupole focusing "k"
! - LDUSEGH = HXR Undulator segment length
! - luHXU   = HXR Undulator period
! - NpHXU   = HXR Undulator period count
! - LHXUCR  = HXR Undulator magnetic length
! - LHXUe   = HXR Undulator spacing between magnet array and strongback end
! - KHXU    = HXR Undulator parameter (rms); range 0.54-2.45
! - kQHX    = natural HXR undulator focusing "k" in x-plane
! ------------------------------------------------------------------------------

ldusegh = 3.372032
ldu1h = 0.040984
ldu2h = 0.0
ldu3h = (1.83-ldusegh/2-lqu/2)/2
ldu4h = 0.13-lqu/2-lrfbub/2
ldu5h = 0.1275-lpshxh-lrfbub/2
ldu6h = 0.109243-lpshxh
ldu7h = 0.08892366667
ldu8h = 0.025
dldu0h = 0.0 !fine tune Z of undulator
ldu0h = 0.094391984077-ldu8h-lrfbub+lrfbub+dldu0h

du0h: drift, l = ldu0h
du1h: drift, l = ldu1h
du2h: drift, l = ldu2h
du3h: drift, l = ldu3h
du4h: drift, l = ldu4h
du5h: drift, l = ldu5h
du6h: drift, l = ldu6h
du7h: drift, l = ldu7h
du8h: drift, l = ldu8h

ddue1a = 0.0
due1a: drift, l = 2.853174666558-lrfbub+ddue1a

 !IntgHX :   definition moved to LCLS2sc_main.xsif and LCLS2cu_main.xsif
gqfhx = intghx/lqu/10*1.0           !T/m
gqdhx = -intghx/lqu/10*1.0           !T/m
kqfhx = 1.e-9*gqfhx*c_light/gamu/mc2 !m^-2
kqdhx = 1.e-9*gqdhx*c_light/gamu/mc2 !m^-2
kqdhxm = -0.51857909178

qhx13: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfhx
qhx14: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdhx
qhx15: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfhx
qhx16: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdhx
qhx17: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfhx
qhx18: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdhx
qhx19: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfhx
qhx20: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdhx
qhx21: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfhx
qhx22: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdhx
qhx23: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfhx
qhx24: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdhx
qhx25: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfhx
qhx26: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdhx
qhx27: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfhx
qhx28: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdhx
qhx29: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfhx
qhx30: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdhx
qhx31: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfhx
qhx32: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdhx
qhx33: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfhx
qhx34: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdhx
qhx35: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfhx
qhx36: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdhx
qhx37: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfhx
qhx38: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdhx
qhx39: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfhx
qhx40: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdhx
qhx41: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfhx
qhx42: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdhx
qhx43: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfhx
qhx44: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdhx
qhx45: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfhx
qhx46: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdhxm

luhxu = 0.026                            !m
nphxu = 129
lhxucr = luhxu*nphxu                      !m
lhxue = (ldusegh-lhxucr)/2               !m
lhxuh = lhxucr/2
khxu = 2.0
kqhx = (khxu*2*pi/luhxu/sqrt(2)/gamu)^2 !m^-2


!------- HXR Undulator -------
my_umahx_k = 2.0
umahx: wiggler, 
        type = "UMAHX",
        L_period = 0.026, 
        n_period = 129, 
        b_max = my_umahx_k * 2*pi*m_electron / (c_light * 0.026), 
        L = 129*0.026, 
        tilt=pi/2,
        ds_step = 0.026*10
        
umahx[L] = umahx[L]/2 ! Will be doubled in desplitting process. 
!---------------------------------
!old: umahx: taylor, type = "UMAHXh", l = lhxuh, {1: cos(lhxuh*sqrt(kqhx)), 1 0 0 0 0 0}, {1:  &
!old         sin(lhxuh*sqrt(kqhx))/sqrt(kqhx), 0 1 0 0 0 0}, {2: -sin(lhxuh*sqrt(kqhx))*sqrt(kqhx),  &
!old         1 0 0 0 0 0}, {2: cos(lhxuh*sqrt(kqhx)), 0 1 0 0 0 0}, {3: 1.0, 0 0 1 0 0 0}, {3: lhxuh,  &
!old         0 0 0 1 0 0}, {4: 0.0, 0 0 1 0 0 0}, {4: 1.0, 0 0 0 1 0 0}, {5: 1.0, 0 0 0 0 1 0}, {6:  &
!old         1.0, 0 0 0 0 0 1}

umahx13: umahx
umahx14: umahx
