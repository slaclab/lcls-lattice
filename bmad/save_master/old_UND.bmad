! ------------------------------------------------------------------------------
! HXR undulator exit section
! ------------------------------------------------------------------------------

! note: the below K-values are for SC beam; the settings for Cu beam are
! in the "LCLS2cu_main.mad8" file

kque1 = -0.09207220416
kque2 = 0.160489725306

que1: quadrupole, type = "3.25Q20", l = lqd/2, aperture = rqd, k1 = kque1
que2: quadrupole, type = "3.25Q20", l = lqd/2, aperture = rqd, k1 = kque2

tcx01: lcavity, rf_frequency = xbandf * 1e6, type = "TRANS_DEFL", l = 1.0/2 !horizontal deflection
tcx02: lcavity, rf_frequency = xbandf * 1e6, type = "TRANS_DEFL", l = 1.0/2 !horizontal deflection

dbkxdmph: drift, l = lbkxdmp !placeholder for x-kicker in HXR dumpline

due2c: drift, l = due2cb[l]+(lqr-lqd)/2 !0.555
due3a: drift, l = 0.375504+(lqp-lqd)/2+0.11496-0.063643
due3b: drift, l = 1.2630495-0.11496+0.063643
due4: drift, l = due4b[l]+(lqr-lqd)/2 !0.394
due5a: drift, l = 0.477799+(lqp-lqd)/2+0.012675-0.063653
due5b: drift, l = 0.264-0.012675+0.063653
due5c: drift, l = 0.2674

xcue2: kicker, type = "class-4"
xcd3: kicker, type = "class-5"

ycue1: kicker, type = "class-4"
ycd3: kicker, type = "class-5"

bpmue1: instrument, type = "Stripline-13" !RFBUE1 : MONI, TYPE="@2,CavityS-1"
bpmue2: instrument, type = "Stripline-13" !RFBUE2 : MONI, TYPE="@2,CavityS-1"
 !RFBUE3 : MONI, TYPE="@2,CavityS-1"

 !IMUNDO : MARKER, TYPE="BCS toroid" !BCS toroid
 !IMBCS3 : MARKER, TYPE="BCS toroid" !BCS toroid before dump bend (comparator with IMBCS4)

mimundo: marker
mimbcs3: marker

true1: instrument, type = "@5" !Be foil inserter (THz) -- existing LCLS device
sptcx: instrument !XTCAV spoiler
btmque: instrument !Burn-Through-Monitor
btm0: instrument !Burn-Through-Monitor behind the PCPM0

pctcx: ecollimator, x_limit = 4.5e-3, y_limit = 4.5e-3 !XTCAV photon collimator (9 mm aperture)
pcpm0: ecollimator, x_limit = 17.5e-3, y_limit = 17.5e-3, l = lpcpm

ph31: instrument, type = "2805 MHz"    !post-undulator phase measurement RF cavity (existing LCLS device)
ph32: instrument, type = "2805 MHz"    !post-undulator phase measurement RF cavity (existing LCLS device)
ph33: instrument, type = "@1,2604 MHz" !post-undulator phase measurement RF cavity (high rate)
ph34: instrument, type = "@1,2604 MHz" !post-undulator phase measurement RF cavity (high rate)

uebeg: marker
ueend: marker
vvtcx: marker !XTCAV vacuum valve
vv36: marker !treaty-point vacuum valve just downbeam of undulator
vv37: marker !vac. valve in dumpline
mtcx01: marker !entrance to TCX01 (for ELEGANT WATCH point)
mtcx: marker !centerline between TCX01 and TCX02 (for matching)
dlstart: marker !start of dumpline
mdlwall: marker !front face of dumpline thermal barrier wall

undexit: line = (begdmph_1, uebeg, due1d, vv36, due1b, mimundo, due1ca, ph33, due1cb, ph34,  &
        due1cc, due2a, ycue1, due2b, ph31, due2d, ph32, due2e, xcue2, due2c, que1, que1, due3a,  &
        bpmue1, due3b, true1, due3c, dbkxdmph, due3c, pctcx, dpcvv, vvtcx, dvvtcx, mtcx01,  &
        2*tcx01, dtcx12, mtcx, dtcx12, 2*tcx02, dtcxsp, sptcx, due4, que2, que2, due5a, bpmue2,  &
        due5b, btmque, due5c, pcpm0, due5f, btm0, due5d, mimbcs3, due5e, mdlwall, ddlwall, ueend &
        , dlstart, dsb0a, ycd3, dsb0b, xcd3, dsb0c, vv37, dsb0d, dsb0e, enddmph_1)

hxrund: line = (hxr, undexit)

