! ==============================================================================
! SXR undulator and extension (north)
! ==============================================================================

! ------------------------------------------------------------------------------
! SXR undulator PPM phase shifter
! - Author: Heinz-Dieter Nuhn, Stanford Linear Accelerator Center
! - Last edited September 06, 2017
! - 10.0 mm miminum Undulator Gap
! ------------------------------------------------------------------------------
! - LPSSX  = SXR Phase Shifter length
! - luPSSX = SXR Phase Shifter period
! - PIPSSX = SXR Phase Shifter phase integral
! - KPSSX  = SXR Phase Shifter Undulator parameter (rms); range 1.34-3.59
! - kQPSSX = natural SXR Phase Shifter undulator focusing "k" in y-plane
! ------------------------------------------------------------------------------

 !Eu     :  definition moved to LCLS2sc_master.xsif and LCLS2cu_master.xsif
gamu = eu/mc2                             !Lorentz energy factor in undulator [ ]
lpssx = 0.0825                             !m
lupssx = 0.075                              !m
lpssxh = lpssx/2
pipssx = 3814                               !T^2mm^3 (180-3814)
kpssx = 1.e-9*c_light/mc2*sqrt(2.e-9*pipssx/lupssx)
kqpssx = (kpssx*2*pi/lupssx/sqrt(2)/gamu)^2 !m^-2

pssxh: taylor, type = "PSSXh", l = lpssxh, {1: 1.0, 1 0 0 0 0 0}, {1: lpssxh, 0 1 0 0 0 0}, {2:  &
        0.0, 1 0 0 0 0 0}, {2: 1.0, 0 1 0 0 0 0}, {3: cos(lpssxh*sqrt(kqpssx)), 0 0 1 0 0 0}, {3 &
        : sin(lpssxh*sqrt(kqpssx))/sqrt(kqpssx), 0 0 0 1 0 0}, {4:  &
        -sin(lpssxh*sqrt(kqpssx))*sqrt(kqpssx), 0 0 1 0 0 0}, {4: cos(lpssxh*sqrt(kqpssx)),  &
        0 0 0 1 0 0}, {5: 1.0, 0 0 0 0 1 0}, {6: 1.0, 0 0 0 0 0 1}

! ------------------------------------------------------------------------------
! SXR drifts
! ------------------------------------------------------------------------------

ldusegs = 3.4
ldu1s = 0.1
ldu2s = 0.03
ldu3s = 0.25-lpssxh-0.04-0.005
ldu4s = (0.25-lpssxh-0.5*lqu)/2+0.04+0.005
ldu5s = (0.25-lpssxh-0.5*lqu)/2
ldu6s = 0.12-lqu/2-lrfbub/2+0.01
ldu7s = 0.25-lrfbub/2-0.01
dldu0s = 0.0 !fine tune Z in undulator
ldu0s = 2.1359-ldu6s-ldu7s-lqu+dldu0s

du0s: drift, l = ldu0s
du1s: drift, l = ldu1s
du2s: drift, l = ldu2s
du3s: drift, l = ldu3s
du4s: drift, l = ldu4s
du5s: drift, l = ldu5s
du6s: drift, l = ldu6s
du7s: drift, l = ldu7s

due1ab: drift, l = 0.9-lrfbub-0.057
due1e: drift, l = 0.057

! ------------------------------------------------------------------------------
! SXR extension quads
! ------------------------------------------------------------------------------

! note: the below K-values are for SC beam; the settings for Cu beam are
! in the "LCLS2cu_main.mad8" file

kqsx16 = 0.589502458599 ! 0.584170476419
kqsx19 = -0.91531741252  !-0.916029555737
kqsx21 = 1.109876931688 ! 1.112214118849
kqsx24 = -1.085714742294 !-1.119664961437

qsxh16: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqsx16
qsxh19: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqsx19
qsxh21: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqsx21
qsxh24: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqsx24

! ------------------------------------------------------------------------------
! SXR extension X-steering coils in quads
! ------------------------------------------------------------------------------

xcsx16: kicker, type = "type-U"
xcsx19: kicker, type = "type-U"
xcsx21: kicker, type = "type-U"
xcsx24: kicker, type = "type-U"

! ------------------------------------------------------------------------------
! SXR extension Y-steering coils in quads
! ------------------------------------------------------------------------------

ycsx16: kicker, type = "type-U"
ycsx19: kicker, type = "type-U"
ycsx21: kicker, type = "type-U"
ycsx24: kicker, type = "type-U"

! ------------------------------------------------------------------------------
! SXR extension BPMs
! ------------------------------------------------------------------------------

rfbsx16: instrument, l = lrfbub, type = "CavityX-1"
drfbs17: drift, l = lrfbub
drfbs18: drift, l = lrfbub
rfbsx19: instrument, l = lrfbub, type = "CavityX-1"
drfbs20: drift, l = lrfbub
rfbsx21: instrument, l = lrfbub, type = "CavityX-1"
drfbs22: drift, l = lrfbub
drfbs23: drift, l = lrfbub
rfbsx24: instrument, l = lrfbub, type = "CavityX-1"
rfbsx25: instrument, l = lrfbub, type = "CavityX-1"

sxxstart: marker !start of soft X-ray extension system
sxxterm: marker !end of soft X-ray extension system
sxrstart: marker !start of undulator system
sxrterm: marker !~end of undulator system
muqs: marker
mphs: marker

qsxblk16: line = (qsxh16, xcsx16, ycsx16, qsxh16)
dqsxbl17: drift, l = lqu
dqsxbl18: drift, l = lqu
qsxblk19: line = (qsxh19, xcsx19, ycsx19, qsxh19)
dqsxbl20: drift, l = lqu
qsxblk21: line = (qsxh21, xcsx21, ycsx21, qsxh21)
dqsxbl22: drift, l = lqu
dqsxbl23: drift, l = lqu
qsxblk24: line = (qsxh24, xcsx24, ycsx24, qsxh24)
dqsxbl25: drift, l = lqu

dphss17: drift, l = lpssx
dphss18: drift, l = lpssx
dphss19: drift, l = lpssx
dphss20: drift, l = lpssx
dphss21: drift, l = lpssx
dphss22: drift, l = lpssx
dphss23: drift, l = lpssx
dphss24: drift, l = lpssx
dphss25: drift, l = lpssx

sxbrk17: line = (du3s, dphss17, du4s, du5s, dqsxbl17, du6s, drfbs17, du7s)
sxbrk18: line = (du3s, dphss18, du4s, du5s, dqsxbl18, du6s, drfbs18, du7s)
sxbrk19: line = (du3s, dphss19, du4s, du5s, qsxblk19, du6s, rfbsx19, du7s)
sxbrk20: line = (du3s, dphss20, du4s, du5s, dqsxbl20, du6s, drfbs20, du7s)
sxbrk21: line = (du3s, dphss21, du4s, du5s, qsxblk21, du6s, rfbsx21, du7s)
sxbrk22: line = (du3s, dphss22, du4s, du5s, dqsxbl22, du6s, drfbs22, du7s)
sxbrk23: line = (du3s, dphss23, du4s, du5s, dqsxbl23, du6s, drfbs23, du7s)
sxbrk24: line = (du3s, dphss24, du4s, du5s, qsxblk24, du6s, rfbsx24, du7s)
sxbrk25: line = (du3s, dphss25, du4s, du5s, dqsxbl25, du6s, rfbsx25, du7s)

dusegs17: drift, l = ldusegs
dusegs18: drift, l = ldusegs
dusegs19: drift, l = ldusegs
dusegs20: drift, l = ldusegs
dusegs21: drift, l = ldusegs
dusegs22: drift, l = ldusegs
dusegs23: drift, l = ldusegs
dusegs24: drift, l = ldusegs
dusegs25: drift, l = ldusegs

sxcel17: line = (du1s, du2s, dusegs17, sxbrk17)
sxcel18: line = (du1s, du2s, dusegs18, sxbrk18)
sxcel19: line = (du1s, du2s, dusegs19, sxbrk19) !Q+RFBPM
sxcel20: line = (du1s, du2s, dusegs20, sxbrk20)
sxcel21: line = (du1s, du2s, dusegs21, sxbrk21) !Q+RFBPM
sxcel22: line = (du1s, du2s, dusegs22, sxbrk22)
sxcel23: line = (du1s, du2s, dusegs23, sxbrk23)
sxcel24: line = (du1s, du2s, dusegs24, sxbrk24) !Q+RFBPM
sxcel25: line = (du1s, du2s, dusegs25, sxbrk25) !RFBPM

sxrxx: line = (begunds, sxxstart, du0s, qsxblk16, du6s, rfbsx16, du7s, sxcel17, sxcel18, sxcel19 &
        , sxcel20, sxcel21, sxcel22, sxcel23, sxcel24, sxcel25, sxxterm)

! ------------------------------------------------------------------------------
! SXR undulator
! ------------------------------------------------------------------------------
! - Author: Heinz-Dieter Nuhn, Stanford Linear Accelerator Center
! - Last edited Mar 03, 2014
! - 7.2 mm miminum Undulator Gap; only constant break length each
! - include natural vertical focusing over all but edge terminations
! ------------------------------------------------------------------------------
! - IntgSX  = integrated quadrupole gradient
! - GQFSX   = QF and QD gradients can be made different to compensate for
!             undulator focussing ...
! - GQDSX   = ... but since undulator focussing depends on gamma^2, compensation
!             will only work for one energy
! - kQFSX   = QF undulator quadrupole focusing "k"
! - kQDSX   = QD undulator quadrupole focusing "k"
! - LDUSEGS = SXR Undulator segment length
! - luSXU   = SXR Undulator period
! - NpSXU   = SXR Undulator period count
! - LSXUCR  = SXR Undulator magnetic length
! - LSXUe   = SXR Undulator spacing between magnet array and strongback end
! - KSXU    = SXR Undulator parameter (rms); range 2-5.5
! - kQSX    = natural SXR undulator focusing "k" in y-plane
! ------------------------------------------------------------------------------

 !IntgSX :   definition moved to LCLS2sc_main.xsif and LCLS2cu_main.xsif
gqfsx = intgsx/lqu/10*1.0           !T/m
gqdsx = -intgsx/lqu/10*1.0           !T/m
kqfsx = 1.e-9*gqfsx*c_light/gamu/mc2 !m^-2
kqdsx = 1.e-9*gqdsx*c_light/gamu/mc2 !m^-2
kqdsxm = -0.266792876891 !-0.406434161462

qsxh26: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh27: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh28: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh29: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh30: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh31: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh32: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh33: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh34: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh35: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh36: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh37: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh38: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh39: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh40: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh41: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh42: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh43: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh44: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh45: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsx
qsxh46: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqfsx
qsxh47: quadrupole, type = "0.433Q3.1", l = lqu/2, aperture = rqu, k1 = kqdsxm

lusxu = 0.039                            !m
npsxu = 87
lsxucr = lusxu*npsxu                      !m
lsxue = (ldusegs-lsxucr)/2               !m
lsxuh = lsxucr/2
ksxu = 5.0
kqsx = (ksxu*2*pi/lusxu/sqrt(2)/gamu)^2 !m^-2

umasxh: taylor, type = "UMASXh", l = lsxuh, {1: 1.0, 1 0 0 0 0 0}, {1: lsxuh, 0 1 0 0 0 0}, {2:  &
        0.0, 1 0 0 0 0 0}, {2: 1.0, 0 1 0 0 0 0}, {3: cos(lsxuh*sqrt(kqsx)), 0 0 1 0 0 0}, {3:  &
        sin(lsxuh*sqrt(kqsx))/sqrt(kqsx), 0 0 0 1 0 0}, {4: -sin(lsxuh*sqrt(kqsx))*sqrt(kqsx),  &
        0 0 1 0 0 0}, {4: cos(lsxuh*sqrt(kqsx)), 0 0 0 1 0 0}, {5: 1.0, 0 0 0 0 1 0}, {6: 1.0,  &
        0 0 0 0 0 1}

umasxh26: umasxh
umasxh27: umasxh
umasxh28: umasxh
umasxh29: umasxh
umasxh30: umasxh
umasxh31: umasxh
umasxh32: umasxh
