sxbrk50: line = (du3s, dphss50, du4s, du5s, dqsxbl50, du6s, drfbs50, du7s)

sxcel26: line = (du1s, blms26, du2s, usegsx26, sxbrk26)
sxcel27: line = (du1s, blms27, du2s, usegsx27, sxbrk27)
