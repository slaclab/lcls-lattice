beginning[beta_a] = 10
beginning[beta_b] = 10

beginning[e_tot] = 100e6

parameter[geometry] = open
parameter[particle] = electron

call, file = $LCLS_LATTICE/bmad/master/SC_HXR.bmad
call, file = $LCLS_LATTICE/bmad/master/LCLSsc_devicenames.bmad

call, file = $LCLS_LATTICE/bmad/overlays/sc/linac_overlays.bmad
call, file = $LCLS_LATTICE/bmad/overlays/sc/bc1_overlays.bmad
call, file = $LCLS_LATTICE/bmad/overlays/sc/bc2_overlays.bmad


! Get energy exactly right
CAVL018[PHI0] =  1.50741452922019872E-002

! HTR
Q0H01[K1] = -6.65641848652943224E+000
Q0H02[K1] =  6.08012422910999906E+000
Q0H03[K1] =  2.98119000854135452E+000
Q0H04[K1] = -4.74595035544890376E+000
Q0H05[K1] = -7.65429764951783920E+000
Q0H06[K1] =  5.93142695356314920E-001

! ENDCOL1
QC101[K1] = -4.73008996457401854E-001
QC102[K1] =  1.60133750252843576E+000
QC103[K1] =  7.26504796724172675E-001
QC104[K1] = -1.53921299074001294E+000

! ENDEMIT2
QE201[K1] = -1.30702934145070326E+000
QE202[K1] =  2.01521810176581839E+000
QE203[K1] = -1.78329347882542799E+000
QE204[K1] =  1.62865943707179994E+000


!!!lcavity::*[ds_step] = .01
sbend::*[fringe_type] = full


! Cavity wakefields
lcavity::CAVL*[sr_wake]  = call::$LCLS_LATTICE/bmad/wakefields/longitudinal_wakes_1300MHz.bmad
lcavity::CAVC*[sr_wake]  = call::$LCLS_LATTICE/bmad/wakefields/longitudinal_wakes_3900MHz.bmad

RWWAKE1[sr_wake] = call::$LCLS_LATTICE/bmad/wakefields/wakefield_SS_24.5mmR.bmad
RWWAKE1[sr_wake%scale_with_length] = F
RWWAKE1[sr_wake%amp_scale] = 105.6


RWWAKE2[sr_wake] = call::$LCLS_LATTICE/bmad/wakefields/wakefield_SS_24.5mmR.bmad
RWWAKE2[sr_wake%scale_with_length] = F
RWWAKE2[sr_wake%amp_scale] = 2035.2

! HXR only

RWWAKE3H[sr_wake] = call::$LCLS_LATTICE/bmad/wakefields/wakefield_SS_24.5mmR.bmad
RWWAKE3H[sr_wake%scale_with_length] = F
RWWAKE3H[sr_wake%amp_scale] = 443.8


RWWAKE4H[sr_wake] = call::$LCLS_LATTICE/bmad/wakefields/wakefield_Cu_17.4mmR.bmad
RWWAKE4H[sr_wake%scale_with_length] = F
RWWAKE4H[sr_wake%amp_scale] = 339.1

RWWAKE5H[sr_wake] = call::$LCLS_LATTICE/bmad/wakefields/wakefield_Al_5mm_gap_flat.bmad
RWWAKE5H[sr_wake%scale_with_length] = F
RWWAKE5H[sr_wake%amp_scale] = 130


lat2: line = (LCLS2scI, lcls2scc)
lat3: line = (LCLS2scI, lcls2scc, LCLS2scS)
!use, lat3


use, SC_HXR
call, file = beginning_BEGGUNB.bmad

!call, file = beginning_BEAM0.bmad
!use, SC_HXRi
