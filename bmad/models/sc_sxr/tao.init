&tao_d2_data
        d2_data%name = 'r56'
        universe = 1
        n_d1_data = 1
/    
&tao_d1_data
        ix_d1_data = 1
        default_weight = 1
        d1_data%name = 'endtwiss'
        datum( 1) =  'r56_compaction'     'BEGHTR' '' 'ENDHTR' 
        datum( 2) =  'r56_compaction'     'BEGBC1B' '' 'ENDBC1B' 
        datum( 3) =  'r56_compaction'     'BEGBC2B' '' 'ENDBC2B'   
/



!-------- Orbit x, y------------
&tao_d2_data
  d2_data%name = 'orbit'
    universe = '*'
  n_d1_data = 2
  default_merit_type = "target"
/
&tao_d1_data
  ix_d1_data = 1
  d1_data%name = 'x'
  default_data_type = 'bpm_orbit.x'
  default_weight = 1e10
  search_for_lat_eles = "-no_lords *BPM*"
/
&tao_d1_data
  ix_d1_data = 2
  d1_data%name = 'y'
  default_data_type = 'bpm_orbit.y'
  default_weight = 1e10
  search_for_lat_eles = "-no_lords *BPM*"
/
!&tao_d1_data
  ix_d1_data = 3
  d1_data%name = 'unstable'
  ix_min_data=1
  datum( 1) = "unstable_orbit", "", "",  "", "target", 0, 1e6,  F
/


!-------- Extra Orbit x, y------------
&tao_d2_data
  d2_data%name = 'extra_orbit'
        universe = 1
  n_d1_data = 3
  default_merit_type = "target"
/
&tao_d1_data
  ix_d1_data = 1
  d1_data%name = 'x'
  default_data_type = 'bpm_orbit.x'
  default_weight = 1e10
  ix_min_data = 1
  datum(1:)%ele_name = "BEGSPS"
/
&tao_d1_data
  ix_d1_data = 2
  d1_data%name = 'y'
  default_data_type = 'bpm_orbit.y'
  default_weight = 1e10
  use_same_lat_eles_as = 'extra_orbit.x'
/
&tao_d1_data
  ix_d1_data = 3
  d1_data%name = 'e_tot'
  default_data_type = 'orbit.e_tot'
  default_weight = 0
  use_same_lat_eles_as = 'extra_orbit.x'
/

!-----------------------------------------------------------------------------------------
!-----------------------------------------------------------------------------------------

&tao_var
	v1_var%name = 'begtwiss'
	default_step = 1e-4
	default_universe = '1'
	ix_min_var = 1
	ix_max_var = 6
	var(1:6)%ele_name  = 'beginning', 'beginning', 'beginning', 'beginning', 'beginning', 'beginning'
    var(1:6)%attribute = 'beta_a', 'alpha_a', 'beta_b', 'alpha_b', 'eta_x', 'etap_x'
    var(1)%low_lim = 0.01
    var(3)%low_lim = 0.01
/



!&tao_var
    v1_var%name = 'L0'
	default_step = 1e-4
	default_attribute = 'x'
	var(1:)%ele_name = 'O_L0'
/

&tao_var
    v1_var%name = 'q.L1'
	default_step = 1e-4
	default_attribute = 'K1'
	var(1:)%ele_name = 'QC010', 'QC011','QC012', 'QCM02', 'QCM03'
/


&tao_var
    v1_var%name = 'q.L2'
	default_step = 1e-4
	default_attribute = 'K1'
	var(1:)%ele_name = 'QCM04', 'QCM08', 'QCM11', 'QCM15'
/

&tao_var
    v1_var%name = 'q.L3'
	default_step = 1e-4
	default_attribute = 'K1'
	var(1:)%ele_name = 'QCM16', 'QCM22', 'QCM29', 'QCM35'
/


!--- Correctors
&tao_var
    v1_var%name = "correctors.x"
  default_universe = '1'
  default_attribute = "HKICK"
  default_weight = 1e9
  default_low_lim  = -0.01
  default_high_lim = 0.01
  default_step = 1e-10
  ix_min_var = 1
  search_for_lat_eles = "kicker::X*"
/
&tao_var
    v1_var%name = "correctors.y"
  default_universe = '1'
  default_attribute = "VKICK"
  default_weight = 1e9
  default_low_lim  = -0.01
  default_high_lim = 0.01
  default_step = 1e-10
  ix_min_var = 1
  search_for_lat_eles = "kicker::Y*"
/


