beginning[beta_a] = 10
beginning[beta_b] = 10

beginning[e_tot] = 100e6

parameter[geometry] = open
parameter[particle] = electron

call, file = $LCLS_LATTICE/bmad/master/SC_HXR.bmad
call, file = $LCLS_LATTICE/bmad/master/LCLSsc_devicenames.bmad



! Get energy exactly right
CAVL018[PHI0] =  1.50741452922019872E-002
! HTR
Q0H01[K1] = -6.59594959029043615E+000
Q0H02[K1] =  5.95698223659817216E+000
Q0H03[K1] =  3.68223868480968974E+000
Q0H04[K1] = -5.76128782527751859E+000
Q0H05[K1] = -6.97516196179434989E+000
Q0H06[K1] =  2.57981867509443685E-001



! WOODDOOR should be at:
! X Y Z =  -0.650494      0.649478   3050.512000


lcavity::*[ds_step] = .01
sbend::*[fringe_type] = full

RWWAKE1[sr_wake] = call::$LCLS_LATTICE/bmad/wakefields/wakefield_SS_24.5mmR.bmad
RWWAKE1[sr_wake%scale_with_length] = F
RWWAKE1[sr_wake%amp_scale] = 105.6


RWWAKE2[sr_wake] = call::$LCLS_LATTICE/bmad/wakefields/wakefield_SS_24.5mmR.bmad
RWWAKE2[sr_wake%scale_with_length] = F
RWWAKE2[sr_wake%amp_scale] = 2035.2

RWWAKE3S[sr_wake] = call::$LCLS_LATTICE/bmad/wakefields/wakefield_SS_24.5mmR.bmad
RWWAKE3S[sr_wake%scale_with_length] = F
RWWAKE3S[sr_wake%amp_scale] = 443.8

RWWAKE4S[sr_wake] = call::$LCLS_LATTICE/bmad/wakefields/wakefield_SS_24.5mmR.bmad
RWWAKE4S[sr_wake%scale_with_length] = F
RWWAKE4S[sr_wake%amp_scale] = 341.8

RWWAKE5S[sr_wake] = call::$LCLS_LATTICE/bmad/wakefields/wakefield_Al_5mm_gap_flat.bmad
RWWAKE5S[sr_wake%scale_with_length] = F
RWWAKE5S[sr_wake%amp_scale] = 100


call, file = beginning_BEGGUNB.bmad
use, sc_diag0
