
parameter[custom_attribute1] = taylor::mat_und_k
parameter[custom_attribute2] = taylor::mat_und_l

call, file = hxr.lat.bmad

lat2: line = (hxcel13, hxcel14)
parameter[geometry] = closed


QHX13[B1_GRADIENT] = -3/QHX13[L]
QHX14[B1_GRADIENT] =  3/QHX13[L]

!Mar.MATCH: marker, superimpose, ref = QHX13

wiggler::*[field_master] = T
use, lat2






lcavity::*[n_rf_steps]=0
