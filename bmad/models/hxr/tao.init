&tao_start
  n_universes = 1
  plot_file   ='$LCLS2_LATTICE/bmad/tao/tao_plot.init '
  startup_file='$LCLS2_LATTICE/bmad/tao/tao.startup'
/




!--------------------------------------------------------
&tao_design_lattice
  !unique_name_suffix="*::_##?"
 design_lattice(1)%file= 'hxr.lat.bmad'
! design_lattice(1)%file= 'hxr_2cells.lat.bmad'
!  combine_consecutive_elements_of_like_name = T
/

!------------------------------------------------------------------------
&tao_params
  !global%plot_on = T
  global%track_type = 'single'
  global%beam_timer_on = T
  global%random_engine = 'pseudo' ! or: 'quasi'
  global%de_lm_step_ratio = 1500
  global%optimizer = 'lmdif'
  global%n_opti_cycles = 100
  !---Bmad---
  bmad_com%radiation_damping_on = F
  bmad_com%radiation_fluctuations_on = T
/


!&tao_beam_init
beam_init%random_engine = 'quasi'
ix_universe = 1
beam_saved_at =  "MARKER::*"
track_start = 'OTR2'
beam_init%position_file = '$LCLS2_LATTICE/bmad/beams/OTR2_250pC_rescaleto540um_solGTF1M_flat_scattered_20keV_100k.beam0'
beam_init%center(1) = 0.0
beam_init%center(2) = 0.0
beam_init%center(3) = 0.0
beam_init%center(4) = 0.0
beam_init%center(5) = 0.0
beam_init%center(6) = 0.0

/


&tao_d2_data
        d2_data%name = 'umatch'
        universe = 1
        n_d1_data = 3
/

&tao_d1_data
        ix_d1_data = 1
        default_weight = 1
        d1_data%name = 'begtwiss'
        datum( 1) =  'beta.a'     '' '' 'Mar.MATCH'   'target' 13.186701148311 1e1   ! Taken from lcls_end_L0a_nominal.beam0
        datum( 2) =  'alpha.a'    '' '' 'Mar.MATCH'   'target'  0.0016579122608167     1e2
        datum( 3) =  'beta.b'     '' '' 'L0BBEG'   'target' 3.3803893850006    1e1
        datum( 4) =  'alpha.b'    '' '' 'Mar.MATCH'   'target'  -7.4311987406928e-06      1e2
        datum( 5) =  'eta.x'      '' '' 'Mar.MATCH'   'target' 0      1e1
        datum( 6) =  'etap.x'     '' '' 'Mar.MATCH'   'target' 0      1e2
/  
&tao_d1_data
        ix_d1_data = 2
        default_weight = 1
        d1_data%name = 'maxs'
        datum( 1) =  'beta.a'     '' 'QHX13' 'QHX45'   'max' 20 1e1   
        datum( 2) =  'beta.b'     '' 'QHX14' 'QHX46'   'max' 20 1e1   
/
&tao_d1_data
        ix_d1_data = 3
        default_weight = 1e5
        d1_data%name = 'average'
        !datum( 1)%data_type = 'expression: ele::QHX*[beta_a]'  
        !datum( 1)%meas = 0
        !datum( 1)%merit_type = 'average'
        datum( 1) =  'beta.a'     '' 'QHX13' 'QHX45'   'average' 20 1e1   
        datum( 2) =  'beta.b'     '' 'QHX13' 'QHX45'   'average' 20 1e1   

/




