




apex_gun: e_gun, 
   L = 0.175,
   tracking_method = time_runge_kutta,  mat6_calc_method = tracking, 
   rf_frequency = 1300e6/7, 
   field_calc = fieldmap, 
   grid_field = call::$LCLS_LATTICE/bmad/fieldmaps/apex_gun/apex_gun_fieldmesh.h5,
   aperture_at = continuous, aperture_type=wall3d,
   wall = {section={s=0, v(1) = {0, 0, 0.015}}, section={s=0.175, v(1)={0, 0, 0.015}} }

! apex_gun[voltage] = 750e3
apex_gun[FIELD_AUTOSCALE] = 20e6
apex_gun[PHI0_AUTOSCALE] = 0.22007420312842 ! Help out the parser


apex_buncher_1300MHz: lcavity, 
    L = 0.3,
    voltage = 1e6,
    tracking_method = runge_kutta, 
    mat6_calc_method = tracking,  
    n_cell = 2, longitudinal = 0, 
    rf_frequency = 1300000000.0, 
    field_calc = fieldmap, 
    aperture_at = continuous, aperture_type=wall3d,
    grid_field = call::$LCLS_LATTICE/bmad/fieldmaps/apex_buncher/apex_buncher_1300MHz_center.h5,
    wall = {section = { s = 0.0, v(1) = {0.0, 0.0, 0.025} },
            section = { s = 0.3, v(1) = {0.0, 0.0, 0.025} } }
    
lcls2_solenoid: solenoid, 
   L =  0.48,
   bs_field = 0.06, ! T
   tracking_method = runge_kutta,  mat6_calc_method = tracking, 
   field_calc = fieldmap, 
   grid_field = call::$LCLS_LATTICE/bmad/fieldmaps/lcls2_solenoid/lcls2_solenoid_fieldmesh.h5    
    


cavity9_1300MHz: lcavity, 
    L = 1.3,
    voltage = 1e6,
    tracking_method = runge_kutta, 
    mat6_calc_method = tracking,  n_cell = 9, longitudinal = 0, 
    rf_frequency = 1300000000.0, 
    field_calc = fieldmap, 
    aperture_at = continuous, aperture_type=wall3d,
    !grid_field = call::$LCLS_LATTICE/bmad/fieldmaps/cavity9/cavity9_1300MHz_center.h5,
    grid_field = call::$LCLS_LATTICE/bmad/fieldmaps/cavity9/cavity9_1300MHz_full.h5,    
    wall = call::$LCLS_LATTICE/bmad/fieldmaps/cavity9/cavity9_1300MHz_full_wall.bmad






