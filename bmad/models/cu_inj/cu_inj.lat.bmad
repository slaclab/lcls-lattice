
parameter[custom_attribute1] = taylor::mat_und_k
parameter[custom_attribute2] = taylor::mat_und_l

! Makes L0BBEG correct
BEGINNING[BETA_A] =   1.51417606703273E+00
BEGINNING[ALPHA_A] =  -1.60406910641986E-01
BEGINNING[BETA_B] =   1.53986428507105E+00
BEGINNING[ALPHA_B] =  -1.63793752798038E-01


beginning[e_tot] = 6e6
parameter[geometry] = open
parameter[particle] = electron

! WOODDOOR should be at:
! X Y Z =  0 0  3050.512000

beginning[theta_position] = -35*pi/180
beginning[z_position] = 3050.512000 - 1032.60052
beginning[x_position] = 10.44893

call, file = $LCLS_LATTICE/bmad/master/CU_HXR.bmad
call, file = $LCLS_LATTICE/bmad/master/LCLScu_devicenames.bmad

! Add fieldmap elements
call, file = $LCLS_LATTICE/bmad/fieldmaps/lcls_gun/lcls_gun.bmad
call, file = $LCLS_LATTICE/bmad/fieldmaps/lcls_gun_solenoid/lcls_gun_solenoid.bmad
!lcls_gun: e_gun, L = 0.135

beginning[p0c] = 0
RFGUN: lcls_gun
SOL1a: lcls_gun_solenoid

!SOL1a[L] = 0.196010*2
SOL1a[L] = 0.19*2
SOL1a[superimpose] = T
SOL1a[ref_origin] = beginning
SOL1a[ele_origin] = center
SOL1a[ref] = BEGGUN
SOL1a[offset] = 0.196010
SOL1a[bs_field] = 0.25

! Cavity wakefields, traveling wave, full sbend


! Matches Impact

QA01[k1] = -8.6773946E+00
QA02[k1] =  8.6773946E+00

QE01[k1] = -4.1571519E-01
QE02[k1] = -3.6885840E-01
QE03[k1] = 5.8646487E+00
QE04[k1] = -6.6176883E+00


lcavity::L0*[sr_wake]  = call::$LCLS_LATTICE/bmad/wakefields/longitudinal_wakes_sband.bmad
lcavity::*[cavity_type] = traveling_wave
sbend::*[fringe_type] = full


XGUNBXG : LINE=(
 !DL00,LOADLOCK,
 !BEGGUN,SOL1BK,DBMARK80,CATHODE,
 DL01a,SOL1_full,DL01a1,VV01,DL01a2,AM00,DL01a3,AM01,
         DL01a4,YAG01,DL01a5,FC01,DL01b,IM01,DL01c,SC1,DL01h,BPM2,DL01d,DBMARK81,ENDGUN)
 


 

use, cu_spec !start at gun
use, XGUNBXG

D000: drift, L = 0.9778443 - RFGUN[L]

GUNA: line = (BEGGUN, RFGUN, d000, ENDGUN)

lat: line = (GUNA, BXGL0a, L0aL0b, DL1_1)

!call, File = markers.bmad

use, lat

lcavity::*[n_rf_steps]=0
