!-----------------------------------------------------------------------------------------

&tao_var
    v1_var%name = 'begtwiss'
    default_step = 1e-4
    default_universe = '1'
    ix_min_var = 1
    ix_max_var = 6
    var(1:6)%ele_name  = 'beginning', 'beginning', 'beginning', 'beginning', 'beginning', 'beginning'
    var(1:6)%attribute = 'beta_a', 'alpha_a', 'beta_b', 'alpha_b', 'eta_x', 'etap_x'
    var(1)%low_lim = 0.01
    var(3)%low_lim = 0.01
/

&tao_var
    v1_var%name = 'q_L2'
	default_step = 1e-4
	default_attribute = 'K1'
	var(1:)%ele_name = 'QCM04', 'QCM08', 'QCM11', 'QCM15'
/

&tao_var
    v1_var%name = 'q_L3'
	default_step = 1e-4
	default_attribute = 'K1'
	var(1:)%ele_name = 'QCM17', 'QCM22', 'QCM29', 'QCM35'
/



&tao_var
    v1_var%name = 'linac_phase'
	default_step = 0.1
	default_attribute = 'phase_deg'
	var(1:)%ele_name = 'SC_L1', 'SC_L1H', 'SC_L2', 'SC_L3'
/

&tao_var
    v1_var%name = 'q_COL1'
	default_step = 1e-4
	default_attribute = 'K1'
	var(1:)%ele_name = 'QC101', 'QC102', 'QC103', 'QC104'
/

&tao_var
    v1_var%name = 'q_EMIT2'
	default_step = 1e-4
	default_attribute = 'K1'
	var(1:)%ele_name = 'QE201', 'QE202', 'QE203', 'QE204'
/


&tao_var
    v1_var%name = 'bc1'
    default_step = 0.01
    default_attribute = 'angle_deg'
    var(1:)%low_lim = -8.35
    var(1:)%high_lim = 0
    var(1:)%ele_name = 'SC_BC1'
/

&tao_var
    v1_var%name = 'bc2'
    default_step = 0.01
    default_attribute = 'angle_deg'
    var(1:)%low_lim =  0 
    var(1:)%high_lim =  9.1
    var(1:)%ele_name = 'SC_BC2'
/


