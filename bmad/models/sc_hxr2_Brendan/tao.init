&tao_start
  n_universes = 1
  plot_file   ='tao_plot.init'
  startup_file='tao.startup'
/

!--------------------------------------------------------
&tao_design_lattice
  !unique_name_suffix="*::_##?"
  design_lattice(1)%file='sc_hxr2.lat.bmad'
  design_lattice(1)%slice_lattice = "OTRC006:HXRSTART"
/

!------------------------------------------------------------------------
&tao_params
  global%plot_on = T
  global%track_type = 'beam'
  global%beam_timer_on = T
  global%random_engine = 'pseudo' ! or: 'quasi'
  global%de_lm_step_ratio = 1500
  global%optimizer = 'lmdif'
  global%n_opti_cycles = 100
  !---Bmad---
  bmad_com%radiation_damping_on = F
  bmad_com%radiation_fluctuations_on = T
/


&tao_beam_init
ix_universe = 1
!saved_at =  "MARKER::*"
track_start = 'OTRC006'
track_end = 'HXRSTART'
beam_init%n_particle = 1000
beam_init%random_engine = 'quasi' ! or 'pseudo'
beam_init%bunch_charge = 300.0e-12
beam_init%a_norm_emit = 1.5e-6
beam_init%b_norm_emit = 1.5e-6
beam_init%n_bunch = 1
beam_init%sig_pz = 1e-3
beam_init%sig_z = 0.8e-3
/

!---------------------------------------------------------------------------------------
! BC1

&tao_d2_data
        d2_data%name = 'BC1'
        universe = 1
        n_d1_data = 2
/
&tao_d1_data
        ix_d1_data = 1
        default_weight = 1
        d1_data%name = 'begtwiss'
        datum( 1) =  'beta.a'     '' '' 'BEGBC1B'   'target'  3.870395077E+01   1e1
        datum( 2) =  'alpha.a'    '' '' 'BEGBC1B'   'target'  4.476022866E-01  1e2
        datum( 3) =  'beta.b'     '' '' 'BEGBC1B'   'target'  3.109163641E+01     1e1
        datum( 4) =  'alpha.b'    '' '' 'BEGBC1B'   'target'  -7.975687433E-01  1e2
        datum( 5) =  'eta.x'      '' '' 'BEGBC1B'   'target'   0  1e1
        datum( 6) =  'etap.x'     '' '' 'BEGBC1B'   'target'   0   1e2
/  

&tao_d1_data
        ix_d1_data = 2
        default_weight = 1
        d1_data%name = 'r56'
        datum( 1) =  'r56_compaction'     'BEGBC1B' '' 'ENDBC1B'  'target' 45e-3  1e1
/


