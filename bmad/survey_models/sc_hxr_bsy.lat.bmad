!
! sc_hxr
! BSY coordinates
!
no_digested

parameter[custom_attribute1] = taylor::mat_und_k
parameter[custom_attribute2] = taylor::mat_und_l

call, file = $LCLS_LATTICE/bmad/master/SC_HXR.bmad
call, file = $LCLS_LATTICE/bmad/master/sc/beginning_sc_bsy.bmad

use, BSYLCLS2scH

lcavity::*[n_rf_steps]=100
bun1b[n_rf_steps]=1000
cavl01*[n_rf_steps]=1000
cavl*[n_cell]=9
cavc*[n_cell]=9
