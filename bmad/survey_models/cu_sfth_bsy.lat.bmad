! 
! cu_sxr
! BSY coordinates
!
no_digested

parameter[custom_attribute1] = taylor::mat_und_k
parameter[custom_attribute2] = taylor::mat_und_l

call, file = $LCLS_LATTICE/bmad/master/CU_SFTH.bmad
call, file = $LCLS_LATTICE/bmad/master/cu/beginning_cu_bsy.bmad

use, BSYLTUHS

lcavity::*[cavity_type] = traveling_wave

call, file = $LCLS_LATTICE/bmad/master/CuS_SC_QUADS.bmad
!QBP33[k1] = kqbp33
!QBP34[k1] = kqbp34
!QDBL1[k1] = kqdbl1
!QDBL2[k1] = kqdbl2
!QDL11[k1] = kqdl11
!QUM1B[k1] = kqum1b
!QUM2B[k1] = kqum2b
!QUM3B[k1] = kqum3b
!QUM4B[k1] = kqum4b
!QSXH16[k1] = kqsx16
!QSXH47[k1] = kqsx47
!QUE1B[k1] = kque1b
!QUE2B[k1] = kque2b
!QDMP1B[k1] = kqdmpb
!QDMP2B[k1] = kqdmpb

lcavity::*[n_rf_steps]=1000
l0a[n_rf_steps] = 50000
l0b[n_rf_steps] = 50000
