! LCLS BC1 overlays

!
! Max horizontal offset: 300 mm
! Min horizontal offset: -10 mm
!  




bc1_theta_default = AB11! Same as AB11 = -0.093583513589    !full chicane bend angle (rad)
bc1_Lp_default = 0.2032
bc1_Lp_drift_default = 2.4349 
bc1_offset_default = 2.47542378E-01

 
 
! Overlays for rectangular bends
!
! Lp : total projected length of the bend
! theta: total angle in radian


O_BX11: overlay = {
  BX11[g]:sin(theta)/Lp, 
  BX11[L]:Lp*theta/sin(theta),
  BX11[e2]:theta}, 
  var = {Lp, theta},
  theta = bc1_theta_default,
  Lp = bc1_Lp_default

O_BX12: overlay = {
  BX12[g]:sin(theta)/Lp, 
  BX12[L]:Lp*theta/sin(theta),
  BX12[e1]:theta}, 
  var = {Lp, theta},
  theta = -bc1_theta_default,
  Lp = bc1_Lp_default

O_BX13: overlay = {
  BX13[g]:sin(theta)/Lp, 
  BX13[L]:Lp*theta/sin(theta),
  BX13[e2]:theta}, 
  var = {Lp, theta},
  theta = -bc1_theta_default,
  Lp = bc1_Lp_default

O_BX14: overlay = {
  BX14[g]:sin(theta)/Lp, 
  BX14[L]:Lp*theta/sin(theta),
  BX14[e1]:theta}, 
  var = {Lp, theta},
  theta = bc1_theta_default,
  Lp = bc1_Lp_default

! Overall BC2 angle
! Lp_drift is the total projected length of the drift between the first and second bends
O_BC1: overlay={
  O_BX11[theta]:angle_deg*pi/180, 
  O_BX12[theta]:-angle_deg*pi/180, 
  O_BX13[theta]:-angle_deg*pi/180, 
  O_BX14[theta]:angle_deg*pi/180,
  D11o[L]:D11o[L] + Lp_drift*(1/cos(angle_deg*pi/180)-1/cos(bc1_theta_default)),
  D11oA[L]:D11oA[L] + Lp_drift*(1/cos(angle_deg*pi/180)-1/cos(bc1_theta_default))},
  var = {angle_deg, Lp_drift}, 
  angle_deg = bc1_theta_default*180/pi,
  Lp_drift=bc1_Lp_drift_default
  

! Automatically generated interpolation points using:
! $LCLS_LATTICE/bmad/overlays/cu/source/bunch_compressors.ipynb
O_BC1_offset: overlay = {O_BC1[angle_deg]: { 4.33589907, 2.89349031, 1.44761486, 0.        ,-1.44761486,-2.89349031,
 -4.33589907,-5.77313792,-7.20353921,-8.6254818 }},
 var={offset}, 
 x_knot = {-2.00000000e-01,-1.33333333e-01,-6.66666667e-02, 2.77555756e-17,
  6.66666667e-02, 1.33333333e-01, 2.00000000e-01, 2.66666667e-01,
  3.33333333e-01, 4.00000000e-01}
O_BC1_offset[offset] = 0.247542378