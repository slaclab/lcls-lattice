! LCLS BC2 overlays


!
! Max horizontal offset: 520 mm
! Min horizontal offset: -10 mm
!  


bc2_theta_default = AB21 ! -0.036971268085 ! Same as AB21 parameter. Was: -0.0347274525623816
bc2_Lp_default = 0.549
bc2_Lp_drift_default = 9.8602


! Overlays for rectangular bends
!
! Lp : total projected length of the bend
! theta: total angle in radian

!

O_BX21: overlay = {
  BX21[g]:sin(theta)/Lp, 
  BX21[L]:Lp*theta/sin(theta),
  BX21[e2]:theta}, 
  var = {Lp, theta},
  theta = bc2_theta_default,
  Lp = bc2_Lp_default

O_BX22: overlay = {
  BX22[g]:sin(theta)/Lp, 
  BX22[L]:Lp*theta/sin(theta),
  BX22[e1]:theta}, 
  var = {Lp, theta},
  theta = -bc2_theta_default,
  Lp = bc2_Lp_default

O_BX23: overlay = {
  BX23[g]:sin(theta)/Lp, 
  BX23[L]:Lp*theta/sin(theta),
  BX23[e2]:theta}, 
  var = {Lp, theta},
  theta = -bc2_theta_default,
  Lp = bc2_Lp_default

O_BX24: overlay = {
  BX24[g]:sin(theta)/Lp, 
  BX24[L]:Lp*theta/sin(theta),
  BX24[e1]:theta}, 
  var = {Lp, theta},
  theta = bc2_theta_default,
  Lp = bc2_Lp_default

! Overall BC2 angle
! Lp_drift is the total projected length of the drift between the first and second bends
O_BC2: overlay={
  O_BX21[theta]:angle_deg*pi/180, 
  O_BX22[theta]:-angle_deg*pi/180, 
  O_BX23[theta]:-angle_deg*pi/180, 
  O_BX24[theta]:angle_deg*pi/180,
  D21oA[L]:D21oA[L] + Lp_drift*(1/cos(angle_deg*pi/180)-1/cos(bc2_theta_default)),
  D21oB[L]:D21oB[L] + Lp_drift*(1/cos(angle_deg*pi/180)-1/cos(bc2_theta_default))},
  var = {angle_deg, Lp_drift}, 
  angle_deg = bc2_theta_default*180/pi,
  Lp_drift=bc2_Lp_drift_default

! Automatically generated interpolation points using:
! $LCLS_LATTICE/bmad/overlays/cu/source/bunch_compressors.ipynb
O_BC2_offset: overlay = {O_BC2[angle_deg]: { 1.10073799, 0.7338735 , 0.3669512 , 0.        ,-0.3669512 ,-0.7338735 ,
 -1.10073799,-1.4675158 ,-1.8341781 ,-2.20069612,-2.56704115,-2.93318456,
 -3.29909781}},
 var={offset}, 
 x_knot = {-0.2       ,-0.13333333,-0.06666667, 0.        , 0.06666667, 0.13333333,
  0.2       , 0.26666667, 0.33333333, 0.4       , 0.46666667, 0.53333333,
  0.6       }
O_BC2_offset[offset] = 0.385010405