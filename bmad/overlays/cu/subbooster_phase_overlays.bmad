! Overlays for subboosters.
! --------
! 21-1 is L1S, and 21-2 is L1X
! Neither of them use the LI21 subbooster
O_SBST21: overlay = {
O_K21_3[subbooster_phase_deg]:phase_deg,
O_K21_4[subbooster_phase_deg]:phase_deg,
O_K21_5[subbooster_phase_deg]:phase_deg,
O_K21_6[subbooster_phase_deg]:phase_deg,
O_K21_7[subbooster_phase_deg]:phase_deg,
O_K21_8[subbooster_phase_deg]:phase_deg}, var = {phase_deg}

! --------
! 24-1, 24-2, and 24-3 do not use the sector subbooster.
! 24-7 is TCAV3, ignore it.
! 24-8 does not exist.
O_SBST24: overlay = {
O_K24_4[subbooster_phase_deg]:phase_deg,
O_K24_5[subbooster_phase_deg]:phase_deg,
O_K24_6[subbooster_phase_deg]:phase_deg}, var = {phase_deg}

