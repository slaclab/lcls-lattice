    COLOUR=100, SPLINE, RANGE=BEGCLTS/ENDCLTS, FILE="LCLS2cu_areas", &
    TITLE="CLTS"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGBSYS/ENDBSYS, FILE="LCLS2cu_areas", &
    TITLE="BSYS"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGLTUS/ENDLTUS, FILE="LCLS2cu_areas", &
    TITLE="LTUS"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGLTUS/ENDLTUS, FILE="LCLS2cu_areas", &
    TITLE="LTUS"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGUNDS/ENDUNDS, FILE="LCLS2cu_areas", &
    TITLE="UNDS" !SXX+SXR
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGDMPS_1/ENDDMPS_2, FILE="LCLS2cu_areas", &
    TITLE="DMPS" !UES+DMPS
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGDMPS_1/ENDDMPS_2, FILE="LCLS2cu_areas", &
    TITLE="DMPS" !UES+DMPS

! ------------------------------------------------------------------------------

  RETURN
