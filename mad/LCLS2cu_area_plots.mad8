
! *** OPTICS=AD_ACCEL-10SEP2026s ***

! ------------------------------------------------------------------------------

  BEAM, ENERGY=E00
  SET, SETCUS, CUSOFF
  CALL, FILENAME="SETK2cuH.xsif"
  USE, CU_HXR
  TWISS, BETA0=TWSSC, SAVE
