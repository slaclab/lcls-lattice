
! *** OPTICS=AD_ACCEL-12MAY2025s ***

  ASSIGN, PRINT="LCLS2cu_areas.print"

! ------------------------------------------------------------------------------

  BEAM, ENERGY=E00
  USE, CU_GSPEC
  TWISS, COUPLE, BETA0=TWSSC, SAVE
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGGSPEC/ENDGSPEC, FILE="LCLS2cu_areas", &
    TITLE="GSPEC"

! ------------------------------------------------------------------------------

  BEAM, ENERGY=E00
  USE, CU_SPEC
  TWISS, COUPLE, BETA0=TWSSC, SAVE
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGSPEC/ENDSPEC, FILE="LCLS2cu_areas", &
    TITLE="SPEC"

! ------------------------------------------------------------------------------

  BEAM, ENERGY=E00
  SET, SETCUS, CUSOFF
  SETK2cuH
  USE, CU_HXR
  TWISS, BETA0=TWSSC, SAVE
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGGUN/ENDGUN, FILE="LCLS2cu_areas", &
    TITLE="GUN"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, &
    COLOUR=100, -SPLINE, RANGE=BEGL0/ENDL0, FILE="LCLS2cu_areas", &
    TITLE="L0", VMIN=0, VMAX=0.15
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, -SPLINE, RANGE=BEGL0/ENDL0, FILE="LCLS2cu_areas", &
    TITLE="L0"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGDL1_1/ENDDL1_2, FILE="LCLS2cu_areas", &
    TITLE="DL1"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGDL1_1/ENDDL1_2, FILE="LCLS2cu_areas", &
    TITLE="DL1"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, &
    COLOUR=100, -SPLINE, RANGE=BEGL1/ENDL1, FILE="LCLS2cu_areas", &
    TITLE="L1"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGL1/ENDL1, FILE="LCLS2cu_areas", &
    TITLE="L1"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGBC1/ENDBC1, FILE="LCLS2cu_areas", &
    TITLE="BC1"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGBC1/ENDBC1, FILE="LCLS2cu_areas", &
    TITLE="BC1"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, &
    COLOUR=100, SPLINE, RANGE=BEGL2/ENDL2, FILE="LCLS2cu_areas", &
    TITLE="L2"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGL2/ENDL2, FILE="LCLS2cu_areas", &
    TITLE="L2"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGBC2/ENDBC2, FILE="LCLS2cu_areas", &
    TITLE="BC2"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGBC2/ENDBC2, FILE="LCLS2cu_areas", &
    TITLE="BC2"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, &
    COLOUR=100, SPLINE, RANGE=BEGL3/ENDL3, FILE="LCLS2cu_areas", &
    TITLE="L3"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGL3/ENDL3, FILE="LCLS2cu_areas", &
    TITLE="L3"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGCLTH_0/ENDBSYH, FILE="LCLS2cu_areas", &
    TITLE="BSY"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGLTUH/ENDLTUH, FILE="LCLS2cu_areas", &
    TITLE="LTUH"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGLTUH/ENDLTUH, FILE="LCLS2cu_areas", &
    TITLE="LTUH"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGUNDH/ENDUNDH, FILE="LCLS2cu_areas", &
    TITLE="UNDH" !HXR
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGDMPH_1/ENDDMPH_2, FILE="LCLS2cu_areas", &
    TITLE="DMPH" !UEH+DMPH
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGDMPH_1/ENDDMPH_2, FILE="LCLS2cu_areas", &
    TITLE="DMPH" !UEH+DMPH

! ------------------------------------------------------------------------------

  BEAM, ENERGY=E00
  SET, SETCUS, CUSON
  SETK2cuS
  USE, CU_SXR
  TWISS, BETA0=TWSSC, SAVE
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGCLTS/ENDCLTS, FILE="LCLS2cu_areas", &
    TITLE="CLTS"
