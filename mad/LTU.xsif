  MM2      : MARK
  MM3      : MARK
  EOBLM    : MARK !future electro-optic bunch length monitor?
  VV999    : MARK !new vacuum valve just upbeam of undulator
  PFILT1   : MARK
  MUHWALL1 : MARK !upstream end of BTH/UH wall-1
  MUHWALL2 : MARK !upstream end of BTH/UH wall-2
  DBMARK37 : MARK !end of undulator match
  RWWAKE5H : MARK, TYPE="WAKE" !LTU beampipe wake applied here

  UNMCH : LINE=(DU1m80cma,DWS36,DU1m80cmb,BTM13,DU1m80cmc,DCX37,D32cmc,&
      XCUM1,DUM1A,&
    QUM1,BPMUM1,QUM1,DUM1B,D32cm,DU2m120cm,DCY38,D32cma,YCUM2,DUM2A,&
    QUM2,BPMUM2,QUM2,DUM2B,DU3m80cm,XCUM3,DUM3A,&
    QUM3,BPMUM3,QUM3,DUM3B,D40cma,EOBLM,DU4m120cm,YCUM4,DUM4A,&
    QUM4,BPMUM4,QUM4,DUM4B,RFB07,DU5m80cm,IMUNDI,D40cmW,MUHWALL1,DUHWALL1,&
      DUHVESTa,RFB08,DUHVESTb,MUHWALL2,DUHWALL2,DW2TDUND,DTDUND1,TDUND,&
      DTDUND2,DPCMUON,PCMUON,DMUON1,VV999,DMUON3,RFBHX12,DMUON4,MM3,PFILT1,&
      DBMARK37)

  LTU : LINE=(VBSYS,MM1,DOGLG2A,DOGLG2B,MM2,EDMCH,EDSYS,UNMCH,RWWAKE5H,ENDLTUH)

! ------------------------------------------------------------------------------
! HXR dumpline
! ------------------------------------------------------------------------------

  KQDMP := -0.155212710055

  QDmp1 : QUAD, TYPE="3.94Q17", L=LQP/2, K1=KQDmp, APER=rQP
  QDmp2 : QUAD, TYPE="3.94Q17", L=LQP/2, K1=KQDmp, APER=rQP

  BYDSHA : SBEN, TYPE="1.26D18.43", L=LeffBYDS/2, ANGLE=ABYDS/2, &
                 HGAP=GBYDS/2, E1=ABYDS/2, E2=0, FINT=0.5, FINTX=0.0, TILT
  BYDSHB : SBEN, TYPE="1.26D18.43", L=LeffBYDS/2, ANGLE=ABYDS/2, &
                 HGAP=GBYDS/2, E1=0, E2=ABYDS/2, FINT=0.0, FINTX=0.5, TILT

  BYD1A  : SBEN, TYPE="1.69VD55.1", L=LeffBdm/2, ANGLE=ABdm/2, HGAP=GBdm/2, &
                 E1=ABdm/2, E2=0, FINT=0.57, FINTX=0.00, TILT
  BYD1B  : SBEN, TYPE="1.69VD55.1", L=LeffBdm/2, ANGLE=ABdm/2, HGAP=GBdm/2, &
                 E1=0, E2=ABdm/2, FINT=0.00, FINTX=0.57, TILT

  BYD2A  : SBEN, TYPE="1.69VD55.1", L=LeffBdm/2, ANGLE=ABdm/2, HGAP=GBdm/2, &
                 E1=ABdm/2, E2=0, FINT=0.57, FINTX=0.00, TILT
  BYD2B  : SBEN, TYPE="1.69VD55.1", L=LeffBdm/2, ANGLE=ABdm/2, HGAP=GBdm/2, &
                 E1=0, E2=ABdm/2, FINT=0.00, FINTX=0.57, TILT

  BYD3A  : SBEN, TYPE="1.69VD55.1", L=LeffBdm/2, ANGLE=ABdm/2, HGAP=GBdm/2, &
                 E1=ABdm/2, E2=0, FINT=0.57, FINTX=0.00, TILT
  BYD3B  : SBEN, TYPE="1.69VD55.1", L=LeffBdm/2, ANGLE=ABdm/2, HGAP=GBdm/2, &
                 E1=0, E2=ABdm/2, FINT=0.00, FINTX=0.57, TILT

  PCPM1L : ECOL, L=LPCPM, XSIZE=14.2875E-3, YSIZE=14.2875E-3
  PCPM2L : ECOL, L=LPCPM, XSIZE=38.1E-3,    YSIZE=38.1E-3

  DD1a : DRIF, L=0.577681302427
  DD1b : DRIF, L=1.000087502327
  DD1c : DRIF, L=0.3048
  DD1e : DRIF, L=0.249638105611
  DD1f : DRIF, L=0.409240058046
  DD1d : DRIF, L=LDMP1-(DD1a[L]+PCPM1L[L]+DD1b[L]+DD1c[L]+&
                 DD1e[L]+PCPM2L[L]+DD1f[L])

  BPMQD : MONI, TYPE="Stripline-8" !RFBQD : MONI, TYPE="@2,CavityL-1"
  BPMDD : MONI, TYPE="Stripline-8"
  RFBDD : MONI, TYPE="@2,CavityL-1"

  XCDD : HKIC,TYPE="class-5"

  YCDD : VKIC,TYPE="class-5"

  OTRDMP : PROF, TYPE="OTR" !Dump screen

  WSDUMP : WIRE, TYPE="@3,special"

 !IMDUMP  : IMON, TYPE="BCS toroid" !BCS toroid in dumpline after Y-bends
 !IMBCS4  : IMON, TYPE="BCS toroid" !BCS comparator toroid (ACM) in dumpline after Y-bends

  MIMDUMP : MARK
  MIMBCS4 : MARK

  BTM1L    : INST !Burn-Through-Monitor behind PCPM1L
  BTM2L    : INST !Burn-Through-Monitor behind PCPM2L
  DUMPFACE : INST !entrance face of main e- dump
  BTMDUMP  : INST !Burn-Through-Monitor of main e- dump

  MQDMP    : MARK
  DMPend   : MARK
  DBMARK38 : MARK !end of final undulator dump

  ARODMP1H := -ARODMP1S
  ARODMP2H := -ARODMP2S

  RODMP1H : SROT, ANGLE=ARODMP1H
  RODMP2H : SROT, ANGLE=ARODMP2H

  DUMPLINE : LINE=(BEGDMPH_2,RODMP1H,&
    BYDSHA,BYDSHB,DS1,BYD1A,BYD1B,DS,BYD2A,BYD2B,DS,BYD3A,BYD3B,&
    DD1a,PCPM1L,BTM1L,DD1b,MIMDUMP,DD1c,MIMBCS4,DD1d,YCDD,DD1e,&
    PCPM2L,BTM2L,DD1f,&
    QDmp1,QDmp1,DD12a,BPMQD,DD12b,MQDMP,DD12c,&
    QDmp2,QDmp2,DD2a,XCDD,DD2b,DD2c,DD3a,BPMDD,DD3b,OTRDMP,&
    DWSDUMPa,RFBDD,DWSDUMPb,WSDUMP,DWSDUMPc,RODMP2H,DUMPFACE,DDUMP,&
    DMPend,BTMDUMP,DBMARK38,ENDDMPH_2)

  RETURN
