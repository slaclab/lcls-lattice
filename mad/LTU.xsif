  IMBSY2b : IMON, TYPE="BCS backup toroid" !PEP2 backup toroid for IMBSY2
  IMBSY3b : IMON, TYPE="BCS backup toroid" !PEP2 backup toroid for IMBSY3

  IMBSY34 : IMON, TYPE="toroid" !diagnostic toroid - existing LCLS device

  LPCBSY : = 0.3 !TBD

  BSYbeg   : MARK
  FFTBORGN : MARK
  S100     : MARK !station 100
  ZLIN15   : MARK !station-100 (or "S100"): Z=3048.0 (Z'=X'=Y'=0.0 m)
