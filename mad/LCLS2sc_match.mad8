  MCCDLD : SUBROUTINE
    BEAM, ENERGY=Ef
    USE, CCDLD
    SET, ABCXDLD, ABCXDLD0
    VALUE, ABCXDLD
    MATCH, BETX=1, BETY=1
      VARY, ABCXDLD, STEP=1.E-6, LOWER=0
      RMATRIX, #S/#E, RM(5,6)=R56CCDLD, WEIGHT(5,6)=1
     !LMDIF, TOL=1.E-20, CALLS=10000
     !MIGRAD, TOL=1.E-20, CALLS=10000
