  ML3E : SUBROUTINE
    BEAM, ENERGY=E2
    USE, L3
    VALUE, FracL3,AmplL3
    MATCH, BETX=1, BETY=1
      VARY, FracL3, STEP=1.E-6
      WEIGHT, ENERGY=1
      CONSTR, #E, ENERGY=E3
     !LMDIF, TOL=1.E-20, CALLS=10000
     !MIGRAD, TOL=1.E-20, CALLS=10000
    ENDMATCH
    VALUE, FracL3,FracL3*AmplL3
    SAVEBETA, TWSSm, #E
    TWISS, BETX=1, BETY=1, SAVE, TAPE="twiss.tape"
