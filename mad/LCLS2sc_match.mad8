! working stuff
! ------------------------------------------------------------------------------

! match geometry of DC spreader (HXR and SXR are the same)
! (NOTE: enable DC spreader definitions SPRD.xsif and BSYsc.xsif)

  MXYZSPdch : SUBROUTINE
    BEAM, ENERGY=Ef
    USE, SPRDkhDC
    VALUE, DSPDCH1[L]
    MATCH, SURVEY, XS=0, YS=0, ZS=0, THETAS=0, PHIS=0, PSIS=0
      VARY, DSPDCH1[L], STEP=1.E-6
      WEIGHT, YS=1
      CONSTR, BLXSPHa, YS=0.015
      LMDIF, TOL=1.E-20
      MIGRAD, TOL=1.E-20
    ENDMATCH
    VALUE, DSPDCH1[L]
    PRINT, FULL
    SURVEY
  ENDSUBROUTINE

! ------------------------------------------------------------------------------

  COMMENT
    DO, TIMES=20
      SET, R56SPH, R56SPH+0.05E-3
      VALUE, R56SPH
      MSPRDH
    ENDDO
    RETURN
  ENDCOMMENT

  COMMENT
    DO, TIMES=30
      SET, R56SPS, R56SPS-0.1E-3
      VALUE, R56SPS
      MSPRDS ; MSPLTUS
    ENDDO
    RETURN
  ENDCOMMENT

! ------------------------------------------------------------------------------

  RETURN
