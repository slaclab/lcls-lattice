
! *** OPTICS=AD_ACCEL-01JUN2026s ***

! LCLS2sc matching routines

! ==============================================================================
! Modification History
! ------------------------------------------------------------------------------
! 10-MAR-2021, M. Woodley
!  * add LEI matching routines (search for "LEI matching")
! ------------------------------------------------------------------------------
! 31-OCT-2018, Y. Nosochkov
!  * update DASEL matching routines
! ------------------------------------------------------------------------------
! 28-NOV-2016, M. Woodley
!  * merge LCLS-II' version 28NOV16 with LCLS2sc version 04NOV16
!  * added definition of TBKYDAS0 parameter ... see SUBROUTINE MKICKDASEL
! 23-NOV-2016, Y. Nosochkov
!  * add MKICKDASEL routine for setting DASEL kicker angle 
! ------------------------------------------------------------------------------
! 04-NOV-2016, Y. Nosochkov
!  * add DASEL matching routines
! ------------------------------------------------------------------------------
! 09-FEB-2016, M. Woodley
!  * add 2nd-order dispersion matching for dogleg, SPDh, SPDs, and DL2B
! ------------------------------------------------------------------------------
! 25-SEP-2015, Y. Nosochkov
!  * update MDL2Mb routine, add new MDL2M2 routine
! 12-MAR-2015, Y. Nosochkov
!  * add routines for A-line match and CUSXR match
! 03-APR-2014, M. Woodley
!  * add missing "USE" command to MDLBXY routine
! ------------------------------------------------------------------------------

  OPTION, ECHO

  Dmdw : DRIF, L=1

  TBKRDAS0 := 0
  TBKRSPX0 := 0

  KmaxQcm :=  24.40/(Cb*Emax*Lcmq) !max |K1| @ Emax for a CM quadrupole
  KmaxQR  :=  47.31/(Cb*Emax*LQR)  !max |K1| @ 165 A for 2Q10
  KmaxQA  := 150.00/(Cb*Emax*LQA)  !max |K1| @ Emax for 1.26Q12
  KmaxQM  :=  27.00/(Cb*Emax*LQM)  !max |K1| @ Emax for 2Q4W
  KmaxQW  :=  16.50/(Cb*Emax*LQW)  !max |K1| @ Emax for a QW
  KmaxQx  :=  20.20/(Cb*Emax*LQx)  !max |K1| @ Emax for a 1.26Q3.5
  KmaxQE  := 100.00/(Cb*Emax*LQE)  !max |K1| @ Emax for a QE
  KmaxQu  :=  40.00/(Cb*Emax*LQu)  !max |K1| @ Emax for an undulator quadrupole
  KmaxQP  :=  38.58/(Cb*Emax*LQP)  !max |K1| @ 150 A for 3.94Q17
  KmaxQD  :=  40.00/(Cb*Emax*LQD)  !max |K1| @ 38 A for a 3.25Q20

  KmaxQxi := 20.20/(Cb*0.15*LQx) !max |K1| @ 150 MeV for 1.26Q3.5
  KmaxQx1 := 20.20/(Cb*0.26*LQx) !max |K1| @ 260 MeV for 1.26Q3.5
  KmaxQx2 := 20.20/(Cb*1.70*LQx) !max |K1| @ 1.7 GeV for 1.26Q3.5

  KmaxSb  := 870.00/(Cb*Emax*LSb)  !max |K2| @ Emax for 1.38S3.00

  GLmaxQUMb := 67 !BMAX = 67 kG @ 120 A (bipolar) for 1.085Q4.31
  KmaxQUMb  := GLmaxQUMb/LQE/(Cb*Emax) !max |K1| @ 10 GeV for QUM1B-4B

! ------------------------------------------------------------------------------
! Note: SETQCM01on.xsif uses parameter redefinition, which is not allowed
!       within a SUBROUTINE by MAD8. Use the SUBROUTINE's below, which use
!       SET commands, when matching ... copy final matched values to
!       xsif-files.
! ------------------------------------------------------------------------------

! match LCLS-II injector including QCM01 (see SETQCM01on.xsif)

  SETQCM01on : SUBROUTINE
    SET, KQCM01,  0.378216482077
    SET, KQ0H01, -6.376445663204
    SET, KQ0H02,  5.70179392031
    SET, KQ0H03,  2.926008068299
    SET, KQ0H04, -5.853998324286
  ENDSUBROUTINE

! ==============================================================================
! Injector/Linac matching (through bypass line)
! ------------------------------------------------------------------------------

  ML0E : SUBROUTINE !no matching ... just check that final energy is 75 MeV
    BEAM, ENERGY=E0
    USE, (GUN,L0)
    VALUE, FracL0
    MATCH, BETX=1, BETY=1
      VARY, FracL0, STEP=1.E-6
      WEIGHT, ENERGY=1
      CONSTR, #E, ENERGY=Ei
     !LMDIF, TOL=1.E-20, CALLS=10000
     !MIGRAD, TOL=1.E-20, CALLS=10000
    ENDMATCH
    VALUE, FracL0
    SAVEBETA, TWSSm, #E
    TWISS, BETA0=TWSS0, SAVE, TAPE="twiss.tape"
    VALUE, TWSSm[ENERGY]
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, &
      STYLE=100, -SPLINE, FILE="match"
  ENDSUBROUTINE

! ------------------------------------------------------------------------------

  ML1E : SUBROUTINE
    BEAM, ENERGY=Ei
    USE, L1
    VALUE, FracL1,AmplL1
    MATCH, BETX=1, BETY=1
      VARY, FracL1, STEP=1.E-6
      WEIGHT, ENERGY=1
      CONSTR, #E, ENERGY=E1
     !LMDIF, TOL=1.E-20, CALLS=10000
     !MIGRAD, TOL=1.E-20, CALLS=10000
    ENDMATCH
    VALUE, FracL1,FracL1*AmplL1
    USE, L1
    SAVEBETA, TWSSm, #E
    TWISS, BETX=1, BETY=1, SAVE, TAPE="twiss.tape"
    VALUE, TWSSm[ENERGY]
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, &
      STYLE=100, -SPLINE, FILE="match"
  ENDSUBROUTINE

! ------------------------------------------------------------------------------

  ML2E : SUBROUTINE
