  UMASX32_full : LINE=(UMASX32,XCSU32,YCSU32,UMASX32)
  UMASX33_full : LINE=(UMASX33,XCSU33,YCSU33,UMASX33)
  UMASX34_full : LINE=(UMASX34,XCSU34,YCSU34,UMASX34)
  UMASX36_full : LINE=(UMASX36,XCSU36,YCSU36,UMASX36)
  UMASX37_full : LINE=(UMASX37,XCSU37,YCSU37,UMASX37)
  UMASX38_full : LINE=(UMASX38,XCSU38,YCSU38,UMASX38)
  UMASX39_full : LINE=(UMASX39,XCSU39,YCSU39,UMASX39)
  UMASX40_full : LINE=(UMASX40,XCSU40,YCSU40,UMASX40)
  UMASX41_full : LINE=(UMASX41,XCSU41,YCSU41,UMASX41)
  UMASX42_full : LINE=(UMASX42,XCSU42,YCSU42,UMASX42)
  UMASX43_full : LINE=(UMASX43,XCSU43,YCSU43,UMASX43)
  UMASX44_full : LINE=(UMASX44,XCSU44,YCSU44,UMASX44)
  UMASX45_full : LINE=(UMASX45,XCSU45,YCSU45,UMASX45)
  UMASX46_full : LINE=(UMASX46,XCSU46,YCSU46,UMASX46)
  UMASX47_full : LINE=(UMASX47,XCSU47,YCSU47,UMASX47)

  USEGSX26 : LINE=(DTSXU,UMASX26_full,DTSXU)
  USEGSX27 : LINE=(DTSXU,UMASX27_full,DTSXU)
  USEGSX28 : LINE=(DTSXU,UMASX28_full,DTSXU)
  USEGSX29 : LINE=(DTSXU,UMASX29_full,DTSXU)
  USEGSX30 : LINE=(DTSXU,UMASX30_full,DTSXU)
  USEGSX31 : LINE=(DTSXU,UMASX31_full,DTSXU)
  USEGSX32 : LINE=(DTSXU,UMASX32_full,DTSXU)
  USEGSX33 : LINE=(DTSXU,UMASX33_full,DTSXU)
  USEGSX34 : LINE=(DTSXU,UMASX34_full,DTSXU)
  DUSEGS35 : LINE=(SCHICANE) !DRIF, L=LDUSEGS
  USEGSX36 : LINE=(DTSXU,UMASX36_full,DTSXU)
  USEGSX37 : LINE=(DTSXU,UMASX37_full,DTSXU)
  USEGSX38 : LINE=(DTSXU,UMASX38_full,DTSXU)
  USEGSX39 : LINE=(DTSXU,UMASX39_full,DTSXU)
