  DQSXBL48 : DRIF, L=LQu
  DQSXBL49 : DRIF, L=LQu
  DQSXBL50 : DRIF, L=LQu

  SXBRK26  : LINE=(DU3s,PHSSX26,DU4s,VVSXU26,DU5s,QSXBLK26,DU6s,RFBSX26,DU7s)
  SXBRK27  : LINE=(DU3s,PHSSX27,DU4s,        DU5s,QSXBLK27,DU6s,RFBSX27,DU7s)
