 !Ztotal  := 134.391*in2m  !total system length
 !Zuseg   := 3.372032      !undulator segment length
  ZB2Bo   := 1.23035       !outer bend center-to-center
  ZB2Bi   := 0.535763      !inner bend center-to-center

  ZCBXC1  := 3.504082 !0.1+(D0CB1[L]+ZB6/2+ZB2Bo+ZB2Bi+ZB2Bo+ZB6/2)
  ZCBXC2  := 3.504089 !0.1+(D0CB2[L]+ZB6/2+ZB2Bo+ZB2Bi+ZB2Bo+ZB6/2)

  D0CB1    : DRIF, L=0.264603-(DU1H[L]+DU2H[L]+ZB6/2) !0.26456
  D1CB1    : DRIF, L=(ZB2Bo-ZB6)/COS(AB6)
  D1CB1a   : DRIF, L=(0.656216-ZB6/2)/COS(AB6)
  D1CB1b   : DRIF, L=0.1059/COS(AB6)
  D1CB1c   : DRIF, L=D1CB1[L]-D1CB1a[L]-D1CB1b[L]
  DCHCB1   : DRIF, L=(ZB2Bi-ZB6)/2
  D2CB     : DRIF, L=D1CB1[L]
  D2CBa    : DRIF, L=0.568799
  D2CBb    : DRIF, L=D2CB[L]-D2CBa[L]
  D3CB1    : DRIF, L=ZCBXC1-(D0CB1[L]+ZB6/2+ZB2Bo+ZB2Bi+ZB2Bo+ZB6/2)
  DU3hCB1  : DRIF, L=0.203362-D3CB1[L] !2*DU3h[L]+0.133428 ! 0.102780
  DU4hCB1  : DRIF, L=DU4h[L]-0.000176 !-0.025003
  DU5hCB1  : DRIF, L=DU5h[L]+0.000741 !-0.133252 !-0.108382

  D0CB2    : DRIF, L=0.264610-(DU1H[L]+DU2H[L]+ZB6/2) !0.26456
  D1CB2    : DRIF, L=D1CB1[L]
  D1CB2a   : DRIF, L=(0.605122666708-ZB6/2)/COS(AB6)
  D1CB2b   : DRIF, L=0.05019/COS(AB6)
  D1CB2c   : DRIF, L=D1CB2[L]-D1CB2a[L]-D1CB2b[L]
  DCHCB2   : DRIF, L=DCHCB1[L]
  D3CB2    : DRIF, L=ZCBXC2-(D0CB2[L]+ZB6/2+ZB2Bo+ZB2Bi+ZB2Bo+ZB6/2)
  DU3hCB2  : DRIF, L=0.203362-D3CB2[L] !DU3h[L]+0.184427
  DU4hCB2  : DRIF, L=DU4h[L]-0.000176 !-0.025003
  DU5hCB2  : DRIF, L=DU5h[L]+0.000734 !-0.133259 !-0.108382

  HXRCB1BEG : MARK
  MCBX4     : INST !X-ray diamond crystal mirror
  YAGCBX42  : PROF
  CENTER1   : MARK
  BODCBX40  : PROF !Beam Overlap Diagnostic
  HXRCB1END : MARK

  HXRCB2BEG : MARK
  DSSCBX11  : PROF !Diamond scintillator screen
  MCBX1     : INST !X-ray diamond crystal mirror
  CENTER2   : MARK
  HXRCB2END : MARK

  BCXCBX11_full : LINE=(BCXCBX11a,BCXCBX11b)
  BCXCBX12_full : LINE=(BCXCBX12a,BCXCBX12b)
  BCXCBX13_full : LINE=(BCXCBX13a,BCXCBX13b)
  BCXCBX14_full : LINE=(BCXCBX14a,BCXCBX14b)

  BCXCBX21_full : LINE=(BCXCBX21a,BCXCBX21b)
  BCXCBX22_full : LINE=(BCXCBX22a,BCXCBX22b)
  BCXCBX23_full : LINE=(BCXCBX23a,BCXCBX23b)
  BCXCBX24_full : LINE=(BCXCBX24a,BCXCBX24b)

  CBCHICANE1 : LINE=(HXRCB1BEG,D0CB1,&
    BCXCBX11_full,D1CB1a,MCBX4,D1CB1b,YAGCBX42,D1CB1c,&
    BCXCBX12_full,DCHCB1,CENTER1,DCHCB1,&
    BCXCBX13_full,D2CBa,BODCBX40,D2CBb,&
    BCXCBX14_full,D3CB1,HXRCB1END)

  CBCHICANE2 : LINE=(HXRCB2BEG,D0CB2,&
    BCXCBX21_full,D1CB2a,DSSCBX11,D1CB2b,MCBX1,D1CB2c,&
    BCXCBX22_full,DCHCB2,CENTER2,DCHCB2,&
    BCXCBX23_full,D2CB,&
    BCXCBX24_full,D3CB2,HXRCB2END)

