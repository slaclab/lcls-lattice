! ==============================================================================
! SXR undulator and extension (north)
! ==============================================================================

! ------------------------------------------------------------------------------
! SXR undulator PPM phase shifter
! - Author: Heinz-Dieter Nuhn, Stanford Linear Accelerator Center
! - Last edited September 06, 2017
! - 10.0 mm miminum Undulator Gap
! ------------------------------------------------------------------------------
! - LPSSX  = SXR Phase Shifter length
! - luPSSX = SXR Phase Shifter period
! - PIPSSX = SXR Phase Shifter phase integral
! - KPSSX  = SXR Phase Shifter Undulator parameter (rms); range 1.34-3.59
! - kQPSSX = natural SXR Phase Shifter undulator focusing "k" in y-plane
! ------------------------------------------------------------------------------

 !Eu     :  definition moved to LCLS2sc_master.xsif and LCLS2cu_master.xsif
  gamu   := Eu/mc2                             !Lorentz energy factor in undulator [ ]
  LPSSX  := 0.0825                             !m
  luPSSX := 0.075                              !m
  LPSSXh := LPSSX/2
  PIPSSX := 3814                               !T^2mm^3 (180-3814)
  KPSSX  := 1.E-9*CLIGHT/mc2*SQRT(2.E-9*PIPSSX/luPSSX)
  kQPSSX := (KPSSX*2*pi/luPSSX/sqrt(2)/gamu)^2 !m^-2

  PSSX : MATR, TYPE="phase shifter", L=LPSSXh,        &
    RM(1,1) = 1.0,                                    &
    RM(1,2) = LPSSXh,                                 &
    RM(2,1) = 0.0,                                    &
    RM(2,2) = 1.0,                                    &
    RM(3,3) =  cos(LPSSXh*sqrt(kQPSSX)),              &
    RM(3,4) =  sin(LPSSXh*sqrt(kQPSSX))/sqrt(kQPSSX), &
    RM(4,3) = -sin(LPSSXh*sqrt(kQPSSX))*sqrt(kQPSSX), &
    RM(4,4) =  cos(LPSSXh*sqrt(kQPSSX)),              &
    RM(5,5) = 1.0,                                    &
    RM(6,6) = 1.0

  PSSX26 : PSSX
  PSSX27 : PSSX
  PSSX28 : PSSX
  PSSX29 : PSSX
  PSSX30 : PSSX
  PSSX31 : PSSX
  PSSX32 : PSSX
  PSSX33 : PSSX
  PSSX34 : PSSX
  PSSX36 : PSSX
  PSSX37 : PSSX
  PSSX38 : PSSX
  PSSX39 : PSSX
  PSSX40 : PSSX
  PSSX41 : PSSX
  PSSX42 : PSSX
  PSSX43 : PSSX
  PSSX44 : PSSX
  PSSX45 : PSSX
  PSSX46 : PSSX

! ------------------------------------------------------------------------------
! SXR drifts
! ------------------------------------------------------------------------------

  LDUSEGS := 3.4
  LDU1s   := 0.1
  LDU2s   := 0.03
  LDU3s   := 0.25-LPSSXh -0.04 -0.005
  LDU4s   := (0.25-LPSSXh-0.5*LQu)/2 +0.04 +0.005
  LDU5s   := (0.25-LPSSXh-0.5*LQu)/2
  LDU6s   := 0.12-LQu/2-LRFBub/2 +0.01
  LDU7s   := 0.25-LRFBub/2 -0.01
 dLDU0s   := 0.0 !fine tune Z in undulator
  LDU0s   := 2.1359-LDU6s-LDU7s-LQu +dLDU0s

  DU0s : DRIF, L=LDU0s
  DU1s : DRIF, L=LDU1s
  DU2s : DRIF, L=LDU2s
  DU3s : DRIF, L=LDU3s
  DU4s : DRIF, L=LDU4s
  DU5s : DRIF, L=LDU5s
  DU6s : DRIF, L=LDU6s
  DU7s : DRIF, L=LDU7s

  DUE1ab : DRIF, L=0.9-LRFBub -0.057
  DUE1e  : DRIF, L=0.057

! ------------------------------------------------------------------------------
! SXR extension quads
! ------------------------------------------------------------------------------

! note: the below K-values come from Y. Nosochkov's UNDS_KQ5_US.xsif file,
!       for E= 4.0 GeV and KSXU= 5.0 (IntgXS= 30.0 kG)

! note: the below K-values are for SC beam; the settings for Cu beam are
!       in the "LCLS2cu_main.mad8" file

  KQSX16 :=  0.386434780667 
  KQSX19 := -0.894006742269
  KQSX21 :=  1.22862150816
  KQSX24 := -1.251292803834 

  QSX16 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=KQSX16, APER=rQu
  QSX19 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=KQSX19, APER=rQu
  QSX21 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=KQSX21, APER=rQu
  QSX24 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=KQSX24, APER=rQu

! ------------------------------------------------------------------------------
! SXR extension X-steering coils in quads
! ------------------------------------------------------------------------------

  XCSX16 : HKIC, TYPE="type-U"
  XCSX19 : HKIC, TYPE="type-U"
  XCSX21 : HKIC, TYPE="type-U"
  XCSX24 : HKIC, TYPE="type-U"

! ------------------------------------------------------------------------------
! SXR extension Y-steering coils in quads
! ------------------------------------------------------------------------------

  YCSX16 : VKIC, TYPE="type-U"
  YCSX19 : VKIC, TYPE="type-U"
  YCSX21 : VKIC, TYPE="type-U"
  YCSX24 : VKIC, TYPE="type-U"

! ------------------------------------------------------------------------------
! SXR extension BPMs
! ------------------------------------------------------------------------------

  RFBSX16 : MONI, L=LRFBub, TYPE="CavityX-1"
  DRFBS17 : DRIF, L=LRFBub
  DRFBS18 : DRIF, L=LRFBub
  RFBSX19 : MONI, L=LRFBub, TYPE="CavityX-1"
  DRFBS20 : DRIF, L=LRFBub
  RFBSX21 : MONI, L=LRFBub, TYPE="CavityX-1"
  DRFBS22 : DRIF, L=LRFBub
  DRFBS23 : DRIF, L=LRFBub
  RFBSX24 : MONI, L=LRFBub, TYPE="CavityX-1"
  RFBSX25 : MONI, L=LRFBub, TYPE="CavityX-1"

  SXXSTART : MARK !start of soft X-ray extension system
  SXXTERM  : MARK !end of soft X-ray extension system
  SXRSTART : MARK !start of undulator system
  RWWAKE5S : MARK, TYPE="WAKE" !SXR beampipe wake applied here
  SXRTERM  : MARK !~end of undulator system
  MUQS     : MARK
  MPHS     : MARK

  QSX16_full : LINE=(QSX16,XCSX16,YCSX16,QSX16)
  DQSX17     : DRIF, L=LQu
  DQSX18     : DRIF, L=LQu
  QSX19_full : LINE=(QSX19,XCSX19,YCSX19,QSX19)
  DQSX20     : DRIF, L=LQu
  QSX21_full : LINE=(QSX21,XCSX21,YCSX21,QSX21)
  DQSX22     : DRIF, L=LQu
  DQSX23     : DRIF, L=LQu
  QSX24_full : LINE=(QSX24,XCSX24,YCSX24,QSX24)
  DQSX25     : DRIF, L=LQu

  DPSSX17 : DRIF, L=LPSSX
  DPSSX18 : DRIF, L=LPSSX
  DPSSX19 : DRIF, L=LPSSX
  DPSSX20 : DRIF, L=LPSSX
  DPSSX21 : DRIF, L=LPSSX
  DPSSX22 : DRIF, L=LPSSX
  DPSSX23 : DRIF, L=LPSSX
  DPSSX24 : DRIF, L=LPSSX
  DPSSX25 : DRIF, L=LPSSX

  SXBRK17 : LINE=(DU3s,DPSSX17,DU4s,DU5s,DQSX17    ,DU6s,DRFBS17,DU7s)
  SXBRK18 : LINE=(DU3s,DPSSX18,DU4s,DU5s,DQSX18    ,DU6s,DRFBS18,DU7s)
  SXBRK19 : LINE=(DU3s,DPSSX19,DU4s,DU5s,QSX19_full,DU6s,RFBSX19,DU7s)
  SXBRK20 : LINE=(DU3s,DPSSX20,DU4s,DU5s,DQSX20    ,DU6s,DRFBS20,DU7s)
  SXBRK21 : LINE=(DU3s,DPSSX21,DU4s,DU5s,QSX21_full,DU6s,RFBSX21,DU7s)
  SXBRK22 : LINE=(DU3s,DPSSX22,DU4s,DU5s,DQSX22    ,DU6s,DRFBS22,DU7s)
  SXBRK23 : LINE=(DU3s,DPSSX23,DU4s,DU5s,DQSX23    ,DU6s,DRFBS23,DU7s)
  SXBRK24 : LINE=(DU3s,DPSSX24,DU4s,DU5s,QSX24_full,DU6s,RFBSX24,DU7s)
  SXBRK25 : LINE=(DU3s,DPSSX25,DU4s,DU5s,DQSX25    ,DU6s,RFBSX25,DU7s)

  DUSEGS17 : DRIF, L=LDUSEGS
  DUSEGS18 : DRIF, L=LDUSEGS
  DUSEGS19 : DRIF, L=LDUSEGS
  DUSEGS20 : DRIF, L=LDUSEGS
  DUSEGS21 : DRIF, L=LDUSEGS
  DUSEGS22 : DRIF, L=LDUSEGS
  DUSEGS23 : DRIF, L=LDUSEGS
  DUSEGS24 : DRIF, L=LDUSEGS
  DUSEGS25 : DRIF, L=LDUSEGS

  SXCEL17 : LINE=(DU1s,DU2s,DUSEGS17,SXBRK17)
  SXCEL18 : LINE=(DU1s,DU2s,DUSEGS18,SXBRK18)
  SXCEL19 : LINE=(DU1s,DU2s,DUSEGS19,SXBRK19) !Q+RFBPM
  SXCEL20 : LINE=(DU1s,DU2s,DUSEGS20,SXBRK20)
  SXCEL21 : LINE=(DU1s,DU2s,DUSEGS21,SXBRK21) !Q+RFBPM
  SXCEL22 : LINE=(DU1s,DU2s,DUSEGS22,SXBRK22)
  SXCEL23 : LINE=(DU1s,DU2s,DUSEGS23,SXBRK23)
  SXCEL24 : LINE=(DU1s,DU2s,DUSEGS24,SXBRK24) !Q+RFBPM
  SXCEL25 : LINE=(DU1s,DU2s,DUSEGS25,SXBRK25) !RFBPM

  SXRXX : LINE=(SXXSTART,&
                DU0s,QSX16_full,DU6s,RFBSX16,DU7s,&
                SXCEL17,SXCEL18,SXCEL19,SXCEL20,&
                SXCEL21,SXCEL22,SXCEL23,SXCEL24,SXCEL25,&
                SXXTERM)

! ------------------------------------------------------------------------------
! SXR undulator
! ------------------------------------------------------------------------------
! - Author: Heinz-Dieter Nuhn, Stanford Linear Accelerator Center
! - Last edited Mar 03, 2014
! - 7.2 mm miminum Undulator Gap; only constant break length each
! - include natural vertical focusing over all but edge terminations
! ------------------------------------------------------------------------------
! - IntgSX  = integrated quadrupole gradient
! - GQFSX   = QF and QD gradients can be made different to compensate for
!             undulator focussing ...
! - GQDSX   = ... but since undulator focussing depends on gamma^2, compensation
!             will only work for one energy
! - kQFSX   = QF undulator quadrupole focusing "k"
! - kQDSX   = QD undulator quadrupole focusing "k"
! - LDUSEGS = SXR Undulator segment length
! - luSXU   = SXR Undulator period
! - NpSXU   = SXR Undulator period count
! - LSXUCR  = SXR Undulator magnetic length
! - LSXUe   = SXR Undulator spacing between magnet array and strongback end
! - KSXU    = SXR Undulator parameter (rms); range 2-5.5
! - kQSX    = natural SXR undulator focusing "k" in y-plane
! ------------------------------------------------------------------------------

 !IntgSX :   definition moved to LCLS2sc_main.xsif and LCLS2cu_main.xsif
  GQFSX  :=  IntgSX/LQu/10*1.0           !T/m
  GQDSX  := -IntgSX/LQu/10*1.0           !T/m
  kQFSX  :=  1.E-9*GQFSX*CLIGHT/gamu/mc2 !m^-2
  kQDSX  :=  1.E-9*GQDSX*CLIGHT/gamu/mc2 !m^-2
  kQDSXm := -1.28484                     !-0.266792876891

  QSX26 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQFSX, APER=rQu
  QSX27 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQDSX, APER=rQu
  QSX28 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQFSX, APER=rQu
  QSX29 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQDSX, APER=rQu
  QSX30 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQFSX, APER=rQu
  QSX31 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQDSX, APER=rQu
  QSX32 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQFSX, APER=rQu
  QSX33 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQDSX, APER=rQu
  QSX34 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQFSX, APER=rQu
  QSX35 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQDSX, APER=rQu
  QSX36 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQFSX, APER=rQu
  QSX37 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQDSX, APER=rQu
  QSX38 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQFSX, APER=rQu
  QSX39 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQDSX, APER=rQu
  QSX40 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQFSX, APER=rQu
  QSX41 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQDSX, APER=rQu
  QSX42 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQFSX, APER=rQu
  QSX43 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQDSX, APER=rQu
  QSX44 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQFSX, APER=rQu
  QSX45 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQDSX, APER=rQu
  QSX46 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQFSX, APER=rQu
  QSX47 : QUAD, TYPE="0.433Q3.1", L=LQu/2, K1=kQDSXm, APER=rQu

  luSXU  := 0.039                            !m
  NpSXU  := 87
  LSXUCR := luSXU*NpSXU                      !m
  LSXUe  := (LDUSEGS-LSXUCR)/2               !m
  LSXUh  := LSXUCR/2
  KSXU   := 5.0
  kQSX   := (KSXU*2*pi/luSXU/sqrt(2)/gamu)^2 !m^-2

  UMASX : MATR, TYPE="VGHPU", L=LSXUh,         &
    RM(1,1) = 1.0,                               &
    RM(1,2) = LSXUh,                             &
    RM(2,1) = 0.0,                               &
    RM(2,2) = 1.0,                               &
    RM(3,3) =  cos(LSXUh*sqrt(kQSX)),            &
    RM(3,4) =  sin(LSXUh*sqrt(kQSX))/sqrt(kQSX), &
    RM(4,3) = -sin(LSXUh*sqrt(kQSX))*sqrt(kQSX), &
    RM(4,4) =  cos(LSXUh*sqrt(kQSX)),            &
    RM(5,5) = 1.0,                               &
    RM(6,6) = 1.0

  UMASX26 : UMASX
  UMASX27 : UMASX
  UMASX28 : UMASX
  UMASX29 : UMASX
  UMASX30 : UMASX
  UMASX31 : UMASX
  UMASX32 : UMASX
  UMASX33 : UMASX
  UMASX34 : UMASX
  UMASX36 : UMASX
  UMASX37 : UMASX
  UMASX38 : UMASX
  UMASX39 : UMASX
  UMASX40 : UMASX
  UMASX41 : UMASX
  UMASX42 : UMASX
  UMASX43 : UMASX
  UMASX44 : UMASX
  UMASX45 : UMASX
  UMASX46 : UMASX
  UMASX47 : UMASX

