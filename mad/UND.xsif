  HXCEL18  : LINE=(HXR18BEG,DU1h,DU2h,USEGHX18,HXBRK18,HXR18END)
  HXCEL19  : LINE=(HXR19BEG,DU1h,DU2h,USEGHX19,HXBRK19,HXR19END)
  HXCEL20  : LINE=(HXR20BEG,DU1h,DU2h,USEGHX20,HXBRK20,HXR20END)
  HXCEL21  : LINE=(HXR21BEG,DU1h,DU2h,DUSEGH21,HXBRK21,HXR21END) !CBCHICANE2+Q+RFBPM
  HXCEL22  : LINE=(HXR22BEG,DU1h,DU2h,USEGHX22,HXBRK22,HXR22END)
