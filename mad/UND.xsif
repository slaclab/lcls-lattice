  HXCEL25  : LINE=(HXR25BEG,DU1h,DU2h,USEGHX25,HXBRK25,HXR25END)
  HXCEL26  : LINE=(HXR26BEG,DU1h,DU2h,USEGHX26,HXBRK26,HXR26END)
