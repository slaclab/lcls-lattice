! ------------------------------------------------------------------------------
! miscellaneous SXR stuff
! ------------------------------------------------------------------------------

! SXRSS-II BOD's

  BOD10 : PROF, TYPE="YAG" !Beam Overlap Device
  DU7sa : DRIF, L=0.078508
  BOD12 : PROF, TYPE="YAG" !Beam Overlap Device
  DU7sb : DRIF, L=DU7s[L]-DU7sa[L]
  
! PEPPEx components

  PEPXANG := 0.105263157895E-2 !offset beam toward aisle (south)

 !DU7sc     : DRIF, L=0.184
 !FSPEPX1   : INST, TYPE="fast shutter"
 !DU7sd     : DRIF, L=DU7s[L]-DU7sc[L]
  XCPEPX1   : HKIC, TYPE="2.19 Gap Type 4", KICK=-PEPXANG*SETPEPX
  DU7se     : DRIF, L=0.074
  VGPEPX1   : MARK, TYPE="vacuum gauges"
  VGCCPEPX1 : INST, TYPE="cold cathode"
  VGPRPEPX1 : INST, TYPE="pirani"
  DU7sf     : DRIF, L=DU7s[L]-DU7se[L]
  DUSEGS50a : DRIF, L=0.064
  XCPEPX2   : HKIC, TYPE="2.19 Gap Type 4", KICK=+PEPXANG*SETPEPX
  DUSEGS50b : DRIF, L=0.586
  ZPPEPX    : INST, TYPE="zone plate"
  DUSEGS50c : DRIF, L=0.29
  VPPEPX1   : MARK, TYPE="ion pump"
  DUSEGS50d : DRIF, L=0.224
  XCPEPX3   : HKIC, TYPE="2.19 Gap Type 4", KICK=+PEPXANG*SETPEPX
  DUSEGS50e : DRIF, L=0.95
  XCPEPX4   : HKIC, TYPE="2.19 Gap Type 4", KICK=-PEPXANG*SETPEPX
  DUSEGS50f : DRIF, L=0.6
  GJPEPX    : INST, TYPE="gas jet"
  DUSEGS50g : DRIF, L=DUSEGS50[L]-DUSEGS50a[L]-DUSEGS50b[L]&
                      -DUSEGS50c[L]-DUSEGS50d[L]-DUSEGS50e[L]&
                      -DUSEGS50f[L]
  DUE1ab1   : DRIF, L=0.121
  VPPEPX2   : MARK, TYPE="ion pump"
  DUE1ab2   : DRIF, L=DUE1ab[L]-DUE1ab1[L]

