  HXCEL14  : LINE=(HXR14BEG,DU1h,DU2h,USEGHX14,HXBRK14,HXR14END)
  HXCEL15  : LINE=(HXR15BEG,DU1h,DU2h,USEGHX15,HXBRK15,HXR15END)
  HXCEL16  : LINE=(HXR16BEG,DU1h,DU2h,USEGHX16,HXBRK16,HXR16END)
