  HXCEL28  : LINE=(HXR28BEG,DU1h,DU2h,DUSEGH28,HXBRK28,HXR28END) !HXRSS+Q+RFBPM
  HXCEL29  : LINE=(HXR29BEG,DU1h,DU2h,USEGHX29,HXBRK29,HXR29END)
