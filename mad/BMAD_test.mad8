  TITLE, "AD_ACCEL (October 17, 2023)" !combine LCLS and LCLS-II

! *** OPTICS=AD_ACCEL-17OCT23 ***

  OPTION, -ECHO, INFO, WARN, VERIFY, DOUBLE
  ASSIGN, ECHO="test.echo"
  ASSIGN, PRINT="test.print"

  SETPLOT, XSIZE=25.4, YSIZE=20.32
  SETPLOT, LWIDTH=5, LSCALE=1.5, SSCALE=1.5, RSCALE=1.5, ASCALE=1.5

! Note: all SURVEY outputs in linac coordinates

! ==============================================================================

 !SC_SXR   : superconducting linac to e- SXR dump
 !SC_SFTS  : superconducting linac to e- SXR safety dump
 !SC_HXR   : superconducting linac to e- HXR dump
 !SC_BSYD  : superconducting linac to BSY dump
 !SC_DIAG0 : superconducting linac to DIAG0
 !SC_DASEL : superconducting linac to End Station A (DASEL)

! ------------------------------------------------------------------------------

  COMMENT !SXR line
    CALL, FILENAME="SC_SXR.xsif"
    BEAM, ENERGY=E0
    USE, SC_SXR
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="test_survey.tape"
    BEAM, ENERGY=Ei
    USE, SC_SXRi
    PRINT, FULL
    TWISS, SAVE, BETX=BXi, ALFX=AXi, BETY=BYi, ALFY=AYi, &
      TAPE="test_twiss.tape" !, RTAPE="test_rmat.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEAM0/DUMPFACEB, &
      TITLE="BEAMPATH=SC_SXR"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEAM0/DUMPFACEB, &
      TITLE="BEAMPATH=SC_SXR"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEAM0/DUMPFACEB, &
      TITLE="BEAMPATH=SC_SXR"
  ENDCOMMENT

! ------------------------------------------------------------------------------

  COMMENT !SXR line to safety dump
    CALL, FILENAME="SC_SFTS.xsif"
    BEAM, ENERGY=E0
    USE, SC_SFTS
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="test_survey.tape"
    BEAM, ENERGY=Ei
    USE, SC_SFTSi
    PRINT, FULL
    TWISS, SAVE, BETX=BXi, ALFX=AXi, BETY=BYi, ALFY=AYi, &
      TAPE="test_twiss.tape" !, RTAPE="test_rmat.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEAM0/SFTDMPB, &
      TITLE="BEAMPATH=SC_SFTS"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEAM0/SFTDMPB, &
      TITLE="BEAMPATH=SC_SFTS"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEAM0/SFTDMPB, &
      TITLE="BEAMPATH=SC_SFTS"
  ENDCOMMENT

! ------------------------------------------------------------------------------

  COMMENT !HXR line
    CALL, FILENAME="SC_HXR.xsif"
    BEAM, ENERGY=E0
    USE, SC_HXR
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="test_survey.tape"
    BEAM, ENERGY=Ei
    USE, SC_HXRi
    PRINT, FULL
    TWISS, SAVE, BETX=BXi, ALFX=AXi, BETY=BYi, ALFY=AYi, &
      TAPE="test_twiss.tape" !, RTAPE="test_rmat.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEAM0/DUMPFACE, &
      TITLE="BEAMPATH=SC_HXR"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEAM0/DUMPFACE, &
      TITLE="BEAMPATH=SC_HXR"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEAM0/DUMPFACE, &
      TITLE="BEAMPATH=SC_HXR"
  ENDCOMMENT

! ------------------------------------------------------------------------------

  !COMMENT !BSY dump line
    CALL, FILENAME="SC_BSYD.xsif"
    BEAM, ENERGY=E0
    USE, SC_BSYD
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="test_survey.tape"
    BEAM, ENERGY=Ei
    USE, SC_BSYDi
    PRINT, FULL
    TWISS, SAVE, BETX=BXi, ALFX=AXi, BETY=BYi, ALFY=AYi, &
      TAPE="test_twiss.tape" !, RTAPE="test_rmat.tape"
    ARCHIVE, TABLE=twiss, FILENAME='BSYD.twiss'
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEAM0/DUMPBSY, &
      TITLE="BEAMPATH=SC_BSYD"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEAM0/DUMPBSY, &
      TITLE="BEAMPATH=SC_BSYD"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEAM0/DUMPBSY, &
      TITLE="BEAMPATH=SC_BSYD"
  !ENDCOMMENT

! ------------------------------------------------------------------------------

  !COMMENT !DIAG0 diagnostic line
    CALL, FILENAME="SC_DIAG0.xsif"
    BEAM, ENERGY=E0
    USE, SC_DIAG0
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="test_survey.tape"
    BEAM, ENERGY=Ei
    USE, SC_DIAG0i
    PRINT, FULL
    TWISS, SAVE, BETX=BXi, ALFX=AXi, BETY=BYi, ALFY=AYi, &
      TAPE="test_twiss.tape" !, RTAPE="test_rmat.tape"
    ARCHIVE, TABLE=twiss, filename='twiss.archive'
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEAM0/ENDDIAG0, &
      TITLE="BEAMPATH=SC_DIAG0"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEAM0/ENDDIAG0, &
      TITLE="BEAMPATH=SC_DIAG0"
  !ENDCOMMENT

! ------------------------------------------------------------------------------

  COMMENT !DASEL line
