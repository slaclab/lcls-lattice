! ultrafast stripline kickers for LCLS Multibunch project
! ------------------------------------------------------------------------------

  Lufkick := 0.300 !electrical length (m)

  BKY21929 : INST, TYPE="0.79K11.8", L=Lufkick
  BKX21957 : INST, TYPE="0.79K11.8", L=Lufkick
  BKY22929 : INST, TYPE="0.79K11.8", L=Lufkick
  BKX22957 : INST, TYPE="0.79K11.8", L=Lufkick

  D219a : DRIF, L=0.4609-Lufkick/2
  D219b : DRIF, L=0.5439-Lufkick
  D219c : DRIF, L=DAQ4[L]-D219a[L]-Lufkick-D219b[L]-Lufkick
  D229a : DRIF, L=D219a[L]
  D229b : DRIF, L=D219b[L]
  D229c : DRIF, L=D219c[L]
  
