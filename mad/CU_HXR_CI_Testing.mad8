  TITLE, "github CI unit testing"

  OPTION, -ECHO, INFO, WARN, VERIFY
  ASSIGN, ECHO="test.echo"
  ASSIGN, PRINT="test.print"

  SETPLOT, XSIZE=25.4, YSIZE=20.32
  SETPLOT, LWIDTH=5, LSCALE=1.5, SSCALE=1.5, RSCALE=1.5, ASCALE=1.5

  BXo = 33.3087298737
  AXo = 1.18314711905
  BYo = 62.3158794579
  AYo = -1.66201012080

! ==============================================================================

 !CU_SXR   : superconducting linac to e- SXR dump
 !CU_HXR   : superconducting linac to e- HXR dump

  CALL, FILENAME="CU_HXR.xsif"
  OPTION, DOUBLE

  USE, CU_HXR
  BEAM, ENERGY=E00
  TWISS, SAVE, COUPLE, BETX=CBETX, ALFX=CALFX, BETY=CBETY, ALFY=CALFY
  ARCHIVE, TABLE=TWISS, FILENAME='CU_HXR_GUN_CI.twiss'

  USE, CU_HXRi
  BEAM, ENERGY=Ei
  TWISS, SAVE, CHROM, BETX=BXi, ALFX=AXi, BETY=BYi, ALFY=AYi, &
  DELTAP=0
  ARCHIVE, TABLE=TWISS, FILENAME='CU_HXR_GUN_CI_i.twiss'

  USE, BSYLTUH
  BEAM, ENERGY=8.000
  TWISS, SAVE, CHROM, BETX=BXo, ALFX=AXo, BETY=BYo, ALFY=AYo, &
  DELTAP=0
  ARCHIVE, TABLE=TWISS, FILENAME='CU_HXR_GUN_CI_postL3.twiss'

  STOP  
