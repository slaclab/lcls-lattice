
! *** OPTICS=AD_ACCEL-15SEP21 ***

! ------------------------------------------------------------------------------
! XLEAP-II optics (Yuri Nosochkov)
! ------------------------------------------------------------------------------

! to run XLEAP-II optics, uncomment the SUBROUTINE with the appropriate energy;
! within the selected SUBROUTINE, comment out any unused wiggler pair

 !COMMENT
    SETK2XL2 : SUBROUTINE !8 GeV
      SET, Ef, 8.0 ; SET, Eu, Ef
     !comment !turn on first wiggler pair and match (chicane and XLEAP wiggler OFF)
        SET, R11XL1,  1.024433796036150 ; SET, R11XL2, R11XL1 
        SET, R12XL1,  1.678538794967410 ; SET, R12XL2, R12XL1 
        SET, R21XL1,  0.029468846719147 ; SET, R21XL2, R21XL1 
        SET, R22XL1,  1.024433796036150 ; SET, R22XL2, R22XL1 
        SET, R33XL1,  0.975763600637818 ; SET, R33XL2, R33XL1 
        SET, R34XL1,  1.651526938083830 ; SET, R34XL2, R34XL1 
        SET, R43XL1, -0.028994619806734 ; SET, R43XL2, R43XL1 
        SET, R44XL1,  0.975763600637818 ; SET, R44XL2, R44XL1 
        SET, KQEM2B, -1.90691592871
        SET, KQEM3B,  1.191623728587
        SET, KQEM4B, -0.664838884251
        SET, KQE31B,  0.230547717948
        SET, KQFXL1,  1.111758049867
       !Yuri match (Ef=8.0, KSXU=5.0)
        SET, KQUM4B, -0.61774146348
        SET, KQSX16,  0.677894017174
        SET, KQSX19, -0.893321229694
        SET, KQSX21,  0.901518123026
        SET, KQSX24, -0.825282828044
        SET, KQDSXM, -1.843482712046
        SET, KQUE1B,  0.325725075565
        SET, KQUE2B, -0.144356640751
     !endcomment
     !comment !turn on second wiggler pair and match (chicane and XLEAP wiggler ON)
        SET, SETXLEAP2, 1 !turn on XLEAP chicane and XLEAP wiggler
        SET, R11XL3,  1.024433796036150 ; SET, R11XL4, R11XL3
        SET, R12XL3,  1.678538794967410 ; SET, R12XL4, R12XL3
        SET, R21XL3,  0.029468846719147 ; SET, R21XL4, R21XL3
        SET, R22XL3,  1.024433796036150 ; SET, R22XL4, R22XL3
        SET, R33XL3,  0.975763600637818 ; SET, R33XL4, R33XL3
        SET, R34XL3,  1.651526938083830 ; SET, R34XL4, R34XL3
        SET, R43XL3, -0.028994619806734 ; SET, R43XL4, R43XL3
        SET, R44XL3,  0.975763600637818 ; SET, R44XL4, R44XL3
        SET, KQFXL2,  0.80795621658
        SET, KQE36B,  0.576286649843E-2
        SET, KQUM1B,  0.421280440634
        SET, KQUM2B, -0.565123338154
        SET, KQUM3B,  0.623837052173
        SET, KQUM4B, -0.626404824474
        SET, KQSX16,  0.539702428378
        SET, KQSX19, -0.839075812772
        SET, KQSX21,  1.009894190449
        SET, KQSX24, -1.013981671812
        SET, KQDSXM, -1.784478916667
        SET, KQUE1B,  0.310926049255
        SET, KQUE2B, -0.110591700418
     !endcomment
    ENDSUBROUTINE
 !ENDCOMMENT

  COMMENT
