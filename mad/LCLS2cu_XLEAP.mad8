
! *** OPTICS=AD_ACCEL-10SEP2026s ***

! XLEAP-II optics

! ==============================================================================
! Modification History
! ------------------------------------------------------------------------------
! 17-MAR-2026, M. Woodley
!  * given that the XLEAP undulators don't focus, there is only one XLEAP
!    "configuration" ... XLEAP wiggler ON (gap closed)
! ------------------------------------------------------------------------------
! 18-SEP-2025, M. Woodley
!  * WIGXL has been (permanently) reinstalled per Gene Kraft
! 17-SEP-2025, M. Woodley
!  * WIGXL is not currently installed
!  * modified UMXL* undulators don't focus/defocus per A. Marinelli
! ------------------------------------------------------------------------------
! 31-AUG-2025, M. Woodley
!  * from ~/git_repos/lcls-lattice/mad/LCLS2cu_XLEAP.mad8
! ------------------------------------------------------------------------------
! 07-APR-2024, M. Woodley
!  * remove UMXL2; move WIGXLH from SXR cell 18 to UMXL2 location
! ------------------------------------------------------------------------------

  KmaxQE200 := 102.00/(Brhof*LQE) !max |K1| @ Ef for 1.085Q4.31 (200 A bipolar )
  KmaxQE120 :=  67.00/(Brhof*LQE) !max |K1| @ Ef for 1.085Q4.31 (120 A bipolar )

 !VALUE, Ef,KmaxQE200,KmaxQE120

! ------------------------------------------------------------------------------

  MXL : SUBROUTINE !match XLEAP-II optics
    BEAM, ENERGY=Ei
    USE, LCLS2cuSe
    VALUE, KQEM1B,KQEM2B,KQEM3B,KQEM4B
    MATCH, BETA0=TWSSi
      VARY, KQEM1B, STEP=1.E-6, LOWER=-KmaxQE200, UPPER=+KmaxQE200
      VARY, KQEM2B, STEP=1.E-6, LOWER=-KmaxQE200, UPPER=+KmaxQE200
      VARY, KQEM3B, STEP=1.E-6, LOWER=-KmaxQE120, UPPER=+KmaxQE120
      VARY, KQEM4B, STEP=1.E-6, LOWER=-KmaxQE120, UPPER=+KmaxQE120
      WEIGHT, DX=0, DPX=0, DY=0, DPY=0
      CONSTR, QE32B[1], LINE=(QE32B,DQEC,DQEC,QE33B,QE33B,DQEC,DQEC,QE32B)
     !LMDIF, TOL=1.E-20
     !MIGRAD, TOL=1.E-20
    ENDMATCH
    VALUE, KQEM1B,KQEM2B,KQEM3B,KQEM4B
    PRINT, FULL
    TWISS, BETA0=TWSSi, SAVE, TAPE="twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, RANGE=MM1B/WS34B, &
      STYLE=100, SPLINE, FILE="match"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, RANGE=WS31B/SXR47END, &
      STYLE=100, SPLINE, FILE="match"
  ENDSUBROUTINE

! ------------------------------------------------------------------------------
! create beamline that starts at WS02
! ------------------------------------------------------------------------------

  BEGDL1_1e : MARK
  ENDDL1_1e : MARK

  DL1_1e : LINE=(BEGDL1_1e,&
    WS02,DE05a,MRK0,DE05a,OTR2,DE06d,BPM10,DE06e,WS03,DE05,OTR3,DE07,&
    QM01,BPM11,QM01,DE08,SC8,DE08a,VV04,DE08b,&
    QM02,BPM12,QM02,DE09,DBMARK82,&
    ENDDL1_1e)

  LCLS2cuSe : LINE=(DL1_1e,DL1_2,L1,BC1,L2,BC2,L3,BSYLTUS)

! ------------------------------------------------------------------------------

  SET, SETCUS, CUSON
  CALL, FILENAME="SETK2cuS.xsif"
  SET, SETXL2WIG,  1
  SET, KQEM1B,  1.984881258518 ! 1.986297644848
  SET, KQEM2B, -1.820436227055 !-1.820291710826
  SET, KQEM3B,  1.250067757678 ! 1.250341381674
  SET, KQEM4B, -0.869065401564 !-0.86977238973

 !MXL

  UMXL1h, TYPE="UMXL1-XL2"
  UMXL3h, TYPE="UMXL3-XL2"
  UMXL4h, TYPE="UMXL4-XL2"
  WIGXLh, TYPE="WIGXL-XL2"

 !COMMENT !SXR from Cu linac (XLEAP-II)
    ASSIGN, PRINT="LCLS2cuS-XL2.print"
    TITLE, "AD_ACCEL_HE copper linac: WS02 to SXR (XLEAP)"
    BEAM, ENERGY=Ei
    USE, LCLS2cuSe
    PRINT, FULL
    SURVEY, X0=XWS02, Z0=ZWS02, THETA0=ADL1, TAPE="LCLS2cuS-XL2_survey.tape"
    TWISS, SAVE, BETA0=TWSSi, TAPE="LCLS2cuS-XL2_twiss.tape" !, &
   !  RTAPE="LCLS2cuS-XL2_rmat.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=MM1B/SXR40END, FILE="LCLS2cuS-XL2", &
      TITLE="XLEAP-II (from Cu linac): LTUS-UNDS"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=MM2B/SXR40END, FILE="LCLS2cuS-XL2", &
      TITLE="XLEAP-II (from Cu linac): LTUS-UNDS"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=WS31B/SXR40END, FILE="LCLS2cuS-XL2", &
      TITLE="XLEAP-II (from Cu linac): LTUS-UNDS"
 !ENDCOMMENT

! ------------------------------------------------------------------------------

  RETURN
