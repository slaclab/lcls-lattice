
! *** OPTICS=AD_ACCEL-preRelease ***

! XLEAP-II optics

! ==============================================================================
! Modification History
! ------------------------------------------------------------------------------
! 07-APR-2024, M. Woodley
!  * remove UMXL2; move WIGXLH from SXR cell 18 to UMXL2 location
! ------------------------------------------------------------------------------

  KmaxQA    := 150.00/(Brhof*LQA) !max |K1| @ Ef for 1.26Q12    (165 A bipolar )
  KmaxQE200 := 102.00/(Brhof*LQE) !max |K1| @ Ef for 1.085Q4.31 (200 A bipolar )
  KmaxQE120 :=  67.00/(Brhof*LQE) !max |K1| @ Ef for 1.085Q4.31 (120 A bipolar )
  KmaxQx    :=  20.00/(Brhof*LQx) !max |K1| @ Ef for 1.26Q3.5   ( 12 A bipolar )
  KmaxQE110 :=  60.00/(Brhof*LQE) !max |K1| @ Ef for 1.085Q4.31 (110 A unipolar)
  KmaxQu    :=  40.00/(Brhof*LQu) !max |K1| @ Ef for 0.433Q3.1  (  6 A bipolar )

 !VALUE, Ef,KmaxQA,KmaxQE200,KmaxQE120,KmaxQx,KmaxQE110,KmaxQu

! ------------------------------------------------------------------------------

  SETXL_8GeV : SUBROUTINE
    SET, Ef, 8.0 ; SET, Eu, Ef
   !COMMENT !turn on UMXL1 (default)
      SET, R11XL1,  1.024433796036150 
      SET, R12XL1,  1.678538794967410 
      SET, R21XL1,  0.029468846719147 
      SET, R22XL1,  1.024433796036150 
      SET, R33XL1,  0.975763600637818 
      SET, R34XL1,  1.651526938083830 
      SET, R43XL1, -0.028994619806734 
      SET, R44XL1,  0.975763600637818 
     !comment !UMXL1 on; WIGXL on (default)
        SET, SETXL2WIG, 1
        SET, KQEM2B, -1.833878525626
        SET, KQEM3B,  1.282001485476
        SET, KQEM4B, -0.677960714845
        SET, KQE31B,  0.0
        SET, KQFXL1,  0.765992557763
     !endcomment
      comment !UMXL1 on; WIGXL off
        SET, SETXL2WIG, 0
        SET, KQEM2B, -1.821907117672
        SET, KQEM3B,  1.295837297793
        SET, KQEM4B, -0.70597659487
        SET, KQE31B,  0.0
        SET, KQFXL1,  0.77027189517
      endcomment
   !ENDCOMMENT
   !COMMENT !turn on UMXL3 and UMXL4 (default)
      SET, R11XL3,  1.024433796036150 ; SET, R11XL4, R11XL3
      SET, R12XL3,  1.678538794967410 ; SET, R12XL4, R12XL3
      SET, R21XL3,  0.029468846719147 ; SET, R21XL4, R21XL3
      SET, R22XL3,  1.024433796036150 ; SET, R22XL4, R22XL3
      SET, R33XL3,  0.975763600637818 ; SET, R33XL4, R33XL3
      SET, R34XL3,  1.651526938083830 ; SET, R34XL4, R34XL3
      SET, R43XL3, -0.028994619806734 ; SET, R43XL4, R43XL3
      SET, R44XL3,  0.975763600637818 ; SET, R44XL4, R44XL3
     !comment !UMXL3 and UMXL4 on; BCXXL self-seeding chicane on (default)
        SET, SETXL2SS, 1
        SET, KQFXL2,  0.812614232951
        SET, KQE36B,  0.0
        SET, KQUM1B,  0.419433960154
        SET, KQUM2B, -0.559270052588
        SET, KQUM3B,  0.615058220771
        SET, KQUM4B, -0.608532103456
        SET, KQSX16,  0.546990157901
        SET, KQSX19, -0.859609899134
        SET, KQSX21,  1.013584755328
        SET, KQSX24, -0.967412935883
     !endcomment
      comment !UMXL3 and UMXL4 on; BCXXL self-seeding chicane off
        SET, SETXL2SS, 0
        SET, KQFXL2,  0.860104338552
        SET, KQE36B, -0.076705358888
        SET, KQUM1B,  0.432445917728
        SET, KQUM2B, -0.543710104726
        SET, KQUM3B,  0.607421987716
        SET, KQUM4B, -0.602511521244
        SET, KQSX16,  0.54473236654
        SET, KQSX19, -0.858451650515
        SET, KQSX21,  1.012979545073
        SET, KQSX24, -0.966377525622
      endcomment
   !ENDCOMMENT
  ENDSUBROUTINE

! ------------------------------------------------------------------------------

  MXL01 : SUBROUTINE !match into XLEAP-II
    BEAM, ENERGY=E00
    USE, CU_SXR
    VALUE, KQEM2B,KQEM3B,KQEM4B,KQE31B,KQFXL1
    MATCH, BETA0=TWSSC
      VARY, KQEM2B, STEP=1.E-6, LOWER=-KmaxQE200, UPPER=+KmaxQE200
      VARY, KQEM3B, STEP=1.E-6, LOWER=-KmaxQE120, UPPER=+KmaxQE120
      VARY, KQEM4B, STEP=1.E-6, LOWER=-KmaxQE120, UPPER=+KmaxQE120
      VARY, KQE31B, STEP=1.E-6, LOWER=-KmaxQx,    UPPER=+KmaxQx
      VARY, KQFXL1, STEP=1.E-6, LOWER= 0,         UPPER=+KmaxQE110
      WEIGHT, DX=0, DPX=0, DY=0, DPY=0
      CONSTR, QE32B[1], LINE=(QE32B,DQEC,DQEC,QE33B,QE33B,DQEC,DQEC,QE32B)
      CONSTR, #E, X=0, PX=0, Y=0, PY=0
      LMDIF, TOL=1.E-20
      MIGRAD, TOL=1.E-20
    ENDMATCH
    VALUE, KQEM2B,KQEM3B,KQEM4B,KQE31B,KQFXL1
    TWISS, SAVE, BETA0=TWSSC, TAPE="twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, RANGE=MM1B/WS34B, &
      STYLE=100, SPLINE, FILE="match"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, RANGE=VBOUTB/WS34B, &
      STYLE=100, SPLINE, FILE="match"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, RANGE=VBOUTB/MBLMS48, &
      STYLE=100, SPLINE, FILE="match"
  ENDSUBROUTINE

  MXL02 : SUBROUTINE !match XLEAP-II into UNDS
    BEAM, ENERGY=E00
    USE, CU_SXR
    VALUE, KQFXL2,KQE36B,KQUM1B,KQUM2B,KQUM3B,KQUM4B
    VALUE, KQSX16,KQSX19,KQSX21,KQSX24
    MATCH, BETA0=TWSSC
      VARY, KQFXL2, STEP=1.E-6, LOWER= 0,         UPPER=+KmaxQE110
      VARY, KQE36B, STEP=1.E-6, LOWER=-KmaxQx,    UPPER= 0
      VARY, KQUM1B, STEP=1.E-6, LOWER=-KmaxQE120, UPPER=+KmaxQE120
      VARY, KQUM2B, STEP=1.E-6, LOWER=-KmaxQE120, UPPER=+KmaxQE120
      VARY, KQUM3B, STEP=1.E-6, LOWER=-KmaxQE120, UPPER=+KmaxQE120
      VARY, KQUM4B, STEP=1.E-6, LOWER=-KmaxQE120, UPPER=+KmaxQE120
      VARY, KQSX16, STEP=1.E-6, LOWER=-1.499*0,  UPPER= 1.499    !10 GeV
      VARY, KQSX19, STEP=1.E-6, LOWER=-1.499,    UPPER= 1.499*0
      VARY, KQSX21, STEP=1.E-6, LOWER=-1.499*0,  UPPER= 1.499
      VARY, KQSX24, STEP=1.E-6, LOWER=-1.499,    UPPER= 1.499*0
      CONSTR, QUM1B[1],  BETX=60
      CONSTR, QUM2B[1],  BETY=60
      CONSTR, QUM3B[1],  BETX=60
      CONSTR, QUM4B[1],  BETY=60
      CONSTR, QSXh16[1], BETX=55
      CONSTR, QSXh21[1], BETX<45
    ! periodic betas in cells 26-46
      WEIGHT, X=0, PX=0, BETX=1, ALFX=0, DX=0, DPX=0, &
              Y=0, PY=0, BETY=1, ALFY=0, DY=0, DPY=0, &
              T=0, PT=0
      COUPLE, QSXh26[1]/QSXh28[1]
      COUPLE, QSXh27[1]/QSXh29[1]
      COUPLE, QSXh26[1]/QSXh30[1]
      COUPLE, QSXh27[1]/QSXh31[1]
      COUPLE, QSXh26[1]/QSXh32[1]
      COUPLE, QSXh27[1]/QSXh33[1]
      COUPLE, QSXh26[1]/QSXh34[1]
      COUPLE, QSXh27[1]/QSXh35[1]
      COUPLE, QSXh26[1]/QSXh36[1]
      COUPLE, QSXh27[1]/QSXh37[1]
      COUPLE, QSXh26[1]/QSXh38[1]
      COUPLE, QSXh27[1]/QSXh39[1]
      COUPLE, QSXh26[1]/QSXh40[1]
      COUPLE, QSXh27[1]/QSXh41[1]
      COUPLE, QSXh26[1]/QSXh42[1]
      COUPLE, QSXh27[1]/QSXh43[1]
      COUPLE, QSXh26[1]/QSXh44[1]
      COUPLE, QSXh27[1]/QSXh45[1]
      COUPLE, QSXh26[1]/QSXh46[1]
      LMDIF, TOL=1.E-20
      MIGRAD, TOL=1.E-20
    ENDMATCH
    VALUE, KQFXL2,KQE36B,KQUM1B,KQUM2B,KQUM3B,KQUM4B
    VALUE, KQSX16,KQSX19,KQSX21,KQSX24
    PRINT, FULL
    TWISS, SAVE, BETA0=TWSSC, TAPE="twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=WS31B/MBLMS48, FILE="match"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=MM1B/MBLMS48, FILE="match"
  ENDSUBROUTINE

! ------------------------------------------------------------------------------
! create ELEGANT beamline (start at WS02)
! ------------------------------------------------------------------------------

  BEGDL1_1e : MARK
  ENDDL1_1e : MARK

  DL1_1e : LINE=(BEGDL1_1e,&
    WS02,DE05a,MRK0,DE05a,OTR2,DE06d,BPM10,DE06e,WS03,DE05,OTR3,DE07,&
    QM01,BPM11,QM01,DE08,SC8,DE08a,VV04,DE08b,&
    QM02,BPM12,QM02,DE09,DBMARK82,&
    ENDDL1_1e)

  LCLS2cuSe : LINE=(DL1_1e,DL1_2,L1,BC1,L2,BC2,L3,BSYLTUS)

! ------------------------------------------------------------------------------

! to run XLEAP-II optics, uncomment the SUBROUTINE(s) with the desired
! undulator(s) turned on (UMXL1 and/or UMXL3&UMXL4); within the selected
! SUBROUTINE(s), turn on WIGXL and/or BCXLSS chicane

  SET, SETCUS, CUSON
  SETK2cuS
  SETXL_8GeV

 !MXL01
 !MXL02

 !COMMENT !SXR from Cu linac (XLEAP-II)
    ASSIGN, PRINT="LCLS2cuS-XL2.print"
    BEAM, ENERGY=Ei
    USE, LCLS2cuSe
    PRINT, FULL
    SURVEY, X0=XWS02, Z0=ZWS02, THETA0=ADL1, TAPE="LCLS2cuS-XL2_survey.tape"
    TWISS, SAVE, BETA0=TWSSi, TAPE="LCLS2cuS-XL2_twiss.tape" !, &
   !  RTAPE="LCLS2cuS-XL2_rmat.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
      STYLE=100, SPLINE, RANGE=WS31B/SXR46END, FILE="LCLS2cuS-XL2", &
      TITLE="XLEAP-II (from Cu linac): LTUS-UNDS"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
      STYLE=100, SPLINE, RANGE=WS31B/#E, FILE="LCLS2cuS-XL2", &
      TITLE="XLEAP-II (from Cu linac): DMPS"
 !ENDCOMMENT

! ------------------------------------------------------------------------------

  RETURN
