! ------------------------------------------------------------------------------

! SXR from Cu linac (XLEAP-II)

  ASSIGN, PRINT="LCLS2cuS-XL2.print"
  BEAM, ENERGY=E00
  SET, SETCUS, CUSON
  SETK2cuS
  USE, CU_SXR
  SAVEBETA, TWXL, VBOUTB
  TWISS, BETA0=TWSSC
  BEAM, ENERGY=Ef
  SETK2XL2 !turns on XLEAP2 components and optics
  USE, CU_SXR, RANGE=VBOUTB/#E
  PRINT, FULL
  TWISS, SAVE, &
    BETX=TWXL[BETX], ALFX=TWXL[ALFX], &
    BETY=TWXL[BETY], ALFY=TWXL[ALFY], &
    TAPE="LCLS2cuS-XL2_twiss.tape" !, RTAPE="LCLS2cuS-XL2_rmat.tape"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    STYLE=100, SPLINE, RANGE=#S/DU7S[31], FILE="LCLS2cuS-XL2", &
    TITLE="XLEAP-II (from Cu linac): LTUS-UNDS"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    STYLE=100, SPLINE, RANGE=DU7S[26]/#E, FILE="LCLS2cuS-XL2", &
    TITLE="XLEAP-II (from Cu linac): DMPS"

! ------------------------------------------------------------------------------

  RETURN
  
