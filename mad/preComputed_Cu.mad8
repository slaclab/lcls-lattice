
! *** OPTICS=AD_ACCEL-preRelease ***

! plot pre-computed cuH and cuS UND/DMP match for Cu linac

  SETK2cuH : SUBROUTINE !for LCLS2cuH

  ! set quad strengths for 8 GeV Cu-linac beam to DMPH

    SET, KQ50Q3,  0.384840836193
    SET, KQ4,    -0.219396715005
    SET, KQ5,     0.165708852387
    SET, KQ6,    -0.11356910147 
    SET, KQA0,    0.109210100871
    SET, KQEM1,  -0.390827735955
    SET, KQEM2,   0.432215708115
    SET, KQEM3,  -0.593433950485
    SET, KQEM4,   0.420485259237 
  !                     Cu               SC
  !              ---------------  ---------------
    SET, KQUM1,   0.270162407674 ! 0.270162424021
    SET, KQUM2,  -0.268570186281 !-0.2685706757  
    SET, KQUM3,   0.279943504421 ! 0.279944439407
    SET, KQUM4,  -0.248916019554 !-0.248916368758 
  ENDSUBROUTINE

  PRECOMPUTEDcuH : SUBROUTINE
    BEAM, ENERGY=E00
    SET, SETCUS, CUSOFF
    SETK2cuH
    SET, QUM1[K1],    0.272149768728
    SET, QUM2[K1],   -0.271562998938
    SET, QUM3[K1],    0.28573385389
    SET, QUM4[K1],   -0.250918113669
    SET, QHXH46[K1], -1.734624260269
    SET, QUE1[K1],    0.167448692306
    SET, QUE2[K1],   -0.13160638771
    SET, QDMP1[K1],  -0.155212710055
    SET, QDMP2[K1],  -0.155212710055
    USE, CU_HXR
    PRINT, FULL
    TWISS, BETA0=TWSSC, SAVE, TAPE="LCLS2cuH-pc_twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=WS31/HXR46END, &
      TITLE="LTUH-UNDH (8 GeV): pre-computed", FILE="preComputed_Cu"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
      STYLE=100, SPLINE, RANGE=QHXh44[1]/DUMPFACE, &
      TITLE="HXR undulator to Dump: pre-computed", FILE="preComputed_Cu"
    MATCH, BETA0=TWSSC
      WEIGHT, X=0, PX=0, BETX=0, ALFX=0, DX=0, DPX=0, &
              Y=0, PY=0, BETY=0, ALFY=0, DY=0, DPY=0, &
              T=0, PT=0
      COUPLE, MTCX/OTRDMP, MUX=90/360 !90 deg phase advance
    ENDMATCH
  ENDSUBROUTINE

  SETK2cuS : SUBROUTINE !for LCLS2cuS

  ! set quad strengths for 8 GeV Cu-linac beam to DMPS

  !                     Cu               SC
  !              ---------------  ---------------
    SET, KQBP33, -0.644538157053 !-0.372473815777
    SET, KQBP34,  0.597475524331 ! 0.549116661002
    SET, KQDBL1, -1.080108740787 !-0.050435325198
    SET, KQDBL2,  0.639673976657 !-0.559283770709
    SET, KQDL11,  0.359471462077 ! 0.424676241757
    SET, KQUM1B,  0.871966671619 ! 0.869377269121
    SET, KQUM2B, -0.778887082233 !-0.772006115975
    SET, KQUM3B,  0.691114674342 ! 0.687923619093
    SET, KQUM4B, -0.756677336763 !-0.755990352295
    SET, KQSX47, -1.512380788874 !-1.45061403166
    SET, KQUE1B,  0.32130962958  ! 0.320428735099
  ENDSUBROUTINE

  PRECOMPUTEDcuS : SUBROUTINE
    BEAM, ENERGY=E00
    SET, SETCUS, CUSON
    SETK2cuS
    SET, QUM1B[K1],   0.604482303974
    SET, QUM2B[K1],  -0.884589061802
    SET, QUM3B[K1],   0.885976866748
    SET, QUM4B[K1],  -0.523377939439
    SET, QSXH16[K1],  0.441193830702
    SET, QSXH47[K1], -1.5985
    SET, QUE1B[K1],   0.252918560633
    SET, QUE2B[K1],   0.0
    SET, QDMP1B[K1], -0.15111165919
    SET, QDMP2B[K1], -0.15111165919
    USE, CU_SXR
    PRINT, FULL
    TWISS, BETA0=TWSSC, SAVE, TAPE="LCLS2cuS-pc_twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=WS31B/SXR46END, &
      TITLE="LTUS-UNDS (8 GeV): preComputed", FILE="preComputed_Cu"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
      STYLE=100, SPLINE, RANGE=QSXh44[1]/DUMPFACEB, &
      TITLE="SXR undulator to Dump (COUPLE): preComputed", FILE="preComputed_Cu"
    MATCH, BETA0=TWSSC
      WEIGHT, X=0, PX=0, BETX=0, ALFX=0, DX=0, DPX=0, &
              Y=0, PY=0, BETY=0, ALFY=0, DY=0, DPY=0, &
              T=0, PT=0
      COUPLE, MTCXB/OTRDMPB, MUX=90/360 !90 deg phase advance
    ENDMATCH
  ENDSUBROUTINE
 
  PRECOMPUTEDcuH
  PRECOMPUTEDcuS

  RETURN
