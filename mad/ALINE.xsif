  B26 : SBEN, TYPE="Aline_bend", HGAP=GBA/2, L=LBA, ANGLE=ABA, &
              E1=ABA/2, FINT=0.5, E2=ABA/2, FINTX=0.5

! ESA bends (E158)

  LD1S := 1.83
  LD2S := 3.45
  LD3S := 3.45

  AD1S :=  0.022344631354
  AD2S := -0.044690490267
  AD3S :=  0.022345239962

  BXD1Sa : SBEN ,L=LD1S/2, ANGLE=AD1S/2, FINT=0, FINTX=0
  BXD1Sb : SBEN ,L=LD1S/2, ANGLE=AD1S/2, FINT=0, FINTX=0
  BXD2Sa : SBEN ,L=LD2S/2, ANGLE=AD2S/2, FINT=0, FINTX=0
  BXD2Sb : SBEN ,L=LD2S/2, ANGLE=AD2S/2, FINT=0, FINTX=0
  BXD3Sa : SBEN ,L=LD3S/2, ANGLE=AD3S/2, FINT=0, FINTX=0
  BXD3Sb : SBEN ,L=LD3S/2, ANGLE=AD3S/2, FINT=0, FINTX=0

! define unsplit SBENs for BMAD ... not used by MAD

  BXD1S : SBEN ,L=LD1S, ANGLE=AD1S, FINT=0, FINTX=0
  BXD2S : SBEN ,L=LD2S, ANGLE=AD2S, FINT=0, FINTX=0
  BXD3S : SBEN ,L=LD3S, ANGLE=AD3S, FINT=0, FINTX=0

