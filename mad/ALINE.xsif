  B26b : SBEN, L=LBA/2, HGAP=GBA/2, ANGLE=ABA/2, E2=ABA/2, FINT=0, FINTX=0.5, &
               TYPE="Aline_bend"

! define unsplit SBENs for BMAD ... not used by MAD

  B11 : SBEN, TYPE="Aline_bend", HGAP=GBA/2, L=LBA, ANGLE=ABA, &
              E1=ABA/2, FINT=0.5, E2=ABA/2, FINTX=0.5
  B12 : SBEN, TYPE="Aline_bend", HGAP=GBA/2, L=LBA, ANGLE=ABA, &
