  SET, SETSP, SETSPs ; SET, SETCUS, CUSOFF
  USE, SC_STXI
  PRINT, FULL
  SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="LCLS2scSTXI_survey.tape"

  ASSIGN, PRINT="LCLS2scSTMO.print"
  BEAM, ENERGY=E0
  SET, SETSP, SETSPs ; SET, SETCUS, CUSOFF
  USE, SC_STMO
  PRINT, FULL
