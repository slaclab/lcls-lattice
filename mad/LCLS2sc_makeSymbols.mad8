
! *** OPTICS=AD_ACCEL-preRelease (2025b) ***

! generate output files for RDB generation

! ------------------------------------------------------------------------------
! SURVEY tape files (linac coordinates)
! ------------------------------------------------------------------------------

! use default K-values

  ASSIGN, PRINT="DIAG0.print"
  BEAM, ENERGY=E0
  USE, SC_DIAG0
  PRINT, FULL
  SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="DIAG0_survey.tape"

  ASSIGN, PRINT="LCLS2scH.print"
  BEAM, ENERGY=E0
  SET, SETSP, SETSPh
  USE, SC_HXR
  PRINT, FULL
  SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="LCLS2scH_survey.tape"

  ASSIGN, PRINT="LCLS2scS.print"
  BEAM, ENERGY=E0
  SET, SETSP, SETSPs ; SET, SETCUS, CUSOFF
  USE, SC_SXR
  PRINT, FULL
  SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="LCLS2scS_survey.tape"

  ASSIGN, PRINT="LCLS2scD.print"
  BEAM, ENERGY=E0
  SET, SETSP, SETSPd ; SET, SETDA, DAOFF
  USE, SC_BSYD
  PRINT, FULL
  SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="LCLS2scD_survey.tape"

  ASSIGN, PRINT="LCLS2scDA.print"
  BEAM, ENERGY=E0
  SET, SETSP, SETSPd ; SET, SETDA, DAON
  USE, SC_DASEL
  PRINT, FULL
  SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="LCLS2scDA_survey.tape"

