! laser heater undulator K-value and period

  UMHTR_K := K_UND ; UMHTR_L := LAM ; VALUE, UMHTR_K,UMHTR_L

! XLEAP-II undulator K-value and period (UMXL2 removed)

  UMXL1H_K := Kund ; UMXL1H_L := lamu ; VALUE, UMXL1H_K,UMXL1H_L
  UMXL3H_K := Kund ; UMXL3H_L := lamu ; VALUE, UMXL3H_K,UMXL3H_L
  UMXL4H_K := Kund ; UMXL4H_L := lamu ; VALUE, UMXL4H_K,UMXL4H_L

