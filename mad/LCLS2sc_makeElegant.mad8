! scS

  L0ZWAKE : MARK, TYPE="WAKE"
  BEAM1   : MARK, TYPE="WATCH"

  BEAM0,    TYPE="WATCH"
  LHBEGB,   TYPE="WATCH"
  LHENDB,   TYPE="WATCH"
  BEGL1B,   TYPE="WATCH"
  ENDL1B,   TYPE="WATCH"
  BC1BCBEG, TYPE="WATCH"
  BC1BCEND, TYPE="WATCH"
  BEGL2B,   TYPE="WATCH"
  ENDL2B,   TYPE="WATCH"
  BC2BCBEG, TYPE="WATCH"
  BC2BCEND, TYPE="WATCH"
  BEGL3B,   TYPE="WATCH"
  ENDL3B,   TYPE="WATCH"
  CCDLUBEG, TYPE="WATCH"
  CCDLDEND, TYPE="WATCH"
  SXRSTART, TYPE="WATCH"
  MTCX01B,  TYPE="WATCH"
  OTRDMPB,  TYPE="WATCH"

! scH

  HXRSTART, TYPE="WATCH"
  MTCX01,   TYPE="WATCH"
  OTRDMP,   TYPE="WATCH"

! scD

  DUMPBSY,  TYPE="WATCH"

! scDA

  MADET,  TYPE="WATCH"
  MADUMP, TYPE="WATCH"

! DIAG0

  BEGDIAG0, TYPE="WATCH"
  OTRDG02,  TYPE="WATCH"
  OTRDG04,  TYPE="WATCH"
  ENDDIAG0, TYPE="WATCH"

! DIAG02

  BEAM0LEI, TYPE="WATCH"
  BEGLEI_2, TYPE="WATCH"
  ENDLEI_2, TYPE="WATCH"

! DIAGIS

  MTCXDGI,    TYPE="WATCH"
  BEGDIAGI_2, TYPE="WATCH"
  OTRDGI1,    TYPE="WATCH"
  DUMPFACEI,  TYPE="WATCH"

! ------------------------------------------------------------------------------
! generate TWISS and SURVEY tape-files
! ------------------------------------------------------------------------------

  TITLE, "AD_ACCEL: superconducting linac: BEAM0 to DIAG0"
  BEAM, ENERGY=Ei
  USE, SC_DIAG0i
  TWISS, BETA0=TWSSi, TAPE="DIAG0_twiss.tape"
  SURVEY, X0=Xgun, Y0=Ygun, Z0=Zi, TAPE="DIAG0_survey.tape"

  TITLE, "AD_ACCEL: superconducting linac: BEAM0 to HXR"
  BEAM, ENERGY=Ei
  SET, SETSP, SETSPh
  USE, SC_HXRi
  TWISS, BETA0=TWSSi, TAPE="LCLS2scH_twiss.tape"
  SURVEY, X0=Xgun, Y0=Ygun, Z0=Zi, TAPE="LCLS2scH_survey.tape"

  TITLE, "AD_ACCEL: superconducting linac: BEAM0 to SXR"
  BEAM, ENERGY=Ei
  SET, SETSP, SETSPs ; SET, SETCUS, CUSOFF
  USE, SC_SXRi
  TWISS, BETA0=TWSSi, TAPE="LCLS2scS_twiss.tape"
  SURVEY, X0=Xgun, Y0=Ygun, Z0=Zi, TAPE="LCLS2scS_survey.tape"

  TITLE, "AD_ACCEL: superconducting linac: BEAM0 to BSY dump"
  BEAM, ENERGY=Ei
  SET, SETSP, SETSPd ; SET, SETDA, DAOFF
  USE, SC_BSYDi
  TWISS, BETA0=TWSSi, TAPE="LCLS2scD_twiss.tape"
  SURVEY, X0=Xgun, Y0=Ygun, Z0=Zi, TAPE="LCLS2scD_survey.tape"

  TITLE, "AD_ACCEL: superconducting linac: BEAM0 to DASEL"
  BEAM, ENERGY=Ei
  SET, SETSP, SETSPd ; SET, SETDA, DAON
  USE, SC_DASELi, RANGE=#S/MADUMP
  TWISS, BETA0=TWSSi, TAPE="LCLS2scDA_twiss.tape"
  SURVEY, X0=Xgun, Y0=Ygun, Z0=Zi, TAPE="LCLS2scDA_survey.tape"

! ------------------------------------------------------------------------------

! for beam from LEI injector

  TITLE, "AD_ACCEL: superconducting linac: BEAM0LEI to DIAGI"
  BEAM, ENERGY=Ei
 !CALL, FILENAME="SETK2scDGI.xsif" !for mux=1.75*2pi from TCXDGI to OTRDGI1_OTR
  USE, SC_DIAGISi
  TWISS, BETA0=TWSSiLEI, TAPE="DIAGIS_twiss.tape"
  SURVEY, X0=Xgun2, Y0=Ygun2, Z0=ZiLEI, TAPE="DIAGIS_survey.tape"

  CALL, FILENAME="SETK2scLEI.xsif" !special match from LEI dogleg to laser heater

  TITLE, "AD_ACCEL: superconducting linac: BEAM0LEI to DIAG0"
  BEAM, ENERGY=Ei
  USE, SC_DIAG0i2
  TWISS, BETA0=TWSSiLEI, TAPE="DIAG02_twiss.tape"
  SURVEY, X0=Xgun2, Y0=Ygun2, Z0=ZiLEI, TAPE="DIAG02_survey.tape"

  TITLE, "AD_ACCEL: superconducting linac: BEAM0LEI to HXR"
  BEAM, ENERGY=Ei
  SET, SETSP, SETSPh
  USE, SC_HXRi2
  TWISS, BETA0=TWSSiLEI, TAPE="LCLS2scH2_twiss.tape"
  SURVEY, X0=Xgun2, Y0=Ygun2, Z0=ZiLEI, TAPE="LCLS2scH2_survey.tape"

  TITLE, "AD_ACCEL: superconducting linac: BEAM0LEI to SXR"
  BEAM, ENERGY=Ei
  SET, SETSP, SETSPs ; SET, SETCUS, CUSOFF
  USE, SC_SXRi2
  TWISS, BETA0=TWSSiLEI, TAPE="LCLS2scS2_twiss.tape"
  SURVEY, X0=Xgun2, Y0=Ygun2, Z0=ZiLEI, TAPE="LCLS2scS2_survey.tape"

  TITLE, "AD_ACCEL: superconducting linac: BEAM0LEI to BSY dump"
  BEAM, ENERGY=Ei
  SET, SETSP, SETSPd ; SET, SETDA, DAOFF
  USE, SC_BSYDi2
  TWISS, BETA0=TWSSiLEI, TAPE="LCLS2scD2_twiss.tape"
  SURVEY, X0=Xgun2, Y0=Ygun2, Z0=ZiLEI, TAPE="LCLS2scD2_survey.tape"

  TITLE, "AD_ACCEL: superconducting linac: BEAM0LEI to DASEL"
  BEAM, ENERGY=Ei
  SET, SETSP, SETSPd ; SET, SETDA, DAON
  USE, SC_DASELi2, RANGE=#S/MADUMP
  TWISS, BETA0=TWSSiLEI, TAPE="LCLS2scDA2_twiss.tape"
  SURVEY, X0=Xgun2, Y0=Ygun2, Z0=ZiLEI, TAPE="LCLS2scDA2_survey.tape"

! ------------------------------------------------------------------------------

! undo SETK2scLEI for beam from LCLS-II injector

  RESETHTRQ !copy from INJ.xsif

