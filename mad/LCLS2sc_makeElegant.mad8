
! *** OPTICS=AD_ACCEL-01JUN2026s ***

! generate input files for ELEGANT

! ==============================================================================
! Instructions for generating ELEGANT input file
! ------------------------------------------------------------------------------
! 1) Copy HTR QUAD strengths to SUBROUTINE RESETHTRQ from INJ.xsif
! 2) insert the following line into your MAD deck:
!      CALL, FILENAME="makeElegant.mad8"
! 3) run MAD
! 4) create an SBEN definition file (for generating an ELEGANT lte-file with
!    CSR) ... there should be one line per bend (name, bunch length, FINT)
! 5) run mad2lte with survey.tape as input
! 6) if your beamline contains MATRIX elements, create Elegant .rmat files
! ------------------------------------------------------------------------------

! ==============================================================================
! SUBROUTINE
! ------------------------------------------------------------------------------

! undo SETK2scLEI

  RESETHTRQ : SUBROUTINE !copy from INJ.xsif
    SET, KQ0H03,   0.483905171963
    SET, KQ0H04,  -3.971575402157
  !                 heater ON        heater OFF        chicane OFF       
  !              ---------------   ---------------   ---------------    
    SET, KQ0H05,  -2.32266979602  ! -7.451315276972 ! -7.508072657056 
    SET, KQ0H06,   0.0            !  1.835321381141 !  1.870908387696
    SET, KQ0H07,   5.84302489781  !  7.794364472964 !  7.804907479846
    SET, KQ0H08,  -5.210258454761 ! -8.272684492892 ! -8.306722243051
    SET, KQHD01, -13.178598580237 ! -8.743988237466 ! -8.746794738551
    SET, KQHD02,   7.650668410884 !  6.400024228564 !  6.401620200768
    SET, KQHD03,  -7.978934972385 ! -8.612136694917 ! -8.622952974048
    SET, KQHD04,   6.238682089532 !  6.860670498454 !  6.864937307631
  ENDSUBROUTINE

! ==============================================================================

