! ------------------------------------------------------------------------------
! special MARKER elements
! ------------------------------------------------------------------------------

! scS

  L0ZWAKE : MARK, TYPE="WAKE"
  BEAM1   : MARK, TYPE="WATCH"

  BEAM0,    TYPE="WATCH"
  LHBEGB,   TYPE="WATCH"
  LHENDB,   TYPE="WATCH"
  BEGL1B,   TYPE="WATCH"
  ENDL1B,   TYPE="WATCH"
  BC1BCBEG, TYPE="WATCH"
  BC1BCEND, TYPE="WATCH"
  BEGL2B,   TYPE="WATCH"
  ENDL2B,   TYPE="WATCH"
  BC2BCBEG, TYPE="WATCH"
  BC2BCEND, TYPE="WATCH"
  BEGL3B,   TYPE="WATCH"
  ENDL3B,   TYPE="WATCH"
  CCDLUBEG, TYPE="WATCH"
  CCDLDEND, TYPE="WATCH"
  SXRSTART, TYPE="WATCH"
  MTCX01B,  TYPE="WATCH"
  OTRDMPB,  TYPE="WATCH"

! scH

  HXRSTART, TYPE="WATCH"
  MTCX01,   TYPE="WATCH"
  OTRDMP,   TYPE="WATCH"

! scD

  DUMPBSY,  TYPE="WATCH"

! DIAG0

  BEGDIAG0, TYPE="WATCH"
  OTRDG02,  TYPE="WATCH"
  OTRDG04,  TYPE="WATCH"
  ENDDIAG0, TYPE="WATCH"

! ------------------------------------------------------------------------------
! generate TWISS and SURVEY tape-files
! ------------------------------------------------------------------------------

! NOTE: DIAG0 Twiss will be incorrect becaues we changed DYQDG00* from MULTs to MATRs

  TITLE, "AD_ACCEL: superconducting linac to DIAG0"
  BEAM, ENERGY=Ei
  USE, SC_DIAG0i
  TWISS, BETA0=TWSSi, TAPE="DIAG0_twiss.tape"
  SURVEY, X0=Xgun, Y0=Ygun, Z0=Zi, TAPE="DIAG0_survey.tape"

  TITLE, "AD_ACCEL: superconducting linac to HXR"
  BEAM, ENERGY=Ei
  SET, SETSP, SETSPh
  USE, SC_HXRi
  TWISS, BETA0=TWSSi, TAPE="LCLS2scH_twiss.tape"
  SURVEY, X0=Xgun, Y0=Ygun, Z0=Zi, TAPE="LCLS2scH_survey.tape"

  TITLE, "AD_ACCEL: superconducting linac to SXR"
  BEAM, ENERGY=Ei
  SET, SETSP, SETSPs ; SET, SETCUS, CUSOFF
  USE, SC_SXRi
  TWISS, BETA0=TWSSi, TAPE="LCLS2scS_twiss.tape"
  SURVEY, X0=Xgun, Y0=Ygun, Z0=Zi, TAPE="LCLS2scS_survey.tape"

  TITLE, "AD_ACCEL: superconducting linac to BSY dump"
  BEAM, ENERGY=Ei
  SET, SETSP, SETSPd ; SET, SETDA, DAOFF
  USE, SC_BSYDi
  TWISS, BETA0=TWSSi, TAPE="LCLS2scD_twiss.tape"
  SURVEY, X0=Xgun, Y0=Ygun, Z0=Zi, TAPE="LCLS2scD_survey.tape"

  TITLE, "AD_ACCEL: superconducting linac to DASEL"
  BEAM, ENERGY=Ei
  SET, SETSP, SETSPd ; SET, SETDA, DAON
  USE, SC_DASELi, RANGE=#S/ENDBSYA
  TWISS, BETA0=TWSSi, TAPE="LCLS2scDA_twiss.tape"
  SURVEY, X0=Xgun, Y0=Ygun, Z0=Zi, TAPE="LCLS2scDA_survey.tape"

! ------------------------------------------------------------------------------

! XLEAP-II optics

  CALL, FILENAME="LCLS2sc_XLEAP.mad8"

 !VALUE, R11XL1,R12XL1,R21XL1,R22XL1
 !VALUE, R33XL1,R34XL1,R43XL1,R44XL1
 !VALUE, R11XL3,R12XL3,R21XL3,R22XL3
 !VALUE, R33XL3,R34XL3,R43XL3,R44XL3
 !VALUE, R11XL4,R12XL4,R21XL4,R22XL4
 !VALUE, R33XL4,R34XL4,R43XL4,R44XL4
 !VALUE, WIGXLh[RM(1,1)],WIGXLh[RM(1,2)],WIGXLh[RM(2,1)],WIGXLh[RM(2,2)]
 !VALUE, WIGXLh[RM(3,3)],WIGXLh[RM(3,4)],WIGXLh[RM(4,3)],WIGXLh[RM(4,4)]

! ------------------------------------------------------------------------------

  VALUE, UMXL1h[L] !no focusing (UMXL1)
  BEAM, ENERGY=Ef
  USE, (UMXL1h) !*LIN.11* (*LIN.10 if LCLS2cu_XLEAP.mad8 not CALLed)
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH

  VALUE, UMXL3h[L] !no focusing (UMXL2)
  BEAM, ENERGY=Ef
  USE, (UMXL3h) !*LIN.12* (*LIN.11 if LCLS2cu_XLEAP.mad8 not CALLed)
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH

  VALUE, UMXL4h[L] !no focusing (UMXL3)
  BEAM, ENERGY=Ef
  USE, (UMXL4h) !*LIN.13* (*LIN.12 if LCLS2cu_XLEAP.mad8 not CALLed)
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH

  VALUE, WIGXLh[L] !vertical focusing (WIGXL)
  BEAM, ENERGY=Ef
  USE, (WIGXLh) !*LIN.14* (*LIN.13 if LCLS2cu_XLEAP.mad8 not CALLed)
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH

! ------------------------------------------------------------------------------

  RETURN
