! set TCAV TYPEs

  TCX01B, TYPE="RFDF"
  TCX01,  TYPE="RFDF"
  TCX02,  TYPE="RFDF"
  TCYDG0, TYPE="RFDF"
  TCXDG0, TYPE="RFDF"

! ------------------------------------------------------------------------------
! output MULT definitions; convert to MATRs
! ------------------------------------------------------------------------------

  BEAM, ENERGY=Ei
  USE, (DYQDG001) !*LIN.01*
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH
  DYQDG001 : MATR, L=0, TYPE="DYQDG001"

  BEAM, ENERGY=Ei
  USE, (DYQDG003) !*LIN.02*
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH
  DYQDG003 : MATR, L=0, TYPE="DYQDG003"

! ------------------------------------------------------------------------------
! output MATR definitions
! ------------------------------------------------------------------------------

  VALUE, UMHTR[L] !vertical focusing (UMLHB)
  BEAM, ENERGY=Ei
  USE, (UMHTR) !*LIN.03*
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH

  VALUE, UMASXh[L] !vertical focusing (VGHPU39)
  BEAM, ENERGY=Ef
  USE, (UMASXh) !*LIN.04*
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH

  VALUE, PSSXh[L] !weak vertical focusing (PS75)
  BEAM, ENERGY=Ef
  USE, (PSSXh) !*LIN.05*
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH

  VALUE, UMASXh_[L] !vertical focusing (VGHPU56)
  BEAM, ENERGY=Ef
  USE, (UMASXh_) !*LIN.06*
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH

  VALUE, PSSXh_[L] !weak vertical focusing (PS97.5)
  BEAM, ENERGY=Ef
  USE, (PSSXh_) !*LIN.07*
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH

  VALUE, UMAHXh[L] !horizontal focusing (HGVPU26)
  BEAM, ENERGY=Ef
  USE, (UMAHXh) !*LIN.08*
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH

  VALUE, PSHXh[L] !weak vertical focusing (PS45)
  BEAM, ENERGY=Ef
  USE, (PSHXh) !*LIN.09*
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH

  UMXL1h, TYPE="UMXL1"
  UMXL3h, TYPE="UMXL3"
  UMXL4h, TYPE="UMXL4"
  WIGXLh, TYPE="WIGXL"

