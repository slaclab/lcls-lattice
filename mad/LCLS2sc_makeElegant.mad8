 !VALUE, WIGXLh[RM(3,3)],WIGXLh[RM(3,4)],WIGXLh[RM(4,3)],WIGXLh[RM(4,4)]

! ------------------------------------------------------------------------------

! output at bottom of LCLS2scS2-XL2.print

  VALUE, UMXL1h[L]
  BEAM, ENERGY=Ef
  USE, (UMXL1h) !*LIN.10*
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH
  UMXL1h, TYPE="UMXL1"

  VALUE, UMXL3h[L]
  BEAM, ENERGY=Ef
  USE, (UMXL3h) !*LIN.11*
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH
  UMXL3h, TYPE="UMXL3"

  VALUE, UMXL4h[L]
  BEAM, ENERGY=Ef
  USE, (UMXL4h) !*LIN.12
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH
  UMXL4h, TYPE="UMXL4"

  VALUE, WIGXLh[L]
  BEAM, ENERGY=Ef
  USE, (WIGXLh) !*LIN.13*
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH
  WIGXLh, TYPE="WIGXL"

