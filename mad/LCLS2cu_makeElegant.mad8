
! *** OPTICS=AD_ACCEL-02SEP2024s ***

! generate input files for ELEGANT

! ==============================================================================
! Instructions for generating ELEGANT input file
! ------------------------------------------------------------------------------
! 1) replace the following line in MAD deck:
!      CALL, FILENAME="LCLS_L1.xsif"
!      CALL, FILENAME="LCLS_L1.xsif"
!      CALL, FILENAME="LCLS_L1.xsif"
!    with:
!      CALL, FILENAME="LCLS_L1e.xsif"
!      CALL, FILENAME="LCLS_L1e.xsif"
!      CALL, FILENAME="LCLS_L1e.xsif"
! 2) insert the following line into your MAD deck:
!      CALL, FILENAME="elegant/makeElegant.mad8"
! 3) run MAD
! 4) create an SBEN definition file (for generating an ELEGANT lte-file with
!    CSR) ... there should be one line per bend (name, bunch length, FINT)
! 5) run mad2lte with survey.tape as input
! 6) if your beamline contains MATRIX elements, create Elegant MATRIX files
! ------------------------------------------------------------------------------

! set TCAV TYPE (add frequency where not already defined)

  TCAV0,  TYPE="RFDF", FREQ=SbandF
  TCAV3,  TYPE="RFDF", FREQ=SbandF
  TCX01,  TYPE="RFDF"
  TCX02,  TYPE="RFDF"
  TCX01B, TYPE="RFDF"

! ------------------------------------------------------------------------------
! output MATR definitions; set TYPE attributes
! ------------------------------------------------------------------------------

  VALUE, UMAHXh[L]
  BEAM, ENERGY=Ef
  USE, (UMAHXh) !*LIN.01*
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH

  UMAHXh14, TYPE="UMAHX"
  UMAHXh15, TYPE="UMAHX"
  UMAHXh16, TYPE="UMAHX"
  UMAHXh17, TYPE="UMAHX"
  UMAHXh18, TYPE="UMAHX"
  UMAHXh19, TYPE="UMAHX"
  UMAHXh20, TYPE="UMAHX"

  UMAHXh22, TYPE="UMAHX"
  UMAHXh23, TYPE="UMAHX"
  UMAHXh24, TYPE="UMAHX"
  UMAHXh25, TYPE="UMAHX"
  UMAHXh26, TYPE="UMAHX"
  UMAHXh27, TYPE="UMAHX"

  UMAHXh29, TYPE="UMAHX"
  UMAHXh30, TYPE="UMAHX"
  UMAHXh31, TYPE="UMAHX"
  UMAHXh32, TYPE="UMAHX"
  UMAHXh33, TYPE="UMAHX"
  UMAHXh34, TYPE="UMAHX"
  UMAHXh35, TYPE="UMAHX"
  UMAHXh36, TYPE="UMAHX"
  UMAHXh37, TYPE="UMAHX"
  UMAHXh38, TYPE="UMAHX"
  UMAHXh39, TYPE="UMAHX"
  UMAHXh40, TYPE="UMAHX"
  UMAHXh41, TYPE="UMAHX"
  UMAHXh42, TYPE="UMAHX"
  UMAHXh43, TYPE="UMAHX"
  UMAHXh44, TYPE="UMAHX"
  UMAHXh45, TYPE="UMAHX"
  UMAHXh46, TYPE="UMAHX"
  UMAHXh47, TYPE="UMAHX"

  VALUE, PSHXh[L]
  BEAM, ENERGY=Ef
  USE, (PSHXh) !*LIN.02*
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH

  PSHXh14, TYPE="PSHX"
  PSHXh15, TYPE="PSHX"
  PSHXh16, TYPE="PSHX"
  PSHXh17, TYPE="PSHX"
  PSHXh18, TYPE="PSHX"
  PSHXh19, TYPE="PSHX"
  PSHXh20, TYPE="PSHX"

  PSHXh22, TYPE="PSHX"
  PSHXh23, TYPE="PSHX"
