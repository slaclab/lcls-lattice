  PSHXh43, TYPE="PSHX"
  PSHXh44, TYPE="PSHX"
  PSHXh45, TYPE="PSHX"
  PSHXh46, TYPE="PSHX"

  VALUE, UMASXh[L]
  BEAM, ENERGY=Ef
  USE, (UMASXh) !*LIN.03*
  MATCH, BETX=1, BETY=1
    RMATRIX, #S/#E, RM(6,6)=1
  ENDMATCH
  UMASXh26, TYPE="UMASX"
  UMASXh27, TYPE="UMASX"
  UMASXh28, TYPE="UMASX"
  UMASXh29, TYPE="UMASX"
  UMASXh30, TYPE="UMASX"
  UMASXh31, TYPE="UMASX"
