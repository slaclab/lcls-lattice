  PSSXh32, TYPE="PSSX"
  PSSXh33, TYPE="PSSX"
  PSSXh34, TYPE="PSSX"

  PSSXh36, TYPE="PSSX"
  PSSXh37, TYPE="PSSX"
  PSSXh38, TYPE="PSSX"
  PSSXh39, TYPE="PSSX"
  PSSXh40, TYPE="PSSX"
  PSSXh41, TYPE="PSSX"
  PSSXh42, TYPE="PSSX"
  PSSXh43, TYPE="PSSX"
  PSSXh44, TYPE="PSSX"
  PSSXh45, TYPE="PSSX"
  PSSXh46, TYPE="PSSX"

  UMXL1h, TYPE="UMXL1"
  UMXL3h, TYPE="UMXL3"
  UMXL4h, TYPE="UMXL4"
  WIGXLh, TYPE="WIGXL"

! ------------------------------------------------------------------------------
