  ENDSUBROUTINE

! ------------------------------------------------------------------------------

  ML28 : SUBROUTINE

  ! match LI28 betas

    VALUE, KQ27801,KQ27901,KQ28201,KQ28301
    USE, (L0b,DL1,L1,BC1,L2,BC2,L3)
    MATCH, BETA0=TWSS0
      VARY, KQ27801, STEP=1.E-5 !, LOWER=0   , UPPER=100
      VARY, KQ27901, STEP=1.E-5 !, LOWER=-100, UPPER=0
      VARY, KQ28201, STEP=1.E-5 !, LOWER=0   , UPPER=100
