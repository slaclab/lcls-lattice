! R56 checks

  MR56CUSXR : SUBROUTINE
    BEAM, ENERGY=Ef
    SET, SETCUS, CUSON
    USE, CUSXR
    MATCH, BETA0=TWSCuS1
      WEIGHT, I2=1, I5=1, I5I2=1
      TMATRIX, #S/#E, TM(6,6,6)=0
      RMATRIX, #S/#E, RM(6,6)=1
    ENDMATCH
  ENDSUBROUTINE

