      STYLE=100, SPLINE, FILE="test", RANGE=#S/DBMARK98, &
      TITLE="BEAMPATH=CU_SPECi"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, FILE="test", RANGE=#S/DBMARK98, &
