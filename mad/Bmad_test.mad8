  ENDCOMMENT

! ------------------------------------------------------------------------------

 !COMMENT !DASEL line (aka S30XL, LESA)
    CALL, FILENAME="SC_DASEL.xsif"
    BEAM, ENERGY=E0
    USE, SC_DASEL
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="test_survey.tape"
    BEAM, ENERGY=Ei
    USE, SC_DASELi
    PRINT, FULL
    TWISS, SAVE, BETX=BXi, ALFX=AXi, BETY=BYi, ALFY=AYi, &
      TAPE="test_twiss.tape" !, RTAPE="test_rmat.tape"
   !PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, &
   !  STYLE=100, SPLINE, FILE="test", RANGE=BEAM0/ENDBSYA_2, &
   !  TITLE="BEAMPATH=SC_DASELi"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=RBETX,RBETY, &
      STYLE=100, SPLINE, FILE="test", RANGE=BEAM0/ENDBSYA_2, &
      TITLE="BEAMPATH=SC_DASELi"
   !PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
   !  STYLE=100, SPLINE, FILE="test", RANGE=BEAM0/ENDBSYA_2, &
   !  TITLE="BEAMPATH=SC_DASELi"
 !ENDCOMMENT

! ==============================================================================

 !CU_HXR   : copper linac to e- HXR dump
 !CU_SFTH  : copper linac to e- HXR safety dump
 !CU_SXR   : copper linac to e- SXR dump
 !CU_GPSEC : copper linac to gun spectrometer
 !CU_SPEC  : copper linac to 135 MeV spectrometer

! ------------------------------------------------------------------------------

  COMMENT !CATHODE to WS02
    CALL, FILENAME="CU_HXR.xsif"
    BEAM, ENERGY=E00
    USE, CU_HXR
    PRINT, FULL
    SURVEY, X0=Xi, Y0=0, Z0=Zi, THETA0=ADL1, TAPE="test_survey.tape"
    SAVEBETA, TWm, WS02
    TWISS, SAVE, BETX=CBETX, ALFX=CALFX, BETY=CBETY, ALFY=CALFY, &
      TAPE="test_twiss.tape" !, RTAPE="test_rmat.tape"
    SHOW, TWm
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, &
      STYLE=100, SPLINE, FILE="test", RANGE=#S/WS02, &
      TITLE="Cu-linac: CATHODE to WS02"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, FILE="test", RANGE=#S/WS02, &
      TITLE="Cu-linac: CATHODE to WS02"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
      STYLE=100, SPLINE, FILE="test", RANGE=#S/WS02, &
      TITLE="Cu-linac: CATHODE to WS02"
  ENDCOMMENT

! ------------------------------------------------------------------------------

