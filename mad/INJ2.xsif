      QDLI1,QDLI1,DDLI1a,CEDLI,DDLI1b,DDLI1c,DDLI1d,&
      QDLI2,QDLI2,DDLI2a,DDLI2b,&
      QDLI3,QDLI3,DDLI3a,DDLI3b,&
      BXDLIR1,DDLI4h1,STDLI1,DDLI4h2,CNTDLI,DDLI4h3,STDLI2,DDLI4h4,&
      BXDLIR2,DDLI5a,DDLI5b,&
      QDLI4,QDLI4,DDLI6a,DDLI6b,&
      QDLI5,QDLI5,DDLI7a,SWALLm,SWALL,SWALLm,DDLI7b1,STDLI3,DDLI7b2,&
      QDLI6,QDLI6,DDLI8a,&
      SDLI2,SDLI2,DDLI8b,&
      BXDLI2,&
      ENDLEI_2)
 !ENDCOMMENT

  LEI : LINE=(LEI_1,LEI_2)

! ------------------------------------------------------------------------------

  RETURN
