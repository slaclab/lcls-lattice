
! *** OPTICS=AD_ACCEL-10SEP2026s ***

! XLEAP-II optics

! ==============================================================================
! Modification History
! ------------------------------------------------------------------------------
! 17-MAR-2026, M. Woodley
!  * given that the XLEAP undulators don't focus, there is only one XLEAP
!    "configuration" ... XLEAP wiggler ON (gap closed)
! ------------------------------------------------------------------------------
! 18-SEP-2025, M. Woodley
!  * WIGXL has been (permanently) reinstalled per Gene Kraft
! 17-SEP-2025, M. Woodley
!  * WIGXL is not currently installed
!  * modified UMXL* undulators don't focus/defocus per A. Marinelli
! ------------------------------------------------------------------------------
! 31-AUG-2025, M. Woodley
!  * from ~/git_repos/lcls-lattice/mad/LCLS2sc_XLEAP.mad8
! ------------------------------------------------------------------------------
! 07-APR-2024, M. Woodley
!  * remove UMXL2; move WIGXLH from SXR cell 18 to UMXL2 location
! ------------------------------------------------------------------------------

  KmaxQE200 := 102.00/(Brhof*LQE) !max |K1| @ Ef for 1.085Q4.31 (200 A bipolar )
  KmaxQE120 :=  67.00/(Brhof*LQE) !max |K1| @ Ef for 1.085Q4.31 (120 A bipolar )

 !VALUE, Ef,KmaxQE200,KmaxQE120

! ------------------------------------------------------------------------------

  MXL : SUBROUTINE !match XLEAP-II optics
    BEAM, ENERGY=Ei
    USE, SC_SXRi
    VALUE, KQEM1B,KQEM2B,KQEM3B,KQEM4B
    MATCH, BETA0=TWSSi
      VARY, KQEM1B, STEP=1.E-6, LOWER=-KmaxQE200, UPPER=+KmaxQE200
      VARY, KQEM2B, STEP=1.E-6, LOWER=-KmaxQE200, UPPER=+KmaxQE200
      VARY, KQEM3B, STEP=1.E-6, LOWER=-KmaxQE120, UPPER=+KmaxQE120
      VARY, KQEM4B, STEP=1.E-6, LOWER=-KmaxQE120, UPPER=+KmaxQE120
      WEIGHT, DX=0, DPX=0, DY=0, DPY=0
      CONSTR, QE32B[1], LINE=(QE32B,DQEC,DQEC,QE33B,QE33B,DQEC,DQEC,QE32B)
      CONSTR, #E, X=0, PX=0, Y=0, PY=0
      LMDIF, TOL=1.E-20
      MIGRAD, TOL=1.E-20
    ENDMATCH
    VALUE, KQEM1B,KQEM2B,KQEM3B,KQEM4B
    PRINT, FULL
    TWISS, BETA0=TWSSi, SAVE, TAPE="twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, RANGE=MM1B/WS34B, &
      STYLE=100, SPLINE, FILE="match"
  ENDSUBROUTINE

! ------------------------------------------------------------------------------

  SET, SETSP, SETSPs ; SET, SETCUS, CUSOFF
  SET, SETXL2WIG, 1
  SET, KQEM1B,  1.986297644812 ! 1.986297644861
  SET, KQEM2B, -1.820291710816 !-1.820291710832
  SET, KQEM3B,  1.250341381636 ! 1.250341381665
  SET, KQEM4B, -0.869772389665 !-0.86977238972 

 !MXL

  UMXL1h, TYPE="UMXL1-XL2"
  UMXL3h, TYPE="UMXL3-XL2"
  UMXL4h, TYPE="UMXL4-XL2"
  WIGXLh, TYPE="WIGXL-XL2"

!COMMENT !SXR from SC linac (XLEAP-II)
    ASSIGN, PRINT="LCLS2scS-XL2.print"
    TITLE, "AD_ACCEL: superconducting linac: BEAM0 to SXR (XLEAP)"
    BEAM, ENERGY=Ei
    USE, SC_SXRi
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zi, TAPE="LCLS2scS-XL2_survey.tape"
    TWISS, BETA0=TWSSi, SAVE, TAPE="LCLS2scS-XL2_twiss.tape" !, &
   !  RTAPE="LCLS2scS-XL2_rmat.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=MM1B/SXR46END, FILE="LCLS2scS-XL2", &
      TITLE="XLEAP-II (from SC linac): LTUS-UNDS"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=MM2B/SXR46END, FILE="LCLS2scS-XL2", &
      TITLE="XLEAP-II (from SC linac): LTUS-UNDS"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=WS31B/SXR46END, FILE="LCLS2scS-XL2", &
      TITLE="XLEAP-II (from SC linac): LTUS-UNDS"
 !ENDCOMMENT

 !COMMENT !SXR from LEI (XLEAP-II)
    ASSIGN, PRINT="LCLS2scS2-XL2.print"
    TITLE, "AD_ACCEL_HE: superconducting linac: BEAM0LEI to SXR (XLEAP)"
    BEAM, ENERGY=Ei
    CALL, FILENAME="SETK2scLEI.xsif"
    USE, SC_SXR2i
    PRINT, FULL
    SURVEY, X0=Xgun2, Y0=Ygun2, Z0=ZiLEI, TAPE="LCLS2scS2-XL2_survey.tape"
    TWISS, BETA0=TWSSiLEI, SAVE, TAPE="LCLS2scS2-XL2_twiss.tape" !, &
   !  RTAPE="LCLS2scS2-XL2_rmat.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=MM1B/SXR46END, FILE="LCLS2scS2-XL2", &
      TITLE="XLEAP-II (from SC linac): LTUS-UNDS"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=MM2B/SXR46END, FILE="LCLS2scS2-XL2", &
      TITLE="XLEAP-II (from SC linac): LTUS-UNDS"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=WS31B/SXR46END, FILE="LCLS2scS2-XL2", &
      TITLE="XLEAP-II (from SC linac): LTUS-UNDS"
 !ENDCOMMENT

! ------------------------------------------------------------------------------

  RETURN
