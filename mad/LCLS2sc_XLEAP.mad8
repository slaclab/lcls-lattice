
! *** OPTICS=AD_ACCEL-preRelease ***

! XLEAP-II optics

! ==============================================================================
! Modification History
! ------------------------------------------------------------------------------
! 07-APR-2024, M. Woodley
!  * remove UMXL2; move WIGXLH from SXR cell 18 to UMXL2 location
! ------------------------------------------------------------------------------

  KmaxQA    := 150.00/(Brhof*LQA) !max |K1| @ Ef for 1.26Q12    (165 A bipolar )
  KmaxQE200 := 102.00/(Brhof*LQE) !max |K1| @ Ef for 1.085Q4.31 (200 A bipolar )
  KmaxQE120 :=  67.00/(Brhof*LQE) !max |K1| @ Ef for 1.085Q4.31 (120 A bipolar )
  KmaxQx    :=  20.00/(Brhof*LQx) !max |K1| @ Ef for 1.26Q3.5   ( 12 A bipolar )
  KmaxQE110 :=  60.00/(Brhof*LQE) !max |K1| @ Ef for 1.085Q4.31 (110 A unipolar)
  KmaxQu    :=  40.00/(Brhof*LQu) !max |K1| @ Ef for 0.433Q3.1  (  6 A bipolar )

 !VALUE, Ef,KmaxQA,KmaxQE200,KmaxQE120,KmaxQx,KmaxQE110,KmaxQu

! ------------------------------------------------------------------------------

  SETXL_4GeV : SUBROUTINE
    SET, Ef, 4.0 ; SET, Eu, Ef
   !COMMENT !turn on UMXL1 (default)
      SET, R11XL1,  1.098929204922070
      SET, R12XL1,  1.719551869522400
      SET, R21XL1,  0.120755530037211
      SET, R22XL1,  1.098929204922070
      SET, R33XL1,  0.904229208659358
      SET, R34XL1,  1.611499871655030
      SET, R43XL1, -0.113167578486975
      SET, R44XL1,  0.904229208659358
     !comment !UMXL1 on; WIGXL on (default)
        SET, SETXL2WIG, 1
        SET, KQVM3B,  0.956858426517
        SET, KQVM4B, -1.258726626248
        SET, KQEM1B,  1.13498903608 
        SET, KQEM2B, -1.973605331554
        SET, KQEM3B,  1.331299678691
        SET, KQEM4B, -1.75483326929
        SET, KQE31B,  1.277595324917
        SET, KQFXL1,  1.090422678467
     !endcomment
      comment !UMXL1 on; WIGXL off
        SET, SETXL2WIG,  0
        SET, KQVM3B,  0.996734578956
        SET, KQVM4B, -1.267896202723
        SET, KQEM1B,  1.131536978222 
        SET, KQEM2B, -1.971599943198
        SET, KQEM3B,  1.260166448032
        SET, KQEM4B, -1.412266387678
        SET, KQE31B,  1.261029299352
        SET, KQFXL1,  1.065943523267
      endcomment
   !ENDCOMMENT
   !COMMENT !turn on UMXL3 and UMXL4 (default)
      SET, R11XL3,  1.098929204922070 ; SET, R11XL4, R11XL3
      SET, R12XL3,  1.719551869522400 ; SET, R12XL4, R12XL3
      SET, R21XL3,  0.120755530037211 ; SET, R21XL4, R21XL3
      SET, R22XL3,  1.098929204922070 ; SET, R22XL4, R22XL3
      SET, R33XL3,  0.904229208659358 ; SET, R33XL4, R33XL3
      SET, R34XL3,  1.611499871655030 ; SET, R34XL4, R34XL3
      SET, R43XL3, -0.113167578486975 ; SET, R43XL4, R43XL3
      SET, R44XL3,  0.904229208659358 ; SET, R44XL4, R44XL3
     !comment !UMXL3 and UMXL4 on; BCXXL self-seeding chicane on (default)
        SET, SETXL2SS, 1
        SET, KQFXL2,  3.518138991068
        SET, KQE36B,  0.0
        SET, KQUM1B, -1.292680353151
        SET, KQUM2B,  1.003895405888
        SET, KQUM3B,  0.373200894558
        SET, KQUM4B, -0.58155169622
        SET, KQSX16,  0.366967804809
        SET, KQSX19, -0.846218490744
        SET, KQSX21,  1.213742161508
        SET, KQSX24, -1.318038699206
     !endcomment
      comment !UMXL3 and UMXL4 on; BCXXL self-seeding chicane off
        SET, SETXL2SS, 0
        SET, KQFXL2,  3.516874325688
        SET, KQE36B,  0.0
        SET, KQUM1B, -1.300978955482
        SET, KQUM2B,  1.00099242088
        SET, KQUM3B,  0.385675414932
        SET, KQUM4B, -0.59757720557
        SET, KQSX16,  0.37144565214
        SET, KQSX19, -0.848105572839
        SET, KQSX21,  1.21433543951
        SET, KQSX24, -1.318179769379
      endcomment
   !ENDCOMMENT
  ENDSUBROUTINE

! ------------------------------------------------------------------------------

  MXL01 : SUBROUTINE !match into XLEAP-II
    BEAM, ENERGY=Ei
    USE, SC_SXRi
    VALUE, KQVM3B,KQVM4B,KQEM1B 
    VALUE, KQEM2B,KQEM3B,KQEM4B,KQE31B,KQFXL1
    MATCH, BETA0=TWSSi
      VARY, KQEM2B, STEP=1.E-6, LOWER=-KmaxQE200, UPPER=+KmaxQE200
      VARY, KQEM3B, STEP=1.E-6, LOWER=-KmaxQE120, UPPER=+KmaxQE120
      VARY, KQEM4B, STEP=1.E-6, LOWER=-KmaxQE120, UPPER=+KmaxQE120
      VARY, KQE31B, STEP=1.E-6, LOWER=-KmaxQx,    UPPER=+KmaxQx
      VARY, KQFXL1, STEP=1.E-6, LOWER= 0,         UPPER=+KmaxQE110
      CONSTR, QEM2B[1], BETY<90
      CONSTR, QEM3B[1], BETX<90
      WEIGHT, DX=0, DPX=0, DY=0, DPY=0
      CONSTR, QE32B[1], LINE=(QE32B,DQEC,DQEC,QE33B,QE33B,DQEC,DQEC,QE32B)
      CONSTR, #E, X=0, PX=0, Y=0, PY=0
      LMDIF, TOL=1.E-20
      MIGRAD, TOL=1.E-20
    ENDMATCH
    VALUE, KQVM3B,KQVM4B,KQEM1B 
    VALUE, KQEM2B,KQEM3B,KQEM4B,KQE31B,KQFXL1
    TWISS, BETA0=TWSSi, SAVE, TAPE="twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, RANGE=MM1B/WS34B, &
      STYLE=100, SPLINE, FILE="match"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, RANGE=VBOUTB/WS34B, &
      STYLE=100, SPLINE, FILE="match"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, RANGE=VBOUTB/MBLMS48, &
      STYLE=100, SPLINE, FILE="match"
  ENDSUBROUTINE

  MXL02 : SUBROUTINE !match XLEAP-II into UNDS
    BEAM, ENERGY=Ei
    USE, SC_SXRi
    VALUE, KQFXL2,KQE36B,KQUM1B,KQUM2B,KQUM3B,KQUM4B
    VALUE, KQSX16,KQSX19,KQSX21,KQSX24
    MATCH, BETA0=TWSSi
     !VARY, KQE36B, STEP=1.E-6, LOWER=-KmaxQx,    UPPER= 0
      VARY, KQFXL2, STEP=1.E-6, LOWER= 0,         UPPER=+KmaxQE110
      VARY, KQUM1B, STEP=1.E-6, LOWER=-KmaxQE120, UPPER=+KmaxQE120
      VARY, KQUM2B, STEP=1.E-6, LOWER=-KmaxQE120, UPPER=+KmaxQE120
      VARY, KQUM3B, STEP=1.E-6, LOWER=-KmaxQE120, UPPER=+KmaxQE120
      VARY, KQUM4B, STEP=1.E-6, LOWER=-KmaxQE120, UPPER=+KmaxQE120
      VARY, KQSX16, STEP=1.E-6, LOWER=-1.499*0,  UPPER= 1.499    !10 GeV
      VARY, KQSX19, STEP=1.E-6, LOWER=-1.499,    UPPER= 1.499*0
      VARY, KQSX21, STEP=1.E-6, LOWER=-1.499*0,  UPPER= 1.499
      VARY, KQSX24, STEP=1.E-6, LOWER=-1.499,    UPPER= 1.499*0
      CONSTR, QUM1B[1],  BETY<80
      CONSTR, QUM2B[1],  BETX=70
      CONSTR, QUM3B[1],  BETX=70
      CONSTR, QUM4B[1],  BETY<70
      CONSTR, QSXh16[1], BETX=70
      CONSTR, QSXh19[1], BETY=70
      CONSTR, QSXh21[1], BETX<100
     !CONSTR, QSXh24[1], BETY<70
    ! periodic betas in cells 26-46
      WEIGHT, X=0, PX=0, BETX=1, ALFX=0, DX=0, DPX=0, &
              Y=0, PY=0, BETY=1, ALFY=0, DY=0, DPY=0, &
              T=0, PT=0
      COUPLE, QSXh26[1]/QSXh28[1]
      COUPLE, QSXh27[1]/QSXh29[1]
      COUPLE, QSXh26[1]/QSXh30[1]
      COUPLE, QSXh27[1]/QSXh31[1]
      COUPLE, QSXh26[1]/QSXh32[1]
      COUPLE, QSXh27[1]/QSXh33[1]
      COUPLE, QSXh26[1]/QSXh34[1]
      COUPLE, QSXh27[1]/QSXh35[1]
      COUPLE, QSXh26[1]/QSXh36[1]
      COUPLE, QSXh27[1]/QSXh37[1]
      COUPLE, QSXh26[1]/QSXh38[1]
      COUPLE, QSXh27[1]/QSXh39[1]
      COUPLE, QSXh26[1]/QSXh40[1]
      COUPLE, QSXh27[1]/QSXh41[1]
      COUPLE, QSXh26[1]/QSXh42[1]
      COUPLE, QSXh27[1]/QSXh43[1]
      COUPLE, QSXh26[1]/QSXh44[1]
      COUPLE, QSXh27[1]/QSXh45[1]
      COUPLE, QSXh26[1]/QSXh46[1]
      LMDIF, TOL=1.E-20, CALLS=10000
      MIGRAD, TOL=1.E-20, CALLS=10000
    ENDMATCH
    MATCH, BETA0=TWSSi
      VARY, KQSX16, STEP=1.E-6, LOWER=-1.499*0,  UPPER= 1.499    !10 GeV
      VARY, KQSX19, STEP=1.E-6, LOWER=-1.499,    UPPER= 1.499*0
      VARY, KQSX21, STEP=1.E-6, LOWER=-1.499*0,  UPPER= 1.499
      VARY, KQSX24, STEP=1.E-6, LOWER=-1.499,    UPPER= 1.499*0
    ! periodic betas in cells 26-46
      WEIGHT, X=0, PX=0, BETX=1, ALFX=0, DX=0, DPX=0, &
              Y=0, PY=0, BETY=1, ALFY=0, DY=0, DPY=0, &
              T=0, PT=0
      COUPLE, QSXh26[1]/QSXh28[1]
      COUPLE, QSXh27[1]/QSXh29[1]
      COUPLE, QSXh26[1]/QSXh30[1]
      COUPLE, QSXh27[1]/QSXh31[1]
      COUPLE, QSXh26[1]/QSXh32[1]
      COUPLE, QSXh27[1]/QSXh33[1]
      COUPLE, QSXh26[1]/QSXh34[1]
      COUPLE, QSXh27[1]/QSXh35[1]
      COUPLE, QSXh26[1]/QSXh36[1]
      COUPLE, QSXh27[1]/QSXh37[1]
      COUPLE, QSXh26[1]/QSXh38[1]
      COUPLE, QSXh27[1]/QSXh39[1]
      COUPLE, QSXh26[1]/QSXh40[1]
      COUPLE, QSXh27[1]/QSXh41[1]
      COUPLE, QSXh26[1]/QSXh42[1]
      COUPLE, QSXh27[1]/QSXh43[1]
      COUPLE, QSXh26[1]/QSXh44[1]
      COUPLE, QSXh27[1]/QSXh45[1]
      COUPLE, QSXh26[1]/QSXh46[1]
      LMDIF, TOL=1.E-20, CALLS=10000
      MIGRAD, TOL=1.E-20, CALLS=10000
    ENDMATCH
    VALUE, KQFXL2,KQE36B,KQUM1B,KQUM2B,KQUM3B,KQUM4B
    VALUE, KQSX16,KQSX19,KQSX21,KQSX24
    PRINT, FULL
    TWISS, BETA0=TWSSi, SAVE, TAPE="twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=WS31B/SXR46END, FILE="match"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=MM1B/SXR46END, FILE="match"
  ENDSUBROUTINE

! ------------------------------------------------------------------------------

! to run XLEAP-II optics, use SETXL_4GeV; uncomment blocks with the desired
! undulator(s) turned on (UMXL1 and/or UMXL3&UMXL4); within the selected
! block(s), turn on WIGXL and/or BCXLSS chicane

  SET, SETSP, SETSPs ; SET, SETCUS, CUSOFF
  SETXL_4GeV

 !MXL01
 !MXL02

 !COMMENT !SXR from SC linac (XLEAP-II)
    ASSIGN, PRINT="LCLS2scS-XL2.print"
    TITLE, "AD_ACCEL: superconducting linac to SXR (XLEAP)"
    BEAM, ENERGY=Ei
    USE, SC_SXRi
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zi, TAPE="LCLS2scS-XL2_survey.tape"
    TWISS, BETA0=TWSSi, SAVE, TAPE="LCLS2scS-XL2_twiss.tape" !, &
   !  RTAPE="LCLS2scS-XL2_rmat.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=WS31B/BCXLSSBEG, FILE="LCLS2scS-XL2", &
      TITLE="XLEAP-II (from SC linac): LTUS-UNDS"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
      STYLE=100, SPLINE, RANGE=MM1B/MBLMS48, FILE="LCLS2scS-XL2", &
      TITLE="XLEAP-II (from SC linac): LTUS-UNDS"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
      STYLE=100, SPLINE, RANGE=MBLMS48/#E, FILE="LCLS2scS-XL2", &
      TITLE="XLEAP-II (from SC linac): DMPS"
 !ENDCOMMENT

! ------------------------------------------------------------------------------

  RETURN
