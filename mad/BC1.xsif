! ==============================================================================
! marker points, etc.
! ------------------------------------------------------------------------------

! collimators (betatron X/Y half-apertures are 27/18 sigma for 1 um normalized
! emittance; default out-of-plane half-aperture is 20 mm)

  CE11B : RCOL, L=Ljaw, XSIZE=19.2e-3, YSIZE=20.E-3, TYPE="HCOLL"    !X momentum collimator
  CYC11 : RCOL, L=Ljaw, YSIZE=2.7e-3,  XSIZE=20.E-3, TYPE="VCOLL"    !Y betatron collimator
  CXC11 : RCOL, L=Ljaw, XSIZE=2.7e-3,  YSIZE=20.E-3, TYPE="HCOLL"    !X betatron collimator
  CYC12 : RCOL, L=Ljaw, YSIZE=2.7e-3,  XSIZE=20.E-3, TYPE="@4,VCOLL" !Y betatron collimator
  CXC12 : RCOL, L=Ljaw, XSIZE=2.7e-3,  YSIZE=20.E-3, TYPE="@4,HCOLL" !X betatron collimator
  CYC13 : RCOL, L=Ljaw, YSIZE=2.7e-3,  XSIZE=20.E-3, TYPE="VCOLL"    !Y betatron collimator
  CXC13 : RCOL, L=Ljaw, XSIZE=2.7e-3,  YSIZE=20.E-3, TYPE="HCOLL"    !X betatron collimator

! instruments

  OTR11B : PROF, TYPE="OTR BC"    !BC1 energy spread
  WS11B  : WIRE, TYPE="@3,fast"   !BC1 energy spread
  BZ11B  : BLMO, TYPE="CSR"       !CSR-based relative bunch length monitor
  IM11B  : IMON, TYPE="ICT"       !Beam Current Monitor
  BZC1   : BLMO, TYPE="gap/diode" !relative bunch length monitor
  WSC104 : WIRE, TYPE="fast"      !post-BC1 emittance
  WSC106 : WIRE, TYPE="fast"      !post-BC1 emittance
  WSC108 : WIRE, TYPE="fast"      !post-BC1 emittance
  WSC110 : WIRE, TYPE="fast"      !post-BC1 emittance

! markers

  BC1BcBEG : MARK
  BC1BcMID : MARK
  CNTBC1   : MARK, TYPE="CENTER"
  BC1BcEND : MARK

! ==============================================================================
! BEAMLINE
! ------------------------------------------------------------------------------

  BCX11_full : LINE=(BCX11a,BCX11b)
  BCX12_full : LINE=(BCX12a,BCX12b)
  BCX13_full : LINE=(BCX13a,BCX13b)
  BCX14_full : LINE=(BCX14a,BCX14b)

  Q1C01_full : LINE=(Q1C01,BPM1C01,Q1C01)
  CQ11B_full : LINE=(CQ11B,CQ11B)
  SQ13B_full : LINE=(SQ13B,SQ13B)
  CQ12B_full : LINE=(CQ12B,CQ12B)
  QC101_full : LINE=(QC101,BPMC101,QC101)
  QC102_full : LINE=(QC102,BPMC102,QC102)
  QC103_full : LINE=(QC103,BPMC103,QC103)
  QC104_full : LINE=(QC104,BPMC104,QC104)
  QC105_full : LINE=(QC105,BPMC105,QC105)
  QC106_full : LINE=(QC106,BPMC106,QC106)
  QC107_full : LINE=(QC107,BPMC107,QC107)
  QC108_full : LINE=(QC108,BPMC108,QC108)
  QC109_full : LINE=(QC109,BPMC109,QC109)
  QC110_full : LINE=(QC110,BPMC110,QC110)
  QC111_full : LINE=(QC111,BPMC111,QC111)
  QC112_full : LINE=(QC112,BPMC112,QC112)

  SC1C00 : LINE=(XC1C00,YC1C00)

  BC1i0 : LINE=(BEGBC1B,D1C00,&
    Q1C01,Q1C01,D1C01)

  BC1i : LINE=(BEGBC1B,D1C00a,SC1C00,D1C00b,&
    Q1C01_full,D1C01a,RFB1C01,D1C01b)

  BC1c0 : LINE=(BC1BcBEG,&
    BCX11a,BCX11b,DC1o,&
    BCX12a,BCX12b,DC1ih,BC1BcMID,DC1ih,&
    BCX13a,BCX13b,DC1o,&
    BCX14a,BCX14b,&
    BC1BcEND)

  BC1c : LINE=(BC1BcBEG,&
    BCX11_full,DC1oa,&
    CQ11B_full,DC1ob,YCM12B,DC1oc,&
    BCX12_full,DC1ia,BPM11B,DC1ib,CE11B,DC1ic,OTR11B,DC1id,WS11B,DC1ie,&
    BCX13_full,DC1od,&
    SQ13B_full,DC1oe,XCM12B,DC1of,&
    CQ12B_full,DC1og,&
    BCX14_full,CNTBC1,&
    BC1BcEND)

  BC1o0 : LINE=(DC100,ENDBC1B)

  BC1o : LINE=(DC100a,BZ11B,DC100b,ENDBC1B)

  BC1 : LINE=(BC1i,BC1c,BC1o)

  COMMENT !simplified
    COL1 : LINE=(BEGCOL1,&
      QC101,QC101,DC101,&
      QC102,QC102,DC102,&
      QC103,QC103,DC103,&
      QC104,QC104,DC104,&
      QC105,QC105,DColl1,&
      QC106,QC106,DColl1,&
      QC107,QC107,DColl1,&
