  YCSP4s  : VKIC, TYPE="class-4"
  YCSP6s  : VKIC, TYPE="class-4"
  YCSP8s  : VKIC, TYPE="class-4"

  XCSP0d  : HKIC, TYPE="@4,Bypass#3"
  YCSP0d  : VKIC, TYPE="@4,Bypass#3"

  XCSP1d  : HKIC, TYPE="class-4"
  XCSP3d  : HKIC, TYPE="class-4"
  XCSP5d  : HKIC, TYPE="class-4"

  YCSP2d  : VKIC, TYPE="class-4"
  YCSP4d  : VKIC, TYPE="class-4"
  YCSP6d  : VKIC, TYPE="class-4"

! SROT to remove rotation angle

  AROSP1H :=  0.423037934339E-5 !0.414577244197E-5
  AROSP2H :=  0.947723874729E-5 !0.947723870567E-5
  AROSP3h := -AROSP2h
  AROSP1s := -0.846062942472E-5 !-0.829141820709E-5

  ROSP1h : SROT, ANGLE=AROSP1h
  ROSP2h : SROT, ANGLE=AROSP2h
  ROSP3h : SROT, ANGLE=AROSP3h
  ROSP1s : SROT, ANGLE=AROSP1s

! other diagnostic

  IMSP0h : IMON, TYPE="ICT" !diagnostic ACM in SPH
  IMSP0s : IMON, TYPE="ICT" !diagnostic ACM in SPS
  IMSP0d : IMON, TYPE="ICT" !diagnostic ACM in SPD

  IMBCSh1 : IMON, TYPE="BCS ACM" !BCS ACM triplet in SPH
  IMBCSh2 : IMON, TYPE="BCS ACM" !BCS ACM triplet in SPH
  IMBCSs1 : IMON, TYPE="BCS ACM" !BCS ACM triplet in SPS
  IMBCSs2 : IMON, TYPE="BCS ACM" !BCS ACM triplet in SPS
  IMBCSd1 : IMON, TYPE="BCS ACM" !BCS ACM triplet in SPD
  IMBCSd2 : IMON, TYPE="BCS ACM" !BCS ACM triplet in SPD

  BTMSPDMP : INST, TYPE="PPS BTM" !Burn-Through-Monitor behind BSY dump

  WSSP1d : WIRE, TYPE="fast" !to measure beam size and energy before BSY dump

  OTRSPDMP : PROF, TYPE="@0,OTR" !OTR screen before BSY dump

! BSY wooden door

  WOODDOOR_SPH : MARK
  WOODDOOR_SPD : MARK

! markers

  CNTSP1S  : MARK, TYPE="CENTER"
  CNTSP2S  : MARK, TYPE="CENTER"
  CNTSP1H  : MARK, TYPE="CENTER"
  CNTSP2H  : MARK, TYPE="CENTER"
  CNTSP3H  : MARK, TYPE="CENTER"
  CNTSP1D  : MARK, TYPE="CENTER"
  RWWAKE3D : MARK, TYPE="WAKE" !SPRDD/BSY beampipe wake applied here
  MUWALLd  : MARK !front face of muon wall for dump beam
  DUMPBSY  : INST, TYPE="DUMPBSY" !front face of BSY dump

