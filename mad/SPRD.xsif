  BPMSP9s  : MONI, TYPE="Stripline-5"

  BPMSP1d  : MONI, TYPE="Stripline-5"
  BPMSP2d  : MONI, TYPE="Stripline-5"
  BPMSP3d  : MONI, TYPE="Stripline-8" !has been already ordered
  BPMSP4d  : MONI, TYPE="Stripline-5"
  BPMSP5d  : MONI, TYPE="Stripline-14" !large aperture BPM for raster

  MRFBSP1d : MARK !MONI, TYPE="CavityS-1" !make RF-bpm if spreader is RF
  MRFBSP2d : MARK !MONI, TYPE="CavityS-1" !make RF-bpm if spreader is RF

! steering correctors

  XCSP1h  : HKIC, TYPE="class-4"
  XCSP3h  : HKIC, TYPE="class-4"
  XCSP5h  : HKIC, TYPE="class-4"
  XCSP7h  : HKIC, TYPE="class-4"
  XCSP9h  : HKIC, TYPE="class-4"
  XCSP11h : HKIC, TYPE="class-4"
  XCSP13h : HKIC, TYPE="class-4"

  YCSP2h  : VKIC, TYPE="class-4"
  YCSP4h  : VKIC, TYPE="class-4"
  YCSP6h  : VKIC, TYPE="class-4"
  YCSP8h  : VKIC, TYPE="class-4"
  YCSP10h : VKIC, TYPE="class-4"
  YCSP12h : VKIC, TYPE="class-4"

  XCSP1   : HKIC, TYPE="class-4"
  YCSP2   : VKIC, TYPE="class-4"

  XCSP1s  : HKIC, TYPE="class-4"
  XCSP3s  : HKIC, TYPE="class-4"
  XCSP5s  : HKIC, TYPE="class-4"
  XCSP7s  : HKIC, TYPE="class-4"
  XCSP9s  : HKIC, TYPE="class-4"

  YCSP2s  : VKIC, TYPE="class-4"
  YCSP4s  : VKIC, TYPE="class-4"
  YCSP6s  : VKIC, TYPE="class-4"
  YCSP8s  : VKIC, TYPE="class-4"

  XCSP1d  : HKIC, TYPE="class-4"
  XCSP3d  : HKIC, TYPE="class-4"
  XCSP5d  : HKIC, TYPE="@0,class-5"

  YCSP2d  : VKIC, TYPE="class-4"
  YCSP4d  : VKIC, TYPE="class-4"
  YCSP6d  : VKIC, TYPE="@0,class-5"

! rastering kickers operating at ~60 Hz with 90 deg phase between each other

  BKXRASd : HKIC, TYPE="class-5"
  BKYRASd : VKIC, TYPE="class-5"

! SROT to remove rotation angle

  AROSP1H :=  0.414577244197E-5
  AROSP2H :=  0.947723870567E-5
  AROSP3h := -AROSP2h
  AROSP1s := -0.829141820709E-5

  ROSP1h : SROT, ANGLE=AROSP1h
  ROSP2h : SROT, ANGLE=AROSP2h
  ROSP3h : SROT, ANGLE=AROSP3h
  ROSP1s : SROT, ANGLE=AROSP1s

! other diagnostic

  IMSP0h : IMON, TYPE="ICT" !diagnostic ACM in SPH
  IMSP0s : IMON, TYPE="ICT" !diagnostic ACM in SPS
  IMSP0d : IMON, TYPE="ICT" !diagnostic ACM in SPD

  IMBCSh1 : IMON, TYPE="@0,BCS ACM" !BCS ACM triplet in SPH
  IMBCSh2 : IMON, TYPE="@0,BCS ACM" !BCS ACM triplet in SPH
  IMBCSh3 : IMON, TYPE="@0,BCS ACM" !BCS ACM triplet in SPH
  IMBCSs1 : IMON, TYPE="@0,BCS ACM" !BCS ACM triplet in SPS
  IMBCSs2 : IMON, TYPE="@0,BCS ACM" !BCS ACM triplet in SPS
  IMBCSs3 : IMON, TYPE="@0,BCS ACM" !BCS ACM triplet in SPS
  IMBCSd1 : IMON, TYPE="@0,BCS ACM" !BCS ACM triplet in SPD
  IMBCSd2 : IMON, TYPE="@0,BCS ACM" !BCS ACM triplet in SPD
  IMBCSd3 : IMON, TYPE="@0,BCS ACM" !BCS ACM triplet in SPD

  PCSP3d : ECOL, L=LPCSP, TYPE="BCS PC" !BCS protection collimator

  BTMSP3d  : INST, TYPE="BCS BTM" !Burn-Through-Monitor behind PCSP3d
  BTMSPDMP : INST, TYPE="BCS BTM" !Burn-Through-Monitor behind BSY dump

  WSSP1d : WIRE, TYPE="fast" !to measure beam size and energy before BSY dump

  OTRSPDMP : PROF, TYPE="@0,OTR" !OTR screen before BSY dump

! beamlines

  SPRDkh : LINE=(&
    BKYSP0ha,BKYSP0hb,DSPBK0h,&
    BKYSP1ha,BKYSP1hb,DSPBK1h,&
    BKYSP2ha,BKYSP2hb,DSPBK2h,&
    BKYSP3ha,BKYSP3hb,DSPBK3h,&
    BKYSP4ha,BKYSP4hb,DSPBK4h,&
    BKYSP5ha,BKYSP5hb,DSPBK5ha,BPMSPh,DSPBK5hb,&
    BLXSPha ,BLXSPhb )

  SPRDksa : LINE=(&
                     DSPQ1a,BPMSP1,DSPQ1b,DSPQ1c,&
    QSP1,QSP1,DSPQ2a,XCSP1 ,DSPQ2b,BPMSP2,DSPQ2c,&
    QSP2,QSP2,DSPQ3a,YCSP2 ,DSPQ3b)

  SPRDksb : LINE=(&
    BKYSP0sa,BKYSP0sb,DSPBK0s,&
    BKYSP1sa,BKYSP1sb,DSPBK1s,&
    BKYSP2sa,BKYSP2sb,DSPBK2s,&
    BKYSP3sa,BKYSP3sb,DSPBK3s,&
    BKYSP4sa,BKYSP4sb,DSPBK4s,&
    BKYSP5sa,BKYSP5sb,DSPBK5sa,BPMSPs,DSPBK5sb,&
    BLXSPsa ,BLXSPsb )

  SPRDks : LINE=(SPRDksa,SPRDksb)

  SPRDha : LINE=(&
            ROSP1h  ,DSP2ha ,&
    BYSP1ha,BYSP1hb ,DSP2hb ,&
    BYSP2ha,BYSP2hb ,CNTSP1H,DSP2hc  ,&
    QSP1h  ,QSP1h   ,DSP3haa,&
    SSP1h  ,SSP1h   ,DSP3hab,BPMSP1h ,DSP3hb ,&
                             XCSP1h  ,DSP3hc ,DSP3hd ,&
    QSP2h  ,BPMSP2h ,QSP2h  ,DSP4ha  ,YCSP2h ,DSP4hb ,&
                             IMSP0h  ,DSP4hc ,&
    BRSP1ha,BRSP1hb ,ROSP2h ,DSP5ha  ,DSP5hb ,&
                             XCSP3h  ,DSP5hca,&
    SSP2h  ,SSP2h   ,DSP5hcb,&
    QSP3h  ,QSP3h   ,DSP6ha ,BPMSP3h ,DSP6hb ,&
                             YCSP4h  ,DSP6hc ,&
    QSP4h  ,QSP4h   ,DSP7ha ,BPMSP4h ,DSP7hb ,&
                             XCSP5h  ,DSP7hc ,&
    QSP5h  ,QSP5h   ,DSP8ha ,BPMSP5h ,DSP8hb ,&
                             YCSP6h  ,DSP8hc ,&
    QSP6h  ,QSP6h   ,DSP9ha ,BPMSP6h ,DSP9hb ,&
                                      DSP9hc ,&
                                      DSP9hd ,&
                                      DSP9he ,&
                                      DSP9hf ,DSP9hg ,&
    QSP7h  ,BPMSP7h ,QSP7h  ,DSP10ha ,XCSP7h ,DSP10hb,&
                                      DSP10hc,&
                             YCSP8h  ,DSP10hd,&
    QSP8h  ,QSP8h   ,DSP11ha,BPMSP8h ,DSP11hb,DSP11hc,&
    QSP9h  ,QSP9h   ,DSP12ha,BPMSP9h ,DSP12hb,&
                             XCSP9h  ,DSP12hc1,&
                                      IMBCSh1 ,&
                                      DSP12hc2,&
                                      IMBCSh2 ,&
                                      DSP12hc3,&
                                      IMBCSh3 ,&
                                      DSP12hc4,&
                             BPMSP10h,DSP12hd,&
                             YCSP10h ,DSP12he,&
    QSP10h ,QSP10h  ,DSP13ha,XCSP11h ,DSP13hb,&
                             BPMSP11h,DSP13hc,&
    QSP11h ,QSP11h  ,DSP14ha,WOODDOOR)

  SPRDhb : LINE=(&
                             DSP14hb ,ROSP3h ,&
    BRSP2ha,BRSP2hb ,CNTSP2H,DSP15ha ,DSP15hb,&
                             DSP15hc ,DSP15hd,&
    QSP12h ,BPMSP12h,QSP12h ,DSP16ha ,YCSP12h,DSP16hb,&
                             XCSP13h ,DSP16hc,&
    QSP13h ,QSP13h  ,DSP17ha,BPMSP13h,DSP17hb,&
    BXSP1ha,BXSP1hb ,CNTSP3H)

  SPRDh : LINE=(SPRDkh,SPRDha,SPRDhb)

  SPRDsa : LINE=(SPRDkh,SPRDks)

  SPRDsb : LINE=(&
            ROSP1s ,DSP2sa ,&
    BYSP1sa,BYSP1sb,DSP2sb ,&
    BYSP2sa,BYSP2sb,CNTSP1S,DSP2sc ,&
    QSP1s  ,QSP1s  ,DSP3saa,&
    SSP1s  ,SSP1s,  DSP3sab,BPMSP1s,DSP3sb ,&
                            XCSP1s ,DSP3sc ,&
    QSP2s  ,QSP2s  ,DSP4sa ,BPMSP2s,DSP4sb ,&
                            YCSP2s ,DSP4sc ,&
                            IMSP0s ,DSP4sd ,&
    BXSP1sa,BXSP1sb,DSP5sa ,XCSP3s ,DSP5sb ,&
    QSP3s  ,QSP3s  ,DSP6sa ,BPMSP3s,DSP6sb ,&
                            YCSP4s ,DSP6sc ,&
    QSP4s  ,QSP4s  ,DSP7sa ,BPMSP4s,DSP7sb ,DSP7sc,&
                            XCSP5s ,DSP7sd ,&
    QSP5s  ,QSP5s  ,DSP8sa ,BPMSP5s,DSP8sb ,&
                                    DSP8sc ,&
                                    DSP8sd ,&
                            YCSP6s ,DSP8se ,&
    QSP6s  ,QSP6s  ,DSP9sa ,BPMSP6s,DSP9sb ,&
                            XCSP7s ,DSP9sc ,&
    QSP7s  ,QSP7s  ,DSP10sa,BPMSP7s,DSP10sb,&
    BXSP2sa,BXSP2sb,DSP11sa,DSP11sb,&
                    DSP11sc,DSP11sd,&
                            YCSP8s ,DSP11se,&
    QSP8s  ,QSP8s  ,DSP12sa,BPMSP8s,DSP12sb,&
                            XCSP9s ,DSP12sca,&
    SSP2s  ,SSP2s  ,DSP12scb,&
    QSP9s  ,QSP9s  ,DSP13sa,BPMSP9s,DSP13sb1,&
                                    IMBCSs1 ,&
                                    DSP13sb2,&
                                    IMBCSs2 ,&
                                    DSP13sb3,&
                                    IMBCSs3 ,&
                                    DSP13sb4,&
    BXSP3sa,BXSP3sb,CNTSP2S)

  SPRDs : LINE=(SPRDsa,SPRDsb)

  SPRDda : LINE=(DSP2da1,MRFBSP1d,DSP2da2,BPMSP1d,DSP2db)

  SPRDdb : LINE=(DSP2dc1)

  SPRDdc : LINE=(&
                                     DSP2dc2,&
                            XCSP1d  ,DSP2dd ,&
    QSP1d  ,QSP1d  ,DSP3da          ,DSP3db ,&
                            IMSP0d  ,DSP3dc ,MRFBSP2d,&
                            BPMSP2d ,DSP3dd ,&
    QSP2d  ,QSP2d  ,DSP4da ,YCSP2d  ,DSP4db ,&
    BYSP1da,BYSP1db,DSP5da ,         DSP5db,&
                            WSSP1d  ,DSP5dc1,&
                                     IMBCSd1,&
                                     DSP5dc2,&
                                     IMBCSd2,&
                                     DSP5dc3,&
                                     IMBCSd3,&
                                     DSP5dc4,&
