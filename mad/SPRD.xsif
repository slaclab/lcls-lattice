  KQSP8S := -0.55912664167  !-0.55912608142  !-0.559079941433
  KQSP9S :=  0.633788997918 ! 0.633788790869 ! 0.633806671882
  KQSP6s :=  KQSP4s
  KQSP7s :=  KQSP3s
