  SSP1s_full : LINE=(SSP1s,SSP1s)
  SSP2s_full : LINE=(SSP2s,SSP2s)

  SPRDsb : LINE=(ROSP1s,DSP2sa,&
    BYSP1s_full,DSP2sb,&
