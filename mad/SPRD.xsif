      IMBCSs1,DSP13sb2,IMBCSs2,DSP13sb3,&
    BXSP3s_full,CNTSP2S)

  SPRDs : LINE=(SPRDsa,SPRDsb)

  SPRDda : LINE=(DSP2da1a,YCSP0D,DSP2da1b,XCSP0D,DSP2da1c,MRFBSP1d,&
    DSP2da2,BPMSP1d,DSP2db)

  SPRDdb : LINE=(DSP2dc1)

  BYSP1d_full : LINE=(BYSP1da,BYSP1db)
  BYSP2d_full : LINE=(BYSP2da,BYSP2db)

  QSP1d_full : LINE=(QSP1d,QSP1d)
  QSP2d_full : LINE=(QSP2d,QSP2d)

  SPRDdc : LINE=(DSP2dc2,XCSP1d,DSP2dd,&
    QSP1d_full,DSP3da,DSP3db,IMSP0d,DSP3dc,MRFBSP2d,BPMSP2d,DSP3dd,&
