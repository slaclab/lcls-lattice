    QSP6s_full,DSP9sa,BPMSP6s,DSP9sb,XCSP7s,DSP9sc,&
    QSP7s_full,DSP10sa,BPMSP7s,DSP10sb,&
    BXSP2s_full,DSP11sa,DSP11sb,DSP11sc,DSP11sd,YCSP8s,DSP11se,&
    QSP8s_full,DSP12sa,BPMSP8s,DSP12sb,XCSP9s,DSP12sc,&
