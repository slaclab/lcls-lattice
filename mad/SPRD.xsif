  KQSP1S :=  0.633449982793 ! 0.633592368552
  KQSP2S := -0.558283402271 !-0.558572403531
  KQSP3S :=  0.652261510863 ! 0.652091326391
  KQSP4S := -0.498336756843 !-0.497963158567
  KQSP5S :=  0.184708908949 ! 0.184546784571
  KQSP6s :=  KQSP4s
  KQSP7s :=  KQSP3s
