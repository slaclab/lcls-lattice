    QSP12h_full,DSP16ha,YCSP12h,DSP16hb,XCSP13h,DSP16hc,&
    QSP13h_full,DSP17ha,BPMSP13h,DSP17hb,&
    BXSP1h_full,CNTSP3H)

  SPRDh : LINE=(SPRDkh,SPRDha,SPRDhb)

  SPRDsa : LINE=(SPRDkh,SPRDks)

  BYSP1s_full : LINE=(BYSP1sa,BYSP1sb)
  BYSP2s_full : LINE=(BYSP2sa,BYSP2sb)
  BXSP1s_full : LINE=(BXSP1sa,BXSP1sb)
  BXSP2s_full : LINE=(BXSP2sa,BXSP2sb)
