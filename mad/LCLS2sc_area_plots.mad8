    TITLE="SLTD"

! ------------------------------------------------------------------------------

  BEAM, ENERGY=Ei
  SET, SETSP, SETSPd ; SET, SETDA, DAON
  USE, SC_DASELi
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=RBETX,RBETY, &
