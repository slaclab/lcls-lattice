    COLOUR=100, SPLINE, RANGE=BEGCOL0/ENDCOL0, FILE="LCLS2sc_areas", &
    TITLE="COL0"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, VMIN=0, &
    COLOUR=100, RANGE=BEGL1B/ENDL1B, FILE="LCLS2sc_areas", &
    TITLE="L1B"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGL1B/ENDL1B, FILE="LCLS2sc_areas", &
    TITLE="L1B"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGBC1B/ENDBC1B, FILE="LCLS2sc_areas", &
    TITLE="BC1B"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGCOL1/ENDCOL1, FILE="LCLS2sc_areas", &
    TITLE="COL1"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, &
    COLOUR=100, RANGE=BEGL2B/ENDL2B, FILE="LCLS2sc_areas", &
    TITLE="L2B"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGL2B/ENDL2B, FILE="LCLS2sc_areas", &
    TITLE="L2B"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGBC2B/ENDBC2B, FILE="LCLS2sc_areas", &
    TITLE="BC2B"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGEMIT2/ENDEMIT2, FILE="LCLS2sc_areas", &
    TITLE="EMIT2"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, VMIN=1.5, VMAX=4.5, &
    COLOUR=100, RANGE=BEGL3B/ENDL3B, FILE="LCLS2sc_areas", &
    TITLE="L3B"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGL3B/ENDL3B, FILE="LCLS2sc_areas", &
    TITLE="L3B"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGEXT/ENDEXT, FILE="LCLS2sc_areas", &
    TITLE="EXT"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGDOG/QBP10[1], FILE="LCLS2sc_areas", &
    TITLE="DOG"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=QBP10[1]/ENDBYP, FILE="LCLS2sc_areas", &
    TITLE="BYP"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGSPH/ENDSPH, FILE="LCLS2sc_areas", &
    TITLE="SPH"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGSLTH/ENDSLTH, FILE="LCLS2sc_areas", &
    TITLE="SLTH"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGBSYH_1/ENDBSYH_2, FILE="LCLS2sc_areas", &
    TITLE="BSYH"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGLTUH/ENDLTUH, FILE="LCLS2sc_areas", &
    TITLE="LTUH"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGUNDH/ENDUNDH, FILE="LCLS2sc_areas", &
    TITLE="UNDH"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGDMPH_1/ENDDMPH_2, FILE="LCLS2sc_areas", &
    TITLE="DMPH"

! ------------------------------------------------------------------------------

  BEAM, ENERGY=Ei
  SET, SETSP, SETSPs ; SET, SETCUS, CUSOFF
  USE, SC_SXRi
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGSPD_1/ENDSPS, FILE="LCLS2sc_areas", &
    TITLE="SPD_1+SPS"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGSLTS/ENDSLTS, FILE="LCLS2sc_areas", &
    TITLE="SLTS"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGBSYS/ENDBSYS, FILE="LCLS2sc_areas", &
    TITLE="BSYS"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGLTUS/ENDLTUS, FILE="LCLS2sc_areas", &
    TITLE="LTUS"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGUNDS/ENDUNDS, FILE="LCLS2sc_areas", &
    TITLE="UNDS" !SXX+SXR
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGDMPS_1/ENDDMPS_2, FILE="LCLS2sc_areas", &
    TITLE="DMPS" !UES+DMPS

! ------------------------------------------------------------------------------

  BEAM, ENERGY=Ei
  SET, SETSP, SETSPs ; SET, SETCUS, CUSOFF
  USE, SC_SFTSi
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGSFTS_1/ENDSFTS_2, FILE="LCLS2sc_areas", &
    TITLE="SFTS"

! ------------------------------------------------------------------------------

  BEAM, ENERGY=Ei
  SET, SETSP, SETSPd ; SET, SETDA, DAOFF
  USE, SC_BSYDi
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
