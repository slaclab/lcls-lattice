
! *** OPTICS=AD_ACCEL-preRelease ***

  ASSIGN, PRINT="LCLS2sc_areas.print"

! ------------------------------------------------------------------------------

  BEAM, ENERGY=E0
  USE, (GUN,L0)
  PRINT, FULL
  TWISS, SAVE, COUPLE, BETA0=TWSS0
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGGUNB/ENDGUNB, FILE="LCLS2sc_areas", &
    TITLE="GUNB"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, VMIN=0, VMAX=0.12, &
    COLOUR=100, RANGE=BEGL0B/ENDL0B, FILE="LCLS2sc_areas", &
    TITLE="L0B"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGL0B/ENDL0B, FILE="LCLS2sc_areas", &
    TITLE="L0B"

! ------------------------------------------------------------------------------

  BEAM, ENERGY=Ei
  USE, SC_DIAG0i
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGDIAG0/ENDDIAG0, FILE="LCLS2sc_areas", &
    TITLE="DIAG0"

! ------------------------------------------------------------------------------

  BEAM, ENERGY=Ei
  SET, SETSP, SETSPh
  USE, SC_HXRi
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGHTR/ENDHTR, FILE="LCLS2sc_areas", &
    TITLE="HTR"
