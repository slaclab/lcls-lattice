
! *** OPTICS=AD_ACCEL-2019next ***

! SC_BSYD path configurations

  SETSP     := 0
  SETCUS    := 0
  SETAL     := 0
  SETDA     := 0
  SETHXRSS  := 0 !set to 1 to turn ON HXR self-seeding chicane
  SETSXRSS  := 0 !set to 1 to turn ON SXR self-seeding chicane
  SETXLEAP2 := 0 !set to 1 to turn ON XLEAP-II components

  IntgSX := 20.0 !kG
  IntgHX := 12.0 !kG
  EfSC   :=  4.0 !GeV
  EuSC   :=  4.0 !GeV

  CALL, FILENAME="LCLS2sc_master.xsif" !calls other xsif files

  COMMENT !to generate SURVEY
    USE, SC_BSYD !start at gun
    ! initial energy: E0
    ! initial SURVEY: Xgun, Ygun, Zgun, 0, 0, 0
  ENDCOMMENT

 !COMMENT !to generate TWISS
    USE, SC_BSYDi !start at BEAM0
    ! initial energy: Ei
    ! initial Twiss : BXi, AXi, BYi, AYi
 !ENDCOMMENT

  RETURN
