
! *** OPTICS=AD_ACCEL-07SEP2025s ***

! generate output files for RDB generation

! ------------------------------------------------------------------------------
! SURVEY tape files (linac coordinates)
! ------------------------------------------------------------------------------

! use default K-values

  ASSIGN, PRINT="LCLS2cuGSPEC.print"
  BEAM, ENERGY=E00
  USE, CU_GSPEC
  PRINT, FULL
  SURVEY, X0=Xi, Z0=Zi, THETA0=ADL1, TAPE="LCLS2cuGSPEC_survey.tape"

  ASSIGN, PRINT="LCLS2cuSPEC.print"
  BEAM, ENERGY=E00
  USE, CU_SPEC
  PRINT, FULL
  SURVEY, X0=Xi, Z0=Zi, THETA0=ADL1, TAPE="LCLS2cuSPEC_survey.tape"

! ------------------------------------------------------------------------------

  SETK2cuH !set K-values for Cu-linac to HXR (includes Q50Q3 and Q4)

  ASSIGN, PRINT="LCLS2cuH.print"
  BEAM, ENERGY=E00
  SET, SETCUS, CUSOFF
  USE, CU_HXR
  PRINT, FULL
  SURVEY, X0=Xi, Z0=Zi, THETA0=ADL1, TAPE="LCLS2cuH_survey.tape"

  ASSIGN, PRINT="LCLS2cuHS.print"
  BEAM, ENERGY=E00
  SET, SETCUS, CUSOFF
  USE, CU_SFTH
  PRINT, FULL
  SURVEY, X0=Xi, Z0=Zi, THETA0=ADL1, TAPE="LCLS2cuHS_survey.tape"

  ASSIGN, PRINT="LCLS2cuHXTES.print"
  BEAM, ENERGY=E00
  SET, SETCUS, CUSOFF
  USE, CU_HXTES
  PRINT, FULL
  SURVEY, X0=Xi, Z0=Zi, THETA0=ADL1, TAPE="LCLS2cuHXTES_survey.tape"

  ASSIGN, PRINT="LCLS2cuHTXI.print"
  BEAM, ENERGY=E00
  SET, SETCUS, CUSOFF
  USE, CU_HTXI
  PRINT, FULL
  SURVEY, X0=Xi, Z0=Zi, THETA0=ADL1, TAPE="LCLS2cuHTXI_survey.tape"

! ------------------------------------------------------------------------------

  SETK2cuS !set K-values for Cu-linac to SXR

  ASSIGN, PRINT="LCLS2cuS.print"
  BEAM, ENERGY=E00
  SET, SETCUS, CUSON   !pulsed
 !SET, SETCUS, CUSONDC !DC
 !VALUE, PULSED,DCMODE
  USE, CU_SXR
  PRINT, FULL
  SURVEY, THETA0=ADL1, X0=Xi, Z0=Zi, TAPE="LCLS2cuS_survey.tape"

! ------------------------------------------------------------------------------
! SURVEY tape files (BSY coordinates)
! ------------------------------------------------------------------------------

  SETK2cuH !set K-values for Cu-linac to HXR (includes Q50Q3 and Q4)

  ASSIGN, PRINT="BSY-LCLS2cuH.print"
  BEAM, ENERGY=Ef
  SET, SETCUS, CUSOFF
  USE, BSYLTUH
  PRINT, FULL
  SURVEY, X0=Xf, Y0=Yf, Z0=Zf, THETA0=THETAf, PHI0=PHIf, PSI0=PSIf, &
    TAPE="BSY-LCLS2cuH_survey.tape"

  ASSIGN, PRINT="BSY-LCLS2cuHS.print"
  BEAM, ENERGY=Ef
  SET, SETCUS, CUSOFF
  USE, BSYLTUHS
  PRINT, FULL
  SURVEY, X0=Xf, Y0=Yf, Z0=Zf, THETA0=THETAf, PHI0=PHIf, PSI0=PSIf, &
    TAPE="BSY-LCLS2cuHS_survey.tape"

  ASSIGN, PRINT="BSY-LCLS2cuHXTES.print"
  BEAM, ENERGY=Ef
  SET, SETCUS, CUSOFF
  USE, BSYLTUHXTES
  PRINT, FULL
  SURVEY, X0=Xf, Y0=Yf, Z0=Zf, THETA0=THETAf, PHI0=PHIf, PSI0=PSIf, &
    TAPE="BSY-LCLS2cuHXTES_survey.tape"

  ASSIGN, PRINT="BSY-LCLS2cuHTXI.print"
  BEAM, ENERGY=Ef
  SET, SETCUS, CUSOFF
  USE, BSYLTUHTXI
  PRINT, FULL
  SURVEY, X0=Xf, Y0=Yf, Z0=Zf, THETA0=THETAf, PHI0=PHIf, PSI0=PSIf, &
    TAPE="BSY-LCLS2cuHTXI_survey.tape"

! ------------------------------------------------------------------------------

  SETK2cuS !set K-values for Cu-linac to SXR

  ASSIGN, PRINT="BSY-LCLS2cuS.print"
  BEAM, ENERGY=Ef
  SET, SETCUS, CUSON   !pulsed
 !SET, SETCUS, CUSONDC !DC
 !VALUE, PULSED,DCMODE
  USE, BSYLTUS
  PRINT, FULL
  SURVEY, X0=Xf, Y0=Yf, Z0=Zf, THETA0=THETAf, PHI0=PHIf, PSI0=PSIf, &
    TAPE="BSY-LCLS2cuS_survey.tape"

