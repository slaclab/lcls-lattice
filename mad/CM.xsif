  CAVL355b : LCAV, FREQ=1300, L=LcavLb, DELTAE=GradL3*LcavLb, PHI0=PhasL3/360, &
                   APER=LcavR, TYPE="cryo"
  CAVL356  : LCAV, FREQ=1300, L=LcavL,  DELTAE=GradL3*LcavL,  PHI0=PhasL3/360, &
                   APER=LcavR, TYPE="cryo"
  CAVL357  : LCAV, FREQ=1300, L=LcavL,  DELTAE=GradL3*LcavL,  PHI0=PhasL3/360, &
                   APER=LcavR, TYPE="cryo"
  CAVL358  : LCAV, FREQ=1300, L=LcavL,  DELTAE=GradL3*LcavL,  PHI0=PhasL3/360, &
                   APER=LcavR, TYPE="cryo"

! ==============================================================================
! QUAD
! ------------------------------------------------------------------------------

  Lcmq := 0.23     !cryomodule quadrupole length
  Rcmq := 0.0762/2 !cryomodule quadrupole pole-tip radius

  KQCMfodo1 := 0.274030631043 !L1: 45 degrees/cell
  KQCMfodo2 := 0.185334132537 !L2: 30 degrees/cell
  KQCMfodo3 := 0.185334132537 !L3: 30 degrees/cell

! L0

  KQCM01 := 0.378216482077

  QCM01 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1= KQCM01

! L1

  QCM02 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1=-0.350950069374 !-KQCMfodo1
  QCM03 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1= 0.234277812828 ! KQCMfodo1

! L2

  QCM04 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1=-0.341774912298 !-KQCMfodo2
  QCM05 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1= 0.305094808406 ! KQCMfodo2
  QCM06 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1=-0.198893505797 !-KQCMfodo2
  QCM07 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1= 0.169578578738 ! KQCMfodo2
  QCM08 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1=-0.171986012666 !-KQCMfodo2
  QCM09 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1= 0.174669019079 ! KQCMfodo2
  QCM10 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1=-0.175452188975 !-KQCMfodo2
  QCM11 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1= 0.176954338709 ! KQCMfodo2
  QCM12 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1=-0.181763763563 !-KQCMfodo2
  QCM13 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1= 0.0629864796   ! KQCMfodo2
  QCM14 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1=-0.176025228588 !-KQCMfodo2
  QCM15 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1= 0.067235283581 ! KQCMfodo2

! L3

  QCM16 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1=-0.316180920256 !-KQCMfodo3
  QCM17 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1= 0.257949204679 ! KQCMfodo3
  QCM18 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1=-0.210397479193 !-KQCMfodo3
  QCM19 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1= 0.19350208973  ! KQCMfodo3
  QCM20 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1=-0.187185819624 !-KQCMfodo3
  QCM21 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1= KQCMfodo3
  QCM22 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1=-KQCMfodo3
  QCM23 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1= KQCMfodo3
  QCM24 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1=-0.190491217851 !-KQCMfodo3
  QCM25 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1= 0.181772039438 ! KQCMfodo3
  QCM26 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1=-0.18153268228  !-KQCMfodo3
  QCM27 : QUAD, TYPE="cryo", L=Lcmq/2, APER=Rcmq, K1= 0.190275954782 ! KQCMfodo3
