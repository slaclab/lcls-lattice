  G031 := GradL1 ; P031 := PhasL1
  G032 := GradL1 ; P032 := PhasL1
  G033 := GradL1 ; P033 := PhasL1
  G034 := GradL1 ; P034 := PhasL1
  G035 := GradL1 ; P035 := PhasL1
  G036 := GradL1 ; P036 := PhasL1
  G037 := GradL1 ; P037 := PhasL1
  G038 := GradL1 ; P038 := PhasL1

  CAVL031  : LCAV, FREQ=1300, L=LcavL,  DELTAE=G031*LcavL,  PHI0=P031/360, &
