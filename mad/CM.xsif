! ==============================================================================
! DRIF
! ------------------------------------------------------------------------------

! ------------------------------------------------------------------------------
! 1.3 GHz cryomodule
! ------------------------------------------------------------------------------

! from Joshua Kaluzny spreadsheet (2015_11_19)

  Lgv2cav   := 0.79731 !u/s gate valve to cavity #1    !0.79981
  Lcav2cav  := 1.38360 !intra-CM cavity to cavity
  Lcav2bpm  := 0.81139 !cavity #8 to BPM
  Lbpm2quad := 0.26444 !BPM to quadrupole
  Lquad2gv  := 0.35186 !quadrupole to d/s gate valve   !0.35436
  Lgv2hom   := 0.16577 !d/s gate valve to HOM absorber !0.16327
  Lhom2gv   := 0.14442 !HOM absorber to u/s gate valve !0.14192

! derived dimensions

  Lcav2quad := Lcav2bpm+Lbpm2quad     !cavity #8 quadrupole
  Lcav2gv   := Lcav2quad+Lquad2gv     !cavity #8 to d/s gate valve
  Lcav2hom  := Lcav2gv+Lgv2hom        !cavity #8 to HOM absorber
  Lgv2gv    := Lgv2hom+Lhom2gv        !d/s gate valve to u/s gate valve
  Lcm2cm    := Lcav2gv+Lgv2gv+Lgv2cav !inter-CM cavity-to-cavity

! cryomodule drifts

  DCM1   : DRIF, L=Lgv2cav-LcavL/2
  DCM2   : DRIF, L=Lcav2cav-LcavL
  DCM3   : DRIF, L=Lcav2bpm-LcavL/2
  DCM4   : DRIF, L=Lbpm2quad-Lcmq/2
  DCM5   : DRIF, L=Lquad2gv-Lcmq/2
  DCMCM1 : DRIF, L=Lgv2hom
  DCMCM2 : DRIF, L=Lhom2gv

  DCM4b : DRIF, L=0.03
  DCM4a : DRIF, L=DCM4[L]-DCM4b[L]

! ------------------------------------------------------------------------------
! 1.3 GHz cryomodule to 3.9 GHz cryomodule
! ------------------------------------------------------------------------------

  Lhom2Hgv := 0.14282 !HOM absorber to u/s gate valve !0.17021

  DCMCMH1 : DRIF, L=Lgv2hom
  DCMCMH2 : DRIF, L=Lhom2Hgv

! ------------------------------------------------------------------------------
! 3.9 GHz cryomodule dimensions
! ------------------------------------------------------------------------------

! new (18-May-16)

  Lgv2Hcav   := 1.14660 !u/s gate valve to cavity #1
  LHcav2Hcav := 0.63416 !intra-CMH cavity to cavity
  LHcav2bpm  := 0.49684 !cavity #8 to BPM
  LHbpm2gv   := 0.16449 !BPM to d/s gate valve (no magnet package)
  LHgv2Hhom  := 0.16888 !d/s gate valve to HOM absorber
  LHhom2Hgv  := 0.13857 !HOM absorber to u/s gate valve

! derived dimensions

  LHcav2gv   := LHcav2bpm+LHbpm2gv !cavity #8 to d/s gate valve

! cryomodule drifts

  DCMH0    : DRIF, L=1.14662-CcavL/2
  DCMH1    : DRIF, L=Lgv2Hcav-CcavL/2
  DCMH2    : DRIF, L=LHcav2Hcav-CcavL
  DCMH3    : DRIF, L=LHcav2bpm-CcavL/2
  DCMH4    : DRIF, L=LHbpm2gv
  DCMHCMH1 : DRIF, L=LHgv2Hhom
  DCMHCMH2 : DRIF, L=LHhom2Hgv

! ------------------------------------------------------------------------------
! end caps, stay-clears, and L3 vacuum break
! ------------------------------------------------------------------------------

! end cap and feed cap dimensions, mechanical stay-clear, and differential
! vacuum pumping stay-clear (mostly from drawing SD-375-000-99-02)

  DCAP0u   : DRIF, L=0.49294 !EC-U to CSP01 = 6.965000 !0.49044
  DCAP0d   : DRIF, L=1.89015 !CSP01 to FC-1 = 7.328290 !1.88765
  DMSC0d   : DRIF, L=1.829
  DPSC1u   : DRIF, L=2.52295
  DMSC1u   : DRIF, L=1.829
  DCAP1u   : DRIF, L=0.87294 !FC-2 to CSP02 = 7.345000 !0.87044
  DCAP1d   : DRIF, L=1.75429 !CSPH2 to FC-3 = 6.333200
  DMSC1d   : DRIF, L=1.829
  DPSC1d   : DRIF, L=1.91205                           !1.91297
  DPSC2u   : DRIF, L=2.1388
  DMSC2u   : DRIF, L=1.829
  DCAP2u   : DRIF, L=0.87294 !FC-4 to CSP04 = 7.345000 !0.87044
  DCAP2d   : DRIF, L=1.58968 !CSP15 to FC-5 = 7.193590
  DMSC2d   : DRIF, L=1.829
  DPSC2d   : DRIF, L=1.91806
  DPSC3u   : DRIF, L=2.32295
  DMSC3u   : DRIF, L=1.829
  DCAP3u   : DRIF, L=0.87294 !FC-6 to CSP16 = 7.345000 !0.87044
  DBREAK   : DRIF, L=2.54931
  DCAP3d   : DRIF, L=1.72438 !CSP35 to EC-D = 7.328290
  DMSC3d   : DRIF, L=1.464
  DPSC3d   : DRIF, L=2.67004

! beamline flanges

  LBLF := 0.0889 !beamline flange to cap face (m)

  DMSC1ub  : DRIF, L=LBLF
  DMSC1ua  : DRIF, L=DMSC1u[L]-DMSC1ub[L]
  DMSC1da  : DRIF, L=LBLF
  DMSC1db  : DRIF, L=DMSC1d[L]-DMSC1da[L]
  DMSC2ub  : DRIF, L=LBLF
  DMSC2ua  : DRIF, L=DMSC2u[L]-DMSC2ub[L]
  DMSC2da  : DRIF, L=LBLF
  DMSC2db  : DRIF, L=DMSC2d[L]-DMSC2da[L]
  DMSC3ub  : DRIF, L=LBLF
  DMSC3ua  : DRIF, L=DMSC3u[L]-DMSC3ub[L]
  DMSC3da  : DRIF, L=LBLF
  DMSC3db  : DRIF, L=DMSC3d[L]-DMSC3da[L]

! split L0 downstream endcap drift for ASTRA treaty point (15 m from cathode)

  Lastra := 0.378513

  DCAP0da : DRIF, L=Lastra
  DCAP0db : DRIF, L=DCAP0d[L]-DCMCM1[L]-DCAP0da[L]

! vacuum components after L0 endcap

  DMSC0da : DRIF, L=LBLF
  DMSC0db : DRIF, L=1.231893
  DMSC0dc : DRIF, L=0.1016
  DMSC0dd : DRIF, L=0.156107
  DMSC0de : DRIF, L=DMSC0d[L]-DMSC0da[L]-DMSC0db[L]-DMSC0dc[L]-DMSC0dd[L]

! miscellaneous definitions

  LcryoL   := DCM1[L]+8*LcavL+7*DCM2[L]+DCM3[L]+DCM4[L]+Lcmq+DCM5[L]
  LcryoC   := DCMH1[L]+8*CcavL+7*DCMH2[L]+DCMH3[L]+DCMH4[L]
  LDCMfodo := LcryoL+Lgv2gv-Lcmq
  
  COMMENT
    VALUE, DCM1[L],DCM2[L],DCM3[L],DCM4[L],DCM5[L],DCMCM1[L],DCMCM2[L]
    VALUE, DCMH1[L],DCMH2[L],DCMH3[L],DCMH4[L]
    VALUE, LcryoL,LcryoC,LDCMfodo,LDCMfodo+Lcmq
  ENDCOMMENT

