! ------------------------------------------------------------------------------
! SURVEY in BSY coordinates (from end of L3)
! ------------------------------------------------------------------------------

! HXR

 !COMMENT
    ASSIGN, PRINT="BSY-LCLS2cuH.print"
    BEAM, ENERGY=Ef
    SET, SETCUS, CUSOFF
    SETK2cuH
    USE, BSYLTUH
    PRINT, FULL
