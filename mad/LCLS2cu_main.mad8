! HXR XTES

 !COMMENT
    ASSIGN, PRINT="BSY-LCLS2cuHXTES.print"
    BEAM, ENERGY=Ef
    SET, SETCUS, CUSOFF
    SETK2cuH
    USE, BSYLTUHXTES
    PRINT, FULL
    SURVEY, X0=Xf, Y0=Yf, Z0=Zf, THETA0=THETAf, PHI0=PHIf, PSI0=PSIf, &
