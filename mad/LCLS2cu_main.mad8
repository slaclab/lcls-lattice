! HXR safety dump

  COMMENT
    ASSIGN, PRINT="LCLS2cuHS.print"
    BEAM, ENERGY=E00
    SET, SETCUS, CUSOFF
    SETK2cuH
    USE, CU_SFTH
    PRINT, FULL
    SURVEY, THETA0=ADL1, X0=Xi, Z0=Zi, TAPE="LCLS2cuHS_survey.tape"
  ENDCOMMENT

