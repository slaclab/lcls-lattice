     !VARY, dSmdw, STEP=1.E-6
      VARY, D224[L], STEP=1.E-6
      WEIGHT, CIRC=1
     !CONSTR, IV40, CIRC=3377.660525-18.45*in2m
     !CONSTR, A3C1B, CIRC=3377.660525+27.43*in2m
     !CONSTR, A3I1, CIRC=3377.660525+102.97*in2m
