! ------------------------------------------------------------------------------

  COMMENT !rematch for dead QCM22
    BEAM, ENERGY=Ei
    USE, SC_SXRi
    SAVEBETA, TWm, CM26BEG
    TWISS, BETA0=TWSSi
    SHOW, TWm
    SET, QCM22[K1], 0
    SET, QCM23[K1], 0
    VALUE, QCM20[K1],QCM21[K1],QCM22[K1],QCM23[K1],QCM24[K1],QCM25[K1]
    MATCH, BETA0=TWSSi
      VARY, QCM20[K1], STEP=1.E-6, UPPER=0
      VARY, QCM21[K1], STEP=1.E-6, LOWER=0
      VARY, QCM24[K1], STEP=1.E-6, UPPER=0
      VARY, QCM25[K1], STEP=1.E-6, LOWER=0
      CONSTR, CM26BEG, BETX=TWm[BETX], ALFX=TWm[ALFX], &
                       BETY=TWm[BETY], ALFY=TWm[ALFY]
      SIMPLEX, TOL=1.E-20, CALLS=10000
      LMDIF, TOL=1.E-20, CALLS=10000
      MIGRAD, TOL=1.E-20, CALLS=10000
    ENDMATCH
    VALUE, QCM20[K1],QCM21[K1],QCM22[K1],QCM23[K1],QCM24[K1],QCM25[K1]
    TWISS, SAVE, BETA0=TWSSi
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=BEGL3B/ENDL3B, FILE="L3B", &
      TITLE="L3B: QCM22 and QCM23 off"
  ENDCOMMENT

  COMMENT !William Colocho's match
    BEAM, ENERGY=Ei
    USE, SC_SXRi
    SET, QCM20[K1], -0.208813709813
    SET, QCM21[K1],  0.30328446035
    SET, QCM22[K1], -0.235600917364
    SET, QCM23[K1],  0.0
    SET, QCM24[K1], -0.150730435467
    TWISS, SAVE, BETA0=TWSSi
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=BEGL3B/ENDL3B, FILE="L3B", &
      TITLE="L3B: QCM22 and QCM23 off"
  ENDCOMMENT

  COMMENT !F-JD's rule-of-thumb match
    BEAM, ENERGY=Ei
    USE, SC_SXRi
    SET, QCM21[K1],  0.185334132537/2
    SET, QCM22[K1],  0.0
    SET, QCM23[K1],  0.0
    SET, QCM24[K1], -0.189977001339/2
    TWISS, SAVE, BETA0=TWSSi
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=BEGL3B/ENDL3B, FILE="L3B", &
      TITLE="L3B: QCM22 and QCM23 off"
  ENDCOMMENT

! @BEAM0:
! - BETX=9.898319949733, ALFX=-1.895312604539, BmagX= 1.0064
! - BETY=3.357019824994, ALFY=-0.391485396868, BmagY= 1.6365

  comment !Mike Ehrlichman's match at 75 MeV
    SET, KQ0H01,  -5.8768  !-6.525507740091
    SET, KQ0H02,   6.2879  ! 6.335021170323
    SET, KQ0H03,  -0.85925 !-0.947730849876
    SET, KQ0H04,   1.0748  !-3.418410369214
    SET, KQ0H05,  -4.8180  !-7.013523766823
    SET, KQ0H06,   0.0     ! 1.450322442367
    SET, KQ0H07,  10.093   ! 7.874726189194
    SET, KQ0H08, -11.482   !-8.293357257814
    SET, KQHD01, -12.998   !-8.9263060781  
    SET, KQHD02,   7.6508  ! 6.460615023279
    SET, KQHD03,  -8.1152  !-8.534034325807
    SET, KQHD04,   6.1453  ! 6.807615097128
    BEAM, ENERGY=Ei
    USE, SC_DIAG0i
    VALUE, BXi,AXi,BYi,AYi
    MATCH, BETA0=TWSSi
      VARY, BXi, STEP=1.E-6, LOWER=0
      VARY, AXi, STEP=1.E-6
      VARY, BYi, STEP=1.E-6, LOWER=0
      VARY, AYi, STEP=1.E-6
      CONSTR, HTRUNDB, BETX=BXlh, ALFX=AXlh, BETY=BYlh, ALFY=AYlh
      LMDIF, TOL=1.E-20, CALLS=10000
      MIGRAD, TOL=1.E-20, CALLS=10000
    ENDMATCH
    VALUE, BXi,AXi,BYi,AYi
    TWISS, BETA0=TWSSi, SAVE, TAPE="twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=#S/#E, VMIN=0, FILE="match"
  endcomment

! ------------------------------------------------------------------------------

  comment !SXR FODO (4 GeV, |GLq|=30 kG, VGHPU39, K=5.5, PSPI=1800)
    BEAM, ENERGY=Ef
    USE, (SXCEL26,SXCEL27,SXCEL28,SXCEL29, &
          SXCEL30,SXCEL31,SXCEL32,SXCEL33)
    SAVEBETA, TWm, #S
    TWISS, SAVE, TAPE="SXR_twiss.tape", RTAPE="SXR_rmat.tape"
    SHOW, TWm
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=#S/#E, FILE="SXR_CELL", &
      TITLE="LCLS-II SXR FODO (30 kG; E=4, KSXU=5.5, PIPSSX=1800)"
  endcomment

  comment !HXR FODO (4 GeV, |GLq|=30 kG, HGVPU, K=2, PSPI=490)
    BEAM, ENERGY=Ef
    USE, (HXCEL14,HXCEL15,HXCEL16,HXCEL17,HXCEL18,HXCEL19)
    SAVEBETA, TWm, #S
    TWISS, SAVE, TAPE="HXR_twiss.tape", RTAPE="HXR_rmat.tape"
    SHOW, TWm
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=#S/#E, FILE="HXR_CELL", &
      TITLE="LCLS-II HXR FODO (30 kG; E=4, KHXU=2, PIPSHX=490)"
  endcomment

