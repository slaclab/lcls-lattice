  comment
    BEAM, ENERGY=E0
    SET, SETSP, SETSPd ; SET, SETDA, DAON
    SET, AB7, 0
    USE, SC_DASEL
   !VALUE, dSmdw,D126[L],D208[L],D126[L]+D208[L]
   !VALUE, D127a[L]
   !VALUE, D204a[L]
    VALUE, D225[L]
    MATCH, SURVEY, XS=Xgun, YS=Ygun, ZS=Zgun
     !VARY, dSmdw, STEP=1.E-6
     !VARY, D127a[L], STEP=1.E-6
     !VARY, D204a[L], STEP=1.E-6
      VARY, D225[L], STEP=1.E-6
      WEIGHT, ZS=1 !, CIRC=1
     !CONSTR, A3C1A, CIRC=3373.337145
     !CONSTR, NOTCHEND, CIRC=3373.404345
     !CONSTR, ALCOVEEND, CIRC=3380.719545
      CONSTR, BMDE, ZS=3503.1082
     !LMDIF, TOL=1.E-201
     !MIGRAD, TOL=1.E-20
    ENDMATCH
   !VALUE, dSmdw,D126[L],D208[L],D126[L]+D208[L]
   !VALUE, D127a[L]
   !VALUE, D204a[L]
    VALUE, D225[L]
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="survey.tape"
  endcomment

  comment
    BEAM, ENERGY=E0
    SET, SETSP, SETSPd ; SET, SETDA, DAON
