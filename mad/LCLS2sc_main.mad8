 !CALL "LCLS2sc_color_plots.mad8" !run by itself (ends with STOP)
 !CALL "LCLS2sc_area_plots.mad8"  !run by itself (ends with STOP)

! ==============================================================================
! Beam from LCLS-II gun (SURVEY in linac coordinates)
! ------------------------------------------------------------------------------
  
! SXR

 !COMMENT
    ASSIGN, PRINT="LCLS2scS.print"
    BEAM, ENERGY=E0
    SET, SETSP, SETSPs ; SET, SETCUS, CUSOFF
    USE, SC_SXR
   !SAVELINE, NAME="SC_SXR", FILENAME="LCLS2scS.saveline"
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="LCLS2scS_survey.tape"
    BEAM, ENERGY=Ei
    USE, SC_SXRi
    PRINT, FULL
    TWISS, SAVE, BETA0=TWSSi, TAPE="LCLS2scS_twiss.tape" !, &
   !  RTAPE="LCLS2scS_rmat.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, VMIN=0, VMAX=10, &
      STYLE=100, SPLINE, RANGE=#S/DUMPFACEB, FILE="LCLS2scS", &
      TITLE="SC-linac to SXR dump"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=#S/DUMPFACEB, FILE="LCLS2scS", &
      TITLE="SC-linac to SXR dump"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
      STYLE=100, SPLINE, RANGE=#S/DUMPFACEB, FILE="LCLS2scS", &
      TITLE="SC-linac to SXR dump"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=VBOUTB/SXR47END, FILE="LCLS2scS", &
      TITLE="VBEND through SXR"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
      STYLE=100, SPLINE, RANGE=QSXh44[1]/DUMPFACEB, FILE="LCLS2scS", &
      TITLE="SXR to Dump"
!ENDCOMMENT

! ------------------------------------------------------------------------------

