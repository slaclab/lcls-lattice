  COMMENT
    ASSIGN, PRINT="LCLS2scD.print"
    BEAM, ENERGY=E0
    SET, SETSP, SETSPd ; SET, SETDA, DAOFF
    USE, SC_BSYD
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="LCLS2scD_survey.tape"
    BEAM, ENERGY=Ei
   !SETQCM01on
    USE, SC_BSYDi
    PRINT, FULL
    TWISS, SAVE, BETA0=TWSSi, TAPE="LCLS2scD_twiss.tape" !, &
   !  RTAPE="LCLS2scD_rmat.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, VMIN=0, VMAX=5.0, &
      STYLE=100, SPLINE, RANGE=#S/ENDEXT, FILE="LCLS2scD", &
      TITLE="SC-linac to EXT"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, VMIN=0, &
      STYLE=100, SPLINE, RANGE=#S/ENDCOL0, FILE="LCLS2scD", &
      TITLE="HTR/COL0"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, VMIN=0, &
      STYLE=100, SPLINE, RANGE=BEGEXT/OTR31, FILE="LCLS2scD", &
      TITLE="EXT/DOG"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, RANGE=#S/DUMPBSY, FILE="LCLS2scD", &
      TITLE="SC-linac to BSY dump"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
      STYLE=100, SPLINE, RANGE=#S/DUMPBSY, FILE="LCLS2scD", &
      TITLE="SC-linac to BSY dump"
  ENDCOMMENT

