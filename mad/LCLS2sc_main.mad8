  COMMENT
    BEAM, ENERGY=E0LEI
    USE, SC_DIAG02
    PRINT, FULL
    SURVEY, X0=XGUN2, Y0=YGUN2, Z0=ZGUN2, TAPE="DIAG02_SURVEY.TAPE"
    BEAM, ENERGY=EI
    USE, LEI_2
    TWISS, BETA0=TWSSDLI, TAPE="TWISS.TAPE", RTAPE="RMAT.TAPE"
    USE, LEI_2_PLOT
    PRINT, FULL
    TWISS, SAVE, BETA0=TWSSDLI
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, FILE="PLOT", &
      TITLE="LCLS-II-HE: LEI DOGLEG ALTERNATE LAYOUT (R56 = -12.124 MM)"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
      STYLE=100, SPLINE, FILE="PLOT", &
      TITLE="LCLS-II-HE: LEI DOGLEG ALTERNATE LAYOUT (R56 = -12.124 MM)"
    TWISS, CHROM, SAVE, BETA0=TWSSDLI, TAPE="CHROM.TAPE"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DDX,DDY, &
      STYLE=100, SPLINE, FILE="PLOT", &
      TITLE="LCLS-II-HE: LEI DOGLEG ALTERNATE LAYOUT (R56 = -12.124 MM)"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=WX,WY, &
      STYLE=100, SPLINE, FILE="PLOT", &
      TITLE="LCLS-II-HE: LEI DOGLEG ALTERNATE LAYOUT (R56 = -12.124 MM)"
    BEAM, ENERGY=EI
    USE, LEI_2
    MATCH, BETA0=TWSSDLI
      WEIGHT, I2=1, I5=1, I5I2=1
      TMATRIX, #S/#E, TM(6,6,6)=0
      RMATRIX, #S/#E, RM(6,6)=1
    ENDMATCH
    USE, SC_DIAG02I
    TWISS, SAVE, BETA0=TWSSILEI
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, FILE="PLOT", &
      TITLE="LCLS-II-HE: LEI DOGLEG ALTERNATE LAYOUT (R56 = -12.124 MM)"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
      STYLE=100, SPLINE, FILE="PLOT", &
      TITLE="LCLS-II-HE: LEI DOGLEG ALTERNATE LAYOUT (R56 = -12.124 MM)"
    USE, SC_DIAGISI
    TWISS, SAVE, BETA0=TWSSILEI
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
      STYLE=100, SPLINE, FILE="PLOT", &
      TITLE="LCLS-II-HE: LEI DIAGNOSTIC/SPECTROMETER LINE"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
      STYLE=100, SPLINE, FILE="PLOT", &
      TITLE="LCLS-II-HE: LEI DIAGNOSTIC/SPECTROMETER LINE"
    BEAM, ENERGY=E0LEI
    USE, SC_DIAGIS
    PRINT, FULL
    SURVEY, X0=XGUN2, Y0=YGUN2, Z0=ZGUN2, TAPE="DIAGIS_SURVEY.TAPE"
  ENDCOMMENT

