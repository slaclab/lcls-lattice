   !VALUE, dSmdw,DDAS21b[L],DDAS21c[L],DDAS21b[L]+DDAS21c[L]
   !VALUE, D125[L]
   !VALUE, D126[L]
   !VALUE, D208[L]
    VALUE, D225[L]
    MATCH, SURVEY, XS=Xgun, YS=Ygun, ZS=Zgun
     !VARY, DDAS14ac1[L], STEP=1.E-6
     !VARY, D125[L], STEP=1.E-6
     !VARY, D126[L], STEP=1.E-6
     !VARY, D208[L], STEP=1.E-6
      VARY, D225[L], STEP=1.E-6
      WEIGHT, ZS=1
     !CONSTR, WSDAS14, ZS=3046.661
     !CONSTR, XCDAS19, ZS=3158.000000
     !CONSTR, D125, ZS=3350.02508
     !CONSTR, A3C1A, ZS=3357.2266
     !CONSTR, PIVOT, ZS=3372.6980
      CONSTR, BMDE, ZS=3503.1082
     !LMDIF, TOL=1.E-20
     !MIGRAD, TOL=1.E-20
    ENDMATCH
   !VALUE, DDAS14ac1[L]
   !VALUE, DDAS14ac[L],DDAS14ac1[L]+DDAS14ac2[L]
   !VALUE, dSmdw,DDAS21b[L],DDAS21c[L],DDAS21b[L]+DDAS21c[L]
   !VALUE, D125[L]
   !VALUE, D126[L]
   !VALUE, D208[L]
    VALUE, D225[L]
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun
  endcomment

  comment
    BEAM, ENERGY=E0
    SET, SETSP, SETSPd ; SET, SETDA, DAON
    USE, SC_DASEL
   !VALUE, dSmdw,D126[L],D127[L],D126[L]+D127[L]
   !VALUE, dSmdw,D128[L],D129[L],D128[L]+D129[L]
   !VALUE, dSmdw,D129[L],D130[L],D129[L]+D130[L]
   !VALUE, dSmdw,D130[L],D131[L],D130[L]+D131[L]
   !VALUE, dSmdw,D131[L],D201[L],D131[L]+D201[L]
   !VALUE, dSmdw,D201[L],D202[L],D201[L]+D202[L]
   !VALUE, dSmdw,D202[L],D203[L],D202[L]+D203[L]
   !VALUE, dSmdw,D203[L],D204[L],D203[L]+D204[L]
   !VALUE, dSmdw,D204[L],D205[L],D204[L]+D205[L]
   !VALUE, dSmdw,D205[L],D206[L],D205[L]+D206[L]
   !VALUE, dSmdw,D206[L],D207[L],D206[L]+D207[L]
   !VALUE, dSmdw,D207[L],D208[L],D207[L]+D208[L]
    VALUE, D224[L]
