  TITLE, "AD_ACCEL (January 17, 2024)" !superconducting linac

! *** OPTICS=AD_ACCEL-17JAN24 ***

  OPTION, -ECHO, INFO, WARN, VERIFY, DOUBLE
  ASSIGN, ECHO="LCLS2sc.echo"
  ASSIGN, PRINT="LCLS2sc.print"

