  comment
    BEAM, ENERGY=Ef
    SET, SETSP, SETSPs ; SET, SETCUS, CUSOFF
    USE, BSYLCLS2scS
    VALUE, DUSEGS50f[L]
    MATCH, SURVEY, XS=Xf, YS=Yf, ZS=Zf, THETAS=THETAf, PHIS=PHIf, PSIS=PSIf
      VARY, DUSEGS50f[L], STEP=1.E-6
      WEIGHT, ZS=1
      CONSTR, GJPEPX, ZS=668.030492
      LMDIF, TOL=1.E-20
      MIGRAD, TOL=1.E-20
    ENDMATCH
    VALUE, DUSEGS50f[L]
    PRINT, FULL
    SURVEY, X0=Xf, Y0=Yf, Z0=Zf, THETA0=THETAf, PHI0=PHIf, PSI0=PSIf, &
      TAPE="survey.tape"
    STOP
  endcomment

  comment !match SXRSS chicane to dX= 17.0 mm
    BEAM, ENERGY=Ef
    VALUE, Ef,Eu
    SET, SETSXRSS, 1
    USE, SCHICANE
    VALUE, AB5,BLB5
    MATCH, BETX=1, BETY=1, SURVEY
      VARY, AB5, STEP=1.E-6, UPPER=0
      WEIGHT, XS=1
      CONSTR, CNTRS, XS=+17.0E-3
      LMDIF, TOL=1.E-20
      MIGRAD, TOL=1.E-20
    ENDMATCH
    VALUE, AB5,BLB5
    PRINT, FULL
    SURVEY
  endcomment

  comment
    BEAM, ENERGY=E0
    SET, SETSP, SETSPs ; SET, SETCUS, CUSOFF
    USE, SC_SXR
    VALUE, DWSDUMPa1[L]
    MATCH, SURVEY, XS=Xgun, YS=Ygun, ZS=Zgun
      VARY, DWSDUMPa1[L], STEP=1.E-6
      WEIGHT, ZS=1
      CONSTR, PCEBDB, ZS=0.3048*12340.17
      LMDIF, TOL=1.E-20
      MIGRAD, TOL=1.E-20
    ENDMATCH
    VALUE, DWSDUMPa1[L]
    BEAM, ENERGY=E0
    USE, SC_SXR
    PRINT, FULL
    SURVEY, X0=Xgun, Y0=Ygun, Z0=Zgun, TAPE="survey.tape"
  endcomment

