! ------------------------------------------------------------------------------
! LCLS2sc working stuff
! ------------------------------------------------------------------------------

  COMMENT !periodic SXR/HXR cells
    BEAM, ENERGY=Eu
    USE, (SXCEL37,SXCEL38,SXCEL39,SXCEL40)
    PRINT, FULL
    SAVEBETA, TWmS, #E
    TWISS, SAVE, TAPE="twiss.tape"
    SHOW, TWmS
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, VMIN=0.0, &
      STYLE=100, SPLINE, RANGE=#S/#E, FILE="plot", &
      TITLE="SXR long-period cells (E = 8 GeV ; GLq = 30 kG)"
    USE, (SXCEL41,SXCEL42,SXCEL43,SXCEL44)
    PRINT, FULL
    SAVEBETA, TWmL, #E
    TWISS, SAVE, TAPE="twiss.tape"
    SHOW, TWmL
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, VMIN=0.0, &
      STYLE=100, SPLINE, RANGE=#S/#E, FILE="plot", &
      TITLE="SXR short-period cells (E= 8 GeV ; GLq= 30 kG)"
    USE, (HXCEL42,HXCEL43,HXCEL44,HXCEL45)
    PRINT, FULL
    SAVEBETA, TWmH, #E
    TWISS, SAVE, TAPE="twiss.tape"
    SHOW, TWmH
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, VMIN=0.0, &
      STYLE=100, SPLINE, RANGE=#S/#E, FILE="plot", &
      TITLE="HXR cells (E = 8 GeV ; GLq = 30 kG)"
  ENDCOMMENT

