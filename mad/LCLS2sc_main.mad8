  comment
    BEAM, ENERGY=Ef
    SET, SETSP, SETSPh
    USE, BSYLCLS2scH
   !VALUE, DMUON1[L],DMUON2[L]
   !VALUE, DMUON3[L],DMUON4[L]
   !VALUE, D0CB[L]+(DU1H[L]+DU2H[L]+ZB6/2)
   !VALUE, ZB1toVV+ZB6/2
   !VALUE, ZB3toVG+ZB6/2
   !VALUE, ZVVtoB4+ZB6/2
   !VALUE, DU3hCBb[L]-DU3h[L],DU4hCB[L]-DU4h[L]
   !VALUE, DU4hCB[L]-DU4h[L],DU5hCB[L]-DU5h[L]
   !VALUE, D0CB2[L]+(DU1H[L]+DU2H[L]+ZB6/2)
    MATCH, SURVEY, XS=Xf, YS=Yf, ZS=Zf, THETAS=THETAf, PHIS=PHIf, PSIS=PSIf
      VARY, dZmdw, STEP=1.E-6
      WEIGHT, ZS=1
     !CONSTR, VV999,     ZS=511.930000+2.791885
     !CONSTR, RFBHX12,   ZS=511.930000+2.97665+LRFBub/2
     !CONSTR, BCXCBX11a, ZS=511.930000+3.42959
     !CONSTR, VVCBX11,   ZS=511.930000+3.69228
     !CONSTR, VGCBX1,    ZS=511.930000+5.61694
     !CONSTR, VVCBX12,   ZS=511.930000+6.16336
     !CONSTR, QHXH13[1], ZS=511.930000+6.85541
     !CONSTR, RFBHX13,   ZS=511.930000+6.98524+LRFBub/2
     !CONSTR, BCXCBX21a, ZS=511.930000+35.53093
     !LMDIF, TOL=1.E-20
     !MIGRAD, TOL=1.E-20
    ENDMATCH
   !VALUE, DMUON1[L],DMUON2[L]
   !VALUE, DMUON3[L],DMUON4[L]
   !VALUE, D0CB[L]+(DU1H[L]+DU2H[L]+ZB6/2)
   !VALUE, ZB1toVV+ZB6/2
   !VALUE, ZB3toVG+ZB6/2
   !VALUE, ZVVtoB4+ZB6/2
   !VALUE, DU3hCBb[L]-DU3h[L],DU4hCB[L]-DU4h[L]
   !VALUE, DU4hCB[L]-DU4h[L],DU5hCB[L]-DU5h[L]
   !VALUE, D0CB2[L]+(DU1H[L]+DU2H[L]+ZB6/2)
    PRINT, FULL
    SURVEY, X0=Xf, Y0=Yf, Z0=Zf, THETA0=THETAf, PHI0=PHIf, PSI0=PSIf, &
      TAPE="survey.tape"
  endcomment

  comment !use with undhBBA.m (non-BBA)
    BEAM, ENERGY=Ef
    SET, SETSP, SETSPh
    USE, (LTUH,HXRUND,DUMPLINE), RANGE=MM1/#E
    PRINT, FULL
    TWISS, BETA0=TWSSmh, SAVE=TWISS, TAPE="twiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
      STYLE=100, SPLINE, RANGE=QHXh44[1]/DUMPFACE, &
      TITLE="HXR undulator to Dump, w/o coupling", FILE="match"
   !TWISS, BETA0=TWSSmh, SAVE=TWISS, COUPLE
   !PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
   !  STYLE=100, SPLINE, RANGE=QHXh44[1]/DUMPFACE, &
   !  TITLE="HXR undulator to Dump, with coupling", FILE="match"
  endcomment

  comment !use with undhBBA.m (BBA)
    BEAM, ENERGY=Ef
    SET, SETSP, SETSPh
    SET, kQHX46, kQDHX !for BBA
    SET, kQHX47, kQFHX !for BBA
    USE, (LTUH,HXRUND,DUMPLINE), RANGE=MM1/#E
    PRINT, FULL
    TWISS, BETA0=TWSSmh, SAVE=TWISS, TAPE="BBAtwiss.tape"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
      STYLE=100, SPLINE, RANGE=QHXh44[1]/DUMPFACE, &
      TITLE="HXR undulator to Dump (BBA), w/o coupling", FILE="BBAmatch"
   !TWISS, BETA0=TWSSmh, SAVE=TWISS, COUPLE
   !PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
   !  STYLE=100, SPLINE, RANGE=QHXh44[1]/DUMPFACE, &
   !  TITLE="HXR undulator to Dump, with coupling", FILE="BBAmatch"
  endcomment

