    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
      STYLE=100, SPLINE, RANGE=#S/ROLL2, FILE="LCLS2scDA", &
      TITLE="SC-linac to DASEL"
    TWISS, COUPLE, SAVE, BETA0=TWSSi
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BEYY, &
      STYLE=100, SPLINE, RANGE=BEGB/MADUMP, FILE="LCLS2scDA", &
      TITLE="Aline (relaxed optics)"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
      STYLE=100, SPLINE, RANGE=BEGB/MADUMP, FILE="LCLS2scDA", &
      TITLE="Aline (relaxed optics)"
