      VARY, LDSPBK5ha, STEP=1.E-6
     !VARY, LDSPQ1a,   STEP=1.E-6
     !VARY, LDSPQ2c,   STEP=1.E-6
     !VARY, LDSPBK5sa, STEP=1.E-6
     !VARY, LDSP3dd,   STEP=1.E-6
     !VARY, LDSP5dd,   STEP=1.E-6
      WEIGHT, ZS=1
      CONSTR, BPMSPH,  ZS=2789.98063   !2790.043003
     !CONSTR, BPMSP1,  ZS=2826.799175  !2826.876003
     !CONSTR, BPMSP2,  ZS=2850.553142  !2850.586903
     !CONSTR, BPMSPS,  ZS=2877.1781665 !2877.219003
     !CONSTR, BPMSP2D, ZS=2962.143405  !2962.172603
     !CONSTR, BPMSP3D, ZS=3040.93406   !3040.884777
     !LMDIF, TOL=1.E-20
     !MIGRAD, TOL=1.E-20
    ENDMATCH
    VALUE, LDSPBK5ha
   !VALUE, LDSPQ1a
   !VALUE, LDSPQ2c
   !VALUE, LDSPBK5sa
   !VALUE, LDSP3dd
   !VALUE, LDSP5dd
