 !COMMENT
    ASSIGN, PRINT="DIAGIS.print"
    BEAM, ENERGY=E0LEI
   !CALL, FILENAME="SETK2scDGI.xsif" !for mux=1.75*2pi from TCXDGI to OTRDGI1 ... use for BSC
    USE, SC_DIAGIS
   !SAVELINE, NAME="DIAGIS", FILENAME="DIAGIS.saveline"
    PRINT, FULL
    SURVEY, X0=Xgun2, Y0=Ygun2, Z0=Zgun2, TAPE="DIAGIS_survey.tape"
    BEAM, ENERGY=Ei
    USE, SC_DIAGISi
    PRINT, FULL
    TWISS, SAVE, BETA0=TWSSiLEI, TAPE="DIAGIS_twiss.tape" !, &
   !  RTAPE="DIAGIS_rmat.tape"
