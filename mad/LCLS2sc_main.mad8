  COMMENT
    BEAM, ENERGY=E0
    SET, SETSP, SETSPH
    USE, SC_HXR
    MATCH, SURVEY, ZS=ZGUN
      VARY, DSMDW, STEP=1.E-6
      WEIGHT, ZS=1
     !CONSTR, SSP1H[1], ZS=2847.6166
     !CONSTR, BPMSP1H,  ZS=2848.1234
     !CONSTR, XCSP1H,   ZS=2848.7601
     !CONSTR, XCSP3H,   ZS=2876.5
     !CONSTR, SSP2H[1], ZS=2877.015
     !LMDIF, TOL=1.E-20
     !MIGRAD, TOL=1.E-20
    ENDMATCH
    BEAM, ENERGY=E0
    SET, SETSP, SETSPH
    USE, SC_HXR
    PRINT, FULL
    SURVEY, X0=XGUN, Y0=YGUN, Z0=ZGUN
  ENDCOMMENT

  COMMENT
    BEAM, ENERGY=E0
    SET, SETSP, SETSPS ; SET, SETCUS, CUSOFF
    USE, SC_SXR
    VALUE, LDSP3SC,LDSP3SD
    VALUE, LDSP3SC+LDSP3SD
    MATCH, SURVEY, ZS=ZGUN
      VARY, DSMDW, STEP=1.E-6
      WEIGHT, ZS=1
     !CONSTR, SSP1S[1], ZS=2924.3919
     !CONSTR, BPMSP1S,  ZS=2924.8986
     !CONSTR, XCSP1S,   ZS=2925.4987
     !LMDIF, TOL=1.E-20
     !MIGRAD, TOL=1.E-20
    ENDMATCH
    VALUE, LDSP3SC,LDSP3SD
    VALUE, LDSP3SC+LDSP3SD
    BEAM, ENERGY=E0
    SET, SETSP, SETSPS ; SET, SETCUS, CUSOFF
    USE, SC_SXR
    PRINT, FULL
    SURVEY, X0=XGUN, Y0=YGUN, Z0=ZGUN
  ENDCOMMENT

  COMMENT !MATCH SXR RASTERING MAGNET LOCATIONS
    BEAM, ENERGY=E0
    SET, SETSP, SETSPS ; SET, SETCUS, CUSOFF
    USE, SC_SXR
    VALUE, DD2B2[L],DD2B3[L]
    MATCH, SURVEY, XS=XGUN, YS=YGUN, ZS=ZGUN
      VARY, DD2B2[L], STEP=1.E-6
      VARY, DD2B3[L], STEP=1.E-6
      WEIGHT, ZS=1
      CONSTR, BKXRASS, ZS=3754.123
      CONSTR, BKYRASS, ZS=3754.961
      LMDIF, TOL=1.E-20
      MIGRAD, TOL=1.E-20
    ENDMATCH
    VALUE, DD2B2[L],DD2B3[L]
    BEAM, ENERGY=E0
    USE, SC_SXR
    PRINT, FULL
    SURVEY, X0=XGUN, Y0=YGUN, Z0=ZGUN, TAPE="SURVEY.TAPE"
  ENDCOMMENT

  COMMENT !MATCH CM001 LOCATION
    BEAM, ENERGY=E0LEI
    SET, SETSP, SETSPS ; SET, SETCUS, CUSOFF
    USE, (GUNLEI,L0LEI)
    VALUE, DGLEI6[L]
    MATCH, SURVEY
      VARY,DGLEI6[L], STEP=1.E-6
      WEIGHT, ZS=1
      CONSTR, CAVL001, ZS=6.5+CAVL001[L]/2
      LMDIF, TOL=1.E-20
      MIGRAD, TOL=1.E-20
    ENDMATCH
    VALUE, DGLEI6[L]
    BEAM, ENERGY=E0LEI
    USE, (GUNLEI,L0LEI)
    PRINT, FULL
    SURVEY, TAPE="SURVEY.TAPE"
    STOP
  ENDCOMMENT

  COMMENT !MATCH CATHODELEI LOCATION
    BEAM, ENERGY=E0LEI
    SET, SETSP, SETSPS ; SET, SETCUS, CUSOFF
    USE, (GUNLEI,L0LEI,LEI,HTR_2)
    VALUE, ZGUN2
    MATCH, SURVEY, XS=XGUN2, YS=YGUN2, ZS=ZGUN2
      VARY, ZGUN2, STEP=1.E-6
      WEIGHT, ZS=1
      CONSTR, Q0H03[1], ZS=1.345628800E+01
      LMDIF, TOL=1.E-20
      MIGRAD, TOL=1.E-20
    ENDMATCH
    VALUE, ZGUN2
    BEAM, ENERGY=E0LEI
    USE, (GUNLEI,L0LEI,LEI,HTR_2)
    PRINT, FULL
    SURVEY, X0=XGUN2, Y0=YGUN2, Z0=ZGUN2, TAPE="SURVEY.TAPE"
    STOP
  ENDCOMMENT

  COMMENT !MATCH SXRSS CHICANE TO DX= 17.0 MM
    BEAM, ENERGY=EF
    VALUE, EF,EU
    SET, SETSXRSS, 1
    USE, SCHICANE
    VALUE, AB5,BLB5
    MATCH, BETX=1, BETY=1, SURVEY
      VARY, AB5, STEP=1.E-6, UPPER=0
      WEIGHT, XS=1
      CONSTR, CNTRS, XS=+17.0E-3
      LMDIF, TOL=1.E-20
      MIGRAD, TOL=1.E-20
    ENDMATCH
    VALUE, AB5,BLB5
    PRINT, FULL
    SURVEY
  ENDCOMMENT

