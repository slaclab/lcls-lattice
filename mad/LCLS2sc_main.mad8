      STYLE=100, SPLINE, RANGE=#S/DUMPFACEI, FILE="DIAGIS", &
      TITLE="DIAGI spectrometer"
    PLOT, TABLE=TWISS, HAXIS=S, VAXIS=DX,DY, &
      STYLE=100, SPLINE, RANGE=#S/DUMPFACEI, FILE="DIAGIS", &
      TITLE="DIAGI spectrometer"
 !ENDCOMMENT

