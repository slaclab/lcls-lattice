
! *** OPTICS=AD_ACCEL-09JUN2025s ***

! ==============================================================================
! Color Twiss plots (beam from LCLS-II gun)
! ------------------------------------------------------------------------------

! Cathode to BEAM0

  BEAM, ENERGY=E0
  USE, (GUN,L0)
  PRINT, FULL
  TWISS, COUPLE, SAVE, BETA0=TWSS0
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, VMIN=0, VMAX=0.12, &
    COLOUR=100, -SPLINE, RANGE=CATHODEB/BEAM0, FILE="LCLS2sc_color", &
    TITLE="GUNB + L0B"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, VMIN=0, VMAX=20, &
    COLOUR=100, -SPLINE, RANGE=CATHODEB/BEAM0, FILE="LCLS2sc_color", &
    TITLE="GUNB + L0B"

! DIAG0

  BEAM, ENERGY=Ei
  USE, SC_DIAG0i
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGDIAG0/ENDDIAG0, FILE="LCLS2sc_color", &
    TITLE="DIAG0"

! BEAM0 to HXR Main Dump

  BEAM, ENERGY=Ei
  SET, SETSP, SETSPh
  USE, SC_HXRi
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, VMIN=0, VMAX=0.160, &
    COLOUR=100, SPLINE, RANGE=#S/ENDCOL0, FILE="LCLS2sc_color", &
    TITLE="SC_linac: Laser Heater + Coll0"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=#S/ENDCOL0, FILE="LCLS2sc_color", &
    TITLE="SC_linac: Laser Heater + Coll0"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, &
    COLOUR=100, SPLINE, RANGE=BEGL1B/ENDCOL1, FILE="LCLS2sc_color", &
    TITLE="SC_linac: L1B + BC1B + Coll1"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGL1B/ENDCOL1, FILE="LCLS2sc_color", &
    TITLE="SC_linac: L1B + BC1B + Coll1"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, VMIN=0, &
    COLOUR=100, SPLINE, RANGE=BEGL2B/ENDEMIT2, FILE="LCLS2sc_color", &
    TITLE="SC_linac: L2B + BC2B + EMIT2"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGL2B/ENDEMIT2, FILE="LCLS2sc_color", &
    TITLE="SC_linac: L2B + BC2B + EMIT2"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, VMIN=0, &
    COLOUR=100, SPLINE, RANGE=BEGL3B/ENDEXT, FILE="LCLS2sc_color", &
    TITLE="SC_linac: L3B + Extension"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGL3B/ENDEXT, FILE="LCLS2sc_color", &
    TITLE="SC_linac: L3B + Extension"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGDOG/MQBP13, FILE="LCLS2sc_color", &
    TITLE="SC_linac: Dogleg + Match to Bypass"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=MQBP13/ENDBYP, FILE="LCLS2sc_color", &
    TITLE="SC_linac: Bypass Line to Spreader"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGSPH/ENDLTUH, FILE="LCLS2sc_color", &
    TITLE="SPH + LTUH"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGUNDH/HXR46END, FILE="LCLS2sc_color", &
    TITLE="HXR Undulator", VMIN=0
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=HXR47BEG/DUMPFACE, FILE="LCLS2sc_color", &
    TITLE="HXR Post-undulator to Dump"

! SPS to SXR Main Dump

  BEAM, ENERGY=Ei
  SET, SETSP, SETSPs ; SET, SETCUS, CUSOFF
  USE, SC_SXRi
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGSPS/ENDLTUS, FILE="LCLS2sc_color", &
    TITLE="SC_linac: Spreader + LTUS"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGUNDS/SXR46END, FILE="LCLS2sc_color", &
    TITLE="SXR Undulator", VMIN=0
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=SXR47BEG/DUMPFACEB, FILE="LCLS2sc_color", &
    TITLE="SXR Post-undulator to Dump"

! SXR Safety Dump

  BEAM, ENERGY=Ei
  SET, SETSP, SETSPs ; SET, SETCUS, CUSOFF
  USE, SC_SFTSi
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGSFTS_1/SFTDMPB, FILE="LCLS2sc_color", &
    TITLE="SXR Safety Dump"

! Spreader to BSY Dump

  BEAM, ENERGY=Ei
  SET, SETSP, SETSPd ; SET, SETDA, DAOFF
  USE, SC_BSYDi
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGSPD_1/DUMPBSY, FILE="LCLS2sc_color", &
    TITLE="Spreader to BSY Dump"

! DASEL (a.k.a. S30XL, LESA ... off-project)

  BEAM, ENERGY=Ei
  SET, SETSP, SETSPd ; SET, SETDA, DAON
  USE, SC_DASELi
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=rBETX,rBETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGDASEL/ENDBSYA_2, FILE="LCLS2sc_color", &
    TITLE="DASEL to A-line"

! ------------------------------------------------------------------------------

  STOP
  
