
! *** OPTICS=AD_ACCEL-10SEP2026s ***

! ==============================================================================
! Color Twiss plots (beam from LCLS-II gun)
! ------------------------------------------------------------------------------

! Cathode to BEAM0

  BEAM, ENERGY=E0
  USE, (GUN,L0)
  PRINT, FULL
  TWISS, COUPLE, SAVE, BETA0=TWSS0
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, VMIN=0, VMAX=0.1, &
    COLOUR=100, -SPLINE, RANGE=CATHODEB/#E, FILE="LCLS2sc_color", &
    TITLE="GUNB + L0B"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, VMIN=0, VMAX=20, &
    COLOUR=100, -SPLINE, RANGE=CATHODEB/#E, FILE="LCLS2sc_color", &
    TITLE="GUNB + L0B"

! BEAM0 to SXR Main Dump

  BEAM, ENERGY=Ei
  SET, SETSP, SETSPs ; SET, SETCUS, CUSOFF
  USE, SC_SXRi
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, VMIN=0, &
    COLOUR=100, SPLINE, RANGE=#S/ENDL1B, FILE="LCLS2sc_color", &
    TITLE="SC_linac: Laser Heater + Coll0 + L1B"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=#S/ENDL1B, FILE="LCLS2sc_color", &
    TITLE="SC_linac: Laser Heater + Coll0 + L1B"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGBC1B/ENDCOL1, FILE="LCLS2sc_color", &
    TITLE="SC_linac: BC1B + Coll1"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, VMIN=0, &
    COLOUR=100, SPLINE, RANGE=BEGL2B/ENDL2B, FILE="LCLS2sc_color", &
    TITLE="SC_linac: L2B"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGL2B/ENDL2B, FILE="LCLS2sc_color", &
    TITLE="SC_linac: L2B"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGBC2B/ENDEMIT2, FILE="LCLS2sc_color", &
    TITLE="SC_linac: BC2B + Emit2"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, VMIN=0, &
    COLOUR=100, SPLINE, RANGE=BEGL3B/ENDBR3B, FILE="LCLS2sc_color", &
    TITLE="SC_linac: L3B + BR3B"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGL3B/ENDBR3B, FILE="LCLS2sc_color", &
    TITLE="SC_linac: L3B + BR3B"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, VMIN=0, &
    COLOUR=100, SPLINE, RANGE=BEGL4B/ENDEXT, FILE="LCLS2sc_color", &
    TITLE="SC_linac: L4B + Extension"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGL4B/ENDEXT, FILE="LCLS2sc_color", &
    TITLE="SC_linac: L4B + Extension"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGDOG/MQBP13, FILE="LCLS2sc_color", &
    TITLE="SC_linac: Dogleg + Match to Bypass"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=MQBP13/ENDSPD_1, FILE="LCLS2sc_color", &
    TITLE="SC_linac: Bypass Line to Spreader"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGSPS/ENDLTUS, FILE="LCLS2sc_color", &
    TITLE="SC_linac: Spreader + LTUS"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, &
    COLOUR=100, SPLINE, RANGE=BEGUNDS/SXR47END, FILE="LCLS2sc_color", &
    TITLE="SXR Undulator"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=SXR47END/DUMPFACEB, FILE="LCLS2sc_color", &
    TITLE="SXR Post-undulator to Dump"

! SXR Safety Dump

  BEAM, ENERGY=Ei
  SET, SETSP, SETSPs ; SET, SETCUS, CUSOFF
  USE, SC_SFTSi
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGSFTS_1/SFTDMPB, FILE="LCLS2sc_color", &
    TITLE="SXR Safety Dump"

! Spreader to HXR Main Dump

  BEAM, ENERGY=Ei
  SET, SETSP, SETSPh
  USE, SC_HXRi
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGSPH/ENDLTUH, FILE="LCLS2sc_color", &
    TITLE="Spreader + LTUH"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGUNDH/DUMPFACE, FILE="LCLS2sc_color", &
    TITLE="HXR Undulator to Dump"

! Spreader to BSY Dump

  BEAM, ENERGY=Ei
  SET, SETSP, SETSPd ; SET, SETDA, DAOFF
  USE, SC_BSYDi
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGSPD_1/DUMPBSY, FILE="LCLS2sc_color", &
    TITLE="Spreader to BSY Dump"

! DIAG0

  BEAM, ENERGY=Ei
  USE, SC_DIAG0i
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGDIAG0/ENDDIAG0, FILE="LCLS2sc_color", &
    TITLE="DIAG0"

! S30XL/DASEL (off-project)

  BEAM, ENERGY=Ei
  SET, SETSP, SETSPd ; SET, SETDA, DAON
  USE, SC_DASELi
  TWISS, SAVE, BETA0=TWSSi
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGSPA/MADUMP, FILE="LCLS2sc_color", &
    TITLE="DASEL to A-line"

! ==============================================================================
! Color Twiss plots (beam from LEI gun)
! ------------------------------------------------------------------------------

! Cathode to BEAM0LEI

  BEAM, ENERGY=E0LEI
  USE, (GUNLEI,L0LEI)
  PRINT, FULL
  TWISS, SAVE, COUPLE, BETA0=TWSS0LEI
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=ENERGY, VMIN=0, VMAX=0.1, &
    COLOUR=100, -SPLINE, RANGE=#S/BEAM0LEI, FILE="LCLS2sc_color", &
    TITLE="GUNLEI + L0LEI"
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS=BETX,BETY, & !VMIN=0, VMAX=20, &
    COLOUR=100, SPLINE, RANGE=#S/BEAM0LEI, FILE="LCLS2sc_color", &
    TITLE="GUNLEI + L0LEI"

! DIAGIS

  BEAM, ENERGY=Ei
 !CALL, FILENAME="SETK2scDGI.xsif" !for mux=1.75*2pi from TCXDGI to OTRDGI1
  USE, SC_DIAGISi
  TWISS, SAVE, BETA0=TWSSiLEI
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGLEI_1/ENDDIAGIS, FILE="LCLS2sc_color", &
    TITLE="BEAM0LEI to DIAGIS spectrometer"

! DIAG02

  BEAM, ENERGY=Ei
  CALL, FILENAME="SETK2scLEI.xsif"
  USE, SC_DIAG02i
  TWISS, SAVE, BETA0=TWSSiLEI
  PLOT, TABLE=TWISS, HAXIS=S, VAXIS1=BETX,BETY, VAXIS2=DX,DY, &
    COLOUR=100, SPLINE, RANGE=BEGLEI_1/#E, FILE="LCLS2sc_color", &
    TITLE="BEAM0LEI to DIAG0"

! ------------------------------------------------------------------------------

  STOP
  
