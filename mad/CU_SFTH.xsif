
! *** OPTICS=AD_ACCEL-2019next ***

! CU_SFTH path configurations

  SETSP     := 0
  SETCUS    := 0
  SETAL     := 0
  SETDA     := 0
  SETHXRSS  := 0 !set to 1 to turn ON HXR self-seeding chicane
  SETSXRSS  := 0 !set to 1 to turn ON SXR self-seeding chicane
  SETXLEAP2 := 0 !set to 1 to turn ON XLEAP-II components

  IntgSX := 20.0   !kG (30.0)
  IntgHX := 40.0   !kG
  EBC2Cu :=  4.300 !GeV
  EfCu   := 13.640 !GeV
  EuCu   := 13.640 !GeV

  CALL, FILENAME="LCLS2cu_master.xsif" !calls other xsif files

  Q50Q3,  K1= 0.385752335743
  Q4,     K1=-0.220385532634
  Q5,     K1= 0.172839699359
  Q6,     K1=-0.115520035877
  QA0,    K1= 0.115396472684
  QVM1,   K1=-0.337436663026
  QVM2,   K1= 0.236576383993
  QVM3,   K1= 0.71515053765
  QVM4,   K1=-0.681649920856
  QUM1,   K1= 0.265384062224 ! 0.265843852443
  QUM2,   K1=-0.236197967124 !-0.23723331482
  QUM3,   K1= 0.165786910657 ! 0.165420280362
  QUM4,   K1=-0.176289890719 !-0.174981185812
  QHXH46, K1=-0.456644089634 !-0.462007123826
  QUE1,   K1=-0.092119193855 !-0.094048953252
  QUE2,   K1= 0.157955482519 ! 0.160549634478
  QDMP1,  K1=-0.155219342716 !-0.155211312125
  QDMP2,  K1=-0.155219342716 !-0.155211312125

  COMMENT !to generate SURVEY
    USE, CU_SFTH !start at gun
    ! initial energy: E00
    ! initial SURVEY: Xi, 0, Zi, ADLi, 0, 0
  ENDCOMMENT

 !COMMENT !to generate TWISS
    USE, CU_SFTH !start at gun
    ! initial energy: E00
    ! initial Twiss : CBETX, CALFX, CBETY, CALFY
 !ENDCOMMENT

  RETURN
