
! *** OPTICS=AD_ACCEL-18FEB2025s ***

! CU_SFTH beam path configuration

  SETSP     := 0 !deflector switch for HXR/SXR/BSYD spreader
  SETCUS    := 0 !deflector switch for HXR/CUSXR
  SETDA     := 0 !deflector switch for BSYD/DASEL
  SETHXRSS  := 0 !ON/OFF switch for HXR self-seeding chicane
  SETSXRSS  := 0 !ON/OFF switch for SXR self-seeding chicane
  SETPEPX   := 0 !ON/OFF switch for PEPPEx chicane
  SETCBXFEL := 0 !ON/OFF switch for CBXFEL chicane(s)
  SETXL2WIG := 0 !ON/OFF switch for XLEAP-II wiggler
  SETXL2SS  := 0 !ON/OFF switch for XLEAP-II self-seeding chicane

  IntgSX := 30.0 !kG
  IntgHX := 30.0 !kG

  CALL, FILENAME="LCLS2cu_master.xsif" !calls other xsif files

  Q50Q3,  K1= 0.384840836193
  Q4,     K1=-0.219396715399
  Q5,     K1= 0.165708853516
  Q6,     K1=-0.113569101753
  QA0,    K1= 0.109210101838
  QUM1,   K1= 0.272741408897
  QUM2,   K1=-0.270601268265
  QUM3,   K1= 0.278762678373
  QUM4,   K1=-0.247470889897
  QHXH46, K1=-1.734624260269
  QUE1,   K1= 0.169109252491
  QUE2,   K1=-0.137840816238
  QDMP1,  K1=-0.155212710055
  QDMP2,  K1=-0.155212710055

  COMMENT !to generate SURVEY
    USE, CU_SFTH !start at gun
    ! initial energy: E00
    ! initial SURVEY: Xi, 0, Zi, ADLi, 0, 0
  ENDCOMMENT

 !COMMENT !to generate TWISS
    USE, CU_SFTH !start at gun
    ! initial energy: E00
    ! initial Twiss : CBETX, CALFX, CBETY, CALFY
 !ENDCOMMENT

  COMMENT !to generate TWISS
    USE, CU_SFTHi !start at OTR2
    ! initial energy: Ei
    ! initial Twiss : BXi, AXi, BYi, AYi
  ENDCOMMENT

  RETURN
