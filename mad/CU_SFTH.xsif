
! *** OPTICS=AD_ACCEL-05OCT20 ***

! CU_SFTH path configurations

  SETSP     := 0
  SETCUS    := 0
  SETAL     := 0
  SETDA     := 0
  SETHXRSS  := 0 !set to 1 to turn ON HXR self-seeding chicane
  SETSXRSS  := 0 !set to 1 to turn ON SXR self-seeding chicane
  SETXLEAP2 := 0 !set to 1 to turn ON XLEAP-II components

  IntgSX := 30.0 !kG
  IntgHX := 30.0 !kG

  CALL, FILENAME="LCLS2cu_master.xsif" !calls other xsif files

  Q50Q3,  K1= 0.384840836193
  Q4,     K1=-0.219396715005
  Q5,     K1= 0.165708852383
  Q6,     K1=-0.113569101471
  QA0,    K1= 0.109210100868
  QUM1,   K1= 0.268627859107
  QUM2,   K1=-0.266627782522
  QUM3,   K1= 0.226430944506
  QUM4,   K1=-0.203543195724
  QHXH46, K1=-1.734624260269
  QUE1,   K1= 0.169109252491
  QUE2,   K1=-0.137840816238
  QDMP1,  K1=-0.155212710055
  QDMP2,  K1=-0.155212710055

  COMMENT !to generate SURVEY
    USE, CU_SFTH !start at gun
    ! initial energy: E00
    ! initial SURVEY: Xi, 0, Zi, ADLi, 0, 0
  ENDCOMMENT

 !COMMENT !to generate TWISS
    USE, CU_SFTH !start at gun
    ! initial energy: E00
    ! initial Twiss : CBETX, CALFX, CBETY, CALFY
 !ENDCOMMENT

  RETURN
