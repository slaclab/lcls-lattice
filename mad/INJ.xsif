! collimators, diagnostics, etc.
! ------------------------------------------------------------------------------

! halo/dark current collimator

  PC0H00 : ECOL, L=Ljaw, XSIZE=6.0e-3, YSIZE=6.0e-3, TYPE="tungsten"

! collimators (betatron X/Y half-apertures are 24/16 sigma for 1 um normalized
! emittance; default out-of-plane half-aperture is 20 mm)

  CEHTR : RCOL, L=Ljaw, XSIZE=3.0e-3, YSIZE=20.e-3, TYPE="HCOLL"    !X momentum collimator
  CYC01 : RCOL, L=Ljaw, YSIZE=4.4e-3, XSIZE=20.e-3, TYPE="VCOLL"    !Y betatron collimator
  CXC01 : RCOL, L=Ljaw, XSIZE=4.4e-3, YSIZE=20.e-3, TYPE="HCOLL"    !X betatron collimator
  CYC02 : RCOL, L=Ljaw, YSIZE=4.4e-3, XSIZE=20.e-3, TYPE="@4,VCOLL" !Y betatron collimator
  CXC02 : RCOL, L=Ljaw, XSIZE=4.4e-3, YSIZE=20.e-3, TYPE="@4,HCOLL" !X betatron collimator
  CYC03 : RCOL, L=Ljaw, YSIZE=4.4e-3, XSIZE=20.e-3, TYPE="VCOLL"    !Y betatron collimator
  CXC03 : RCOL, L=Ljaw, XSIZE=4.4e-3, YSIZE=20.e-3, TYPE="HCOLL"    !X betatron collimator

! instruments

  CATHODEB : INST
  VV01B    : INST
  IM01B    : IMON, TYPE="ICT"
  VV02B    : INST
  WS0H04   : WIRE, TYPE="fast"
  BZ0H04   : BLMO, TYPE="gap/diode"
  YAGH1    : PROF, TYPE="YAG INJ"
  YAGH2    : PROF, TYPE="YAG INJ"
  IMBCSi1  : IMON, TYPE="BCS ACM"
  IMBCSi2  : IMON, TYPE="BCS ACM"
  WSC006   : WIRE, TYPE="@4,fast"

  FC00EIC  : INST, TYPE="Faraday cup"

! combination YAG/collimator
! - beam pipe ID = 47.6 mm
! - one standard YAG crystal
! - one YAG crystal with a 6 mm diameter hole in it (for measuring beam halo)
! - four circular collimator bores (12mm, 16mm, 20mm, 24mm)

  YAG01B      : PROF, TYPE="YAG" !with or without hole
  YAG01B_COLL : ECOL, TYPE="collimator" !bore: 12mm, 16mm, 20mm, or 24mm
  YAG01B_full : LINE=(YAG01B,YAG01B_COLL)

! combination OTR/YAG !PAL type

  OTR0H04      : PROF, TYPE="OTR"
  OTR0H04_YAG  : PROF, TYPE="YAG"
  OTR0H04_full : LINE=(OTR0H04,OTR0H04_YAG)

  OTRC006      : PROF, TYPE="OTR"
  OTRC006_YAG  : PROF, TYPE="YAG"
  OTRC006_full : LINE=(OTRC006,OTRC006_YAG)

! marker points

  AM00B   : MARK !gun laser injection mirror (MIR01)
  BLFU    : MARK !beamline flange
  DP0H01  : MARK
  DP0H02  : MARK
  DP0H03  : MARK
  LHBEGB  : MARK
  MIRLHu  : MARK, TYPE="laser inj/ext"
  HTRUNDB : MARK, TYPE="SCATTER"
  MIRLHd  : MARK, TYPE="laser inj/ext"
  CNTHTR  : MARK, TYPE="CENTER"
  LHENDB  : MARK

  BEGEIC : MARK
  ECUEIC : MARK !u/s flange face
  ENDEIC : MARK

