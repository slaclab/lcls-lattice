! laser heater

  ZhBBo  := 3.264933791099
  ZhBBi  := 2.009304
  ZhBMo  := 1.53742329
  ZhBMIu := 0.37561671
  ZhBMId := 1.389994208901

  dLhun := 0.506263-9*lam !adjust undulator length

  Dh01   : DRIF, L=ZhBBo/COS(ABh), TYPE="CSR"
  Dh01a  : DRIF, L=ZhBMo/COS(ABh), TYPE="CSR"
  Dh01b  : DRIF, L=ZhBMIu/COS(ABh), TYPE="CSR"
