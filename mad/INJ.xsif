  DG006 : DRIF, L=0.075408
  DG007 : DRIF, L=0.139016-Lbun/2
  DG008 : DRIF, L=0.155084-Lbun/2
  DG009 : DRIF, L=0.181801
  DG010 : DRIF, L=0.222999
  DG011 : DRIF, L=0.121314
  DG012 : DRIF, L=0.155496-Lsol2/2
  DG013 : DRIF, L=0.136970-Lsol2/2
  DG014 : DRIF, L=0.101444
  DG015 : DRIF, L=0.004540
  DG016 : DRIF, L=0.163813

  DG012a : DRIF, L=0.08-LQg/2
  DG012b : DRIF, L=DG012[L]-LQg-DG012a[L]
  DG016b : DRIF, L=0.082968
  DG016a : DRIF, L=DG016[L]-DG016b[L]
  DG011b : DRIF, L=5.8*in2m-DG012a[L]-LQg
  DG011a : DRIF, L=DG011[L]-LQg-DG011b[L]

  DGEIC : DRIF, L=3.0-2.052577

! L0 to laser heater

  D0H00  : DRIF, L=0.658175
  D0H01  : DRIF, L=0.427898
  D0H02  : DRIF, L=4.179215
  D0H03  : DRIF, L=0.409812
  D0H04  : DRIF, L=1.0979
