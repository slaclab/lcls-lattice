
! *** OPTICS=AD_ACCEL-15OCT20 ***

! LCLS-style quadrupole (shorter effective length)

  LQut :=  0.078 !LCLS undulator quadrupole effective length [m]

  IntgHX13 :=  30.0
  IntgHX14 := -30.0
  IntgHX15 :=  30.0
  IntgHX16 := -30.0
  IntgHX17 :=  30.0
! ------18
  IntgHX19 :=  30.0
  IntgHX20 := -30.0
! ------21
! ------22
! ------23

  kQHXh13 := IntgHX13/LQut/Brhou
  kQHXh14 := IntgHX14/LQut/Brhou
  kQHXh15 := IntgHX15/LQut/Brhou
  kQHXh16 := IntgHX16/LQut/Brhou
  kQHXh17 := IntgHX17/LQut/Brhou
! -----18
  kQHXh19 := IntgHX19/LQut/Brhou
  kQHXh20 := IntgHX20/LQut/Brhou
! -----21
! -----22
! -----23

  QHXh13 : QUAD, TYPE="QUND", L=LQut/2, K1=kQHXh13 !QU01
  QHXh14 : QUAD, TYPE="QUND", L=LQut/2, K1=kQHXh14 !QU02
  QHXh15 : QUAD, TYPE="QUND", L=LQut/2, K1=kQHXh15 !QU03
  QHXh16 : QUAD, TYPE="QUND", L=LQut/2, K1=kQHXh16 !QU04
  QHXh17 : QUAD, TYPE="QUND", L=LQut/2, K1=kQHXh17 !QU05
! ----18
  QHXh19 : QUAD, TYPE="QUND", L=LQut/2, K1=kQHXh19 !QU07
  QHXh20 : QUAD, TYPE="QUND", L=LQut/2, K1=kQHXh20 !QU08
! ----21
! ----22
! ----23

  LRFBut := 0 !undulator RF-BPM only implemented as zero length monitor

  RFBHX13 : MONI, L=LRFBut, TYPE="01_um_res" !RFBU01
  RFBHX14 : MONI, L=LRFBut, TYPE="01_um_res" !RFBU02
  RFBHX15 : MONI, L=LRFBut, TYPE="01_um_res" !RFBU03
  RFBHX16 : MONI, L=LRFBut, TYPE="01_um_res" !RFBU04
  RFBHX17 : MONI, L=LRFBut, TYPE="01_um_res" !RFBU05
! -----18
  RFBHX19 : MONI, L=LRFBut, TYPE="01_um_res" !RFBU07
  RFBHX20 : MONI, L=LRFBut, TYPE="01_um_res" !RFBU08
! -----21
! -----22
! -----23

! unused Beam Finder Wires

  BFW01 : MARK
  BFW02 : MARK
  BFW03 : MARK
  BFW04 : MARK
  BFW05 : MARK
! ---06
  BFW07 : MARK
  BFW08 : MARK
! ---09
! ---10
! ---11

  DUSEGH : DRIF, L=1.665
  DTt    : DRIF, L=0.035
  DBWMt  : DRIF, L=0.035133
  DB4t   : DRIF, L=0.058577
  DB1    : DRIF, L=0.06889
  DB3    : DRIF, L=0.09111
  DBRSt  : DRIF, L=0.13829
  DBRL   : DRIF, L=0.56629

  USTBK01 : LINE=(DTt,DUSEGH,DUSEGH,DTt)
  USTBK02 : LINE=(DTt,DUSEGH,DUSEGH,DTt)
  USTBK03 : LINE=(DTt,DUSEGH,DUSEGH,DTt)
  USTBK04 : LINE=(DTt,DUSEGH,DUSEGH,DTt)
  USTBK05 : LINE=(DTt,DUSEGH,DUSEGH,DTt)
! -----06
  USTBK07 : LINE=(DTt,DUSEGH,DUSEGH,DTt)
  USTBK08 : LINE=(DTt,DUSEGH,DUSEGH,DTt)
! -----09
! -----10
! -----11

  QHXh13_full : LINE=(QHXh13,XCHX13,MUQH,YCHX13,QHXh13)
  QHXh14_full : LINE=(QHXh14,XCHX14,MUQH,YCHX14,QHXh14)
  QHXh15_full : LINE=(QHXh15,XCHX15,MUQH,YCHX15,QHXh15)
  QHXh16_full : LINE=(QHXh16,XCHX16,MUQH,YCHX16,QHXh16)
  QHXh17_full : LINE=(QHXh17,XCHX17,MUQH,YCHX17,QHXh17)
! ----18-----
  QHXh19_full : LINE=(QHXh19,XCHX19,MUQH,YCHX19,QHXh19)
  QHXh20_full : LINE=(QHXh20,XCHX20,MUQH,YCHX20,QHXh20)
! ----21-----
! ----22-----
! ----23-----

  GIRD01 : LINE=(BFW01,DBWMt,DB4t,USTBK01,DB1,QHXh13_full,DB3,RFBHX13) !cell 13: LCLS-style, no undulator
  GIRD02 : LINE=(BFW02,DBWMt,DB4t,USTBK02,DB1,QHXh14_full,DB3,RFBHX14) !cell 14: LCLS-style, no undulator
  GIRD03 : LINE=(BFW03,DBWMt,DB4t,USTBK03,DB1,QHXh15_full,DB3,RFBHX15) !cell 15: LCLS-style, no undulator
  GIRD04 : LINE=(BFW04,DBWMt,DB4t,USTBK04,DB1,QHXh16_full,DB3,RFBHX16) !cell 16: LCLS-style, no undulator
  GIRD05 : LINE=(BFW05,DBWMt,DB4t,USTBK05,DB1,QHXh17_full,DB3,RFBHX17) !cell 17: LCLS-style, no undulator
! ----06
  GIRD07 : LINE=(BFW07,DBWMt,DB4t,USTBK07,DB1,QHXh19_full,DB3,RFBHX19) !cell 19: LCLS-style, no undulator
  GIRD08 : LINE=(BFW08,DBWMt,DB4t,USTBK08,DB1,QHXh20_full,DB3,RFBHX20) !cell 20: LCLS-style, no undulator
! ----09
! ----10
! ----11

  ZbsyG01 := 5.152655814E+02 !start of LCLS GIRD01
  ZbsyG05 := 5.349052914E+02 !end of LCLS GIRD05
  ZbsyG07 := 5.393415814E+02 !start of LCLS GIRD07
  ZbsyG08 := 5.469432914E+02 !end of LCLS GIRD08

  ZbsyC13 := 5.150949847E+02 !start of LCLS-II cell 13
  ZbsyC17 := 5.351583181E+02 !end of LCLS-II cell 17
  ZbsyC19 := 5.391709847E+02 !start of LCLS-II cell 19
  ZbsyC20 := 5.471963181E+02 !end of LCLS-II cell 20

  DGIRD01u : DRIF, L=ZbsyG01-ZbsyC13
  DGIRD05d : DRIF, L=ZbsyC17-ZbsyG05
  DGIRD07u : DRIF, L=ZbsyG07-ZbsyC19 !-0.1E-06
  DGIRD08d : DRIF, L=ZbsyC20-ZbsyG08
