
! *** OPTICS=AD_ACCEL-05DEC19 ***

! CU_SXR path configurations

  SETSP     := 0
  SETCUS    := 1
  SETAL     := 0
  SETDA     := 0
  SETHXRSS  := 0 !set to 1 to turn ON HXR self-seeding chicane
  SETSXRSS  := 0 !set to 1 to turn ON SXR self-seeding chicane
  SETXLEAP2 := 0 !set to 1 to turn ON XLEAP-II components

  IntgSX := 30.0 !kG
  IntgHX := 30.0 !kG

  CALL, FILENAME="LCLS2cu_master.xsif" !calls other xsif files

  QBP33,  K1=-0.644554011561
  QBP34,  K1= 0.595247855684
  QDBL1,  K1=-1.067473401506
  QDBL2,  K1= 0.619068833425
  QDL11,  K1= 0.358733393526
  QUM4B,  K1=-0.61774146348
  QSX16,  K1= 0.677894017174
  QSX19,  K1=-0.893321229694
  QSX21,  K1= 0.901518123026
  QSX24,  K1=-0.825282828044
  QSX47,  K1=-0.470663936073
  QUE1B,  K1=-0.251630752095
  QUE2B,  K1= 0.373117835514
  QDMP1B, K1=-0.155049913166
  QDMP2B, K1=-0.155049913166

  COMMENT !to generate SURVEY
    USE, CU_SXR !start at gun
    ! initial energy: E00
    ! initial SURVEY: Xi, 0, Zi, ADLi, 0, 0
  ENDCOMMENT

 !COMMENT !to generate TWISS
    USE, CU_SXR !start at gun
    ! initial energy: E00
    ! initial Twiss : CBETX, CALFX, CBETY, CALFY
 !ENDCOMMENT

  RETURN
