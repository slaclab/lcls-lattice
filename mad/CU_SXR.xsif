
! *** OPTICS=AD_ACCEL-15SEP21 ***

! CU_SXR path configurations

  SETSP     := 0
  SETCUS    := 1
  SETAL     := 0
  SETDA     := 0
  SETHXRSS  := 0 !set to 1 to turn ON HXR self-seeding chicane
  SETSXRSS  := 0 !set to 1 to turn ON SXR self-seeding chicane
  SETXLEAP2 := 0 !set to 1 to turn ON XLEAP-II components

  IntgSX := 30.0 !kG
  IntgHX := 30.0 !kG

  CALL, FILENAME="LCLS2cu_master.xsif" !calls other xsif files

  QBP33,  K1=-0.645066535808
  QBP34,  K1= 0.592977153135
  QDBL1,  K1=-1.045760158543
  QDBL2,  K1= 0.585600770813
  QDL11,  K1= 0.358732502069
  QUM1B,  K1= 0.311729673613
  QUM2B,  K1=-0.13
  QUM3B,  K1= 0.384569277452
  QUM4B,  K1=-0.61774146348
  QSXH16, K1= 0.677696586055
  QSXH19, K1=-0.894080323674
  QSXH21, K1= 0.902720730991
  QSXH24, K1=-0.825788398259
  QSXH47, K1=-1.843482712046
  QUE1B,  K1= 0.325725075565
  QUE2B,  K1=-0.144356640751
  QDMP1B, K1=-0.154946553294
  QDMP2B, K1=-0.154946553294

  COMMENT !to generate SURVEY
    USE, CU_SXR !start at gun
    ! initial energy: E00
    ! initial SURVEY: Xi, 0, Zi, ADLi, 0, 0
  ENDCOMMENT

 !COMMENT !to generate TWISS
    USE, CU_SXR !start at gun
    ! initial energy: E00
    ! initial Twiss : CBETX, CALFX, CBETY, CALFY
 !ENDCOMMENT

  RETURN
