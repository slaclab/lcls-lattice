
! *** OPTICS=AD_ACCEL-preRelease ***

! CU_SXR path configuration

  SETSP     := 0 !deflector switch for HXR/SXR/BSYD spreader
  SETCUS    := 1 !deflector switch for HXR/CUSXR
  SETDA     := 0 !deflector switch for BSYD/DASEL
  SETHXRSS  := 0 !ON/OFF switch for HXR self-seeding chicane
  SETSXRSS  := 0 !ON/OFF switch for SXR self-seeding chicane
  SETPEPX   := 0 !ON/OFF switch for PEPPEx chicane
  SETCBXFEL := 0 !ON/OFF switch for CBXFEL chicanes
  SETXL2WIG := 0 !ON/OFF switch for XLEAP-II wiggler
  SETXL2SS  := 0 !ON/OFF switch for XLEAP-II self-seeding chicane

  IntgSX := 30.0 !kG
  IntgHX := 30.0 !kG

  CALL, FILENAME="LCLS2cu_master.xsif" !calls other xsif files

  QBP33,  K1=-0.644574478167
  QBP34,  K1= 0.59726873366 
  QDBL1,  K1=-1.078395638822
  QDBL2,  K1= 0.636934220082
  QDL11,  K1= 0.359459375554

  COMMENT !to generate SURVEY
    USE, CU_SXR !start at gun
    ! initial energy: E00
    ! initial SURVEY: Xi, 0, Zi, ADLi, 0, 0
  ENDCOMMENT

 !COMMENT !to generate TWISS
    USE, CU_SXR !start at gun
    ! initial energy: E00
    ! initial Twiss : CBETX, CALFX, CBETY, CALFY
 !ENDCOMMENT

  COMMENT !to generate TWISS
    USE, CU_SXRi !start at gun
    ! initial energy: Ei
    ! initial Twiss : BXi, AXi, BYi, AYi
  ENDCOMMENT

  RETURN
