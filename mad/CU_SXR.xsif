
! *** OPTICS=AD_ACCEL-06NOV2025s ***

! CU_SXR beam path configuration

  SETSP     := 0 !deflector switch for HXR/SXR/BSYD spreader
  SETCUS    := 1 !deflector switch for HXR/CUSXR
  SETDA     := 0 !deflector switch for BSYD/DASEL
  SETHXRSS  := 0 !ON/OFF switch for HXR self-seeding chicane
  SETSXRSS  := 0 !ON/OFF switch for SXR self-seeding chicane
  SETPEPX   := 0 !ON/OFF switch for PEPPEx chicane
  SETCBXFEL := 0 !ON/OFF switch for CBXFEL chicane(s)
  SETXL2WIG := 0 !ON/OFF switch for XLEAP-II wiggler
  SETXL2SS  := 0 !ON/OFF switch for XLEAP-II self-seeding chicane

  IntgSX := 30.0 !kG
  IntgHX := 30.0 !kG

  CALL, FILENAME="LCLS2cu_master.xsif" !calls other xsif files

  QBP33,  K1=-0.644929924665
  QBP34,  K1= 0.594268425596
  QDBL1,  K1=-1.055659800022
  QDBL2,  K1= 0.60103715269 
  QDL11,  K1= 0.358957901623
  QUM1B,  K1= 0.594601107257
  QUM2B,  K1=-0.832190827952
  QUM3B,  K1= 0.894619176764
  QUM4B,  K1=-0.592858253522
  QSXH16, K1= 0.497605535024
  QSXH47, K1=-1.843482712046 !Yuri (E=8.0, K=5.0)
  QUE1B,  K1= 0.325725075565 !Yuri (E=8.0, K=5.0)
  QUE2B,  K1=-0.144356640751 !Yuri (E=8.0, K=5.0)
  QDMP1B, K1=-0.154946553294 !Yuri (E=8.0, K=5.0)
  QDMP2B, K1=-0.154946553294 !Yuri (E=8.0, K=5.0)

  COMMENT !to generate SURVEY
    USE, CU_SXR !start at gun
    ! initial energy: E00
    ! initial SURVEY: Xi, 0, Zi, ADLi, 0, 0
  ENDCOMMENT

 !COMMENT !to generate TWISS
    USE, CU_SXR !start at gun
    ! initial energy: E00
    ! initial Twiss : CBETX, CALFX, CBETY, CALFY
 !ENDCOMMENT

  COMMENT !to generate TWISS
    USE, CU_SXRi !start at gun
    ! initial energy: Ei
    ! initial Twiss : BXi, AXi, BYi, AYi
  ENDCOMMENT

  RETURN
