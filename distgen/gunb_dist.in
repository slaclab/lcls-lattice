##############################
#To run the following file, 
# on the command line, use:
# distgen -gpt dist.in -v 1
#############################
#----------------------------------
particle_count 10000 
dist_name gpt-10k-1.2mm-2ps.part
total_charge 250 [pC]
particle_type e-
#----------------------------------

#----------------------------------
#    Transverse Coordinates:
#----------------------------------
r_dist         truncated_gaussian
#r_min           0.5 [mm]
#r_max           1 [mm]
#xy_rms     0.2 [mm]
truncation_fraction	0.5
pinhole_size	1 [mm]
x_offset     0 [mm]
y_offset     0 [mm]
px_dist     gaussian
py_dist     gaussian
MTE         510 [meV]   
#----------------------------------

#----------------------------------
#    Longitudinal Coordinates:
#----------------------------------
#t_dist        uniform
#t_min         -4 [ps]
#t_max          0 [ps]
#
t_dist        gaussian
sigma_t       8.5 [ps]
#
#t_dist		deformable
#t_rand		pr
#t_tail		0
#t_dip		0
#t_ellips	0
#t_slope		0
#sigma_t		2 [ps]
#----------------------------------

#----------------------------------
#         GPT Specific:
#----------------------------------
#asci2gdf_binary asci2gdf
#----------------------------------	          
# output file name

