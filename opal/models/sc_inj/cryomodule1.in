//Input components for LCLS2 - Cryomodule 1 
//-------------------------------------------------------------------------------------
// Cryomodule 1
//
// Cavity/RF field.
//
// L:			physical element length (real in m). Length (of field map) (m).
// VOLT:		field scaling factor (real). RF field magnitude (MV/m).
// FMAPFN:		field file name (string)
// ELEMEDGE:		physical start of the element on the floor (real in m)
// TYPE:		specifies "STANDING" (default), "TRAVELLING" or "SINGLE GAP" structure
// FREQ:		RF frequency of cavity (real in MHz). Resonance frequency.
// LAG:			cavity phase (radians)
//

REAL lcav = 1.3836; 

REAL d1 = 3.3428;
REAL d2 = d1 + lcav;
REAL d3 = d2 + lcav;
REAL d4 = d3 + lcav;
REAL d5 = d4 + lcav;
REAL d6 = d5 + lcav;
REAL d7 = d6 + lcav;
REAL d8 = d7 + lcav;
REAL deg = 3.14/180.0;

C1: RFCavity, L = 0.199, VOLT = 14.0, ELEMEDGE = d1, TYPE = "STANDING", 		
    FMAPFN = "../../fieldmaps/L0B_9cell.txt",
    FREQ = 1.3e3, LAG = -35*deg; 

C2: RFCavity, L = 0.199, VOLT = 1.0e-20, ELEMEDGE = d2, TYPE = "STANDING", 		
    FMAPFN = "../../fieldmaps/L0B_9cell.txt",
    FREQ = 1.3e3, LAG = 0.0; 

C3: RFCavity, L = 0.199, VOLT = 1.0e-20, ELEMEDGE = d3, TYPE = "STANDING", 		
    FMAPFN = "../../fieldmaps/L0B_9cell.txt",
    FREQ = 1.3e3, LAG = 0.0; 

C4: RFCavity, L = 0.199, VOLT = 28.0, ELEMEDGE = d4, TYPE = "STANDING", 		
    FMAPFN = "../../fieldmaps/L0B_9cell.txt",
    FREQ = 1.3e3, LAG = 0.0; 

C5: RFCavity, L = 0.199, VOLT = 32.2, ELEMEDGE = d5, TYPE = "STANDING", 		
    FMAPFN = "../../fieldmaps/L0B_9cell.txt",
    FREQ = 1.3e3, LAG = 0.0; 

C6: RFCavity, L = 0.199, VOLT = 32.2, ELEMEDGE = d6, TYPE = "STANDING", 		
    FMAPFN = "../../fieldmaps/L0B_9cell.txt",
    FREQ = 1.3e3, LAG = 0.0; 

C7: RFCavity, L = 0.199, VOLT = 32.2, ELEMEDGE = d7, TYPE = "STANDING", 		
    FMAPFN = "../../fieldmaps/L0B_9cell.txt",
    FREQ = 1.3e3, LAG = 0*deg; 

C8: RFCavity, L = 0.199, VOLT = 32.2, ELEMEDGE = d8, TYPE = "STANDING", 		
    FMAPFN = "../../fieldmaps/L0B_9cell.txt",
    FREQ = 1.3e3, LAG = 0*deg; 


      
CM1:  Line = (C1,C2,C3,C4,C5,C6,C7,C8);
